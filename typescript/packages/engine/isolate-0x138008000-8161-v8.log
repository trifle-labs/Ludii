script-source,209,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/one-ply-no-heuristic.js,/**\n * Java parity: AI/src/search/flat/OnePlyNoHeuristic.java \u2014\n * Look one move ahead\x2C pick the move whose resulting state has the\n * highest reward for the mover. No heuristic on non-terminal states:\n * everything that hasn't ended is treated as a draw (the midpoint of\n * win and loss). Ties broken at random.\n *\n * Useful as a baseline: stronger than random because it always grabs\n * an immediate win when one exists\x2C but blind beyond a single ply.\n */\nimport { SeededRng } from "../rng.js";\nimport { AI } from "./ai.js";\nimport { scoreForPlayer } from "./flat-monte-carlo-ai.js";\nexport class OnePlyNoHeuristic extends AI {\n    rng;\n    constructor(options = {}) {\n        super();\n        this.friendlyName = "One-Ply (No Heuristic)";\n        this.rng = new SeededRng(options.seed ?? 0x1f1f1f);\n    }\n    withSeed(seed) {\n        this.rng = new SeededRng(seed);\n        return this;\n    }\n    selectAction(context\x2C _options = {}) {\n        const moves = context.game.moves(context);\n        if (moves.length === 0)\n            return undefined;\n        if (moves.length === 1)\n            return moves[0];\n        const mover = context.mover;\n        let bestScore = Number.NEGATIVE_INFINITY;\n        const bestMoves = [];\n        for (const move of moves) {\n            const child = context.game.apply(context\x2C move);\n            // For terminal states\x2C use the actual outcome; otherwise treat as\n            // draw (0). Java uses the midpoint of next-win/next-loss bounds \u2014\n            // for win/draw/loss in [-1\x2C 0\x2C +1] that midpoint is 0.\n            const score = child.over ? scoreForPlayer(child\x2C mover) : 0;\n            if (score > bestScore) {\n                bestScore = score;\n                bestMoves.length = 0;\n                bestMoves.push(move);\n            }\n            else if (score === bestScore) {\n                bestMoves.push(move);\n            }\n        }\n        const pick = this.rng.nextInt(bestMoves.length);\n        return bestMoves[pick];\n    }\n}\n//# sourceMappingURL=one-ply-no-heuristic.js.map
