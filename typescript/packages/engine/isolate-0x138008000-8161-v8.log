script-source,206,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/mcts-ai.js,/**\n * Java parity: AI/src/search/mcts/MCTS.java (selection/expansion/simulation/\n * backpropagation skeleton) \u2014 a self-contained UCT MCTS for the TS\n * engine surface. The TS version trades the Java surface's pluggability\n * (multiple selection/playout/backprop classes) for a single\x2C focused\n * UCT implementation that matches the engine's deterministic\x2C immutable\n * Game/Context model.\n */\nimport { SeededRng } from "../rng.js";\nimport { AI } from "./ai.js";\nimport { scoreForPlayer } from "./flat-monte-carlo-ai.js";\nimport { NSTPlayout } from "./nst-playout.js";\nimport { RandomPlayout } from "./playout.js";\nconst DEFAULT_EXPLORATION = Math.SQRT2;\nconst DEFAULT_MAX_PLAYOUT_LENGTH = 256;\nconst DEFAULT_ITERATIONS = 1024;\nclass MCTSNode {\n    visits = 0;\n    totalReward = 0;\n    /** Moves not yet expanded into a child. */\n    untried;\n    children = [];\n    /** The move played to reach this node from its parent. */\n    moveFromParent;\n    parent;\n    context;\n    /** The mover whose perspective `totalReward` is recorded from. */\n    moverAtNode;\n    constructor(context\x2C parent\x2C move) {\n        this.context = context;\n        this.parent = parent;\n        this.moveFromParent = move;\n        this.moverAtNode = context.mover;\n        this.untried = [...context.game.moves(context)];\n    }\n    isLeaf() {\n        return this.untried.length > 0 || this.children.length === 0;\n    }\n    bestChild(c\x2C progressiveHistoryWeight = 0\x2C moveStats) {\n        let best;\n        let bestScore = Number.NEGATIVE_INFINITY;\n        const logN = Math.log(Math.max(1\x2C this.visits));\n        for (const child of this.children) {\n            const exploit = child.visits > 0 ? child.totalReward / child.visits : 0;\n            const explore = c * Math.sqrt(logN / Math.max(1\x2C child.visits));\n            let bias = 0;\n            if (progressiveHistoryWeight > 0 &&\n                moveStats !== undefined &&\n                child.moveFromParent !== undefined) {\n                bias =\n                    (progressiveHistoryWeight * moveStats.mean(child.moveFromParent)) /\n                        (child.visits + 1);\n            }\n            const score = exploit + explore + bias;\n            if (score > bestScore) {\n                bestScore = score;\n                best = child;\n            }\n        }\n        return best ?? this;\n    }\n    mostVisitedChild() {\n        let best;\n        let bestVisits = -1;\n        for (const child of this.children) {\n            if (child.visits > bestVisits) {\n                bestVisits = child.visits;\n                best = child;\n            }\n        }\n        return best;\n    }\n}\nexport class MCTSAI extends AI {\n    c;\n    maxPlayoutLength;\n    defaultIterations;\n    playout;\n    moveStats;\n    bigramStats;\n    progressiveHistoryWeight;\n    alphaGoBlend;\n    rng;\n    constructor(options = {}) {\n        super();\n        this.friendlyName = "UCT";\n        this.c = options.explorationConstant ?? DEFAULT_EXPLORATION;\n        this.maxPlayoutLength =\n            options.maxPlayoutLength ?? DEFAULT_MAX_PLAYOUT_LENGTH;\n        this.defaultIterations = options.defaultIterations ?? DEFAULT_ITERATIONS;\n        this.playout = options.playout ?? new RandomPlayout();\n        this.moveStats = options.moveStats;\n        this.bigramStats = options.bigramStats;\n        this.progressiveHistoryWeight = options.progressiveHistoryWeight ?? 0;\n        this.alphaGoBlend = Math.max(0\x2C Math.min(1\x2C options.alphaGoBlend ?? 1));\n        this.rng = new SeededRng(options.seed ?? 0xb16b00b5);\n    }\n    selectAction(context\x2C options = {}) {\n        const rootMoves = context.game.moves(context);\n        if (rootMoves.length === 0)\n            return undefined;\n        if (rootMoves.length === 1)\n            return rootMoves[0];\n        const root = new MCTSNode(context);\n        const start = Date.now();\n        const deadlineMs = options.maxSeconds && options.maxSeconds > 0\n            ? options.maxSeconds * 1000\n            : Number.POSITIVE_INFINITY;\n        const iterLimit = options.maxIterations !== undefined && options.maxIterations >= 0\n            ? options.maxIterations\n            : deadlineMs === Number.POSITIVE_INFINITY\n                ? this.defaultIterations\n                : Number.POSITIVE_INFINITY;\n        const depthLimit = options.maxDepth !== undefined && options.maxDepth >= 0\n            ? options.maxDepth\n            : Number.POSITIVE_INFINITY;\n        for (let i = 0; i < iterLimit; i += 1) {\n            if (Date.now() - start > deadlineMs)\n                break;\n            this.iterate(root\x2C depthLimit);\n        }\n        const best = root.mostVisitedChild();\n        return best?.moveFromParent ?? rootMoves[0];\n    }\n    iterate(root\x2C depthLimit) {\n        // ---- Selection ----------------------------------------------------\n        let node = root;\n        let depth = 0;\n        const playedMoves = [];\n        while (node.untried.length === 0 &&\n            node.children.length > 0 &&\n            !node.context.over &&\n            depth < depthLimit) {\n            node = node.bestChild(this.c\x2C this.progressiveHistoryWeight\x2C this.moveStats);\n            if (node.moveFromParent !== undefined)\n                playedMoves.push(node.moveFromParent);\n            depth += 1;\n        }\n        // ---- Expansion ----------------------------------------------------\n        if (!node.context.over && node.untried.length > 0 && depth < depthLimit) {\n            const idx = this.rng.nextInt(node.untried.length);\n            const move = node.untried[idx];\n            node.untried.splice(idx\x2C 1);\n            const childCtx = node.context.game.apply(node.context\x2C move);\n            const child = new MCTSNode(childCtx\x2C node\x2C move);\n            node.children.push(child);\n            playedMoves.push(move);\n            node = child;\n        }\n        // ---- Simulation ---------------------------------------------------\n        if (this.playout instanceof NSTPlayout)\n            this.playout.resetHistory();\n        const simReward = this.simulate(node.context\x2C playedMoves);\n        // ---- Stats update -------------------------------------------------\n        // Update MAST/NST tables with each move played\x2C from that player's\n        // perspective.\n        if (this.moveStats !== undefined || this.bigramStats !== undefined) {\n            let prevHash = 0;\n            for (const move of playedMoves) {\n                const reward = signedRewardFor(simReward\x2C move.mover);\n                if (this.moveStats !== undefined)\n                    this.moveStats.update(move\x2C reward);\n                if (this.bigramStats !== undefined)\n                    this.bigramStats.update(prevHash\x2C move\x2C reward);\n                prevHash = move.hash();\n            }\n        }\n        // ---- Backpropagation ----------------------------------------------\n        let cursor = node;\n        while (cursor !== undefined) {\n            cursor.visits += 1;\n            const moverHere = cursor.moverAtNode;\n            const signed = signedRewardFor(simReward\x2C moverHere);\n            let blended = signed;\n            if (this.alphaGoBlend < 1 &&\n                this.moveStats !== undefined &&\n                cursor.moveFromParent !== undefined) {\n                const prior = this.moveStats.mean(cursor.moveFromParent);\n                blended = this.alphaGoBlend * signed + (1 - this.alphaGoBlend) * prior;\n            }\n            cursor.totalReward += blended;\n            cursor = cursor.parent;\n        }\n    }\n    simulate(context\x2C playedMoves) {\n        let cur = context;\n        for (let depth = 0; depth < this.maxPlayoutLength; depth += 1) {\n            if (cur.over)\n                break;\n            const m = this.playout.selectMove(cur\x2C this.rng);\n            if (m === undefined)\n                break;\n            playedMoves.push(m);\n            cur = cur.game.apply(cur\x2C m);\n        }\n        // Return a per-player reward map (for 2-player games we just need\n        // the winner; encode as winner-or-draw).\n        if (!cur.over) {\n            return { winner: 0\x2C draw: true };\n        }\n        return { winner: cur.winner\x2C draw: cur.winner === 0 };\n    }\n}\nfunction signedRewardFor(reward\x2C player) {\n    if (reward.draw)\n        return 0;\n    return reward.winner === player ? 1 : -1;\n}\nexport { scoreForPlayer };\n//# sourceMappingURL=mcts-ai.js.map
