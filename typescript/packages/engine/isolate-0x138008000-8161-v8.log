script-source,233,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/graph-element.js,// @java Core/src/game/util/graph/GraphElement.java GraphElement\n// @java Core/src/game/util/graph/Vertex.java Vertex\n// @java Core/src/game/util/graph/Edge.java Edge\n// @java Core/src/game/util/graph/Face.java Face\n//\n// The incidence substrate the trajectory generator walks. Our base Graph\n// (graph.ts) stores only vertex/edge/face lists; Java's Vertex/Edge/Face carry\n// the cross-references (vertex.edges()/faces()\x2C edge's two faces\x2C face.edges())\n// that Face.stepsTo / Vertex.stepsTo traverse. This module derives those\n// references once\x2C so the generated topology matches Java element-for-element.\n/** SiteType ordinals\x2C faithful to Java game.types.board.SiteType. */\nexport var SiteType;\n(function (SiteType) {\n    SiteType[SiteType["Vertex"] = 0] = "Vertex";\n    SiteType[SiteType["Edge"] = 1] = "Edge";\n    SiteType[SiteType["Cell"] = 2] = "Cell";\n})(SiteType || (SiteType = {}));\nexport const NUM_SITE_TYPES = 3;\nexport class VertexEl {\n    id;\n    pt;\n    siteType = SiteType.Vertex;\n    edges = [];\n    faces = [];\n    pivotVertex = null;\n    constructor(id\x2C pt) {\n        this.id = id;\n        this.pt = pt;\n    }\n    pivot() {\n        return this.pivotVertex;\n    }\n    setPivot(v) {\n        this.pivotVertex = v;\n    }\n    /** @java Vertex.edgeAwayFrom(Face) */\n    edgeAwayFrom(face) {\n        for (const edge of this.edges) {\n            if (!face.containsEdge(edge))\n                return edge.otherVertex(this.id);\n        }\n        return null;\n    }\n}\nexport class EdgeEl {\n    id;\n    va;\n    vb;\n    pt;\n    siteType = SiteType.Edge;\n    faces = [];\n    constructor(id\x2C va\x2C vb\x2C pt) {\n        this.id = id;\n        this.va = va;\n        this.vb = vb;\n        this.pt = pt;\n    }\n    pivot() {\n        return null;\n    }\n    /** @java Edge.otherVertex(int) */\n    otherVertex(vid) {\n        return this.va.id === vid ? this.vb : this.va;\n    }\n    /** @java Edge.otherFace(int) */\n    otherFace(faceId) {\n        for (const f of this.faces)\n            if (f.id !== faceId)\n                return f;\n        return null;\n    }\n}\nexport class FaceEl {\n    id;\n    pt;\n    siteType = SiteType.Cell;\n    vertices = [];\n    edges = [];\n    constructor(id\x2C pt) {\n        this.id = id;\n        this.pt = pt;\n    }\n    /** @java Core/src/game/util/graph/Face.java pivot */\n    pivot() {\n        // First vertex with a pivot (concentric boards).\n        for (const v of this.vertices) {\n            const p = v.pivot();\n            if (p !== null)\n                return p;\n        }\n        return null;\n    }\n    containsVertex(v) {\n        for (const vv of this.vertices)\n            if (vv.id === v.id)\n                return true;\n        return false;\n    }\n    containsEdge(e) {\n        for (const ee of this.edges)\n            if (ee.id === e.id)\n                return true;\n        return false;\n    }\n}\n/**\n * Derived topology: VertexEl / EdgeEl / FaceEl with their cross-references\x2C\n * built once from a planar Graph. `elements(siteType)` mirrors Java\n * `graph.elements(SiteType)`.\n */\nexport class GraphTopology {\n    verts = [];\n    edgeEls = [];\n    faceEls = [];\n    constructor(graph) {\n        // Vertices.\n        for (const v of graph.vertices) {\n            this.verts.push(new VertexEl(v.id\x2C { x: v.x\x2C y: v.y\x2C z: 0 }));\n        }\n        // Edges \u2014 midpoint as pt; record an undirected key \u2192 EdgeEl for face wiring.\n        const edgeByKey = new Map();\n        const key = (a\x2C b) => a < b ? `${a}:${b}` : `${b}:${a}`;\n        for (const e of graph.edges) {\n            const va = this.verts[e.a];\n            const vb = this.verts[e.b];\n            if (!va || !vb)\n                continue;\n            const mid = {\n                x: (va.pt.x + vb.pt.x) / 2\x2C\n                y: (va.pt.y + vb.pt.y) / 2\x2C\n                z: 0\x2C\n            };\n            const edge = new EdgeEl(e.id\x2C va\x2C vb\x2C mid);\n            this.edgeEls.push(edge);\n            edgeByKey.set(key(e.a\x2C e.b)\x2C edge);\n            va.edges.push(edge);\n            vb.edges.push(edge);\n        }\n        // Faces \u2014 vertices in polygon order\x2C edges between consecutive vertices.\n        for (const f of graph.faces) {\n            const face = new FaceEl(f.id\x2C { x: f.cx\x2C y: f.cy\x2C z: 0 });\n            for (const vid of f.vertices) {\n                const v = this.verts[vid];\n                if (v) {\n                    face.vertices.push(v);\n                    v.faces.push(face);\n                }\n            }\n            const k = f.vertices.length;\n            for (let i = 0; i < k; i += 1) {\n                const a = f.vertices[i];\n                const b = f.vertices[(i + 1) % k];\n                const edge = edgeByKey.get(key(a\x2C b));\n                if (edge) {\n                    face.edges.push(edge);\n                    if (!edge.faces.includes(face))\n                        edge.faces.push(face);\n                }\n            }\n            this.faceEls.push(face);\n        }\n    }\n    elements(siteType) {\n        if (siteType === SiteType.Vertex)\n            return this.verts;\n        if (siteType === SiteType.Edge)\n            return this.edgeEls;\n        return this.faceEls;\n    }\n    /** Mean edge length \u2014 @java Graph.averageEdgeLength(). */\n    averageEdgeLength() {\n        if (this.edgeEls.length === 0)\n            return 0;\n        let total = 0;\n        for (const e of this.edgeEls) {\n            const dx = e.vb.pt.x - e.va.pt.x;\n            const dy = e.vb.pt.y - e.va.pt.y;\n            const dz = e.vb.pt.z - e.va.pt.z;\n            total += Math.sqrt(dx * dx + dy * dy + dz * dz);\n        }\n        return total / this.edgeEls.length;\n 