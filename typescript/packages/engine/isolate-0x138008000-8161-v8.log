script-source,235,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/math.js,// @java Common/src/main/math/MathRoutines.java MathRoutines\n//\n// The exact geometric helpers the trajectory generator depends on. Ported\n// verbatim (same formulas\x2C same EPSILON) so adjacency/radial decisions match\n// Java bit-for-bit on the same float inputs. 2-D boards use z = 0.\n/** @java Common/src/main/math/MathRoutines.java EPSILON */\nexport const EPSILON = 0.0000001;\n/** @java MathRoutines.distance(double\x2Cdouble\x2Cdouble\x2Cdouble) */\nexport function distance2D(ax\x2C ay\x2C bx\x2C by) {\n    const dx = bx - ax;\n    const dy = by - ay;\n    return Math.sqrt(dx * dx + dy * dy);\n}\n/** @java MathRoutines.distance(Point3D\x2CPoint3D) */\nexport function distance3D(a\x2C b) {\n    const dx = b.x - a.x;\n    const dy = b.y - a.y;\n    const dz = b.z - a.z;\n    return Math.sqrt(dx * dx + dy * dy + dz * dz);\n}\n/** @java MathRoutines.angle(Point2D\x2CPoint2D) \u2014 radians in (-PI\x2C PI]. */\nexport function angle2D(ax\x2C ay\x2C bx\x2C by) {\n    return Math.atan2(by - ay\x2C bx - ax);\n}\n/**\n * @java MathRoutines.distanceToLine(Point2D\x2CPoint2D\x2CPoint2D)\n * Distance from pt to the infinite line through a and b.\n */\nexport function distanceToLine(px\x2C py\x2C ax\x2C ay\x2C bx\x2C by) {\n    const dx = bx - ax;\n    const dy = by - ay;\n    if (Math.abs(dx) + Math.abs(dy) < EPSILON) {\n        return distance2D(px\x2C py\x2C ax\x2C ay); // endpoints coincident\n    }\n    const a2 = (py - ay) * dx - (px - ax) * dy;\n    return Math.sqrt((a2 * a2) / (dx * dx + dy * dy));\n}\n/**\n * @java MathRoutines.absTanAngleDifference3D(Point3D\x2CPoint3D\x2CPoint3D)\n * |(c-b) \xd7 (b-a)| / ((c-b)\xb7(b-a)); +Infinity if the dot product is not positive\n * (i.e. the turn is >= 90\xb0). Used to follow the straightest radial continuation.\n */\nexport function absTanAngleDifference3D(a\x2C b\x2C c) {\n    const vx = b.x - a.x;\n    const vy = b.y - a.y;\n    const vz = b.z - a.z;\n    const ux = c.x - b.x;\n    const uy = c.y - b.y;\n    const uz = c.z - b.z;\n    const dot = ux * vx + uy * vy + uz * vz;\n    if (dot <= 0.0)\n        return Number.POSITIVE_INFINITY;\n    const crossX = vy * uz - vz * uy;\n    const crossY = vz * ux - vx * uz;\n    const crossZ = vx * uy - vy * ux;\n    const crossMag = Math.sqrt(crossX * crossX + crossY * crossY + crossZ * crossZ);\n    return Math.abs(crossMag / dot);\n}\n/** @java MathRoutines.whichSide(double\u2026) \u2014 which side of line AB point (x\x2Cy) lies on. */\nexport function whichSide(x\x2C y\x2C ax\x2C ay\x2C bx\x2C by) {\n    const result = (bx - ax) * (y - ay) - (by - ay) * (x - ax);\n    if (result < -EPSILON)\n        return -1;\n    if (result > EPSILON)\n        return 1;\n    return 0;\n}\n/** Dot product of two 3-D vectors (for circular In/Out classification). */\nexport function dot3D(ax\x2C ay\x2C az\x2C bx\x2C by\x2C bz) {\n    return ax * bx + ay * by + az * bz;\n}\n//# sourceMappingURL=math.js.map
