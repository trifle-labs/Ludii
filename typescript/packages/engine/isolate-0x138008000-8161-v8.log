stepsNode = expNamed.get("steps");\n            const stepsFn = stepsNode\n                ? compileInt(stepsNode\x2C env)\n                : { eval: () => 1 };\n            let originRegion;\n            try {\n                originRegion = compileRegion(originNode\x2C env);\n            }\n            catch {\n                const siteFn = compileInt(originNode\x2C env);\n                originRegion = {\n                    eval: (ctx) => {\n                        const s = siteFn.eval(ctx);\n                        return s >= 0 ? [s] : [];\n                    }\x2C\n                };\n            }\n            return {\n                eval: (ctx) => {\n                    const steps = Math.max(1\x2C stepsFn.eval(ctx));\n                    let cur = originRegion.eval(ctx);\n                    for (let k = 0; k < steps; k += 1)\n                        cur = expandRegion(cur\x2C ctx);\n                    return cur;\n                }\x2C\n            };\n        }\n        case "forEach": {\n            const { positional\x2C named } = parseArgs(rest);\n            // `(forEach of:<region> <region2>)` \u2014 for each site of `of`\x2C evaluate\n            // `region2` with `(site)` bound to it\x2C and union the results\n            // (Java: ForEachSiteInRegion).\n            const ofNode = named.get("of");\n            if (ofNode && isList(ofNode)) {\n                const ofRegion = compileRegion(ofNode\x2C env);\n                const bodyNode = positional[0];\n                if (!bodyNode)\n                    throw new LudemeCompileError("(forEach of:\u2026 \u2026) needs a region.");\n                const body = compileRegion(bodyNode\x2C env);\n                return {\n                    eval: (ctx) => {\n                        const out = [];\n                        const seen = new Set();\n                        for (const s of ofRegion.eval(ctx)) {\n                            if (s < 0)\n                                continue;\n                            for (const r of body.eval(ctx.withFrame({ site: s\x2C to: s }))) {\n                                if (r >= 0 && !seen.has(r)) {\n                                    seen.add(r);\n                                    out.push(r);\n                                }\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            // `(forEach <region> if:<bool>)` and the explicit `(forEach Site\n            // <region> if:<bool>)` both keep the region's sites for which the\n            // predicate holds\x2C with `(site)` bound to each candidate (ForEachSite).\n            const kindNode = positional[0];\n            const isSiteKw = kindNode && isIdent(kindNode) && kindNode.name === "Site";\n            const regionNode = isSiteKw ? positional[1] : kindNode;\n            if (regionNode && isList(regionNode)) {\n                const region = compileRegion(regionNode\x2C env);\n                const ifNode = named.get("if");\n                const cond = ifNode ? compileBool(ifNode\x2C env) : undefined;\n                return {\n                    eval: (ctx) => {\n                        const out = [];\n                        for (const s of region.eval(ctx)) {\n                            if (s < 0)\n                                continue;\n                            if (cond && !cond.eval(ctx.withFrame({ site: s\x2C to: s })))\n                                continue;\n                            out.push(s);\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            // `(forEach Level at:<site> [FromBottom|FromTop] [if:<bool>] [startAt:<int>])`\n            // in region position \u2014 the stack-level indices at the site that satisfy\n            // the optional condition\x2C with frame.level/frame.to bound to each level.\n            // Java: game.functions.region.foreach.level.ForEachLevel\n            if (kindNode && isIdent(kindNode) && kindNode.name === "Level") {\n                const lvlAtNode = named.get("at");\n                if (!lvlAtNode)\n                    return { eval: () => [] };\n                const lvlSiteFn = compileInt(lvlAtNode\x2C env);\n                const lvlDirNode = positional.find((p) => isIdent(p) && (p.name === "FromBottom" || p.name === "FromTop"));\n                const lvlFromBottom = !!lvlDirNode && isIdent(lvlDirNode) && lvlDirNode.name === "FromBottom";\n                const lvlIfNode = named.get("if") ?? named.get("If");\n                const lvlCond = lvlIfNode ? compileBool(lvlIfNode\x2C env) : undefined;\n                const lvlStartAtNode = named.get("startAt");\n                const lvlStartAtFn = lvlStartAtNode\n                    ? compileInt(lvlStartAtNode\x2C env)\n                    : undefined;\n                return {\n                    eval: (ctx) => {\n                        const site = lvlSiteFn.eval(ctx);\n                        if (site < 0)\n                            return [];\n                        const stackSize = ctx.state.stackSize(site);\n                        if (stackSize <= 0)\n                            return [];\n                        const out = [];\n                        const rawStart = lvlStartAtFn ? lvlStartAtFn.eval(ctx) : -1;\n                        if (lvlFromBottom) {\n                            const start = rawStart < 0 ? 0 : rawStart;\n                            for (let lvl = start; lvl < stackSize; lvl += 1) {\n                                const sub = ctx.withFrame({ level: lvl\x2C site\x2C to: lvl });\n                                if (!lvlCond || lvlCond.eval(sub))\n                                    out.push(lvl);\n                            }\n                        }\n                        else {\n                            const start = rawStart < 0 ? stackSize - 1 : Math.min(rawStart\x2C stackSize - 1);\n                            for (let lvl = start; lvl >= 0; lvl -= 1) {\n                                const sub = ctx.withFrame({ level: lvl\x2C site\x2C to: lvl });\n                                if (!lvlCond || lvlCond.eval(sub))\n                                    out.push(lvl);\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            throw new LudemeCompileError(`Unsupported (forEach ${kindNode && isIdent(kindNode) ? kindNode.name : "?"} \u2026) region.`);\n        }\n        case "values":\n            return compileValuesRegion(node);\n        case "centrePoint":\n        case "centre":\n        case "center":\n            // (centrePoint [SiteType]) as a region \u2192 the board's centre site(s).\n            return { eval: (ctx) => centreSites(ctx) };\n        case "results": {\n            // (results from:<siteOrRegion> to:<siteOrRegion> <intFn>) \u2014 iterate every\n            // (from\x2C to) pair\x2C evaluate the int body with frame.from/frame.to bound\x2C\n            // and collect the resulting integers as a region (used by `is In`).\n            // Java: game.functions.intArray.math.Results\n            const { positional: resPos\x2C named: resNamed } = parseArgs(rest);\n            const fromNode = resNamed.get("from") ?? resNamed.get("From");\n            const toNode = resNamed.get("to") ?? resNamed.get("To");\n            const bodyNode = resPos[resPos.length - 1];\n            if (!bodyNode)\n                return { eval: () => [] };\n            const fromRegion = fromNode\n                ? compileSiteOrRegion(fromNode\x2C env)\n                : undefined;\n            const toRegion = toNode ? compileSiteOrRegion(toNode\x2C env) : undefined;\n            const bodyFn = compileInt(bodyNode\x2C env);\n            return {\n                eval: (ctx) => {\n                    const froms = fromRegion\n                        ? fromRegion.eval(ctx)\n                        : [ctx.frame.from ?? -1];\n                    const out = [];\n                    for (const f of froms) {\n                        const ctxF = ctx.withFrame({ from: f });\n                        const tos = toRegion ? toRegion.eval(ctxF) : [ctxF.frame.to ?? -1];\n                        for (const t of tos) {\n                            out.push(bodyFn.eval(ctxF.withFrame({ to: t })));\n                        }\n                    }\n                    return out;\n                }\x2C\n            };\n        }\n        case "players":\n            // (players \u2026) as a region \u2192 the list of player indices 1..numPlayers.\n            // Java: game.functions.region.sites.player. Used by Setichch.\n            return {\n                eval: (ctx) => Array.from({ length: ctx.context.game.numPlayers }\x2C (_\x2C i) => i + 1)\x2C\n            };\n        default:\n            throw new LudemeCompileError(`Unsupported region ludeme: (${head} \u2026).`);\n    }\n}\n/**\n * `(values Remembered <name>?)` \u2014 the remembered-values list as a region.\n * Java: `game.functions.intArray.values.ValuesRemembered`. A `null` name\n * reads the unnamed list; a string name reads `mapRememberingValues`.\n */\nfunction compileValuesRegion(node) {\n    const kindNode = node.items[1];\n    if (!kindNode || !isIdent(kindNode) || kindNode.name !== "Remembered") {\n        // Only Remembered is modelled; other (values \u2026) forms read as empty.\n        return { eval: () => [] };\n    }\n    const nameNode = node.items[2];\n    const name = nameNode && isString(nameNode) ? nameNode.value : undefined;\n    return {\n        eval: (ctx) => name === undefined\n            ? [...ctx.state.rememberedFor("")]\n            : [...ctx.state.rememberedFor(name)]\x2C\n    };\n}\nfunction compileSites(node\x2C env) {\n    const arg = node.items[1];\n    // `(sites {C3 D1 \u2026})` / `(sites {0 1 2})` \u2014 an explicit list of sites.\n    if (arg && isList(arg) && arg.delimiter === "curly") {\n        return compileSiteList(arg.items);\n    }\n    // `(sites (values Remembered <name>?))` \u2014 a remembered-values region.\n    if (arg && isList(arg) && listHead(arg) === "values") {\n        return compileValuesRegion(arg);\n    }\n    // `(sites "Name")` \u2014 a named region declared by `(regions "Name" \u2026)`.\n    if (arg && isString(arg)) {\n        const name = arg.value;\n        return {\n            eval: (ctx) => env.namedRegions?.get(name)?.eval(ctx) ?? []\x2C\n        };\n    }\n    if (arg && isIdent(arg)) {\n        const name = arg.name;\n        const { positional\x2C named } = parseArgs(node.items.slice(2));\n        switch (name) {\n            case "Empty":\n                return { eval: (ctx) => indicesWhere(ctx\x2C (c) => c === 0) };\n            case "Occupied": {\n                // (sites Occupied by:<role> [container:<name>]) scopes to one owner;\n                // bare = all pieces. A `container:"Hand"` arg restricts the scan to\n                // that role's hand cells instead of the whole board \u2014 without it the\n                // hand query degenerates to every board piece\x2C which is both wrong and\n                // pathologically slow for drop games (shogi/chess pockets).\n                const byNode = named.get("by");\n                const pred = byNode && isIdent(byNode)\n                    ? ownerPredicate(byNode.name)\n                    : (c) => c !== 0;\n                const containerNode = named.get("container");\n                const containerName = containerNode && isString(containerNode)\n                    ? containerNode.value\n                    : containerNode && isIdent(containerNode)\n                        ? containerNode.name\n                        : undefined;\n                if (containerName === "Hand") {\n                    const roleName = byNode && isIdent(byNode) ? byNode.name : "Mover";\n                    return {\n                        eval: (ctx) => ctx.board\n                            .handSites(resolveRole(roleName\x2C ctx))\n                            .filter((s) => pred(ctx.state.cells[s] ?? 0\x2C ctx))\x2C\n                    };\n                }\n                // `container:(mover)` / `container:<int>` \u2014 a numeric container index.\n                // Container 0 is the board; 1..N are the per-player hands (the Ludii\n                // convention used by `("FromHand")` = `\u2026 container:(mover)`). A hand\n                // index restricts the scan to that player's hand cells.\n                if (containerName === undefined &&\n                    containerNode !== undefined &&\n                    (isList(containerNode) || isNumber(containerNode))) {\n                    const idxFn = compileInt(containerNode\x2C env);\n                    return {\n                        eval: (ctx) => {\n                            const idx = idxFn.eval(ctx);\n                            if (idx >= 1) {\n                                return ctx.board\n                                    .handSites(idx)\n                                    .filter((s) => pred(ctx.state.cells[s] ?? 0\x2C ctx));\n                            }\n                            return indicesWhere(ctx\x2C (c) => pred(c\x2C ctx));\n                        }\x2C\n                    };\n                }\n                return { eval: (ctx) => indicesWhere(ctx\x2C (c) => pred(c\x2C ctx)) };\n            }\n            case "Board":\n                return { eval: (ctx) => allSites(ctx) };\n            case "Top":\n                return { eval: (ctx) => rowSites(ctx\x2C ctx.board.height - 1) };\n            case "Bottom":\n                return { eval: (ctx) => rowSites(ctx\x2C 0) };\n            case "Left":\n                return { eval: (ctx) => colSites(ctx\x2C 0) };\n            case "Right":\n                return { eval: (ctx) => colSites(ctx\x2C ctx.board.width - 1) };\n            case "Row": {\n                const nNode = positional[0];\n                if (!nNode)\n                    throw new LudemeCompileError("(sites Row n) needs a row.");\n                const n = compileInt(nNode\x2C env);\n                return { eval: (ctx) => rowSites(ctx\x2C n.eval(ctx)) };\n            }\n            case "Column": {\n                const nNode = positional[0];\n                if (!nNode)\n                    throw new LudemeCompileError("(sites Column n) needs a column.");\n                const n = compileInt(nNode\x2C env);\n                return { eval: (ctx) => colSites(ctx\x2C n.eval(ctx)) };\n            }\n            case "Centre":\n            case "Center":\n                return { eval: (ctx) => centreSites(ctx) };\n            case "Corners":\n                return { eval: (ctx) => cornerSites(ctx) };\n            case "Outer":\n                return { eval: (ctx) => outerSites(ctx) };\n            case "Side": {\n                // (sites Side <compass>) \u2192 the board edge on that side. Cardinal\n                // names map to the obvious row/column; diagonal names (used by\n                // rhombus-coordinate connection games like Hex/Y) map to the four\n                // distinct edges so the (is Connected \u2026) goal regions stay disjoint.\n                const dirNode = positional[0];\n                const dir = dirNode && isIdent(dirNode) ? dirNode.name : "";\n                return { eval: (ctx) => sideSites(ctx\x2C dir) };\n            }\n            case "Direction": {\n                // (sites Direction from:<site> [<dirs>] [distance:<n>] [included:True])\n                // \u2192 every site on the rays leaving <from> along the given directions.\n                const fromNode = named.get("from");\n                const fromFn = fromNode ? siteIntOf(fromNode\x2C env) : undefined;\n                const dirSpec = positional.find((p) => isIdent(p) || isList(p));\n                const tokens = collectDirectionTokens(dirSpec);\n                const included = isTrueIdent(named.get("included")) ||\n                    isTrueIdent(named.get("includeSelf"));\n                const distNode = named.get("distance");\n                const distFn = distNode ? compileInt(distNode\x2C env) : undefined;\n                return {\n                    eval: (ctx) => {\n                        const from = fromFn ? fromFn.eval(ctx) : lastToSite(ctx);\n                        if (from < 0)\n                            return [];\n                        const max = distFn ? distFn.eval(ctx) : Infinity;\n                        return rayDirectionSites(ctx\x2C from\x2C tokens\x2C max\x2C included);\n                    }\x2C\n                };\n            }\n            case "LineOfSight": {\n                // (sites LineOfSight [Piece|Empty] at:<site> [<dirs>]) \u2192 along each ray\n                // from <at>\x2C the empty sites up to the first blocker (default/Empty)\x2C\n                // or the first occupied site seen (Piece variant).\n                const typeNode = positional.find((p) => isIdent(p));\n                const losType = typeNode && isIdent(typeNode) ? typeNode.name : "Empty";\n                const atNode = named.get("at");\n                const atFn = atNode ? siteIntOf(atNode\x2C env) : undefined;\n                const dirSpec = positional.find((p) => isList(p));\n                const tokens = collectDirectionTokens(dirSpec);\n                return {\n                    eval: (ctx) => {\n                        const at = atFn ? atFn.eval(ctx) : lastToSite(ctx);\n                        if (at < 0)\n                            return [];\n                        return lineOfSightSites(ctx\x2C at\x2C tokens\x2C losType === "Piece");\n                    }\x2C\n                };\n            }\n            case "Hand": {\n                // (sites Hand <role>?) \u2192 every cell index in that player's hand.\n                // A missing role defaults to the mover (Chessence: `(sites Hand)`).\n                const roleNode = positional[0];\n                const roleName = roleNode && isIdent(roleNode) ? roleNode.name : "Mover";\n                return {\n                    eval: (ctx) => ctx.board.handSites(resolveRole(roleName\x2C ctx))\x2C\n                };\n            }\n            case "Start": {\n                // `(sites Start (piece <ownerExpr>))` \u2192 the initial placement sites\n                // of the component whose owner `<ownerExpr>` names. The TS engine\n                // keys placements by owner\x2C so the inner `(piece \u2026)` collapses to an\n                // owner id (`(what at:(from))`\x2C `(id "X" Next)`\x2C etc.). Bare\n                // `(sites Start)` unions every owner's start sites.\n                const map = env.startSitesByOwner;\n                if (!map)\n                    return { eval: () => [] };\n                const spec = positional[0];\n                let ownerFn;\n                if (spec && isList(spec)) {\n                    if (listHead(spec) === "piece") {\n                        const inner = spec.items[1];\n                        if (inner)\n                            ownerFn = compileInt(inner\x2C env);\n                    }\n                    else {\n                        ownerFn = compileInt(spec\x2C env);\n                    }\n                }\n                if (!ownerFn) {\n                    return {\n                        eval: () => {\n                            const all = [];\n                            for (const s of map.values())\n                                all.push(...s);\n                            return all;\n                        }\x2C\n                    };\n                }\n                const of = ownerFn;\n                return { eval: (ctx) => map.get(of.eval(ctx)) ?? [] };\n            }\n            case "Track": {\n                // (sites Track) \u2192 every distinct site across all declared tracks;\n                // (sites Track <Role>) \u2192 the named player's track (else shared).\n                const roleNode = positional[0];\n                const roleName = roleNode && isIdent(roleNode) ? roleNode.name : undefined;\n                return {\n                    eval: (ctx) => {\n                        const tracks = ctx.board.tracks;\n                        if (tracks.length === 0)\n                            return [];\n                        const seen = new Set();\n                        const out = [];\n                        const want = roleName !== undefined ? resolveRole(roleName\x2C ctx) : undefined;\n                        for (const t of tracks) {\n                            if (want !== undefined && t.owner !== want && t.owner !== 0) {\n                                continue;\n                            }\n                            for (const s of t.sites) {\n                                if (!seen.has(s)) {\n                                    seen.add(s);\n                                    out.push(s);\n                                }\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            case "Around": {\n                const siteNode = positional[0];\n                if (!siteNode)\n                    throw new LudemeCompileError("(sites Around <site>) needs a site.");\n                // The anchor may be a single site or a whole region; union the\n                // neighbourhood over every member.\n                const region = compileSiteOrRegion(siteNode\x2C env);\n                const dirTokens = rawDirectionTokens(positional[1]).filter((t) => !t.startsWith("#"));\n                return {\n                    eval: (ctx) => {\n                        const seen = new Set();\n                        const out = [];\n                        for (const s of region.eval(ctx)) {\n                            for (const a of aroundSites(ctx\x2C s\x2C dirTokens)) {\n                                if (a >= 0 && !seen.has(a)) {\n                                    seen.add(a);\n                                    out.push(a);\n                                }\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            // Role tokens (Mover/Next/P1\u2026) name the player's declared region\n            // from `(regions <Role> \u2026)`; resolve through the env at eval time.\n            case "Mover":\n            case "Next":\n            case "Prev":\n                return playerRegionLookup((ctx) => resolveRole(name\x2C ctx)\x2C env);\n            case "Player": {\n                // (sites Player) \u2192 the iterated player's declared region;\n                // (sites Player "Name") \u2192 that player's named region.\n                const nameArg = positional[0];\n                if (nameArg && isString(nameArg)) {\n                    const regionName = nameArg.value;\n                    return {\n                        eval: (ctx) => env.namedRegions?.get(regionName)?.eval(ctx) ?? []\x2C\n                    };\n                }\n                return playerRegionLookup((ctx) => resolveRole("Player"\x2C ctx)\x2C env);\n            }\n            case "Pending":\n                // (sites Pending) \u2192 sites flagged by (set Pending <site>).\n                return { eval: (ctx) => [...ctx.state.pending] };\n            case "ToClear":\n                // (sites ToClear) \u2192 pieces queued for removal in a capture sequence.\n                // No backing state in the TS port yet; [] keeps capture games compiling.\n                return { eval: () => [] };\n            case "Phase": {\n                // (sites Phase <n>) \u2192 all sites of board colouring n. Derived as\n                // (x+y)%2 on rectangular boards; graph boards have no colouring \u2192 [].\n                const phNode = positional[0];\n                if (!phNode)\n                    return { eval: () => [] };\n                const phFn = compileInt(phNode\x2C env);\n                return {\n                    eval: (ctx) => {\n                        if (ctx.board.traj)\n                            return [];\n                        const ph = phFn.eval(ctx);\n                        const out = [];\n                        const n = ctx.board.numSites;\n                        for (let s = 0; s < n; s += 1) {\n                            if (ctx.board.isOnBoard(s) &&\n                                (ctx.board.xOf(s) + ctx.board.yOf(s)) % 2 === ph) {\n                                out.push(s);\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            case "Distance": {\n                // (sites Distance [relation] from:<site> (exact N) | (range a b)) \u2014\n                // BFS from <site> collecting sites whose step-distance is in [min\x2Cmax].\n                // A custom (step \u2026) traversal isn't modelled \u2192 [].\n                const fromNode = named.get("from");\n                if (!fromNode)\n                    return { eval: () => [] };\n                const fromFn = compileInt(fromNode\x2C env);\n                const first = positional[0];\n                if (first && isList(first) && listHead(first) !== "exact" &&\n                    listHead(first) !== "range" && listHead(first) !== "min") {\n                    return { eval: () => [] };\n                }\n                let rangeNode;\n                let useAllDirs = false;\n                if (first && isIdent(first)) {\n                    const rel = first.name;\n                    useAllDirs = rel === "Adjacent" || rel === "All" || rel === "Diagonal";\n                    rangeNode = positional[1];\n                }\n                else {\n                    rangeNode = first;\n                }\n                if (!rangeNode || !isList(rangeNode))\n                    return { eval: () => [] };\n                const rHead = listHead(rangeNode);\n                let minFn;\n                let maxFn;\n                if (rHead === "exact") {\n                    const n = rangeNode.items[1];\n                    if (!n)\n                        return { eval: () => [] };\n                    minFn = compileInt(n\x2C env);\n                    maxFn = minFn;\n                }\n                else if (rHead === "range") {\n                    const a = rangeNode.items[1];\n                    const b = rangeNode.items[2];\n                    if (!a)\n                        return { eval: () => [] };\n                    minFn = compileInt(a\x2C env);\n                    maxFn = b ? compileInt(b\x2C env) : minFn;\n                }\n                else if (rHead === "min") {\n                    const a = rangeNode.items[1];\n                    if (!a)\n                        return { eval: () => [] };\n                    minFn = compileInt(a\x2C env);\n                    maxFn = { eval: () => 9999 };\n                }\n                else {\n                    return { eval: () => [] };\n                }\n                const allDirs = useAllDirs;\n                return {\n                    eval: (ctx) => {\n                        const from = fromFn.eval(ctx);\n                        const minD = minFn.eval(ctx);\n                        const maxD = maxFn.eval(ctx);\n                        if (from < 0)\n                            return [];\n                        const seen = new Set([from]);\n                        let frontier = [from];\n                        const out = [];\n                        for (let d = 1; d <= maxD && frontier.length > 0; d += 1) {\n                            const next = [];\n                            for (const s of frontier) {\n                                const nbs = allDirs\n                                    ? aroundSites(ctx\x2C s\x2C ["Adjacent"])\n                                    : orthoNeighbours(ctx\x2C s);\n                                for (const nb of nbs) {\n                                    if (!seen.has(nb)) {\n                                        seen.add(nb);\n                                        next.push(nb);\n                                    }\n                                }\n                            }\n                            if (d >= minD)\n                                out.push(...next);\n                            frontier = next;\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            case "Playable":\n                // (sites Playable) \u2192 sites where a piece may be placed. The TS port has\n                // no precomputed playability layer\x2C so this is the empty on-board sites.\n                return { eval: (ctx) => indicesWhere(ctx\x2C (c) => c === 0) };\n            case "To":\n                // (sites To) \u2192 the destination site(s) of the current/last move.\n                return {\n                    eval: (ctx) => {\n                        const s = ctx.frame.to ?? lastToSite(ctx);\n                        return s >= 0 ? [s] : [];\n                    }\x2C\n                };\n            case "From":\n                // (sites From) \u2192 the origin site(s) of the current/last move.\n                return {\n                    eval: (ctx) => {\n                        const s = ctx.frame.from ?? OFF;\n                        return s >= 0 ? [s] : [];\n                    }\x2C\n                };\n            case "State": {\n                // (sites State [<SiteType>] <n>) \u2192 every on-board site whose per-site\n                // state layer equals n. A leading Cell/Vertex/Edge ident is ignored\n                // (the TS port has a single site space).\n                const valNode = positional.find((p) => !(isIdent(p) && SITE_TYPE_IDENTS.has(p.name)));\n                if (!valNode)\n                    return { eval: () => [] };\n                const valFn = compileInt(valNode\x2C env);\n                return {\n                    eval: (ctx) => {\n                        const want = valFn.eval(ctx);\n                        const out = [];\n                        const n = ctx.board.numSites;\n                        for (let s = 0; s < n; s += 1) {\n                            if (ctx.board.isOnBoard(s) && ctx.state.stateAtSite(s) === want) {\n                                out.push(s);\n                            }\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            case "Group": {\n                // (sites Group [<SiteType>] (at:|from:)<site> [<dirs>] [<role>]) \u2192 the\n                // connected same-owner component containing the seed site\x2C via\n                // orthogonal adjacency.\n                const seedNode = named.get("at") ?? named.get("from");\n                const seedFn = seedNode ? siteIntOf(seedNode\x2C env) : undefined;\n                return {\n                    eval: (ctx) => {\n                        const seed = seedFn ? seedFn.eval(ctx) : lastToSite(ctx);\n                        return groupAt(ctx\x2C seed);\n                    }\x2C\n                };\n            }\n            case "Incident": {\n                // (sites Incident <ofType> of:<atType> at:<site>) \u2192 the elements of one\n                // site space incident to a site of another. The TS port has a single\n                // site space\x2C so this collapses to the orthogonal neighbourhood of the\n                // anchor (best-effort; keeps graph-incidence games compiling).\n                const atNode = named.get("at");\n                const atFn = atNode ? siteIntOf(atNode\x2C env) : undefined;\n                return {\n                    eval: (ctx) => {\n                        const at = atFn ? atFn.eval(ctx) : lastToSite(ctx);\n                        if (at < 0)\n                            return [];\n                        return orthoNeighbours(ctx\x2C at).filter((s) => s >= 0);\n                    }\x2C\n                };\n            }\n            case "Between": {\n                // (sites Between <dirn> from:<a> to:<b> [fromIncluded:] [toIncluded:]) \u2192\n                // the sites on the straight line from a to b. Best-effort: walk unit\n                // steps when the endpoints are colinear (orthogonal or diagonal).\n                const fromNode = named.get("from");\n                const toNode = named.get("to");\n                const fromFn = fromNode ? siteIntOf(fromNode\x2C env) : undefined;\n                const toFn = toNode ? siteIntOf(toNode\x2C env) : undefined;\n                const incFrom = isTrueIdent(named.get("fromIncluded"));\n                const incTo = isTrueIdent(named.get("toIncluded"));\n                return {\n                    eval: (ctx) => {\n                        const a = fromFn ? fromFn.eval(ctx) : OFF;\n                        const b = toFn ? toFn.eval(ctx) : OFF;\n                        if (a < 0 || b < 0)\n                            return [];\n                        const ax = ctx.board.xOf(a);\n                        const ay = ctx.board.yOf(a);\n                        const bx = ctx.board.xOf(b);\n                        const by = ctx.board.yOf(b);\n                        const dx = Math.sign(bx - ax);\n                        const dy = Math.sign(by - ay);\n                        const adx = Math.abs(bx - ax);\n                        const ady = Math.abs(by - ay);\n                        // Only colinear (straight or 45\xb0) lines have a defined "between".\n                        if (adx !== 0 && ady !== 0 && adx !== ady)\n                            return [];\n                        const steps = Math.max(adx\x2C ady);\n                        const out = [];\n                        for (let i = 0; i <= steps; i += 1) {\n                            if (i === 0 && !incFrom)\n                                continue;\n                            if (i === steps && !incTo)\n                                continue;\n                            const s = ctx.board.siteAt(ax + dx * i\x2C ay + dy * i);\n                            if (s >= 0)\n                                out.push(s);\n                        }\n                        return out;\n                    }\x2C\n                };\n            }\n            case "Random": {\n                // (sites Random [<region>] [num:<n>]) \u2014 pick num random distinct sites\n                // from region (default: 1 from all empty sites). A deterministic\n                // first-N implementation is sufficient for compile coverage.\n                // Java: game.functions.region.sites.random.SitesRandom\n                const regionArg = positional[0];\n                const numNode = named.get("num");\n                const regionFn = regionArg\n                    ? compileSiteOrRegion(regionArg\x2C env)\n                    : { eval: (ctx) => indicesWhere(ctx\x2C (c) => c === 0) };\n                const numFn = numNode\n                    ? compileInt(numNode\x2C env)\n                    : { eval: () => 1 };\n                return {\n                    eval: (ctx) => {\n                        const sites = regionFn.eval(ctx);\n                        const n = Math.min(numFn.eval(ctx)\x2C sites.length);\n                        return sites.slice(0\x2C n);\n                    }\x2C\n                };\n            }\n            case "Cell":\n            case "Vertex":\n            case "Edge": {\n                // (sites Cell|Vertex|Edge <coord|index>?) \u2014 a single site addressed by\n                // a coordinate string ("A1") or index; bare form is every board site.\n                const spec = positional[0];\n                if (spec && isString(spec)) {\n                    const coord = parseCoord(spec.value);\n                    return {\n                        eval: (ctx) => {\n                            if (!coord)\n                                return [];\n                            const s = ctx.board.siteAt(coord.col\x2C coord.row);\n                            return s >= 0 ? [s] : [];\n                        }\x2C\n                    };\n                }\n                if (spec) {\n                    const intFn = compileInt(spec\x2C env);\n                    return {\n                        eval: (ctx) => {\n                            const s = intFn.eval(ctx);\n                            return s >= 0 ? [s] : [];\n                        }\x2C\n                    };\n                }\n                return { eval: (ctx) => allSites(ctx) };\n            }\n            case "Inner":\n                // (sites Inner) \u2014 every board site that is not on the perimeter.\n                return {\n                    eval: (ctx) => {\n                        const outer = new Set(outerSites(ctx));\n                        return allSites(ctx).filter((s) => !outer.has(s));\n                    }\x2C\n                };\n            case "Perimeter":\n                // (sites Perimeter) \u2014 the outer ring of board sites.\n                return { eval: (ctx) => outerSites(ctx) };\n            case "Layer": {\n                // (sites Layer <n>?) \u2014 flat boards expose only layer 0 (all sites);\n                // any higher layer is empty.\n                const layerNode = positional[0];\n                const layerFn = layerNode ? compileInt(layerNode\x2C env) : undefined;\n                return {\n                    eval: (ctx) => (layerFn ? layerFn.eval(ctx) : 0) === 0 ? allSites(ctx) : []\x2C\n                };\n            }\n            case "LineOfPlay":\n            case "Hidden":\n                // Hidden-information / line-of-play regions are not modelled; empty.\n                return { eval: () => [] };\n            default: {\n                // Unsubstituted define placeholders (`~`\x2C `#1`\x2C `#2`\x2C \u2026) reaching\n                // `(sites \u2026)` as the first argument represent an intentionally-empty\n                // region in a partially-expanded branch (MensaSpiel: `(sites ~ "Rings")`).\n                if (name === "~" || isPlaceholderIdent(name)) {\n                    return { eval: () => [] };\n                }\n                const pid = resolveStaticRole(name);\n                if (pid !== undefined) {\n                    return playerRegionLookup(() => pid\x2C env);\n                }\n                throw new LudemeCompileError(`Unsupported (sites ${name}).`);\n            }\n        }\n    }\n    // `(sites <intExpr>)` \u2014 e.g. `(sites (player (mapEntry (mover))))`. Java\n    // promotes an IntFunction here to the region declared for that player.\n    if (arg && isList(arg)) {\n        const pidFn = compileInt(arg\x2C env);\n        return playerRegionLookup((ctx) => pidFn.eval(ctx)\x2C env);\n    }\n    throw new LudemeCompileError("Unsupported (sites \u2026) form.");\n}\n/** True when a node is the bare `True` ident. */\nfunction isTrueIdent(node) {\n    return !!node && isIdent(node) && node.name === "True";\n}\n/**\n * Every site reached by walking outward from `from` along the given direction\n * tokens (full rays\x2C optionally capped at `maxDist` steps). The seed site is\n * included only when `includeSelf` is set (Java: Sites Direction).\n */\nfunction rayDirectionSites(ctx\x2C from\x2C tokens\x2C maxDist\x2C includeSelf) {\n    const board = ctx.board;\n    const dirs = resolveDirectionTokens(tokens.length > 0 ? tokens : ["Adjacent"]\x2C ctx);\n    const out = new Set();\n    if (includeSelf)\n        out.add(from);\n    for (const d of dirs) {\n        let x = board.xOf(from);\n        let y = board.yOf(from);\n        for (let step = 0; step < maxDist; step += 1) {\n            x += d.dx;\n            y += d.dy;\n            const s = board.siteAt(x\x2C y);\n            if (s < 0)\n                break;\n            out.add(s);\n        }\n    }\n    return [...out].sort((a\x2C b) => a - b);\n}\n/**\n * Line-of-sight from `at` along each direction: the run of empty sites up to\n * the first blocker\x2C plus that blocker when `wantPiece` is set (Piece variant\n * returns only the first piece seen\x2C the default returns the empty run).\n */\nfunction lineOfSightSites(ctx\x2C at\x2C tokens\x2C wantPiece) {\n    const board = ctx.board;\n    const dirs = resolveDirectionTokens(tokens.length > 0 ? tokens : ["Adjacent"]\x2C ctx);\n    const out = new Set();\n    for (const d of dirs) {\n        let x = board.xOf(at);\n        let y = board.yOf(at);\n        for (;;) {\n            x += d.dx;\n            y += d.dy;\n            const s = board.siteAt(x\x2C y);\n            if (s < 0)\n                break;\n            const occupied = (ctx.state.cells[s] ?? 0) !== 0;\n            if (occupied) {\n                if (wantPiece)\n                    out.add(s);\n                break;\n            }\n            if (!wantPiece)\n                out.add(s);\n        }\n    }\n    return [...out].sort((a\x2C b) => a - b);\n}\n/** Predicate matching a cell owner against a role name (Mover/Enemy/Pn\u2026). */\nfunction ownerPredicate(role) {\n    switch (role) {\n        case "Mover":\n        case "Friend":\n            return (c\x2C ctx) => c === ctx.mover;\n        case "Enemy":\n            return (c\x2C ctx) => c !== 0 && c !== ctx.mover;\n        case "Player":\n        case "Next":\n        case "Prev": {\n            return (c\x2C ctx) => c === resolveRole(role\x2C ctx);\n        }\n        default: {\n            const pid = resolveStaticRole(role);\n            if (pid !== undefined)\n                return (c) => c === pid;\n            return () => false;\n        }\n    }\n}\n/** The board's centre cell(s): exact centre on odd dims\x2C 2x2 on even. */\nfunction centreSites(ctx) {\n    const { width\x2C height } = ctx.board;\n    const xs = width % 2 === 1 ? [(width - 1) / 2] : [width / 2 - 1\x2C width / 2];\n    const ys = height % 2 === 1 ? [(height - 1) / 2] : [height / 2 - 1\x2C height / 2];\n    const out = [];\n    for (const y of ys)\n        for (const x of xs) {\n            const s = ctx.board.siteAt(x\x2C y);\n            if (s >= 0)\n                out.push(s);\n        }\n    return out;\n}\n/** The four corner cells of a rectangular board. */\nfunction cornerSites(ctx) {\n    const { width\x2C height } = ctx.board;\n    const out = new Set();\n    for (const [x\x2C y] of [\n        [0\x2C 0]\x2C\n        [width - 1\x2C 0]\x2C\n        [0\x2C height - 1]\x2C\n        [width - 1\x2C height - 1]\x2C\n    ]) {\n        const s = ctx.board.siteAt(x\x2C y);\n        if (s >= 0)\n            out.add(s);\n    }\n    return [...out];\n}\n/** The perimeter ring of a rectangular board. */\nfunction outerSites(ctx) {\n    const { width\x2C height } = ctx.board;\n    const out = new Set();\n    for (let x = 0; x < width; x += 1) {\n        out.add(ctx.board.siteAt(x\x2C 0));\n        out.add(ctx.board.siteAt(x\x2C height - 1));\n    }\n    for (let y = 0; y < height; y += 1) {\n        out.add(ctx.board.siteAt(0\x2C y));\n        out.add(ctx.board.siteAt(width - 1\x2C y));\n    }\n    return [...out].filter((s) => s >= 0).sort((a\x2C b) => a - b);\n}\n/**\n * The cells along one edge of a rectangular board\x2C named by compass side.\n * Cardinal names map to the obvious row/column. Diagonal names (used by\n * rhombus-coordinate connection games such as Hex/Y/Havannah) map to the four\n * distinct edges\x2C keeping the goal regions of an `(is Connected \u2026)` disjoint.\n */\nfunction sideSites(ctx\x2C dir) {\n    const { width: w\x2C height: h } = ctx.board;\n    switch (dir) {\n        case "N":\n        case "NE":\n            return rowSites(ctx\x2C h - 1);\n        case "S":\n        case "SW":\n            return rowSites(ctx\x2C 0);\n        case "E":\n        case "SE":\n            return colSites(ctx\x2C w - 1);\n        case "W":\n        case "NW":\n            return colSites(ctx\x2C 0);\n        default:\n            return outerSites(ctx);\n    }\n}\n/** Neighbouring cells of a site along the given direction group(s). */\n/** The `to` site of the trial's most recent move (Java default for `at:`). */\nfunction lastToSite(ctx) {\n    const moves = ctx.context.trial.moves;\n    const last = moves[moves.length - 1];\n    return last ? last.to() : OFF;\n}\n/** Orthogonally (edge-) adjacent on-board sites of `site`. */\nfunction orthoNeighbours(ctx\x2C site) {\n    const board = ctx.board;\n    if (board.traj)\n        return board.traj.neighbours(site);\n    const x = board.xOf(site);\n    const y = board.yOf(site);\n    const out = [];\n    for (const d of board.tiling.groups.Orthogonal ??\n        board.tiling.groups.All ??\n        []) {\n        const n = board.siteAt(x + d.dx\x2C y + d.dy);\n        if (n >= 0)\n            out.push(n);\n    }\n    return out;\n}\n/**\n * Size of the connected component of same-owner pieces that contains `site`\n * (Java: SizeGroup with orthogonal connectivity). 0 for an empty/off site.\n */\n/** SiteType prefix idents that select a graph layer; the TS port has a single\n * site space\x2C so these are skipped where they appear positionally. */\nconst SITE_TYPE_IDENTS = new Set(["Cell"\x2C "Vertex"\x2C "Edge"]);\n/** The same-owner connected component containing `start` (orthogonal\n * adjacency)\x2C as a site-index array. Empty when the seed is empty/off-board. */\nfunction groupAt(ctx\x2C start) {\n    if (start < 0 || start >= ctx.state.cells.length)\n        return [];\n    const owner = ctx.state.cells[start] ?? 0;\n    if (owner === 0)\n        return [];\n    const seen = new Set([start]);\n    const stack = [start];\n    while (stack.length > 0) {\n        const s = stack.pop();\n        for (const nb of orthoNeighbours(ctx\x2C s)) {\n            if (!seen.has(nb) && (ctx.state.cells[nb] ?? 0) === owner) {\n                seen.add(nb);\n                stack.push(nb);\n            }\n        }\n    }\n    return [...seen];\n}\nfunction groupSizeAt(ctx\x2C start) {\n    if (start < 0 || start >= ctx.state.cells.length)\n        return 0;\n    const owner = ctx.state.cells[start] ?? 0;\n    if (owner === 0)\n        return 0;\n    const seen = new Set([start]);\n    const stack = [start];\n    while (stack.length > 0) {\n        const s = stack.pop();\n        for (const n of orthoNeighbours(ctx\x2C s)) {\n            if (!seen.has(n) && (ctx.state.cells[n] ?? 0) === owner) {\n                seen.add(n);\n                stack.push(n);\n            }\n        }\n    }\n    return seen.size;\n}\n/**\n * Connected components over the on-board sites for which `member(site)` is\n * true\x2C using orthogonal adjacency (Java: CountGroups / SizeBiggestGroup with\n * the default Adjacent direction). Returns one Set of site indices per group.\n */\nfunction groupComponents(ctx\x2C member) {\n    const n = ctx.state.cells.length;\n    const seen = new Set();\n    const groups = [];\n    for (let start = 0; start < n; start += 1) {\n        if (seen.has(start) || !member(start))\n            continue;\n        const comp = new Set([start]);\n        seen.add(start);\n        const stack = [start];\n        while (stack.length > 0) {\n            const s = stack.pop();\n            for (const nb of orthoNeighbours(ctx\x2C s)) {\n                if (!seen.has(nb) && member(nb)) {\n                    seen.add(nb);\n                    comp.add(nb);\n                    stack.push(nb);\n                }\n            }\n        }\n        groups.push(comp);\n    }\n    return groups;\n}\n/** Empty on-board sites orthogonally adjacent to the same-owner group at\n * `start` (Java: CountLiberties). 0 for an empty/off seed site. */\nfunction libertiesAt(ctx\x2C start) {\n    if (start < 0 || start >= ctx.state.cells.length)\n        return 0;\n    const owner = ctx.state.cells[start] ?? 0;\n    if (owner === 0)\n        return 0;\n    const group = new Set([start]);\n    const stack = [start];\n    while (stack.length > 0) {\n        const s = stack.pop();\n        for (const nb of orthoNeighbours(ctx\x2C s)) {\n            if (!group.has(nb) && (ctx.state.cells[nb] ?? 0) === owner) {\n                group.add(nb);\n                stack.push(nb);\n            }\n        }\n    }\n    const liberties = new Set();\n    for (const s of group) {\n        for (const nb of orthoNeighbours(ctx\x2C s)) {\n            if ((ctx.state.cells[nb] ?? 0) === 0)\n                liberties.add(nb);\n        }\n    }\n    return liberties.size;\n}\n/** Shortest orthogonal step distance from `from` to `to` (BFS)\x2C or OFF if\n * unreachable (Java: CountSteps over the adjacency graph). */\nfunction stepDistance(ctx\x2C from\x2C to) {\n    if (from === to)\n        return 0;\n    if (from < 0 || to < 0)\n        return OFF;\n    const seen = new Set([from]);\n    let frontier = [from];\n    let dist = 0;\n    while (frontier.length > 0) {\n        dist += 1;\n        const next = [];\n        for (const s of frontier) {\n            for (const nb of orthoNeighbours(ctx\x2C s)) {\n                if (nb === to)\n                    return dist;\n                if (!seen.has(nb)) {\n                    seen.add(nb);\n                    next.push(nb);\n                }\n            }\n        }\n        frontier = next;\n    }\n    return OFF;\n}\n/** Moves played so far in the current turn \u2014 the run of trailing moves whose\n * mover matches the last move's (Java: state.numTurnSamePlayer()). */\nfunction movesThisTurn(ctx) {\n    const moves = ctx.context.trial.moves;\n    const last = moves[moves.length - 1];\n    if (!last)\n        return 0;\n    let n = 0;\n    for (let i = moves.length - 1; i >= 0; i -= 1) {\n        if (moves[i]?.mover === last.mover)\n            n += 1;\n        else\n            break;\n    }\n    return n;\n}\nfunction aroundSites(ctx\x2C site\x2C dirTokens) {\n    if (site < 0)\n        return [];\n    const board = ctx.board;\n    const x = board.xOf(site);\n    const y = board.yOf(site);\n    const dirs = resolveDirectionTokens(dirTokens.length > 0 ? dirTokens : ["Adjacent"]\x2C ctx);\n    const out = new Set();\n    for (const d of dirs) {\n        const n = board.siteAt(x + d.dx\x2C y + d.dy);\n        if (n >= 0)\n            out.add(n);\n    }\n    return [...out].sort((a\x2C b) => a - b);\n}\n/**\n * Build a static region from an explicit list of site nodes: coordinate\n * strings like `"A1"` (column letters + 1-based row\x2C origin bottom-left) or\n * raw integer indices. Resolved against the board width at eval time.\n */\nfunction compileSiteList(items) {\n    const coords = [];\n    for (const item of items) {\n        if (isNumber(item)) {\n            coords.push(item.value);\n        }\n        else if (isString(item)) {\n            const c = parseCoord(item.value);\n            if (c)\n                coords.push(c);\n        }\n    }\n    return {\n        eval: (ctx) => {\n            const out = [];\n            for (const c of coords) {\n                const site = typeof c === "number" ? c : ctx.board.siteAt(c.col\x2C c.row);\n                if (site >= 0)\n                    out.push(site);\n            }\n            return out;\n        }\x2C\n    };\n}\n/** Parse a chess-style coordinate ("A1"\x2C "J4") to 0-based column/row. */\nfunction parseCoord(s) {\n    const m = /^([A-Za-z]+)(\\d+)$/.exec(s.trim());\n    if (!m?.[1] || !m[2])\n        return undefined;\n    let col = 0;\n    for (const ch of m[1].toUpperCase()) {\n        col = col * 26 + (ch.charCodeAt(0) - 64);\n    }\n    return { col: col - 1\x2C row: Number(m[2]) - 1 };\n}\n/** A `(sites <Role>)` lookup: the player's declared region\x2C else empty. */\nfunction playerRegionLookup(pidOf\x2C env) {\n    return {\n        eval: (ctx) => {\n            const region = env.playerRegions?.get(pidOf(ctx));\n            return region ? [...region.eval(ctx)] : [];\n        }\x2C\n    };\n}\nfunction resolveStaticRole(name) {\n    const m = /^P(\\d+)$/.exec(name);\n    if (m?.[1])\n        return Number(m[1]);\n    return undefined;\n}\nfunction allSites(ctx) {\n    // Board sites only \u2014 hand sites live beyond board.numSites in cells and\n    // are addressed by `(sites Hand \u2026)`\x2C not the on-board regions. Hex masks\n    // filter out bounding-box holes.\n    const board = ctx.board;\n    const n = board.numSites;\n    const out = [];\n    for (let i = 0; i < n; i += 1) {\n        if (board.isOnBoard(i))\n            out.push(i);\n    }\n    return out;\n}\nfunction indicesWhere(ctx\x2C pred) {\n    const out = [];\n    const cells = ctx.state.cells;\n    const board = ctx.board;\n    const n = board.numSites;\n    for (let i = 0; i < n; i += 1) {\n        if (!board.isOnBoard(i))\n            continue;\n        if (pred(cells[i] ?? 0))\n            out.push(i);\n    }\n    return out;\n}\nfunction rowSites(ctx\x2C y) {\n    const out = [];\n    for (let x = 0; x < ctx.board.width; x += 1) {\n        const s = ctx.board.siteAt(x\x2C y);\n        if (s !== OFF)\n            out.push(s);\n    }\n    return out;\n}\nfunction colSites(ctx\x2C x) {\n    const out = [];\n    for (let y = 0; y < ctx.board.height; y += 1) {\n        const s = ctx.board.siteAt(x\x2C y);\n        if (s !== OFF)\n            out.push(s);\n    }\n    return out;\n}\nfunction combineRegions(op\x2C parts\x2C ctx) {\n    if (parts.length === 0)\n        return [];\n    const sets = parts.map((p) => new Set(p.eval(ctx)));\n    const first = sets[0] ?? new Set();\n    if (op === "union") {\n        const out = new Set();\n        for (const s of sets)\n            for (const v of s)\n                out.add(v);\n        return [...out];\n    }\n    if (op === "intersection") {\n        return [...first].filter((v) => sets.every((s) => s.has(v)));\n    }\n    // difference\n    return [...first].filter((v) => sets.slice(1).every((s) => !s.has(v)));\n}\nfunction expandRegion(sites\x2C ctx) {\n    const board = ctx.board;\n    const out = new Set(sites);\n    for (const s of sites) {\n        const x = board.xOf(s);\n        const y = board.yOf(s);\n        for (const d of board.tiling.groups.Orthogonal ?? board.tiling.groups.All ?? []) {\n            const n = board.siteAt(x + d.dx\x2C y + d.dy);\n            if (n >= 0)\n                out.add(n);\n        }\n    }\n    return [...out];\n}\n// ---- direction functions ---------------------------------------------------\nexport function compileDirections(node) {\n    const tokens = collectDirectionTokens(node);\n    return { eval: (ctx) => resolveDirectionTokens(tokens\x2C ctx) };\n}\n// ---- move generators -------------------------------------------------------\nexport function compileMoves(node\x2C env) {\n    node = unwrapParens(node);\n    // `~` is Ludii's "absent optional" token; in a moves slot it means no\n    // generator. Unsubstituted define placeholders (`#1`\x2C `[#]`) likewise\n    // contribute nothing \u2014 degrade to an empty generator so the rest of the\n    // game still compiles rather than aborting the whole tree.\n    if (isIdent(node) && (node.name === "~" || isPlaceholderIdent(node.name))) {\n        return EMPTY_MOVES;\n    }\n    if (!isList(node)) {\n        throw new LudemeCompileError(`Cannot compile moves from ${node.kind}.`);\n    }\n    // A bare `{ <moves>\u2026 }` curly group is an implicit set of generators\n    // (Ludii treats it as an `(or \u2026)`). This arises when a define expands to\n    // a brace block that lands as a child of `(or \u2026)` / `(play \u2026)`.\n    if (node.delimiter === "curly") {\n        return compileMovesList(node.items\x2C env\x2C concatMoves);\n    }\n    const head = listHead(node);\n    // An unresolved define invocation leaves a round-paren list whose first item\n    // is a string (the define name) \u2014 `listHead` is undefined because the head is\n    // a string\x2C not an ident. This happens when a define body evaporated (empty\n    // `<>` option substitution) or lived inside an option-variant block that the\n    // top-level define collector didn't reach. Treat as a piece with no moves.\n    const firstItem = node.items[0];\n    if (head === undefined &&\n        node.delimiter === "round" &&\n        firstItem !== undefined &&\n        isString(firstItem)) {\n        return EMPTY_MOVES;\n    }\n    const rest = node.items.slice(1);\n    switch (head) {\n        case "move":\n            return compileMoveLudeme(node\x2C env);\n        case "forEach":\n            return compileForEach(node\x2C env);\n        case "do":\n            return compileDo(node\x2C env);\n        case "or":\n            return compileMovesList(rest\x2C env\x2C concatMoves);\n        case "and":\n            // `(and {<moves>\u2026})` bundles generators that all contribute moves this\n            // turn. Modelled as a flat concatenation of the alternatives.\n            return compileMovesList(rest\x2C env\x2C concatMoves);\n        case "priority":\n            // (priority {<moves>\u2026}) \u2014 try each alternative in order; the first one\n            // that produces any move wins (later generators are only reached when\n            // earlier ones are empty).\n            return compileMovesList(rest\x2C env\x2C firstNonEmptyMoves);\n        case "roll":\n            return compileRoll(env);\n        case "max":\n        case "min": {\n            // (max/min Moves|Captures|Distance [opts] <generator>) \u2014 a move-quantity\n            // optimiser. Lenient: return the inner generator's moves unchanged;