script-source,203,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/heuristic-sampling.js,/**\n * Java parity: AI/src/search/flat/HeuristicSampling.java \u2014\n * a flat heuristic-sampled search. Each turn pick a fraction of the\n * legal moves at random\x2C apply each\x2C and choose the one whose resulting\n * state has the highest heuristic score for the mover. Optionally\n * descend one more level when applying a move leaves the same mover\n * on play (move-again / multi-step turns) \u2014 capped at depth 10.\n *\n * Compared to flat Monte-Carlo this is cheaper per move (no playout)\n * but relies on the heuristic being directionally correct.\n */\nimport { SeededRng } from "../rng.js";\nimport { AI } from "./ai.js";\nimport { MaterialEvaluator } from "./alpha-beta-ai.js";\n/** Decisive bonus / penalty for terminal states discovered mid-search. */\nconst WIN_SCORE = 10_000;\nconst PARANOID_OPP_WIN_SCORE = 10_000;\n/** Hard cap on the continuation recursion (Java parity). */\nconst MAX_CONTINUATION_DEPTH = 10;\nexport class HeuristicSampling extends AI {\n    fraction;\n    continuation;\n    evaluator;\n    rng;\n    constructor(options = {}) {\n        super();\n        this.fraction = Math.max(1\x2C options.fraction ?? 2);\n        this.continuation = options.continuation ?? true;\n        this.evaluator = options.evaluator ?? new MaterialEvaluator();\n        this.rng = new SeededRng(options.seed ?? 0xa5a5a5);\n        this.friendlyName = `HS (1/${this.fraction})${this.continuation ? "*" : ""}`;\n    }\n    withSeed(seed) {\n        this.rng = new SeededRng(seed);\n        return this;\n    }\n    selectAction(context\x2C _options = {}) {\n        const moves = context.game.moves(context);\n        if (moves.length === 0)\n            return undefined;\n        if (moves.length === 1)\n            return moves[0];\n        return this.evaluateMoves(context\x2C 1).move;\n    }\n    evaluateMoves(context\x2C depth) {\n        const moves = this.selectMoves(context\x2C depth);\n        const mover = context.mover;\n        let bestScore = Number.NEGATIVE_INFINITY;\n        let bestMove = moves[0];\n        for (const move of moves) {\n            const child = context.game.apply(context\x2C move);\n            // Immediate terminal: a win is the dominant choice\x2C a loss is skipped.\n            if (child.over) {\n                const winner = child.winner;\n                if (winner === mover) {\n                    return { move\x2C score: WIN_SCORE };\n                }\n                if (winner !== 0 && winner !== mover) {\n                    continue; // losing branch \u2014 skip\n                }\n                // Draw \u2014 score 0; fall through to comparison.\n                const drawScore = 0;\n                if (drawScore > bestScore) {\n                    bestScore = drawScore;\n                    bestMove = move;\n                }\n                continue;\n            }\n            let score;\n            if (this.continuation &&\n                child.mover === mover &&\n                depth <= MAX_CONTINUATION_DEPTH) {\n                score = this.evaluateMoves(child\x2C depth + 1).score;\n            }\n            else {\n                // Heuristic from mover's POV; subtract opponents' heuristics.\n                score = this.evaluator.evaluate(child\x2C mover);\n                const numPlayers = child.game.numPlayers;\n                for (let p = 1; p <= numPlayers; p += 1) {\n                    if (p === mover)\n                        continue;\n                    if (child.over && child.winner === p) {\n                        score -= PARANOID_OPP_WIN_SCORE;\n                    }\n                    else {\n                        score -= this.evaluator.evaluate(child\x2C p);\n                    }\n                }\n                // Tiny random tie-breaker\x2C same as the Java implementation.\n                score += this.rng.nextInt(1000) / 1_000_000;\n            }\n            if (score > bestScore) {\n                bestScore = score;\n                bestMove = move;\n            }\n        }\n        return { move: bestMove\x2C score: bestScore };\n    }\n    selectMoves(context\x2C depth) {\n        const all = [...context.game.moves(context)];\n        const minMoves = depth < 3 ? 2 : 1;\n        const scalar = depth < 3 ? 1 / this.fraction : 1 / (this.fraction * 2 ** (depth - 2));\n        const target = Math.max(minMoves\x2C Math.floor((all.length + 1) * scalar));\n        if (target >= all.length)\n            return all;\n        const picked = [];\n        while (picked.length < target && all.length > 0) {\n            const r = this.rng.nextInt(all.length);\n            picked.push(all[r]);\n            // O(1) swap-remove.\n            const last = all.pop();\n            if (r < all.length && last !== undefined)\n                all[r] = last;\n        }\n        return picked;\n    }\n}\n//# sourceMappingURL=heuristic-sampling.js.map
