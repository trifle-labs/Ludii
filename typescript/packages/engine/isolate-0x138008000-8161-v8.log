script-source,123,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/context.js,// @java Core/src/other/context/Context.java Context\n/**\n * Java parity:\n * - Core/src/other/context/Context.java\n *\n * Holds a `Game` + `Trial` + `State`. Immutable in the TS port: every\n * `apply()` produces a new Context. The Java surface is broad\n * (RNG\x2C completed trials\x2C owned components\x2C ranking); the methods\n * pinned here are the ones the engine + browser-player actually call.\n */\nimport { SeededRng } from "./rng.js";\nexport class Context {\n    game;\n    state;\n    trial;\n    rng;\n    constructor(game\x2C state\x2C trial\x2C rng) {\n        this.game = game;\n        this.state = state;\n        this.trial = trial;\n        this.rng = rng ?? new SeededRng(0x9e3779b1);\n    }\n    withState(state) {\n        return new Context(this.game\x2C state\x2C this.trial\x2C this.rng);\n    }\n    withTrial(trial) {\n        return new Context(this.game\x2C this.state\x2C trial\x2C this.rng);\n    }\n    withRng(rng) {\n        return new Context(this.game\x2C this.state\x2C this.trial\x2C rng);\n    }\n    /** Java parity: `Context.rng()`. */\n    getRng() {\n        return this.rng;\n    }\n    /** Java parity: `Context.trial().ranking()`. */\n    ranking() {\n        return this.trial.ranking;\n    }\n    get mover() {\n        return this.state.mover;\n    }\n    get over() {\n        return this.trial.over;\n    }\n    get winner() {\n        return this.trial.winner;\n    }\n    /** Java parity: `Context.game()`. Kept as a method for shape parity. */\n    getGame() {\n        return this.game;\n    }\n    /** Java parity: `Context.state()`. */\n    getState() {\n        return this.state;\n    }\n    /** Java parity: `Context.trial()`. */\n    getTrial() {\n        return this.trial;\n    }\n    /** Java parity: `Context.numPlayers()`. */\n    numPlayers() {\n        return this.game.numPlayers;\n    }\n    /** Java parity: `Context.score(pid)`. */\n    score(pid) {\n        return this.state.score(pid);\n    }\n}\n//# sourceMappingURL=context.js.map
