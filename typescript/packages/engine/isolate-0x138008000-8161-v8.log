script-source,205,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/mast-playout.js,/**\n * Java parity: AI/src/search/mcts/playout/MAST.java.\n *\n * Picks playout moves via softmax-temperature over the running per-move\n * mean reward recorded in a shared `MoveStats`. The first time a move is\n * seen it has mean 0 (so a uniform prior softmax). With \u03b5 > 0 we mix in\n * uniform random for forced exploration.\n */\nexport class MASTPlayout {\n    stats;\n    temperature;\n    epsilon;\n    constructor(options) {\n        this.stats = options.stats;\n        this.temperature = Math.max(1e-6\x2C options.temperature ?? 1);\n        this.epsilon = Math.max(0\x2C Math.min(1\x2C options.epsilon ?? 0.1));\n    }\n    selectMove(context\x2C rng) {\n        const moves = context.game.moves(context);\n        if (moves.length === 0)\n            return undefined;\n        if (moves.length === 1)\n            return moves[0];\n        if (rng.nextFloat() < this.epsilon) {\n            return moves[rng.nextInt(moves.length)];\n        }\n        // Softmax over per-move means.\n        let maxVal = Number.NEGATIVE_INFINITY;\n        const vals = new Array(moves.length);\n        for (let i = 0; i < moves.length; i += 1) {\n            const m = moves[i];\n            const v = this.stats.mean(m) / this.temperature;\n            vals[i] = v;\n            if (v > maxVal)\n                maxVal = v;\n        }\n        let total = 0;\n        for (let i = 0; i < vals.length; i += 1) {\n            const e = Math.exp(vals[i] - maxVal);\n            vals[i] = e;\n            total += e;\n        }\n        if (total <= 0 || !Number.isFinite(total)) {\n            return moves[rng.nextInt(moves.length)];\n        }\n        let r = rng.nextFloat() * total;\n        for (let i = 0; i < vals.length; i += 1) {\n            r -= vals[i];\n            if (r <= 0)\n                return moves[i];\n        }\n        return moves[moves.length - 1];\n    }\n}\n//# sourceMappingURL=mast-playout.js.map
