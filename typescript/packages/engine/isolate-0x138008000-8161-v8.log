script-source,201,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/feature-discovery.js,/**\n * Java parity: AI/src/features/generation/AtomicFeatureGenerator.java\n * and AI/src/features/spatial/RelativeFeatureSet.java.\n *\n * Generates candidate "spatial offset" features and ranks them by\n * absolute Pearson correlation with a labelled training signal. Each\n * candidate is parameterised by a (dx\x2C dy) offset relative to the move\n * target and one of three relationships to the mover: "friend" (cell\n * owned by mover)\x2C "enemy" (cell owned by some other player)\x2C or\n * "empty". This is a sliver of the full Java spatial feature generator\n * but produces useful features for square-board games.\n */\nimport { FeatureSet } from "./feature.js";\nexport class SpatialOffsetFeature {\n    name;\n    dx;\n    dy;\n    relation;\n    constructor(dx\x2C dy\x2C relation) {\n        this.dx = dx;\n        this.dy = dy;\n        this.relation = relation;\n        this.name = `offset(${dx}\x2C${dy})=${relation}`;\n    }\n    activation(context\x2C move) {\n        const site = move.siteIndices[0];\n        if (site === undefined)\n            return 0;\n        const game = context.game;\n        const w = game.width ?? 0;\n        const h = game.height ?? 0;\n        if (w <= 0 || h <= 0)\n            return 0;\n        const x = site % w;\n        const y = Math.floor(site / w);\n        const nx = x + this.dx;\n        const ny = y + this.dy;\n        if (nx < 0 || nx >= w || ny < 0 || ny >= h)\n            return 0;\n        const owner = context.state.cellAt(ny * w + nx).owner;\n        if (this.relation === "friend")\n            return owner === move.mover ? 1 : 0;\n        if (this.relation === "enemy")\n            return owner !== 0 && owner !== move.mover ? 1 : 0;\n        return owner === 0 ? 1 : 0;\n    }\n}\nfunction pearson(xs\x2C ys) {\n    if (xs.length !== ys.length || xs.length === 0)\n        return 0;\n    const n = xs.length;\n    let sx = 0;\n    let sy = 0;\n    for (let i = 0; i < n; i += 1) {\n        sx += xs[i] ?? 0;\n        sy += ys[i] ?? 0;\n    }\n    const mx = sx / n;\n    const my = sy / n;\n    let cov = 0;\n    let vx = 0;\n    let vy = 0;\n    for (let i = 0; i < n; i += 1) {\n        const dx = (xs[i] ?? 0) - mx;\n        const dy = (ys[i] ?? 0) - my;\n        cov += dx * dy;\n        vx += dx * dx;\n        vy += dy * dy;\n    }\n    if (vx === 0 || vy === 0)\n        return 0;\n    return cov / Math.sqrt(vx * vy);\n}\n/**\n * Score every candidate spatial offset feature against the labelled\n * samples and return the top-K by absolute Pearson correlation. The\n * resulting FeatureSet can be plugged into a DecisionTreeTrainer or\n * passed to MASTPlayout via softmax weights.\n */\nexport function discoverFeatures(samples\x2C options = {}) {\n    const maxRadius = options.maxRadius ?? 2;\n    const topK = options.topK ?? 8;\n    const offsets = options.offsets ??\n        (() => {\n            const out = [];\n            for (let dy = -maxRadius; dy <= maxRadius; dy += 1) {\n                for (let dx = -maxRadius; dx <= maxRadius; dx += 1) {\n                    if (dx === 0 && dy === 0)\n                        continue;\n                    out.push([dx\x2C dy]);\n                }\n            }\n            return out;\n        })();\n    const labels = samples.map((s) => s.label);\n    const candidates = [];\n    for (const [dx\x2C dy] of offsets) {\n        for (const relation of ["friend"\x2C "enemy"\x2C "empty"]) {\n            const feature = new SpatialOffsetFeature(dx\x2C dy\x2C relation);\n            const activations = samples.map((s) => feature.activation(s.context\x2C s.move));\n            candidates.push({ dx\x2C dy\x2C relation\x2C activations });\n        }\n    }\n    const scored = candidates\n        .map((c) => ({\n        ...c\x2C\n        score: Math.abs(pearson(c.activations\x2C labels))\x2C\n    }))\n        .filter((c) => Number.isFinite(c.score) && c.score > 0)\n        .sort((a\x2C b) => b.score - a.score)\n        .slice(0\x2C topK);\n    return new FeatureSet(scored.map((c) => new SpatialOffsetFeature(c.dx\x2C c.dy\x2C c.relation)));\n}\n//# sourceMappingURL=feature-discovery.js.map
