script-source,144,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-add-player-to-team.js,// @java Core/src/other/action/state/ActionAddPlayerToTeam.java ActionAddPlayerToTeam\n/** Java parity: Core/src/other/action/state/ActionAddPlayerToTeam.java. */\nimport { BaseAction } from "./action.js";\nexport class ActionAddPlayerToTeam extends BaseAction {\n    static TYPE = "AddPlayerToTeam";\n    player;\n    team;\n    constructor(player\x2C team) {\n        super();\n        this.player = player;\n        this.team = team;\n    }\n    apply(state) {\n        // Team assignment is folded into the per-player value array for now.\n        return state.withValuePlayer(this.player\x2C this.team);\n    }\n    actionType() {\n        return ActionAddPlayerToTeam.TYPE;\n    }\n    who() {\n        return this.player;\n    }\n    value() {\n        return this.team;\n    }\n}\n//# sourceMappingURL=action-add-player-to-team.js.map
