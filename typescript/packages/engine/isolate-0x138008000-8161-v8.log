script-source,230,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/operators.js,/**\n * Board-algebra operators \u2014 Java parity with\n * Core/src/game/functions/graph/operators/**. Each takes one or more planar\n * {@link Graph}s and returns a new one. Vertex coincidence is handled by\n * `Graph.addVertex`'s tolerance dedup\x2C so `merge`/`union` reduce to re-adding\n * every vertex and edge into a fresh graph.\n */\nimport { Graph\x2C VERTEX_TOL } from "./graph.js";\n/** Re-add a graph's vertices and edges into `out`\x2C returning the id remap. */\nfunction absorb(out\x2C g\x2C tol = VERTEX_TOL) {\n    const map = g.vertices.map((v) => out.addVertex(v.x\x2C v.y\x2C tol));\n    for (const e of g.edges)\n        out.addEdge(map[e.a]\x2C map[e.b]);\n    return map;\n}\n/** `(merge g1 g2 \u2026)` / `(union \u2026)` \u2014 overlay graphs\x2C fusing coincident vertices. */\nexport function merge(graphs\x2C tol = VERTEX_TOL) {\n    const out = new Graph();\n    for (const g of graphs)\n        absorb(out\x2C g\x2C tol);\n    out.makeFaces();\n    return out;\n}\nexport const union = merge;\n/** Apply a per-vertex coordinate transform\x2C preserving edges. */\nfunction transform(g\x2C fn) {\n    const out = new Graph();\n    const map = g.vertices.map((v) => {\n        const [x\x2C y] = fn(v.x\x2C v.y);\n        return out.addVertex(x\x2C y);\n    });\n    for (const e of g.edges)\n        out.addEdge(map[e.a]\x2C map[e.b]);\n    out.makeFaces();\n    return out;\n}\n/** `(shift dx dy g)` \u2014 translate. */\nexport function shift(dx\x2C dy\x2C g) {\n    return transform(g\x2C (x\x2C y) => [x + dx\x2C y + dy]);\n}\n/** `(scale s g)` or `(scale sx sy g)` \u2014 scale about the origin. */\nexport function scale(sx\x2C sy\x2C g) {\n    return transform(g\x2C (x\x2C y) => [x * sx\x2C y * sy]);\n}\n/**\n * `(rotate degrees g)` \u2014 rotate anticlockwise about the graph's midpoint (the\n * bounding-box centre)\x2C matching Java `Gr