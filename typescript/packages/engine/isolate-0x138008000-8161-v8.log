script-source,160,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-remove.js,// @java Core/src/other/action/move/remove/ActionRemove.java ActionRemove\n/**\n * Java parity:\n * - Core/src/other/action/move/remove/ActionRemove.java \u2014 the\n *   "remove one or more pieces from a site" action.\n *\n * Subset ported: deterministic data members (to / count / level) plus\n * the core `apply(state) \u2192 state` semantics: the piece at `to` is\n * cleared. Hidden info and the long tail of optional parameters are\n * deferred.\n */\nimport { ACTION_UNDEFINED\x2C BaseAction } from "./action.js";\nexport class ActionRemove extends BaseAction {\n    static TYPE = "Remove";\n    toIndex;\n    countValue;\n    level;\n    siteType;\n    constructor(options) {\n        super();\n        if (!Number.isInteger(options.to) || options.to < 0) {\n            throw new RangeError("ActionRemove.to must be a non-negative integer.");\n        }\n        this.toIndex = options.to;\n        this.countValue = options.count ?? 1;\n        this.level = options.level ?? ACTION_UNDEFINED;\n        this.siteType = options.type ?? "Cell";\n    }\n    apply(state) {\n        // Removing from a multi-piece pile (Java: a stacked site\x2C e.g. Bagh goat\n        // stacks) leaves the remainder in place; only when the count is exhausted\n        // does the site become empty. Plain single pieces (count 0/1) are cleared.\n        const pile = state.countAtSite(this.toIndex);\n        if (pile > this.countValue) {\n            return state.withCountAt(this.toIndex\x2C pile - this.countValue);\n        }\n        let next = state.withCell(this.toIndex\x2C 0).withWhatAt(this.toIndex\x2C 0);\n        if (pile > 0)\n            next = next.withCountAt(this.toIndex\x2C 0);\n        return next;\n    }\n    actionType() {\n        return ActionRemove.TYPE;\n    }\n    to() {\n        return this.toIndex;\n    }\n    count() {\n        return this.countValue;\n    }\n    fromType() {\n        return this.siteType;\n    }\n    toType() {\n        return this.siteType;\n    }\n    getLevel() {\n        return this.level;\n    }\n    setLevel(level) {\n        this.level = level;\n    }\n}\n//# sourceMappingURL=action-remove.js.map
