script-source,234,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/trajectories.js,// @java Core/src/game/util/graph/Trajectories.java Trajectories\n//\n// The faithful trajectory engine: precomputes\x2C for every SiteType and every\n// site\x2C the single-hop Steps and multi-hop Radials\x2C each tagged with the\n// AbsoluteDirections it agrees with. This is the one mechanism Java uses to\n// resolve movement on EVERY board (square / hex / triangular / concentric)\x2C\n// replacing the port's earlier Cartesian dx/dy shortcut. See PARITY.md.\n//\n// Pipeline (mirrors Java create()):\n//   generateSteps  \u2192 stepsTo per element (structural Orthogonal/Diagonal/\u2026)\n//                  \u2192 setCompassDirections (angular N/E/\u2026 + SameLayer/Up/Down)\n//                  \u2192 setCircularDirections (pivoted CW/CCW/In/Out)\n//   generateRadials \u2192 followRadial (straightest continuation\x2C 0.25 rad bend)\nimport { AbsoluteDirection\x2C ALL_DIRECTIONS\x2C } from "./absolute-direction.js";\nimport { GraphTopology\x2C NUM_SITE_TYPES\x2C SiteType\x2C } from "./graph-element.js";\nimport { absTanAngleDifference3D\x2C angle2D\x2C distance3D\x2C distanceToLine\x2C dot3D\x2C whichSide\x2C } from "./math.js";\nimport { Radial\x2C Radials } from "./radial.js";\nimport { Step\x2C Steps } from "./step.js";\nconst SITE_TYPES = [\n    SiteType.Vertex\x2C\n    SiteType.Edge\x2C\n    SiteType.Cell\x2C\n];\n// -- structural steps (stepsTo) ----------------------------------------------\n/** @java Face.stepsTo(Steps) */\nfunction faceStepsTo(face\x2C steps) {\n    const usedFaces = new Set();\n    usedFaces.add(face.id);\n    // Adjacent cells across shared edges \u2192 Orthogonal.\n    for (const edge of face.edges) {\n        const other = edge.otherFace(face.id);\n        if (other === null)\n            continue;\n        usedFaces.add(other.id);\n        const step = new Step(face\x2C other);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    // Diagonal cells joined by a vertex (square grid) \u2192 Diagonal.\n    for (const vertex of face.vertices) {\n        let bestDistance = 1000000;\n        let diagonal = null;\n        for (const other of vertex.faces) {\n            if (usedFaces.has(other.id))\n                continue;\n            const dist = distanceToLine(vertex.pt.x\x2C vertex.pt.y\x2C face.pt.x\x2C face.pt.y\x2C other.pt.x\x2C other.pt.y);\n            if (dist < bestDistance) {\n                bestDistance = dist;\n                diagonal = other;\n            }\n        }\n        if (diagonal === null)\n            continue;\n        usedFaces.add(diagonal.id);\n        const step = new Step(face\x2C diagonal);\n        step.directions.add(AbsoluteDirection.Diagonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    // Remaining off-diagonal cells joined by a vertex (tri grid) \u2192 OffDiagonal.\n    for (const vertex of face.vertices) {\n        for (const other of vertex.faces) {\n            if (usedFaces.has(other.id))\n                continue;\n            usedFaces.add(other.id);\n            const step = new Step(face\x2C other);\n            step.directions.add(AbsoluteDirection.OffDiagonal);\n            step.directions.add(AbsoluteDirection.Adjacent);\n            step.directions.add(AbsoluteDirection.All);\n            steps.add(step);\n        }\n    }\n    // Non-adjacent diagonal cells joined by an edge (hex grid) \u2192 Diagonal.\n    for (const vertex of face.vertices) {\n        if (vertex.edges.length !== 3)\n            continue; // only trivalent intersections\n        const otherVertex = vertex.edgeAwayFrom(face);\n        if (otherVertex === null)\n            continue;\n        for (const otherFace of otherVertex.faces) {\n            if (usedFaces.has(otherFace.id))\n                continue;\n            const distV = distanceToLine(vertex.pt.x\x2C vertex.pt.y\x2C face.pt.x\x2C face.pt.y\x2C otherFace.pt.x\x2C otherFace.pt.y);\n            const distOV = distanceToLine(otherVertex.pt.x\x2C otherVertex.pt.y\x2C face.pt.x\x2C face.pt.y\x2C otherFace.pt.x\x2C otherFace.pt.y);\n            const distAB = Math.hypot(otherFace.pt.x - face.pt.x\x2C otherFace.pt.y - face.pt.y);\n            const error = distAB === 0 ? Infinity : (distV + distOV) / distAB;\n            if (error > 0.1)\n                continue;\n            usedFaces.add(otherFace.id);\n            const step = new Step(face\x2C otherFace);\n            step.directions.add(AbsoluteDirection.Diagonal);\n            step.directions.add(AbsoluteDirection.All);\n            steps.add(step);\n        }\n    }\n    // Steps to this face's own vertices and edges \u2192 Orthogonal/Adjacent/All.\n    for (const vertex of face.vertices) {\n        const step = new Step(face\x2C vertex);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    for (const edge of face.edges) {\n        const step = new Step(face\x2C edge);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n}\n/** @java Vertex.stepsTo(Steps) */\nfunction vertexStepsTo(vertex\x2C steps) {\n    // Orthogonal steps along edges to other vertices.\n    for (const edge of vertex.edges) {\n        const to = edge.otherVertex(vertex.id);\n        const step = new Step(vertex\x2C to);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    // Diagonal steps across cell faces (square cells) \u2192 Diagonal.\n    for (const face of vertex.faces) {\n        if (face.vertices.length < 4)\n            continue; // no diagonal across a triangle\n        let bestDist = 1000000;\n        let bestTo = null;\n        for (const to of face.vertices) {\n            if (to.id === vertex.id)\n                continue;\n            const dist = distanceToLine(face.pt.x\x2C face.pt.y\x2C vertex.pt.x\x2C vertex.pt.y\x2C to.pt.x\x2C to.pt.y);\n            if (dist < bestDist) {\n                bestDist = dist;\n                bestTo = to;\n            }\n        }\n        if (bestTo === null)\n            continue;\n        const step = new Step(vertex\x2C bestTo);\n        step.directions.add(AbsoluteDirection.Diagonal);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    // Steps to incident edges and faces \u2192 Orthogonal/Adjacent/All.\n    for (const edge of vertex.edges) {\n        const step = new Step(vertex\x2C edge);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n    for (const face of vertex.faces) {\n        const step = new Step(vertex\x2C face);\n        step.directions.add(AbsoluteDirection.Orthogonal);\n        step.directions.add(AbsoluteDirection.Adjacent);\n        step.directions.add(AbsoluteDirection.All);\n        steps.add(step);\n    }\n}\nfunction stepsToFor(element\x2C steps) {\n    if (element.siteType === SiteType.Cell)\n        faceStepsTo(element\x2C steps);\n    else if (element.siteType === SiteType.Vertex) {\n        vertexStepsTo(element\x2C steps);\n    }\n    // Edge.stepsTo is unused: board-graph maps use:Edge play onto Vertex sites.\n}\n// -- compass-direction assignment --------------------------------------------\n/**\n * @java Trajectories.mapAngleToAbsoluteDirection\n * Bin a step's planar angle into a compass direction. `intercardinal` selects\n * the 16-point set (used when two steps collide in the 8-point set). Planar\n * boards have elevation 0\x2C so only the 2-D branch is reachable here.\n */\nfunction mapAngleToAbsoluteDirection(step\x2C _unit\x2C intercardinal) {\n    const a = step.from.pt;\n    const b = step.to.pt;\n    // 2-D planar boards: elevation is always 0 (z === 0)\x2C so omit the U/D branch.\n    let angle = Math.atan2(b.y - a.y\x2C b.x - a.x);\n    while (angle < 0)\n        angle += 2 * Math.PI;\n    while (angle > 2 * Math.PI)\n        angle -= 2 * Math.PI;\n    if (!intercardinal) {\n        const off = (2 * Math.PI) / 16;\n        if (angle < off)\n            return AbsoluteDirection.E;\n        if (angle < off + (2 * Math.PI) / 8)\n            return AbsoluteDirection.NE;\n        if (angle < off + (4 * Math.PI) / 8)\n            return AbsoluteDirection.N;\n        if (angle < off + (6 * Math.PI) / 8)\n            return AbsoluteDirection.NW;\n        if (angle < off + (8 * Math.PI) / 8)\n            return AbsoluteDirection.W;\n        if (angle < off + (10 * Math.PI) / 8)\n            return AbsoluteDirection.SW;\n        if (angle < off + (12 * Math.PI) / 8)\n            return AbsoluteDirection.S;\n        if (angle < off + (14 * Math.PI) / 8)\n            return AbsoluteDirection.SE;\n        return AbsoluteDirection.E;\n    }\n    const off = (2 * Math.PI) / 32;\n    if (angle < off)\n        return AbsoluteDirection.E;\n    if (angle < off + (2 * Math.PI) / 16)\n        return AbsoluteDirection.ENE;\n    if (angle < off + (4 * Math.PI) / 16)\n        return AbsoluteDirection.NE;\n    if (angle < off + (6 * Math.PI) / 16)\n        return AbsoluteDirection.NNE;\n    if (angle < off + (8 * Math.PI) / 16)\n        return AbsoluteDirection.N;\n    if (angle < off + (10 * Math.PI) / 16)\n        return AbsoluteDirection.NNW;\n    if (angle < off + (12 * Math.PI) / 16)\n        return AbsoluteDirection.NW;\n    if (angle < off + (14 * Math.PI) / 16)\n        return AbsoluteDirection.WNW;\n    if (angle < off + (16 * Math.PI) / 16)\n        return AbsoluteDirection.W;\n    if (angle < off + (18 * Math.PI) / 16)\n        return AbsoluteDirection.WSW;\n    if (angle < off + (20 * Math.PI) / 16)\n        return AbsoluteDirection.SW;\n    if (angle < off + (22 * Math.PI) / 16)\n        return AbsoluteDirection.SSW;\n    if (angle < off + (24 * Math.PI) / 16)\n        return AbsoluteDirection.S;\n    if (angle < off + (26 * Math.PI) / 16)\n        return AbsoluteDirection.SSE;\n    if (angle < off + (28 * Math.PI) / 16)\n        return AbsoluteDirection.SE;\n    if (angle < off + (30 * Math.PI) / 16)\n        return AbsoluteDirection.ESE;\n    return AbsoluteDirection.E;\n}\nconst COMPASS_SAME_LAYER = new Set([\n    AbsoluteDirection.N\x2C AbsoluteDirection.E\x2C AbsoluteDirection.S\x2C AbsoluteDirection.W\x2C\n    AbsoluteDirection.NE\x2C AbsoluteDirection.SE\x2C AbsoluteDirection.SW\x2C AbsoluteDirection.NW\x2C\n    AbsoluteDirection.NNE\x2C AbsoluteDirection.ENE\x2C AbsoluteDirection.ESE\x2C AbsoluteDirection.SSE\x2C\n    AbsoluteDirection.SSW\x2C AbsoluteDirection.WSW\x2C AbsoluteDirection.WNW\x2C AbsoluteDirection.NNW\x2C\n]);\n// -- the engine --------------------------------------------------------------\n/** @java Core/src/game/util/graph/Trajectories.java Trajectories */\nexport class TrajectoriesCore {\n    topo;\n    /** steps[siteTypeOrdinal][siteId] */\n    stepsArr;\n    /** radials[siteTypeOrdinal][siteId] */\n    radialsArr;\n    totalDirections = new Set();\n    constructor(graph) {\n        this.topo = new GraphTopology(graph);\n        this.stepsArr = Array.from({ length: NUM_SITE_TYPES }\x2C () => []);\n        this.radialsArr = Array.from({ length: NUM_SITE_TYPES }\x2C () => []);\n        this.create();\n    }\n    // -- public accessors (mirror Java steps()/radials() overloads) -----------\n    stepsToType(fromType\x2C siteId\x2C toType) {\n        return this.stepsArr[fromType]?.[siteId]?.toSiteType(toType) ?? [];\n    }\n    stepsInDirection(fromType\x2C siteId\x2C dirn) {\n        return this.stepsArr[fromType]?.[siteId]?.inDirection(dirn) ?? [];\n    }\n    stepsToTypeInDirection(fromType\x2C siteId\x2C toType\x2C dirn) {\n        return this.stepsArr[fromType]?.[siteId]?.toSiteTypeInDirection(toType\x2C dirn) ?? [];\n    }\n    radialsOf(fromType\x2C siteId) {\n        return this.radialsArr[fromType]?.[siteId];\n    }\n    radialsInDirection(fromType\x2C siteId\x2C dirn) {\n        return this.radialsArr[fromType]?.[siteId]?.inDirection(dirn) ?? [];\n    }\n    // -- construction ---------------------------------------------------------\n    create() {\n        this.generateSteps();\n        this.generateRadials();\n    }\n    generateSteps() {\n        for (const siteType of SITE_TYPES) {\n            for (const from of this.topo.elements(siteType)) {\n                const stepsFrom = new Steps(siteType\x2C from.id);\n                stepsToFor(from\x2C stepsFrom);\n                this.stepsArr[siteType][from.id] = stepsFrom;\n            }\n        }\n        this.setDirections();\n        for (const siteType of SITE_TYPES) {\n            for (const stepList of this.stepsArr[siteType]) {\n                if (!stepList)\n                    continue;\n                for (const d of stepList.totalDirections)\n                    this.totalDirections.add(d);\n            }\n        }\n    }\n    setDirections() {\n        this.setCompassDirections();\n        this.setCircularDirections();\n        // Propagate every per-direction step bit into the step itself and into the\n        // toSiteTypeInDirection index. @java Trajectories.setDirections final loop.\n        for (const siteType of SITE_TYPES) {\n            const elements = this.topo.elements(siteType);\n            for (let id = 0; id < elements.length; id += 1) {\n                const stepsFrom = this.stepsArr[siteType][id];\n                if (!stepsFrom)\n                    continue;\n                for (const dirn of ALL_DIRECTIONS) {\n                    for (const step of [...stepsFrom.inDirection(dirn)]) {\n                        step.directions.add(dirn);\n                        stepsFrom.addToSiteTypeInDirection(step.to.siteType\x2C dirn\x2C step);\n                        this.totalDirections.add(dirn);\n                    }\n                }\n            }\n        }\n    }\n    /** @java Trajectories.setCompassDirections */\n    setCompassDirections() {\n        const unit = this.topo.averageEdgeLength();\n        for (const siteType of SITE_TYPES) {\n            for (const element of this.topo.elements(siteType)) {\n                const stepsFrom = this.stepsArr[siteType][element.id];\n                if (!stepsFrom)\n                    continue;\n                const stepList = stepsFrom.steps;\n                // 8 compass directions unless two steps collide \u2192 use 16.\n                const used = new Set();\n                let collision = false;\n                for (const step of stepList) {\n                    const dirn = mapAngleToAbsoluteDirection(step\x2C unit\x2C false);\n                    if (used.has(dirn)) {\n                        collision = true;\n                        break;\n                    }\n                    used.add(dirn);\n                }\n                for (const step of stepList) {\n                    const dirn = mapAngleToAbsoluteDirection(step\x2C unit\x2C collision);\n                    stepsFrom.addInDirection(dirn\x2C step);\n                    if (COMPASS_SAME_LAYER.has(dirn)) {\n                        stepsFrom.addInDirection(AbsoluteDirection.SameLayer\x2C step);\n                    }\n                    // Upward/Downward families are unreachable on planar boards (z = 0).\n                }\n            }\n        }\n    }\n    /** @java Trajectories.setCircularDirections (pivoted concentric boards). */\n    setCircularDirections() {\n        const vertexType = SiteType.Vertex;\n        // Pivot vertices: all steps go Out + Rotational.\n        const pivotIds = new Set();\n        for (const vertex of this.topo.verts) {\n            const p = vertex.pivot();\n            if (p !== null)\n                pivotIds.add(p.id);\n        }\n        if (pivotIds.size === 0)\n            return; // square/rect/etc. have no pivots\n        for (const id of pivotIds) {\n            const stepsFrom = this.stepsArr[vertexType][id];\n            if (!stepsFrom)\n                continue;\n            for (const step of stepsFrom.steps) {\n                stepsFrom.addInDirection(AbsoluteDirection.Out\x2C step);\n                stepsFrom.addInDirection(AbsoluteDirection.Rotational\x2C step);\n            }\n        }\n        for (const siteType of SITE_TYPES) {\n            const elements = this.topo.elements(siteType);\n            for (let id = 0; id < elements.length; id += 1) {\n                if (siteType === vertexType && pivotIds.has(id))\n                    continue;\n                const from = elements[id];\n                const pivot = from.pivot();\n                if (pivot === null)\n                    continue;\n                const stepsFrom = this.stepsArr[siteType][id];\n                if (!stepsFrom)\n                    continue;\n                for (const step of stepsFrom.steps) {\n                    if (step.directions.has(AbsoluteDirection.Diagonal))\n                        continue;\n                    // Vectors from-element\u2192to and from-element\u2192pivot\x2C normalised.\n                    const abx = step.to.pt.x - from.pt.x;\n                    const aby = step.to.pt.y - from.pt.y;\n                    const abz = step.to.pt.z - from.pt.z;\n                    const apx = pivot.pt.x - from.pt.x;\n                    const apy = pivot.pt.y - from.pt.y;\n                    const apz = pivot.pt.z - from.pt.z;\n                    const abLen = Math.hypot(abx\x2C aby\x2C abz) || 1;\n                    const apLen = Math.hypot(apx\x2C apy\x2C apz) || 1;\n                    const d = dot3D(abx / abLen\x2C aby / abLen\x2C abz / abLen\x2C apx / apLen\x2C apy / apLen\x2C apz / apLen);\n                    if (d > 0.9) {\n                        stepsFrom.addInDirection(AbsoluteDirection.In\x2C step);\n                        stepsFrom.addInDirection(AbsoluteDirection.Rotational\x2C step);\n                    }\n                    else if (d < -0.9) {\n                        stepsFrom.addInDirection(AbsoluteDirection.Out\x2C step);\n                        stepsFrom.addInDirection(AbsoluteDirection.Rotational\x2C step);\n                    }\n                    else {\n                        const side = whichSide(step.to.pt.x\x2C step.to.pt.y\x2C from.pt.x\x2C from.pt.y\x2C pivot.pt.x\x2C pivot.pt.y);\n                        const dir = side > 0 ? AbsoluteDirection.CW : AbsoluteDirection.CCW;\n                        stepsFrom.addInDirection(dir\x2C step);\n                        stepsFrom.addInDirection(AbsoluteDirection.Rotational\x2C step);\n                    }\n                }\n            }\n        }\n    }\n    // -- radials --------------------------------------------------------------\n    generateRadials() {\n        for (const siteType of SITE_TYPES) {\n            const elements = this.topo.elements(siteType);\n            for (let id = 0; id < elements.length; id += 1) {\n                const radials = new Radials(siteType\x2C id);\n                this.radialsArr[siteType][id] = radials;\n                const stepsFrom = this.stepsArr[siteType][id];\n                if (!stepsFrom)\n                    continue;\n                for (const dirn of ALL_DIRECTIONS) {\n                    for (const step of stepsFrom.inDirection(dirn)) {\n                        if (step.to.siteType !== siteType)\n                            continue;\n                        const radial = new RadialWIP(step.from\x2C dirn);\n                        this.followRadial(radials\x2C siteType\x2C dirn\x2C step.to\x2C radial);\n                    }\n                }\n            }\n        }\n        // Remove opposite subsets.\n        for (const siteType of SITE_TYPES) {\n            for (const radials of this.radialsArr[siteType]) {\n                if (!radials)\n                    continue;\n                for (const radial of radials.radials)\n                    radial.removeOppositeSubsets();\n            }\n        }\n        // Reassign Rotational radials\x2C then setDistinct + sort.\n        for (const siteType of SITE_TYPES) {\n            const elements = this.topo.elements(siteType);\n            for (let id = 0; id < elements.length; id += 1) {\n                const radials = this.radialsArr[siteType][id];\n                if (!radials)\n                    continue;\n                // Rebuild Rotational from In/Out/CW/CCW.\n                const rot = radials.inDirection(AbsoluteDirection.Rotational);\n                rot.length = 0;\n                for (const dir of [\n                    AbsoluteDirection.In\x2C AbsoluteDirection.Out\x2C\n                    AbsoluteDirection.CW\x2C AbsoluteDirection.CCW\x2C\n                ]) {\n                    for (const radial of radials.inDirection(dir)) {\n                        radials.addInDirection(AbsoluteDirection.Rotational\x2C radial);\n                    }\n                }\n                radials.removeSubsetsInDirection(AbsoluteDirection.Rotational);\n            }\n        }\n        for (const siteType of SITE_TYPES) {\n            for (const radials of this.radialsArr[siteType]) {\n                if (!radials)\n                    continue;\n                radials.setDistinct();\n                radials.sort();\n            }\n        }\n    }\n    /** @java Trajectories.followRadial */\n    followRadial(radials\x2C siteType\x2C dirn\x2C current\x2C radial) {\n        const tanThreshold = Math.tan(0.25);\n        const previous = radial.lastStep();\n        radial.addStep(current);\n        const stepsHere = this.stepsArr[siteType]?.[current.id];\n        if (!stepsHere)\n            return;\n        const nextSteps = stepsHere.inDirection(dirn);\n        const circular = dirn === AbsoluteDirection.CW || dirn === AbsoluteDirection.CCW ||\n            dirn === AbsoluteDirection.In || dirn === AbsoluteDirection.Out;\n        if (circular) {\n            let bestNextTo = null;\n            for (const next of nextSteps) {\n                if (next.to.siteType !== siteType)\n                    continue;\n                if (next.directions.has(dirn)) {\n                    bestNextTo = next.to;\n                    break;\n                }\n            }\n            if (bestNextTo !== null && !radial.contains(bestNextTo)) {\n                this.followRadial(radials\x2C siteType\x2C dirn\x2C bestNextTo\x2C radial);\n            }\n            else {\n                radials.addSafe(radial.toRadial());\n            }\n            return;\n        }\n        // Non-circular: follow the straightest continuation(s).\n        let bestAbsTanDiff = tanThreshold;\n        let bestsNextTo = [];\n        for (const next of nextSteps) {\n            if (next.to.siteType !== siteType)\n                continue;\n            if (!next.directions.has(dirn))\n                continue;\n            const absTanDiff = absTanAngleDifference3D(previous.pt\x2C current.pt\x2C next.to.pt);\n            if (absTanDiff < bestAbsTanDiff) {\n                bestAbsTanDiff = absTanDiff;\n                bestsNextTo = [next.to];\n                if (bestAbsTanDiff === 0.0)\n                    break;\n            }\n            else if (absTanDiff === bestAbsTanDiff) {\n                bestsNextTo.push(next.to);\n            }\n        }\n        if (bestsNextTo.length !== 0) {\n            for (const nextTo of bestsNextTo) {\n                if (!radial.contains(nextTo)) {\n                    this.followRadial(radials\x2C siteType\x2C dirn\x2C nextTo\x2C new RadialWIP(radial));\n                }\n                else {\n                    radials.addSafe(radial.toRadial());\n                }\n            }\n        }\n        else {\n            radials.addSafe(radial.toRadial());\n        }\n    }\n}\n/** @java Trajectories.RadialWIP \u2014 a radial under construction. */\nclass RadialWIP {\n    elements = [];\n    direction;\n    constructor(start\x2C direction) {\n        if (start instanceof RadialWIP) {\n            this.direction = start.direction;\n            this.elements = [...start.elements];\n        }\n        else {\n            this.direction = direction;\n            this.elements.push(start);\n        }\n    }\n    addStep(to) {\n        this.elements.push(to);\n    }\n    lastStep() {\n        return this.elements[this.elements.length - 1];\n    }\n    contains(el) {\n        for (const e of this.elements) {\n            if (e.siteType === el.siteType && e.id === el.id)\n                return true;\n        }\n        return false;\n    }\n    toRadial() {\n        return new Radial([...this.elements]\x2C this.direction);\n    }\n}\n// Re-export the shared types/enums consumers of the core need.\nexport { AbsoluteDirection\x2C SiteType };\nexport { angle2D\x2C distance3D };\n//# sourceMappingURL=trajectories.js.map
