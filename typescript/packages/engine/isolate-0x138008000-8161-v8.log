     for (const [i\x2C j] of spec.edgesByIndex)\n            out.addEdge(i\x2C j);\n    out.makeFaces();\n    return out;\n}\n/**\n * `(remove g vertices:{\u2026} edges:{\u2026})` \u2014 drop the listed vertices (and their\n * incident edges) and edges\x2C renumbering survivors.\n */\nexport function remove(base\x2C spec) {\n    const drop = new Set(spec.vertices ?? []);\n    const dropEdge = new Set((spec.edgesByIndex ?? []).map(([a\x2C b]) => (a < b ? `${a}:${b}` : `${b}:${a}`)));\n    const out = new Graph();\n    const map = new Map();\n    for (const v of base.vertices) {\n        if (drop.has(v.id))\n            continue;\n        map.set(v.id\x2C out.addVertex(v.x\x2C v.y));\n    }\n    for (const e of base.edges) {\n        if (drop.has(e.a) || drop.has(e.b))\n            continue;\n        const key = e.a < e.b ? `${e.a}:${e.b}` : `${e.b}:${e.a}`;\n        if (dropEdge.has(key))\n            continue;\n        const a = map.get(e.a);\n        const b = map.get(e.b);\n        if (a !== undefined && b !== undefined)\n            out.addEdge(a\x2C b);\n    }\n    out.makeFaces();\n    return out;\n}\n/**\n * `(dual g)` \u2014 the weak planar dual: one vertex at each face centroid\x2C joined\n * where the source faces share an edge.\n */\nexport function dual(base) {\n    const out = new Graph();\n    const faceVert = base.faces.map((f) => out.addVertex(f.cx\x2C f.cy));\n    // Map each undirected edge to the faces touching it.\n    const edgeFaces = new Map();\n    const key = (a\x2C b) => (a < b ? `${a}:${b}` : `${b}:${a}`);\n    base.faces.forEach((f\x2C fi) => {\n        const vs = f.vertices;\n        for (let i = 0; i < vs.length; i += 1) {\n            const k = key(vs[i]\x2C vs[(i + 1) % vs.length]);\n            (edgeFaces.get(k) ?? edgeFaces.set(k\x2C []).get(k)).push(fi);\n        }\n    });\n    for (const fs of edgeFaces.values()) {\n        for (let i = 0; i < fs.length; i += 1)\n            for (let j = i + 1; j < fs.length; j += 1)\n            