script-source,224,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/board-graph.js,/**\n * Compile a board-shape ludeme (`(board <shape> use:\u2026)`) into a planar\n * {@link Graph} plus the play-site kind (Cell / Vertex). Returns `undefined`\n * for shapes not yet modelled\x2C so the caller can fall back to the legacy\n * lattice path or report an honest "unsupported tiling".\n *\n * Handles the board-algebra generators and operators (square / rectangle /\n * circle / concentric / merge / add / remove / dual / rotate / scale / shift /\n * skew / intersect / explicit graph) plus best-effort pass-through for\n * geometry-preserving wrappers (clip / trim / keep / subdivide / \u2026).\n */\nimport { isIdent\x2C isList\x2C isNumber\x2C listHead\x2C } from "@ludii/typescript-language";\nimport { genCircle\x2C genConcentricCounts\x2C genConcentricPolygon\x2C genRectangle\x2C genSquare\x2C } from "./generators.js";\nimport { Graph } from "./graph.js";\nimport { buildNamedTiling\x2C genBrick\x2C genHex\x2C genQuadhex\x2C genRegular\x2C genSpiral\x2C genTri\x2C genWedge\x2C } from "./named-tilings.js";\nimport { add\x2C dual\x2C intersect\x2C merge\x2C remove\x2C rotate\x2C scale\x2C shift\x2C skew\x2C } from "./operators.js";\nimport { Trajectories } from "./trajectories.js";\nconst num = (n\x2C dflt = Number.NaN) => n && isNumber(n) ? n.value : dflt;\n/** Split items after the head into positional nodes + `key:` \u2192 value map. */\nfunction args(items) {\n    const pos = [];\n    const named = new Map();\n    for (let i = 0; i < items.length; i += 1) {\n        const it = items[i];\n        if (!it)\n            continue;\n        if (isIdent(it) && it.name.endsWith(":")) {\n            const v = items[i + 1];\n            if (v) {\n                named.set(it.name.slice(0\x2C -1)\x2C v);\n                i += 1;\n            }\n            continue;\n        }\n        pos.push(it);\n    }\n    return { pos\x2C named };\n}\nconst isTrue = (n) => !!n && isIdent(n) && n.name === "True";\n/**\n * Evaluate a node to a number\x2C handling literal numbers and simple integer\n * arithmetic (`+ - * /`) recursively. Resolves option-substituted expressions\n * like `(* 3 5)` that appear inside board-shape argument lists.\n */\nfunction evalNum(node) {\n    if (!node)\n        return undefined;\n    if (isNumber(node))\n        return node.value;\n    if (!isList(node) || node.delimiter !== "round")\n        return undefined;\n    const h = node.items[0];\n    if (!h || !isIdent(h))\n        return undefined;\n    const args = [];\n    for (let i = 1; i < node.items.length; i += 1) {\n        const v = evalNum(node.items[i]);\n        if (v === undefined)\n            return undefined;\n        args.push(v);\n    }\n    if (args.length === 0)\n        return undefined;\n    switch (h.name) {\n        case "+":\n            return args.reduce((a\x2C b) => a + b);\n        case "-":\n            return args.length === 1 ? -args[0] : args.reduce((a\x2C b) => a - b);\n        case "*":\n            return args.reduce((a\x2C b) => a * b);\n        case "/":\n            return args.length === 2 && args[1] !== 0\n                ? Math.trunc(args[0] / args[1])\n                : undefined;\n        default:\n            return undefined;\n    }\n}\n/** Numbers inside a `{ \u2026 }` curly list; evaluates simple arithmetic expressions. */\nfunction numberList(n) {\n    if (!n || !isList(n) || n.delimiter !== "curly")\n        return [];\n    const out = [];\n    for (const item of n.items) {\n        const v = evalNum(item);\n        if (v !== undefined)\n            out.push(v);\n    }\n    return out;\n}\n/** Coordinate pairs inside `{ {x y} \u2026 }`. */\nfunction pairList(n) {\n    if (!n || !isList(n) || n.delimiter !== "curly")\n        return [];\n    const out = [];\n    for (const it of n.items) {\n        if (isList(it) && it.delimiter === "curly") {\n            const xs = it.items.filter(isNumber).map((x) => x.value);\n            if (xs.length >= 2)\n                out.push([xs[0]\x2C xs[1]]);\n        }\n    }\n    return out;\n}\n/** Recurse into operands: positional list children (flattening curly groups). */\nfunction operandGraphs(pos\x2C vertexMode) {\n    const out = [];\n    for (const p of pos) {\n        if (!isList(p))\n            continue;\n        if (p.delimiter === "curly") {\n            for (const inner of p.items) {\n                if (isList(inner)) {\n                    const g = toGraph(inner\x2C vertexMode);\n                    if (g)\n                        out.push(g);\n                }\n            }\n            continue;\n        }\n        const g = toGraph(p\x2C vertexMode);\n        if (g)\n            out.push(g);\n    }\n    return out;\n}\n/** First positional list child that compiles to a graph. */\nfunction firstOperand(pos\x2C vertexMode) {\n    for (const p of pos) {\n        if (isList(p)) {\n            const g = toGraph(p\x2C vertexMode);\n            if (g)\n                return g;\n        }\n    }\n    return undefined;\n}\nconst PASSTHROUGH = new Set([\n    "clip"\x2C\n    "trim"\x2C\n    "keep"\x2C\n    "hole"\x2C\n    "subdivide"\x2C\n    "splitcrossings"\x2C\n    "makefaces"\x2C\n    "renumber"\x2C\n    "repeat"\x2C\n    "complete"\x2C\n    "mesh"\x2C\n    "layers"\x2C\n    "renumberclockwise"\x2C\n    "recoordinate"\x2C\n    "hole"\x2C\n]);\n/**\n * Dispatch a shape/operator node to a Graph\x2C or undefined if unmodelled.\n * `vertexMode` (from the board's `use:` clause) selects the Java\n * `RectangleOnSquare` vertex-grid sizing for square/rectangle bases.\n */\nexport function toGraph(node\x2C vertexMode = false) {\n    if (!isList(node))\n        return undefined;\n    const head = (listHead(node) ?? "").toLowerCase();\n    const { pos\x2C named } = args(node.items.slice(1));\n    switch (head) {\n        case "square": {\n            const diag = named.get("diagonals");\n            return genSquare(num(pos[0]\x2C 1)\x2C vertexMode\x2C diag && isIdent(diag) ? diag.name : undefined);\n        }\n        case "rectangle":\n        case "rect": {\n            const diag = named.get("diagonals");\n            return genRectangle(num(pos[0]\x2C 1)\x2C num(pos[1]\x2C num(pos[0]\x2C 1))\x2C vertexMode\x2C diag && isIdent(diag) ? diag.name : undefined);\n        }\n        case "circle":\n            return genCircle(numberList(pos[0])\x2C isTrue(named.get("stagger")));\n        case "quadhex":\n            return genQuadhex(num(pos[0]\x2C 4));\n        case "spiral":\n            return genSpiral(num(named.get("turns")\x2C 4)\x2C num(named.get("sites")\x2C 80)\x2C !(named.has("clockwise") && !isTrue(named.get("clockwise"))));\n        case "tiling": {\n            const tname = pos[0];\n            if (!tname || !isIdent(tname))\n                return undefined;\n            return buildNamedTiling(tname.name\x2C num(pos[1]\x2C 3)\x2C num(pos[2]));\n        }\n        case "hex":\n        case "tri":\n        case "brick": {\n            // Optional leading shape ident: (hex Diamond 11) vs (hex 5).\n            const shape = pos[0] && isIdent(pos[0]) ? pos[0].name : undefined;\n            const off = shape ? 1 : 0;\n            const dimA = num(pos[off]\x2C 3);\n            const dimB = num(pos[off + 1]);\n            if (head === "hex")\n                return genHex(shape\x2C dimA\x2C dimB);\n            if (head === "tri")\n                return genTri(shape\x2C dimA\x2C dimB);\n            return genBrick(shape\x2C dimA\x2C dimB\x2C isTrue(named.get("trim")));\n        }\n        case "wedge":\n            return genWedge(num(pos[0]\x2C 3)\x2C pos[1] ? num(pos[1]) : undefined);\n        case "regular": {\n            // (regular [Star] numSides) \u2014 a regular polygon ring or star polygon.\n            const first = pos[0];\n            const isStar = !!first && isIdent(first) && first.name.toLowerCase() === "star";\n            const nArg = isStar ? pos[1] : first;\n            return genRegular(isStar\x2C num(nArg\x2C 6));\n        }\n        case "celtic": {\n            // (celtic rows [cols]) \u2014 Celtic-knot board. Exact geometry needs a\n            // perimeter-curve algorithm; approximate as a rows\xd7cols square grid so\n            // the file compiles.\n            const rows = num(pos[0]\x2C 3);\n            const cols = pos[1] && isNumber(pos[1]) ? num(pos[1]) : rows;\n            return genRectangle(Math.max(1\x2C rows)\x2C Math.max(1\x2C cols)\x2C vertexMode);\n        }\n        case "shape": {\n            // (shape [Star] N) \u2014 a regular polygon perimeter; compound shapes fall\n            // back to passing through their first subgraph operand.\n            const first = pos[0];\n            const isStar = !!first && isIdent(first) && first.name.toLowerCase() === "star";\n            const nArg = isStar ? pos[1] : first;\n            if (nArg && isNumber(nArg))\n                return genRegular(isStar\x2C nArg.value);\n            return firstOperand(pos\x2C vertexMode);\n        }\n        case "concentric": {\n            const first = pos[0];\n            if (first && isIdent(first)) {\n                return genConcentricPolygon(first.name\x2C num(named.get("rings")\x2C 3)\x2C isTrue(named.get("joinCorners"))\x2C isTrue(named.get("joinMidpoints"))\x2C named.has("steps") ? num(named.get("steps")) : undefined);\n            }\n            return genConcentricCounts(numberList(first));\n        }\n        case "merge":\n        case "union": {\n            const gs = operandGraphs(pos\x2C vertexMode);\n            return gs.length > 0 ? merge(gs) : undefined;\n        }\n        case "intersect": {\n            const gs = operandGraphs(pos\x2C vertexMode);\n            return gs.length > 0 ? intersect(gs) : undefined;\n        }\n        case "dual": {\n            const g = firstOperand(pos\x2C vertexMode);\n            return g ? dual(g) : undefined;\n        }\n        case "rotate":