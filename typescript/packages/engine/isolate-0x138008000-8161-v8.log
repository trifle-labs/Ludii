script-source,122,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/concept.js,// @java Core/src/other/concept/Concept.java Concept\n/**\n * Java parity:\n * - Core/src/game/types/state/Concept.java enumerates ~600 named\n *   gameplay concepts; the TS port pins the subset the MVE engine\n *   actually tracks so callers can inspect what a move/game touches\n *   without dragging in the full enum.\n *\n * Concepts are exposed as a frozen `Set<ConceptName>`. The Java side\n * uses BitSet keyed by ordinal; we keep names because the TS engine is\n * data-driven and identifier-stable.\n */\nexport const CONCEPT_NAMES = [\n    "Add"\x2C\n    "Move"\x2C\n    "Remove"\x2C\n    "Swap"\x2C\n    "Pass"\x2C\n    "Forfeit"\x2C\n    "Vote"\x2C\n    "LineWin"\x2C\n    "ConnectionWin"\x2C\n    "DrawByFill"\x2C\n    "AlternatingTurns"\x2C\n    "HiddenInformation"\x2C\n    "Stacking"\x2C\n    "PieceOwnership"\x2C\n    "DeterministicPlayout"\x2C\n];\nexport class ConceptSet {\n    bag;\n    constructor(initial) {\n        this.bag = new Set(initial ?? []);\n    }\n    add(name) {\n        if (this.bag.has(name))\n            return this;\n        return new ConceptSet([...this.bag\x2C name]);\n    }\n    has(name) {\n        return this.bag.has(name);\n    }\n    get size() {\n        return this.bag.size;\n    }\n    toArray() {\n        return Object.freeze([...this.bag]);\n    }\n    union(other) {\n        return new ConceptSet([...this.bag\x2C ...other.bag]);\n    }\n    static of(...names) {\n        return new ConceptSet(names);\n    }\n}\nexport function isConceptName(value) {\n    return (typeof value === "string" &&\n        CONCEPT_NAMES.includes(value));\n}\n//# sourceMappingURL=concept.js.map
