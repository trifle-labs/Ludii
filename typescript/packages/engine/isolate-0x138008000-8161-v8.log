script-source,191,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-type.js,// @java Core/src/other/action/ActionType.java ActionType\n/**\n * Java parity:\n * - Core/src/other/action/ActionType.java \u2014 enum-shape port (one\n *   string-literal-union member per Java enum value\x2C declaration order\n *   preserved).\n *\n * The set of different action categories the engine recognises.\n */\nexport const ACTION_TYPES = [\n    "Add"\x2C\n    "Pass"\x2C\n    "NextInstance"\x2C\n    "Noop"\x2C\n    "Forfeit"\x2C\n    "Note"\x2C\n    "Propose"\x2C\n    "Vote"\x2C\n    "SetValueOfPlayer"\x2C\n    "SetTrumpSuit"\x2C\n    "UseDie"\x2C\n    "RollDice"\x2C\n    "SetDiceAllEqual"\x2C\n    "SetStateAndUpdateDice"\x2C\n    "SetCost"\x2C\n    "SetPhase"\x2C\n    "SetVisible"\x2C\n    "SetMasked"\x2C\n    "SetInvisible"\x2C\n    "Remove"\x2C\n    "Select"\x2C\n    "Insert"\x2C\n    "Promote"\x2C\n    "AddPlayerToTeam"\x2C\n    "Bet"\x2C\n    "SetPot"\x2C\n    "SetAmount"\x2C\n    "SetCount"\x2C\n    "Move"\x2C\n    "MoveN"\x2C\n    "StackMove"\x2C\n    "Copy"\x2C\n    "SetHidden"\x2C\n    "SetHiddenCount"\x2C\n    "SetHiddenRotation"\x2C\n    "SetHiddenState"\x2C\n    "SetHiddenValue"\x2C\n    "SetHiddenWhat"\x2C\n    "SetHiddenWho"\x2C\n    "SetCounter"\x2C\n    "SetNextPlayer"\x2C\n    "SetPending"\x2C\n    "Swap"\x2C\n    "Reset"\x2C\n    "SetValuePuzzle"\x2C\n    "Toggle"\x2C\n    "Forget"\x2C\n    "Remember"\x2C\n    "SetRotation"\x2C\n    "SetValue"\x2C\n    "SetState"\x2C\n    "SetScore"\x2C\n    "SetTemp"\x2C\n    "SetVar"\x2C\n    "StoreState"\x2C\n    "Trigger"\x2C\n];\nexport function isActionType(value) {\n    return ACTION_TYPES.includes(value);\n}\n//# sourceMappingURL=action-type.js.map
