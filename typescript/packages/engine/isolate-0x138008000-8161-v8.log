script-source,208,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/nst-playout.js,/**\n * Java parity: AI/src/search/mcts/playout/NST.java.\n *\n * Bigram variant of MAST. Picks the next playout move via softmax over\n * the running mean reward of the (previous-move\x2C candidate-move) pair.\n * Falls back to the unigram (MAST) mean when no bigram data exists.\n */\n/**\n * Tracks the previously-played move's hash across calls so the strategy\n * can key bigram updates. Reset by calling `resetHistory()` at the start\n * of each rollout.\n */\nexport class NSTPlayout {\n    stats;\n    bigramStats;\n    temperature;\n    epsilon;\n    prevHash = 0;\n    constructor(options) {\n        this.stats = options.stats;\n        this.bigramStats = options.bigramStats;\n        this.temperature = Math.max(1e-6\x2C options.temperature ?? 1);\n        this.epsilon = Math.max(0\x2C Math.min(1\x2C options.epsilon ?? 0.1));\n    }\n    resetHistory() {\n        this.prevHash = 0;\n    }\n    selectMove(context\x2C rng) {\n        const moves = context.game.moves(context);\n        if (moves.length === 0)\n            return undefined;\n        if (moves.length === 1) {\n            this.prevHash = moves[0].hash();\n            return moves[0];\n        }\n        if (rng.nextFloat() < this.epsilon) {\n            const pick = moves[rng.nextInt(moves.length)];\n            this.prevHash = pick.hash();\n            return pick;\n        }\n        let maxVal = Number.NEGATIVE_INFINITY;\n        const vals = new Array(moves.length);\n        for (let i = 0; i < moves.length; i += 1) {\n            const m = moves[i];\n            const bigramVisits = this.bigramStats.visits(this.prevHash\x2C m);\n            const v = bigramVisits > 0\n                ? this.bigramStats.mean(this.prevHash\x2C m) / this.temperature\n                : this.stats.mean(m) / this.temperature;\n            vals[i] = v;\n            if (v > maxVal)\n                maxVal = v;\n        }\n        let total = 0;\n        for (let i = 0; i < vals.length; i += 1) {\n            const e = Math.exp(vals[i] - maxVal);\n            vals[i] = e;\n            total += e;\n        }\n        if (total <= 0 || !Number.isFinite(total)) {\n            const pick = moves[rng.nextInt(moves.length)];\n            this.prevHash = pick.hash();\n            return pick;\n        }\n        let r = rng.nextFloat() * total;\n        for (let i = 0; i < vals.length; i += 1) {\n            r -= vals[i];\n            if (r <= 0) {\n                const pick = moves[i];\n                this.prevHash = pick.hash();\n                return pick;\n            }\n        }\n        const fallback = moves[moves.length - 1];\n        this.prevHash = fallback.hash();\n        return fallback;\n    }\n}\n//# sourceMappingURL=nst-playout.js.map
