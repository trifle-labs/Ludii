script-source,237,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/step.js,// @java Core/src/game/util/graph/Step.java Step\n// @java Core/src/game/util/graph/Steps.java Steps\n//\n// A Step is a single hop from one graph element to an adjacent one\x2C tagged with\n// the set of AbsoluteDirections it agrees with (its `directions` BitSet). Steps\n// is the per-element collection\x2C indexed three ways exactly like Java:\n// flat\x2C by toType\x2C by direction\x2C and by (toType\x2C direction).\nimport { NUM_DIRECTIONS\x2C } from "./absolute-direction.js";\nimport { NUM_SITE_TYPES } from "./graph-element.js";\n/** @java Core/src/game/util/graph/Step.java Step */\nexport class Step {\n    from;\n    to;\n    /** AbsoluteDirection ordinals this step agrees with \u2014 @java Step.directions (BitSet). */\n    directions = new Set();\n    constructor(from\x2C to) {\n        this.from = from;\n        this.to = to;\n    }\n    /** @java Step.matches(Step): same endpoints AND identical direction set. */\n    matches(other) {\n        if (!matchesElement(this.from\x2C other.from))\n            return false;\n        if (!matchesElement(this.to\x2C other.to))\n            return false;\n        if (this.directions.size !== other.directions.size)\n            return false;\n        for (const d of this.directions)\n            if (!other.directions.has(d))\n                return false;\n        return true;\n    }\n}\n/** @java GraphElement.matches(GraphElement): same siteType and id. */\nexport function matchesElement(a\x2C b) {\n    return a.siteType === b.siteType && a.id === b.id;\n}\n/** @java Core/src/game/util/graph/Steps.java Steps */\nexport class Steps {\n    siteType;\n    id;\n    steps = [];\n    inDirectionLists;\n    toSiteTypeLists;\n    toSiteTypeInDirectionLists;\n    totalDirections = new Set();\n    constructor(siteType\x2C id) {\n        this.siteType = siteType;\n        this.id = id;\n        this.toSiteTypeLists = Array.from({ length: NUM_SITE_TYPES }\x2C () => []);\n        this.inDirectionLists = Array.from({ length: NUM_DIRECTIONS }\x2C () => []);\n        this.toSiteTypeInDirectionLists = Array.from({ length: NUM_SITE_TYPES }\x2C () => Array.from({ length: NUM_DIRECTIONS }\x2C () => []));\n    }\n    toSiteType(toType) {\n        return this.toSiteTypeLists[toType];\n    }\n    inDirection(dirn) {\n        return this.inDirectionLists[dirn];\n    }\n    toSiteTypeInDirection(toType\x2C dirn) {\n        return this.toSiteTypeInDirectionLists[toType][dirn];\n    }\n    clearInDirection(dirn) {\n        this.inDirectionLists[dirn].length = 0;\n    }\n    addInDirection(dirn\x2C step) {\n        this.inDirectionLists[dirn].push(step);\n    }\n    /** @java Steps.addToSiteTypeInDirection \u2014 dedup by Step.matches. */\n    addToSiteTypeInDirection(toType\x2C dirn\x2C step) {\n        const list = this.toSiteTypeInDirection(toType\x2C dirn);\n        for (const existing of list)\n            if (step.matches(existing))\n                return;\n        list.push(step);\n    }\n    /**\n     * @java Steps.add(Step): dedup by (from\x2Cto); on a duplicate\x2C OR in any new\n     * direction bits. On a fresh step\x2C index it by toType and by each set bit.\n     */\n    add(step) {\n        for (const existing of this.steps) {\n            if (matchesElement(existing.from\x2C step.from) &&\n                matchesElement(existing.to\x2C step.to)) {\n                for (const d of step.directions)\n                    existing.directions.add(d);\n                return;\n            }\n        }\n        this.steps.push(step);\n        const toId = step.to.siteType;\n        this.toSiteTypeLists[toId].push(step);\n        for (const d of step.directions) {\n            this.inDirectionLists[d].push(step);\n            this.toSiteTypeInDirectionLists[toId][d]?.push(step);\n            this.totalDirections.add(d);\n        }\n    }\n}\n//# sourceMappingURL=step.js.map
