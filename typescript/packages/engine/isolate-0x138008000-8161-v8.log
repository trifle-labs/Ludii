script-source,198,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/decision-tree-trainer.js,/**\n * Java parity: AI/src/decision_trees/logits/LogitTreeLearner.java and\n * AI/src/decision_trees/classifiers/DecisionTreeLearner.java.\n *\n * A self-contained CART-style regressor: take labelled (features \u2192 value)\n * samples\x2C exhaustively search axis-aligned splits\x2C and grow a binary\n * tree until a stop criterion fires (max depth\x2C min samples per node\x2C or\n * insufficient variance reduction).\n */\nimport { DecisionTree\x2C } from "./decision-tree.js";\nfunction meanOf(samples) {\n    if (samples.length === 0)\n        return 0;\n    let total = 0;\n    for (const s of samples)\n        total += s.label;\n    return total / samples.length;\n}\nfunction ssOf(samples) {\n    if (samples.length === 0)\n        return 0;\n    const mu = meanOf(samples);\n    let sumSq = 0;\n    for (const s of samples) {\n        const d = s.label - mu;\n        sumSq += d * d;\n    }\n    return sumSq;\n}\nfunction bestSplit(samples) {\n    const numFeatures = samples[0]?.features.length ?? 0;\n    if (numFeatures === 0 || samples.length < 2)\n        return undefined;\n    const parentSS = ssOf(samples);\n    let best;\n    for (let f = 0; f < numFeatures; f += 1) {\n        const values = new Set();\n        for (const s of samples)\n            values.add(s.features[f] ?? 0);\n        const sorted = [...values].sort((a\x2C b) => a - b);\n        for (let i = 0; i < sorted.length - 1; i += 1) {\n            const a = sorted[i];\n            const b = sorted[i + 1];\n            if (a === undefined || b === undefined)\n                continue;\n            const threshold = (a + b) / 2;\n            const left = [];\n            const right = [];\n            for (const s of samples) {\n                if ((s.features[f] ?? 0) <= threshold)\n                    left.push(s);\n                else\n                    right.push(s);\n            }\n            if (left.length === 0 || right.length === 0)\n                continue;\n            const decrease = parentSS - (ssOf(left) + ssOf(right));\n            if (!best || decrease > best.impurityDecrease) {\n                best = {\n                    featureIndex: f\x2C\n                    threshold\x2C\n                    left\x2C\n                    right\x2C\n                    impurityDecrease: decrease\x2C\n                };\n            }\n        }\n    }\n    return best;\n}\nexport class DecisionTreeTrainer {\n    maxDepth;\n    minSamplesPerLeaf;\n    minImpurityDecrease;\n    constructor(options = {}) {\n        this.maxDepth = options.maxDepth ?? 6;\n        this.minSamplesPerLeaf = options.minSamplesPerLeaf ?? 1;\n        this.minImpurityDecrease = options.minImpurityDecrease ?? 1e-6;\n    }\n    train(samples) {\n        const root = this.build(samples\x2C 0);\n        return new DecisionTree(root);\n    }\n    build(samples\x2C depth) {\n        const leafValue = meanOf(samples);\n        if (depth >= this.maxDepth ||\n            samples.length <= this.minSamplesPerLeaf * 2) {\n            return this.leaf(leafValue);\n        }\n        const split = bestSplit(samples);\n        if (!split ||\n            split.impurityDecrease < this.minImpurityDecrease ||\n            split.left.length < this.minSamplesPerLeaf ||\n            split.right.length < this.minSamplesPerLeaf) {\n            return this.leaf(leafValue);\n        }\n        const internal = {\n            kind: "internal"\x2C\n            featureIndex: split.featureIndex\x2C\n            threshold: split.threshold\x2C\n            left: this.build(split.left\x2C depth + 1)\x2C\n            right: this.build(split.right\x2C depth + 1)\x2C\n        };\n        return internal;\n    }\n    leaf(value) {\n        return { kind: "leaf"\x2C value };\n    }\n}\n//# sourceMappingURL=decision-tree-trainer.js.map
