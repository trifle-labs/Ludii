script-source,228,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/graph.js,/**\n * Planar graph board model \u2014 Java parity with\n * Core/src/game/util/graph/Graph.java (+ Vertex / Edge / Face).\n *\n * A Ludii board is a planar graph: vertices carry 2-D positions\x2C edges join\n * vertices\x2C and faces are the minimal bounded cycles of the planar embedding.\n * Games play either on the faces (`use:Cell`\x2C the default) or on the vertices\n * (`use:Vertex`\x2C e.g. Go / shibumi-style boards). Direction adjacency is\n * derived geometrically from the embedding (see trajectories.ts)\x2C so unlike\n * the legacy lattice model this representation supports arbitrary tilings and\n * the board-algebra operators (merge / add / dual / \u2026).\n *\n * This module is the data layer only: construction\x2C deduplicating\n * vertex/edge insertion\x2C and planar face detection. Generators and operators\n * build on top of it.\n */\n/** Coincidence tolerance for treating two vertex positions as the same. */\nexport const VERTEX_TOL = 0.01;\nconst hypot = (dx\x2C dy) => Math.sqrt(dx * dx + dy * dy);\n/**\n * A mutable planar graph. Build it with `addVertex` / `addEdge`\x2C then call\n * `makeFaces()` to populate the bounded faces. All accessors return frozen\n * snapshots so downstream board code can hold them safely.\n */\nexport class Graph {\n    vlist = [];\n    elist = [];\n    flist = [];\n    /** Undirected edge-key \u2192 edge id\x2C for dedup. */\n    edgeKey = new Map();\n    get vertices() {\n        return this.vlist;\n    }\n    get edges() {\n        return this.elist;\n    }\n    get faces() {\n        return this.flist;\n    }\n    /** Find an existing vertex within `tol` of (x\x2C y)\x2C else add a new one. */\n    addVertex(x\x2C y\x2C tol = VERTEX_TOL) {\n        for (const v of this.vlist) {\n            if (hypot(v.x - x\x2C v.y - y) <= tol)\n                return v.id;\n        }\n        const id = this.vlist.length;\n        this.vlist.push({ id\x2C x\x2C y });\n        return id;\n    }\n    /** Add an undirected edge between two vertex ids (deduplicated). */\n    addEdge(a\x2C b) {\n        if (a === b)\n            return -1;\n        const key = a < b ? `${a}:${b}` : `${b}:${a}`;\n        const existing = this.edgeKey.get(key);\n        if (existing !== undefined)\n            return existing;\n        const id = this.elist.length;\n        this.elist.push({ id\x2C a\x2C b });\n        this.edgeKey.set(key\x2C id);\n        return id;\n    }\n    hasEdge(a\x2C b) {\n        const key = a < b ? `${a}:${b}` : `${b}:${a}`;\n        return this.edgeKey.has(key);\n    }\n    /** Mean edge length\x2C used by operators that auto-connect nearby vertices. */\n    averageEdgeLength() {\n        if (this.elist.length === 0)\n            return 0;\n        let total = 0;\n        for (const e of this.elist) {\n            const va = this.vlist[e.a];\n            const vb = this.vlist[e.b];\n            if (va && vb)\n                total += hypot(va.x - vb.x\x2C va.y - vb.y);\n        }\n        return total / this.elist.length;\n    }\n    /**\n     * Detect the bounded faces of the planar embedding and store them. Uses the\n     * standard half-edge traversal: at each vertex incident edges are sorted by\n     * angle; arriving along (u\u2192v) the next half-edge is the one immediately\n     * clockwise from (v\u2192u). Every directed half-edge belongs to exactly one\n     * cycle; the single unbounded (outer) cycle \u2014 the one whose signed area is\n     * the most negative \u2014 is discarded.\n     */\n    makeFaces() {\n        this.flist = [];\n        if (this.elist.length === 0)\n            return;\n        // Sorted adjacency: for each vertex\x2C neighbour ids ordered by edge angle.\n        const adj = this.vlist.map(() => []);\n        for (const e of this.elist) {\n            const va = this.vlist[e.a];\n            const vb = this.vlist[e.b];\n            if (!va || !vb)\n                continue;\n            adj[e.a]?.push({ to: e.b\x2C angle: Math.atan2(vb.y - va.y\x2C vb.x - va.x) });\n            adj[e.b]?.push({ to: e.a\x2C angle: Math.atan2(va.y - vb.y\x2C va.x - vb.x) });\n        }\n        for (const list of adj)\n            list.sort((p\x2C q) => p.angle - q.angle);\n        // index of neighbour `to` within vertex `v`'s sorted adjacency.\n        const indexOf = (v\x2C to) => {\n            const list = adj[v];\n            if (!list)\n                return -1;\n            for (let i = 0; i < list.length; i += 1) {\n                if (list[i]?.to === to)\n                    return i;\n            }\n            return -1;\n        };\n        const visited = new Set(); // directed half-edge "u>v"\n        const cycles = [];\n        for (const e of this.elist) {\n            for (const [u0\x2C v0] of [\n                [e.a\x2C e.b]\x2C\n                [e.b\x2C e.a]\x2C\n            ]) {\n                if (visited.has(`${u0}>${v0}`))\n                    continue;\n                const cycle = [];\n                let u = u0;\n                let v = v0;\n                let guard = 0;\n                const limit = this.elist.length * 2 + 4;\n                while (guard < limit) {\n                    guard += 1;\n                    visited.add(`${u}>${v}`);\n                    cycle.push(u);\n                    // Next half-edge: clockwise neighbour of u as seen from v.\n                    const list = adj[v];\n                    if (!list || list.length === 0)\n                        break;\n                    const i = indexOf(v\x2C u);\n                    if (i < 0)\n                        break;\n                    const next = list[(i - 1 + list.length) % list.length];\n                    if (!next)\n                        break;\n                    u = v;\n                    v = next.to;\n                    if (u === u0 && v === v0)\n                        break;\n                }\n                if (cycle.length >= 3)\n                    cycles.push(cycle);\n            }\n        }\n        // Signed area (shoelace); the outer face is the most-negative one.\n        const signedArea = (cyc) => {\n            let s = 0;\n            for (let i = 0; i < cyc.length; i += 1) {\n                const p = this.vlist[cyc[i]];\n                const q = this.vlist[cyc[(i + 1) % cyc.length]];\n                if (p && q)\n                    s += p.x * q.y - q.x * p.y;\n            }\n            return s / 2;\n        };\n        let outerIdx = -1;\n        let outerArea = 0;\n        const areas = cycles.map((c\x2C i) => {\n            const ar = signedArea(c);\n            if (ar < outerArea) {\n                outerArea = ar;\n                outerIdx = i;\n            }\n            return ar;\n        });\n        const seen = new Set();\n        for (let i = 0; i < cycles.length; i += 1) {\n            if (i === outerIdx)\n                continue;\n            const cyc = cycles[i];\n            if (areas[i] <= 0)\n                continue; // keep CCW bounded faces only\n            const key = [...cyc].sort((a\x2C b) => a - b).join("\x2C");\n            if (seen.has(key))\n                continue;\n            seen.add(key);\n            let cx = 0;\n            let cy = 0;\n            for (const vid of cyc) {\n                const vtx = this.vlist[vid];\n                if (vtx) {\n                    cx += vtx.x;\n                    cy += vtx.y;\n                }\n            }\n            this.flist.push({\n                id: this.flist.length\x2C\n                vertices: cyc\x2C\n                cx: cx / cyc.length\x2C\n                cy: cy / cyc.length\x2C\n            });\n        }\n    }\n    /**\n     * Reorder vertices (and remap edges) bottom-to-top\x2C left-to-right \u2014 Java's\n     * `Graph.reorder()` sort key `y * K + x`. Faces are re-derived afterwards by\n     * the caller if needed; here we only renumber vertices and edges.\n     */\n    reorder() {\n        const order = [...this.vlist].sort((p\x2C q) => p.y !== q.y ? p.y - q.y : p.x - q.x);\n        const remap = new Array(this.vlist.length);\n        order.forEach((v\x2C i) => {\n            remap[v.id] = i;\n        });\n        this.vlist = order.map((v\x2C i) => ({ id: i\x2C x: v.x\x2C y: v.y }));\n        this.elist = this.elist.map((e\x2C i) => ({\n            id: i\x2C\n            a: remap[e.a]\x2C\n            b: remap[e.b]\x2C\n        }));\n        this.edgeKey.clear();\n        for (const e of this.elist) {\n            const key = e.a < e.b ? `${e.a}:${e.b}` : `${e.b}:${e.a}`;\n            this.edgeKey.set(key\x2C e.id);\n        }\n    }\n}\n//# sourceMappingURL=graph.js.map
