o\x2C what })]\x2C\n                    }));\n                }\n            }\n            return out;\n        }\x2C\n    };\n}\n/** Default `(to)` landing rule for a hop: land on an empty cell. */\nconst HOP_DEFAULT_TO = {\n    eval: (ctx) => {\n        const s = ctx.frame.to ?? OFF;\n        return s >= 0 && s < ctx.state.cells.length && (ctx.state.cells[s] ?? 0) === 0;\n    }\x2C\n};\n/** Default `(between)` rule for a hop: jump over an occupied cell. */\nconst HOP_DEFAULT_BETWEEN = {\n    eval: (ctx) => {\n        const s = ctx.frame.between ?? OFF;\n        return s >= 0 && s < ctx.state.cells.length && (ctx.state.cells[s] ?? 0) !== 0;\n    }\x2C\n};\n/**\n * The site continuing the straight line `from \u2192 between` one more step\x2C using\n * the board's topology rather than raw geometry. On a graph board the drawn\n * lines are not the lattice grid (an alquerque "Orthogonal" line runs along a\n * bounding-box diagonal\x2C and triangle-appendage sites sit a unit away but are\n * *not* a straight continuation)\x2C so a hop's landing must follow the actual\n * radial: it is the neighbour of `between` (other than `from`) whose direction\n * stays within Ludii's 0.25-rad straightness bend (Trajectories.followRadial).\n * Returns OFF when no near-collinear continuation exists.\n */\nfunction radialNext(board\x2C from\x2C between\x2C dx\x2C dy) {\n    const traj = board.traj;\n    if (!traj)\n        return OFF;\n    const bx = board.xOf(between);\n    const by = board.yOf(between);\n    const inLen = Math.hypot(dx\x2C dy) || 1;\n    const minCos = Math.cos(0.25);\n    let best = OFF;\n    let bestCos = -2;\n    for (const t of traj.group(between\x2C "Adjacent")) {\n        if (t === from)\n            continue;\n        const tx = board.xOf(t) - bx;\n        const ty = board.yOf(t) - by;\n        const tl = Math.hypot(tx\x2C ty) || 1;\n        const cos = (tx * dx + ty * dy) / (tl * inLen);\n        if (cos > bestCos) {\n            bestCos = cos;\n            best = t;\n        }\n    }\n    return bestCos >= minCos ? best : OFF;\n}\n/**\n * `(move Hop <from?> <dir?> (between if:<over> (apply <effect>)) (to if:<land>))`.\n * A distance-1 jump: over the adjacent `between` cell onto the `to` cell two\n * steps along each direction. Emits a relocating move when both guards hold\x2C\n * carrying the `between` clause's effect \u2014 typically `(remove (between))`\x2C\n * which captures the *jumped* piece. That removal targets the between cell\x2C\n * not the landing\x2C so (unlike Step/Slide capture) it is never subsumed.\n * Defaults reproduce a checkers leap: hop over an occupied cell to an empty\n * one. Long-range hops (`(between (range \u2026))`) are not yet modelled.\n */\nfunction compileHop(node\x2C env\x2C startIndex = 2) {\n    const after = node.items.slice(startIndex);\n    const toNode = after.find((n) => isList(n) && listHead(n) === "to");\n    const betweenNode = after.find((n) => isList(n) && listHead(n) === "between");\n    // An explicit `(from <int>)` clause (e.g. `(from (last To))` in the\n    // hop-again sequence) seeds the start site; otherwise the move iterates from\n    // `ctx.frame.from` (set by an enclosing `(forEach Piece \u2026)`).\n    const fromNode = after.find((n) => isList(n) && listHead(n) === "from");\n    const fromInner = fromNode?.items[1];\n    const fromFn = fromInner ? compileInt(fromInner\x2C env) : undefined;\n    const dirNode = after.find((n) => n !== toNode &&\n        n !== betweenNode &&\n        n !== fromNode &&\n        isDirectionArg(n));\n    const resolveDirs = compileDirsResolver(dirNode);\n    let toCond = HOP_DEFAULT_TO;\n    if (toNode) {\n        const ifNode = parseArgs(toNode.items.slice(1)).named.get("if");\n        if (ifNode)\n            toCond = compileBool(ifNode\x2C env);\n    }\n    let betweenCond = HOP_DEFAULT_BETWEEN;\n    let betweenEffect;\n    if (betweenNode) {\n        const { positional\x2C named } = parseArgs(betweenNode.items.slice(1));\n        const ifNode = named.get("if");\n        if (ifNode)\n            betweenCond = compileBool(ifNode\x2C env);\n        const applyNode = positional.find((n) => isList(n) && listHead(n) === "apply");\n        if (applyNode)\n            betweenEffect = compileApply(applyNode\x2C env);\n    }\n    return {\n        generate: (ctx) => {\n            const from = fromFn ? fromFn.eval(ctx) : ctx.frame.from;\n            if (from === undefined || from < 0)\n                return [];\n            const board = ctx.board;\n            const x0 = board.xOf(from);\n            const y0 = board.yOf(from);\n            const dirs = resolveDirs(ctx\x2C from);\n            const mover = ctx.mover;\n            const out = [];\n            for (const d of dirs) {\n                const between = board.siteAt(x0 + d.dx\x2C y0 + d.dy);\n                if (between === OFF)\n                    continue;\n                // The landing is two steps along the line. On a lattice that is a plain\n                // offset; on a graph board it must follow the topology's radial so a\n                // hop never crosses to a geometrically-collinear but non-connected site.\n                const to = board.traj\n                    ? radialNext(board\x2C from\x2C between\x2C d.dx\x2C d.dy)\n                    : board.siteAt(x0 + d.dx * 2\x2C y0 + d.dy * 2);\n                if (to === OFF)\n                    continue;\n                const sub = ctx.withFrame({ from\x2C between\x2C to });\n                if (!betweenCond.eval(sub) || !toCond.eval(sub))\n                    continue;\n                const actions = [new ActionMove({ from\x2C to })];\n                if (betweenEffect)\n                    actions.push(...betweenEffect(sub));\n                out.push(new Move({\n                    id: `hop:${from}:${to}:${mover}`\x2C\n                    label: `Hop ${from}\u2192${to}`\x2C\n                    siteIndices: [to]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                    actions\x2C\n                }));\n            }\n            return out;\n        }\x2C\n    };\n}\nfunction compileMoveLudeme(node\x2C env) {\n    const inner = compileMoveLudemeInner(node\x2C env);\n    // A `(move \u2026 (then <effect>))` block runs side effects after the move and\n    // may keep the turn (`moveAgain`). Compile it and fold it into each move.\n    const thenNode = node.items.find((n) => isList(n) && listHead(n) === "then");\n    if (!thenNode)\n        return inner;\n    const { moveAgain\x2C effect } = compileThen(thenNode\x2C env);\n    return {\n        generate: (ctx) => inner.generate(ctx).map((m) => {\n            // Bind the move's own from/to so a `(then \u2026)` effect (notably `(sow)`)\n            // reads the just-selected site through `(from)` / `(to)`\x2C and record the\n            // move in a throwaway trial so `(last To)` / `(last From)` resolve to it\n            // (Java runs the consequence after the move\x2C when it is the last move).\n            // The state stays pre-move so pickup-driven effects like sow are intact.\n            const ectx = ctx\n                .withContext(ctx.context.withTrial(ctx.context.trial.withMove(m\x2C false\x2C -1)))\n                .withFrame({ from: m.from()\x2C to: m.to() });\n            const extra = effect ? effect(ectx) : [];\n            return extra.length > 0 || moveAgain\n                ? m.withConsequence(extra\x2C moveAgain)\n                : m;\n        })\x2C\n    };\n}\n/**\n * Compile a `(then <effect>\u2026)` block. Returns whether the turn repeats\n * (`moveAgain`) and an optional effect producing the extra actions to append\n * after the move's own actions. Supported effects: `moveAgain`\x2C `set Score`\x2C\n * `addScore`\x2C `set Var`\x2C and `remove`.\n */\n/** True for a bare `moveAgain` ident or a `(moveAgain)` list. */\nfunction isMoveAgainNode(node) {\n    if (!node)\n        return false;\n    if (isIdent(node))\n        return node.name === "moveAgain";\n    return isList(node) && listHead(node) === "moveAgain";\n}\n/**\n * The evaluation context *after* the move currently being folded as a `(then \u2026)`\n * consequence. The generation sites record that move as the trial's last entry\x2C\n * so re-applying it to the current state yields the post-move position \u2014 what\n * Java sees when it evaluates `then` consequents (which run after the move's own\n * actions). Falls back to `ctx` unchanged when no move is recorded.\n */\nfunction postMoveContext(ctx) {\n    const last = ctx.context.trial.lastMove();\n    if (!last)\n        return ctx;\n    return ctx.withContext(ctx.context.withState(last.applyTo(ctx.context.state)));\n}\nfunction compileThen(node\x2C env) {\n    let moveAgain = false;\n    const effects = [];\n    const visit = (item) => {\n        if (isIdent(item) && item.name === "moveAgain") {\n            moveAgain = true;\n            return;\n        }\n        if (!isList(item))\n            return;\n        if (item.delimiter === "curly") {\n            for (const inner of item.items)\n                visit(inner);\n            return;\n        }\n        const head = listHead(item);\n        if (head === "moveAgain") {\n            moveAgain = true;\n            return;\n        }\n        const fn = compileEffectAction(item\x2C env);\n        if (fn)\n            effects.push(fn);\n    };\n    for (const item of node.items.slice(1))\n        visit(item);\n    if (effects.length === 0)\n        return { moveAgain };\n    return {\n        moveAgain\x2C\n        effect: (ctx) => effects.flatMap((fn) => fn(ctx))\x2C\n    };\n}\n/** Compile a single post-move effect ludeme into an action producer. */\nfunction compileEffectAction(node\x2C env) {\n    const head = listHead(node);\n    if (head === "moveAgain") {\n        // As an effect (e.g. inside `(if \u2026 (moveAgain))`): schedule the current\n        // mover to play again by overriding the next player. Java: MoveAgain emits\n        // ActionSetNextPlayer(mover).\n        return (ctx) => [new ActionSetNextPlayer(ctx.mover)];\n    }\n    if (head === "and") {\n        // `(and <eff>\u2026)` / `(and { <eff>\u2026 })` \u2014 run several effects in sequence.\n        // Curly-list arguments are flattened; an unsupported member is dropped\n        // (matching the prior silent-skip of unknown then-effects) rather than\n        // failing the whole compile.\n        const subs = effectChildren(node.items.slice(1))\n            .map((n) => {\n            try {\n                return compileEffectAction(n\x2C env);\n            }\n            catch {\n                return undefined;\n            }\n        })\n            .filter((f) => f !== undefined);\n        if (subs.length === 0)\n            return undefined;\n        return (ctx) => subs.flatMap((f) => f(ctx));\n    }\n    if (head === "if") {\n        // `(if <cond> <then> [<else>])` \u2014 guard an effect on a board predicate.\n        // If the condition or branches use forms we can't compile yet\x2C drop the\n        // effect (prior behaviour) instead of failing the whole game's compile.\n        const condNode = node.items[1];\n        const thenNode = node.items[2];\n        const elseNode = node.items[3];\n        if (!condNode || !thenNode)\n            return undefined;\n        // A conditional `(moveAgain)` (e.g. `(if ("HandOccupied" Mover)\n        // (moveAgain))`) must be decided on the *post-move* state: Java applies\n        // `then` consequents after the move's own actions\x2C so a placement that\n        // empties the hand stops repeating. The generation sites record the move\n        // as the trial's last entry\x2C so re-apply it to obtain that state before\n        // testing the guard.\n        if (isMoveAgainNode(thenNode) && !elseNode) {\n            let cond;\n            try {\n                cond = compileBool(condNode\x2C env);\n            }\n            catch {\n                return undefined;\n            }\n            return (ctx) => cond.eval(postMoveContext(ctx)) ? [new ActionSetNextPlayer(ctx.mover)] : [];\n        }\n        if (!isList(thenNode))\n            return undefined;\n        try {\n            const cond = compileBool(condNode\x2C env);\n            const thenEff = compileEffectAction(thenNode\x2C env);\n            const elseEff = elseNode && isList(elseNode)\n                ? compileEffectAction(elseNode\x2C env)\n                : undefined;\n            if (!thenEff && !elseEff)\n                return undefined;\n            return (ctx) => {\n                if (cond.eval(ctx))\n                    return thenEff ? thenEff(ctx) : [];\n                return elseEff ? elseEff(ctx) : [];\n            };\n        }\n        catch {\n            return undefined;\n        }\n    }\n    if (head === "sow") {\n        return compileSow(node\x2C env);\n    }\n    if (head === "fromTo") {\n        return compileFromToEffect(node\x2C env);\n    }\n    if (head === "remove") {\n        const siteNode = node.items[1];\n        if (!siteNode)\n            return undefined;\n        const site = compileInt(siteNode\x2C env);\n        return (ctx) => {\n            const s = site.eval(ctx);\n            return s >= 0 ? [new ActionRemove({ to: s })] : [];\n        };\n    }\n    if (head === "promote") {\n        // `(promote <site> <piece-spec> [player])` \u2014 replace the piece's type at\n        // <site>. Piece type isn't modelled\x2C so this preserves the current owner\n        // (board-neutral) rather than swapping in a concrete piece value.\n        const siteNode = node.items[1];\n        if (!siteNode)\n            return undefined;\n        const site = compileInt(siteNode\x2C env);\n        return (ctx) => {\n            const s = site.eval(ctx);\n            if (s < 0)\n                return [];\n            const owner = ctx.state.cells[s] ?? ctx.mover;\n            return owner > 0 ? [new ActionPromote(s\x2C owner)] : [];\n        };\n    }\n    if (head === "addScore") {\n        const who = node.items[1];\n        const value = node.items[2];\n        if (!who || !value)\n            return undefined;\n        const pid = compileInt(who\x2C env);\n        const amount = compileInt(value\x2C env);\n        return (ctx) => [\n            new ActionSetScore({\n                player: pid.eval(ctx)\x2C\n                score: amount.eval(ctx)\x2C\n                add: true\x2C\n            })\x2C\n        ];\n    }\n    if (head === "remember" || head === "forget") {\n        // `(remember Value <name>? <int> [unique:True])` appends a value to the\n        // named remembered list; `(forget Value <name>? <int>)` removes it. The\n        // empty-string key is the unnamed (Java: rememberingValues) list.\n        const sub = node.items[1];\n        if (!sub || !isIdent(sub) || sub.name !== "Value")\n            return undefined;\n        const { positional } = parseArgs(node.items.slice(2));\n        let idx = 0;\n        let name = "";\n        if (positional[idx] && isString(positional[idx])) {\n            name = positional[idx].value;\n            idx += 1;\n        }\n        const valNode = positional[idx];\n        if (!valNode)\n            return undefined;\n        const valFn = compileInt(valNode\x2C env);\n        if (head === "remember") {\n            return (ctx) => [new ActionRememberValue(name\x2C valFn.eval(ctx))];\n        }\n        return (ctx) => [new ActionForgetValue(name\x2C valFn.eval(ctx))];\n    }\n    if (head === "set") {\n        const sub = node.items[1];\n        const subName = sub && isIdent(sub) ? sub.name : "";\n        if (subName === "Score") {\n            const who = node.items[2];\n            const value = node.items[3];\n            if (!who || !value)\n                return undefined;\n            const pid = compileInt(who\x2C env);\n            const amount = compileInt(value\x2C env);\n            return (ctx) => [\n                new ActionSetScore({ player: pid.eval(ctx)\x2C score: amount.eval(ctx) })\x2C\n            ];\n        }\n        if (subName === "Var") {\n            // (set Var ["name"] <int>) \u2014 the name is optional; without it the value\n            // sits in items[2] and targets the default unnamed var.\n            const nameNode = node.items[2];\n            const named = nameNode && (isString(nameNode) || isIdent(nameNode));\n            const varName = named\n                ? isString(nameNode)\n                    ? nameNode.value\n                    : nameNode.name\n                : "";\n            const valueNode = named ? node.items[3] : nameNode;\n            if (!valueNode)\n                return undefined;\n            const amount = compileInt(valueNode\x2C env);\n            return (ctx) => [new ActionSetVar(varName\x2C amount.eval(ctx))];\n        }\n        if (subName === "Pending") {\n            // `(set Pending)` marks the state pending (sentinel 1) so the next turn's\n            // `(is Pending)` is true; `(set Pending <site>)` marks a specific site.\n            const arg = node.items[2];\n            const siteFn = arg ? compileInt(arg\x2C env) : undefined;\n            return (ctx) => [\n                new ActionSetPending(siteFn ? siteFn.eval(ctx) : 1)\x2C\n            ];\n        }\n        if (subName === "Count") {\n            // (set Count <n> [at:<site>] [to:<region>]) \u2014 the count at one site or\n            // every site of a region (Java overwrites the per-site count layer).\n            const { positional\x2C named } = parseArgs(node.items.slice(2));\n            const countFn = positional[0] ? compileInt(positional[0]\x2C env) : undefined;\n            const atNode = named.get("at");\n            const toNode = named.get("to");\n            const atFn = atNode ? compileInt(atNode\x2C env) : undefined;\n            const toReg = toNode ? compileRegion(toNode\x2C env) : undefined;\n            return (ctx) => {\n                const c = countFn ? countFn.eval(ctx) : 1;\n                if (atFn) {\n                    const s = atFn.eval(ctx);\n                    return s >= 0 ? [new ActionSetCount({ to: s\x2C count: c })] : [];\n                }\n                if (toReg) {\n                    return toReg\n                        .eval(ctx)\n                        .filter((s) => s >= 0)\n                        .map((s) => new ActionSetCount({ to: s\x2C count: c }));\n                }\n                return [];\n            };\n        }\n        if (subName === "Counter") {\n            const arg = node.items[2];\n            const valFn = arg ? compileInt(arg\x2C env) : undefined;\n            return (ctx) => [\n                new ActionSetCounter(valFn ? valFn.eval(ctx) : ctx.state.counter)\x2C\n            ];\n        }\n        if (subName === "State") {\n            // (set State [at:<site>] <state> [<level>]) \u2014 per-site state layer.\n            const { positional\x2C named } = parseArgs(node.items.slice(2));\n            const valFn = positional[0] ? compileInt(positional[0]\x2C env) : undefined;\n            const atNode = named.get("at");\n            const atFn = atNode ? compileInt(atNode\x2C env) : undefined;\n            return (ctx) => {\n                const s = atFn ? atFn.eval(ctx) : (ctx.frame.to ?? 0);\n                if (s < 0)\n                    return [];\n                return [new ActionSetState({ to: s\x2C state: valFn ? valFn.eval(ctx) : 0 })];\n            };\n        }\n        if (subName === "Value") {\n            // Two grammars: (set Value at:<site> <n>) \u2192 per-site value layer\x2C and\n            // (set Value <player> <n>) \u2192 per-player value.\n            const { positional\x2C named } = parseArgs(node.items.slice(2));\n            const atNode = named.get("at");\n            if (atNode) {\n                const atFn = compileInt(atNode\x2C env);\n                const valFn = positional[0] ? compileInt(positional[0]\x2C env) : undefined;\n                return (ctx) => {\n                    const s = atFn.eval(ctx);\n                    return s >= 0\n                        ? [new ActionSetValue({ to: s\x2C value: valFn ? valFn.eval(ctx) : 0 })]\n                        : [];\n                };\n            }\n            const pidFn = positional[0] ? compileInt(positional[0]\x2C env) : undefined;\n            const valFn = positional[1] ? compileInt(positional[1]\x2C env) : undefined;\n            return (ctx) => [\n                new ActionSetValueOfPlayer(pidFn ? pidFn.eval(ctx) : ctx.mover\x2C valFn ? valFn.eval(ctx) : 0)\x2C\n            ];\n        }\n        if (subName === "NextPlayer") {\n            // (set NextPlayer (player <n>)) \u2014 force the next mover.\n            const arg = node.items[2];\n            const fn = arg ? compileInt(arg\x2C env) : undefined;\n            return (ctx) => [new ActionSetNextPlayer(fn ? fn.eval(ctx) : ctx.mover)];\n        }\n        if (subName === "Rotation") {\n            const { positional\x2C named } = parseArgs(node.items.slice(2));\n            const valFn = positional[0] ? compileInt(positional[0]\x2C env) : undefined;\n            const atNode = named.get("at");\n            const atFn = atNode ? compileInt(atNode\x2C env) : undefined;\n            return (ctx) => {\n                const s = atFn ? atFn.eval(ctx) : (ctx.frame.to ?? 0);\n                if (s < 0)\n                    return [];\n                return [\n                    new ActionSetRotation({\n                        to: s\x2C\n                        rotation: valFn ? valFn.eval(ctx) : 0\x2C\n                    })\x2C\n                ];\n            };\n        }\n        if (subName === "TrumpSuit") {\n            const arg = node.items[2];\n            const valFn = arg ? compileInt(arg\x2C env) : undefined;\n            return (ctx) => [new ActionSetTrumpSuit(valFn ? valFn.eval(ctx) : 0)];\n        }\n        if (subName === "RememberValue") {\n            // (set RememberValue "Name" <int|region>) \u2014 append value(s) to a named\n            // remembered list. A region argument remembers each of its sites.\n            const nameNode = node.items[2];\n            const name = nameNode && isString(nameNode)\n                ? nameNode.value\n                : nameNode && isIdent(nameNode)\n                    ? nameNode.name\n                    : "";\n            const valNode = node.items[3];\n            if (valNode && isList(valNode)) {\n                let reg;\n                try {\n                    reg = compileRegion(valNode\x2C env);\n                }\n                catch {\n                    reg = undefined;\n                }\n                if (reg) {\n                    return (ctx) => reg\n                        .eval(ctx)\n                        .filter((s) => s >= 0)\n                        .map((s) => new ActionRememberValue(name\x2C s));\n                }\n            }\n            const valFn = valNode ? compileInt(valNode\x2C env) : undefined;\n            return (ctx) => [new ActionRememberValue(name\x2C valFn ? valFn.eval(ctx) : 0)];\n        }\n        // Hidden-information\x2C team\x2C and pot bookkeeping have no public-state\n        // backing in this port yet; accept the syntax as a no-op so the rest of\n        // the game still compiles.\n        if (subName === "Hidden" ||\n            subName === "Team" ||\n            subName === "Pot" ||\n            subName === "Visible") {\n            return () => [];\n        }\n    }\n    if (head === "trigger") {\n        // `(trigger "<event>" <player>)` in effect position. Java: Trigger.java \u2014\n        // records a named event as fired for the given player via ActionTrigger.\n        // Trigger state is not modelled here so ActionTrigger.apply() is a no-op\x2C\n        // but the action is carried through so the form compiles cleanly.\n        const eventNode = node.items[1];\n        const playerNode = node.items[2];\n        if (!eventNode || !isString(eventNode))\n            return () => [];\n        const event = eventNode.value;\n        let playerFn = { eval: (ctx) => ctx.mover };\n        if (playerNode) {\n            try {\n                playerFn = compileInt(playerNode\x2C env);\n            }\n            catch {\n                /* default to mover */\n            }\n        }\n        return (ctx) => [new ActionTrigger(event\x2C playerFn.eval(ctx))];\n    }\n    if (head === "add") {\n        // `(add (piece \u2026) (to \u2026))` as an effect \u2014 place a piece without generating\n        // a selectable move (Shogi/Crazyhouse capture-to-hand\x2C Game of Life\x2C \u2026).\n        const { positional\x2C named } = parseArgs(node.items.slice(1));\n        const pieceNode = node.items.find((n) => isList(n) && listHead(n) === "piece");\n        let whatFn = { eval: (ctx) => ctx.mover };\n        if (pieceNode?.items[1]) {\n            try {\n                whatFn = compileInt(pieceNode.items[1]\x2C env);\n            }\n            catch {\n                /* mover */\n            }\n        }\n        const region = resolveAddRegion(node\x2C positional\x2C named\x2C pieceNode\x2C env);\n        if (!region)\n            return () => [];\n        const stackNode = named.get("stack");\n        const onStack = stackNode !== undefined && isIdent(stackNode) && stackNode.name === "True";\n        return (ctx) => {\n            const site = region.eval(ctx)[0] ?? OFF;\n            if (site < 0)\n                return [];\n            const what = whatFn.eval(ctx);\n            return [\n                new ActionAdd({\n                    to: site\x2C\n                    what: what > 0 ? what : ctx.mover\x2C\n                    onStack\x2C\n                })\x2C\n            ];\n        };\n    }\n    return undefined;\n}\nfunction compileMoveLudemeInner(node\x2C env) {\n    const second = node.items[1];\n    // (move Step <dir> (to if:<bool> (apply <effect>)))\n    if (second && isIdent(second) && second.name === "Step") {\n        return compileStep(node\x2C env);\n    }\n    // (move Slide <dir?> (between if:<go>)? (to if:<land> (apply <effect>))?)\n    if (second && isIdent(second) && second.name === "Slide") {\n        return compileSlide(node\x2C env);\n    }\n    // (move Hop <from?> <dir?> (between if:<over> (apply \u2026)) (to if:<land>))\n    if (second && isIdent(second) && second.name === "Hop") {\n        return compileHop(node\x2C env);\n    }\n    // (move Leap <walk> (to if:<land> (apply <effect>)?)) \u2014 knight-like jumps\n    // described by a turtle walk (F/L/R) applied from each orthogonal heading.\n    if (second && isIdent(second) && second.name === "Leap") {\n        return compileLeap(node\x2C env);\n    }\n    // (move Shoot (piece "Dot") <dirs?>) \u2014 slide a fresh marker outward from the\n    // just-moved piece (Amazons arrow). Lands on / passes through empty cells.\n    if (second && isIdent(second) && second.name === "Shoot") {\n        return compileShoot(node\x2C env);\n    }\n    // (move Select (from <region> if:<bool>?)) \u2014 pick a site; the actual board\n    // effect lives in the `(then \u2026)` chain (e.g. `(sow)`). Common in mancala.\n    if (second && isIdent(second) && second.name === "Select") {\n        return compileSelect(node\x2C env);\n    }\n    // (move Pass) \u2014 a single turn-skipping move.\n    if (second && isIdent(second) && second.name === "Pass") {\n        return {\n            generate: (ctx) => {\n                const mover = ctx.mover;\n                return [\n                    new Move({\n                        id: `pass:${mover}`\x2C\n                        label: "Pass"\x2C\n                        siteIndices: [0]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionPass()]\x2C\n                    })\x2C\n                ];\n            }\x2C\n        };\n    }\n    // (move Remove <region>) \u2014 one removal move per site in the region.\n    if (second && isIdent(second) && second.name === "Remove") {\n        const regionNode = node.items[2];\n        if (!regionNode)\n            throw new LudemeCompileError("(move Remove \u2026) needs a region.");\n        const region = compileRegion(regionNode\x2C env);\n        return {\n            generate: (ctx) => {\n                const out = [];\n                const mover = ctx.mover;\n                for (const site of region.eval(ctx)) {\n                    if (site < 0)\n                        continue;\n                    out.push(new Move({\n                        id: `remove:${site}:${mover}`\x2C\n                        label: `Remove at ${site}`\x2C\n                        siteIndices: [site]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionRemove({ to: site })]\x2C\n                    }));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    // (move Add (to <region>))\n    if (second && isIdent(second) && second.name === "Add") {\n        const { named } = parseArgs(node.items.slice(2));\n        let toRegion;\n        const toNode = node.items.find((n) => isList(n) && listHead(n) === "to");\n        if (toNode) {\n            const { positional: toPos } = parseArgs(toNode.items.slice(1));\n            const regionArg = dropSiteType(toPos)[0];\n            if (regionArg)\n                toRegion = compileRegion(regionArg\x2C env);\n        }\n        if (named.has("to")) {\n            toRegion = compileRegion(named.get("to")\x2C env);\n        }\n        if (!toRegion) {\n            throw new LudemeCompileError("(move Add \u2026) needs a (to \u2026) region.");\n        }\n        const region = toRegion;\n        return {\n            generate: (ctx) => {\n                const out = [];\n                const mover = ctx.mover;\n                for (const site of region.eval(ctx)) {\n                    if (site < 0)\n                        continue;\n                    out.push(new Move({\n                        id: `add:${site}:${mover}`\x2C\n                        label: `Add at ${site}`\x2C\n                        siteIndices: [site]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionAdd({ to: site\x2C what: mover })]\x2C\n                    }));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    // (move Promote <site> <piece-spec> [player]) \u2014 replace the piece at <site>\n    // with another type. The engine tracks only ownership\x2C not piece type\x2C so\n    // promotion preserves the current owner (a board-neutral but legal move);\n    // the chosen target type is not yet represented.\n    if (second && isIdent(second) && second.name === "Promote") {\n        const siteNode = node.items[2];\n        if (!siteNode) {\n            throw new LudemeCompileError("(move Promote \u2026) needs a site.");\n        }\n        const siteFn = compileInt(siteNode\x2C env);\n        return {\n            generate: (ctx) => {\n                const s = siteFn.eval(ctx);\n                if (s < 0)\n                    return [];\n                const owner = ctx.state.cells[s] ?? ctx.mover;\n                if (owner <= 0)\n                    return [];\n                return [\n                    new Move({\n                        id: `promote:${s}:${owner}`\x2C\n                        label: `Promote at ${s}`\x2C\n                        siteIndices: [s]\x2C\n                        mover: ctx.mover\x2C\n                        placedOwner: ctx.mover\x2C\n                        actions: [new ActionPromote(s\x2C owner)]\x2C\n                    })\x2C\n                ];\n            }\x2C\n        };\n    }\n    // Generic relocation: (move (from <region>?) (to <region> if:\u2026 (apply \u2026))).\n    // The most common move primitive in Ludii \u2014 a piece travels from each\n    // from-site to each to-site\x2C optionally capturing via the to-clause's\n    // (apply \u2026) effect. Dispatched last so the keyword forms above win.\n    const hasFromOrTo = node.items.some((n) => isList(n) && (listHead(n) === "from" || listHead(n) === "to"));\n    if (hasFromOrTo) {\n        return compileFromTo(node\x2C env);\n    }\n    // (move Set NextPlayer (player <n>)) \u2014 override whose turn follows.\n    // (move Set Rotation [(to <site>)] [{r1 r2 \u2026}]) \u2014 emit one move per rotation.\n    if (second && isIdent(second) && second.name === "Set") {\n        const subNode = node.items[2];\n        const subName = subNode && isIdent(subNode) ? subNode.name : "";\n        if (subName === "NextPlayer") {\n            const arg = node.items[3];\n            const fn = arg ? compileInt(arg\x2C env) : undefined;\n            return {\n                generate: (ctx) => {\n                    const mover = ctx.mover;\n                    const next = fn ? fn.eval(ctx) : mover;\n                    return [\n                        new Move({\n                            id: `setNext:${next}:${mover}`\x2C\n                            label: `SetNextPlayer ${next}`\x2C\n                            siteIndices: [0]\x2C\n                            mover\x2C\n                            placedOwner: mover\x2C\n                            actions: [new ActionSetNextPlayer(next)]\x2C\n                        })\x2C\n                    ];\n                }\x2C\n            };\n        }\n        if (subName === "Rotation") {\n            const toNode = node.items.find((n) => isList(n) && listHead(n) === "to");\n            const atNode = toNode\n                ? parseArgs(toNode.items.slice(1)).positional[0]\n                : undefined;\n            const atFn = atNode ? compileInt(atNode\x2C env) : undefined;\n            const setNode = node.items.find((n) => isList(n) && n.delimiter === "curly");\n            const rotValues = setNode\n                ? setNode.items.filter(isNumber).map((n) => n.value)\n                : [];\n            const values = rotValues.length > 0 ? rotValues : [0];\n            return {\n                generate: (ctx) => {\n                    const mover = ctx.mover;\n                    const site = atFn ? atFn.eval(ctx) : (ctx.frame.to ?? 0);\n                    if (site < 0)\n                        return [];\n                    return values.map((rot) => new Move({\n                        id: `setRot:${site}:${rot}:${mover}`\x2C\n                        label: `SetRotation ${site}->${rot}`\x2C\n                        siteIndices: [site]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionSetRotation({ to: site\x2C rotation: rot })]\x2C\n                    }));\n                }\x2C\n            };\n        }\n        return EMPTY_MOVES;\n    }\n    // (move Propose "string" \u2026) \u2014 record a proposition.\n    // (move Vote "Yes") \u2014 cast a vote on the active proposal (mancala end-by-vote).\n    if (second && isIdent(second) && second.name === "Vote") {\n        const voteNode = node.items[2];\n        const vote = voteNode && isString(voteNode)\n            ? voteNode.value\n            : voteNode && isIdent(voteNode)\n                ? voteNode.name\n                : "Yes";\n        return {\n            generate: (ctx) => {\n                const mover = ctx.mover;\n                return [\n                    new Move({\n                        id: `vote:${vote}:${mover}`\x2C\n                        label: `Vote ${vote}`\x2C\n                        siteIndices: [0]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionVote(vote)]\x2C\n                    })\x2C\n                ];\n            }\x2C\n        };\n    }\n    if (second && isIdent(second) && second.name === "Propose") {\n        const textNode = node.items[2];\n        const text = textNode && isString(textNode)\n            ? textNode.value\n            : textNode && isIdent(textNode)\n                ? textNode.name\n                : "Propose";\n        return {\n            generate: (ctx) => {\n                const mover = ctx.mover;\n                return [\n                    new Move({\n                        id: `propose:${text}:${mover}`\x2C\n                        label: `Propose ${text}`\x2C\n                        siteIndices: [0]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionPropose(text)]\x2C\n                    })\x2C\n                ];\n            }\x2C\n        };\n    }\n    // (move Swap Players \u2026) \u2014 player-order swap (not modelled \u2192 Pass).\n    // (move Swap Pieces <site1> <site2>) \u2014 swap the pieces at two sites.\n    if (second && isIdent(second) && second.name === "Swap") {\n        const subNode = node.items[2];\n        const subName = subNode && isIdent(subNode) ? subNode.name : "";\n        if (subName === "Players") {\n            return {\n                generate: (ctx) => {\n                    const mover = ctx.mover;\n                    return [\n                        new Move({\n                            id: `swapPlayers:${mover}`\x2C\n                            label: "SwapPlayers"\x2C\n                            siteIndices: [0]\x2C\n                            mover\x2C\n                            placedOwner: mover\x2C\n                            actions: [new ActionPass()]\x2C\n                        })\x2C\n                    ];\n                }\x2C\n            };\n        }\n        if (subName === "Pieces") {\n            const s1Node = node.items[3];\n            const s2Node = node.items[4];\n            if (!s1Node || !s2Node)\n                return EMPTY_MOVES;\n            const s1Fn = compileInt(s1Node\x2C env);\n            const s2Fn = compileInt(s2Node\x2C env);\n            return {\n                generate: (ctx) => {\n                    const mover = ctx.mover;\n                    const a = s1Fn.eval(ctx);\n                    const b = s2Fn.eval(ctx);\n                    if (a < 0 || b < 0)\n                        return [];\n                    return [\n                        new Move({\n                            id: `swapPieces:${a}:${b}:${mover}`\x2C\n                            label: `SwapPieces ${a}<->${b}`\x2C\n                            siteIndices: [b]\x2C\n                            mover\x2C\n                            placedOwner: mover\x2C\n                            actions: [new ActionSwap(a\x2C b)]\x2C\n                        })\x2C\n                    ];\n                }\x2C\n            };\n        }\n        return EMPTY_MOVES;\n    }\n    // (move Bet <player> (range <min> <max>) \u2026) \u2014 one move per amount in range.\n    if (second && isIdent(second) && second.name === "Bet") {\n        const playerNode = node.items[2];\n        const rangeNode = node.items[3];\n        const playerFn = playerNode && isIdent(playerNode)\n            ? { eval: (ctx) => resolveRole(playerNode.name\x2C ctx) }\n            : playerNode\n                ? compileInt(playerNode\x2C env)\n                : { eval: (ctx) => ctx.mover };\n        let minFn = { eval: () => 0 };\n        let maxFn = { eval: () => 0 };\n        if (rangeNode && isList(rangeNode) && listHead(rangeNode) === "range") {\n            const a = rangeNode.items[1];\n            const b = rangeNode.items[2];\n            if (a)\n                minFn = compileInt(a\x2C env);\n            maxFn = b ? compileInt(b\x2C env) : minFn;\n        }\n        return {\n            generate: (ctx) => {\n                const mover = ctx.mover;\n                const player = playerFn.eval(ctx);\n                const lo = minFn.eval(ctx);\n                const hi = maxFn.eval(ctx);\n                const out = [];\n                for (let amt = lo; amt <= hi; amt += 1) {\n                    out.push(new Move({\n                        id: `bet:${player}:${amt}:${mover}`\x2C\n                        label: `Bet ${amt}`\x2C\n                        siteIndices: [0]\x2C\n                        mover\x2C\n                        placedOwner: mover\x2C\n                        actions: [new ActionBet(player\x2C amt)]\x2C\n                    }));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    throw new LudemeCompileError("Unsupported (move \u2026) form.");\n}\n/**\n * `(move Select (from <region> if:<bool>?))` \u2014 emit one selection move per\n * site in the from-region that passes the `if:` guard. The move records an\n * `ActionSelect`; the board mutation is supplied by the `(then \u2026)` chain\n * (`(sow \u2026)` in mancala). From-sites default to the mover's occupied cells.\n */\nfunction compileSelect(node\x2C env) {\n    const fromNode = node.items.find((n) => isList(n) && listHead(n) === "from");\n    let fromRegion;\n    let fromCond;\n    if (fromNode) {\n        const { positional\x2C named } = parseArgs(fromNode.items.slice(1));\n        const regionArg = dropSiteType(positional)[0];\n        if (regionArg)\n            fromRegion = compileRegion(regionArg\x2C env);\n        const ifNode = named.get("if");\n        if (ifNode)\n            fromCond = compileBool(ifNode\x2C env);\n    }\n    return {\n        generate: (ctx) => {\n            const mover = ctx.mover;\n            let fromSites;\n            if (fromRegion) {\n                fromSites = [...fromRegion.eval(ctx)];\n            }\n            else {\n                fromSites = [];\n                const cells = ctx.state.cells;\n                for (let s = 0; s < cells.length; s += 1) {\n                    if (cells[s] === mover)\n                        fromSites.push(s);\n                }\n            }\n            const out = [];\n            for (const from of fromSites) {\n                if (from < 0)\n                    continue;\n                const fctx = ctx.withFrame({ from });\n                if (fromCond && !fromCond.eval(fctx))\n                    continue;\n                out.push(new Move({\n                    id: `select:${from}:${mover}`\x2C\n                    label: `Select ${from}`\x2C\n                    siteIndices: [from]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                    actions: [new ActionSelect(from\x2C from)]\x2C\n                }));\n            }\n            return out;\n        }\x2C\n    };\n}\n/** The track the mover would sow along from `site`: prefer the mover's own\n * track\x2C then a shared (owner 0) track\x2C then any track containing `site`. */\nfunction pickTrack(ctx\x2C site) {\n    const tracks = ctx.board.tracks;\n    if (tracks.length === 0)\n        return undefined;\n    const mover = ctx.mover;\n    const containing = tracks.filter((t) => t.sites.includes(site));\n    const pool = containing.length > 0 ? containing : tracks;\n    return (pool.find((t) => t.owner === mover) ??\n        pool.find((t) => t.owner === 0) ??\n        pool[0]);\n}\n/** The track belonging to `player` (or a shared owner-0 track)\x2C optionally\n * filtered by name substring. Java: `Context.tracks()` owner/name lookup. */\nfunction trackForPlayer(ctx\x2C player\x2C name) {\n    const tracks = ctx.board.tracks;\n    if (tracks.length === 0)\n        return undefined;\n    const named = name ? tracks.filter((t) => t.name.includes(name)) : tracks;\n    const pool = named.length > 0 ? named : tracks;\n    return (pool.find((t) => t.owner === player) ??\n        pool.find((t) => t.owner === 0) ??\n        pool[0]);\n}\n/**\n * `(trackSite FirstSite|EndSite|Move \u2026)` \u2014 resolve a site on a track.\n * - `FirstSite [from:<site>] [if:<cond>]`: starting at `from` (or the track\n *   start)\x2C the first site (walking forward\x2C cyclically) where `if:` holds \u2014\n *   or just the start when no condition is given.\n * - `EndSite`: the last site of the track.\n * - `Move from:<site> steps:<n>`: the site reached `n` steps forward of `from`.\n * An optional trailing role / `name:` selects which track.\n */\n/**\n * `(ahead [<siteType>] <site> [steps:<n>] <direction>)` \u2014 the site reached by\n * stepping `n` (default 1) units in `<direction>` from `<site>`. Direction may\n * be an absolute compass token (N/E/S/W and diagonals) or a player-relative\n * token (Forward/Backward/\u2026); relative tokens are rotated for the mover.\n * Returns Off when the step would leave the board or the direction is unknown.\n * Java parity: game.functions.ints.board.Ahead.\n */\nfunction compileAhead(node\x2C env) {\n    const { positional\x2C named } = parseArgs(node.items.slice(1));\n    const args = isSiteTypeIdent(positional[0])\n        ? positional.slice(1)\n        : positional;\n    const siteNode = args.length >= 2 ? args[0] : undefined;\n    const dirNode = args[args.length - 1];\n    const siteFn = siteNode\n        ? compileInt(siteNode\x2C env)\n        : { eval: (ctx) => ctx.frame.to ?? OFF };\n    const stepsNode = named.get("steps");\n    const stepsFn = stepsNode ? compileInt(stepsNode\x2C env) : undefined;\n    const dirName = dirNode && isIdent(dirNode)\n        ? dirNode.name\n        : dirNode && isString(dirNode)\n            ? dirNode.value\n            : "Forward";\n    return {\n        eval: (ctx) => {\n            const start = siteFn.eval(ctx);\n            if (start < 0)\n                return OFF;\n            const dir = resolveDirection(dirName\x2C facingForSite(ctx\x2C start)\x2C ctx.board.tiling);\n            if (!dir)\n                return OFF;\n            const steps = stepsFn ? stepsFn.eval(ctx) : 1;\n            const board = ctx.board;\n            let x = board.xOf(start);\n            let y = board.yOf(start);\n            let site = start;\n            for (let i = 0; i < steps; i += 1) {\n                x += dir.dx;\n                y += dir.dy;\n                site = board.siteAt(x\x2C y);\n                if (site < 0)\n                    return OFF;\n            }\n            return site;\n        }\x2C\n    };\n}\nfunction compileTrackSite(node\x2C env) {\n    const { positional\x2C named } = parseArgs(node.items.slice(1));\n    const kindNode = positional[0];\n    const kind = kindNode && isIdent(kindNode) ? kindNode.name : "FirstSite";\n    const nameNode = named.get("name");\n    const trackName = nameNode && isString(nameNode) ? nameNode.value : undefined;\n    // Optional trailing role ident (the track owner) \u2014 e.g. (trackSite Move \u2026 P1).\n    const roleNode = positional\n        .slice(1)\n        .find((n) => isIdent(n) && /^(Mover|Next|Prev|P\\d+)$/.test(n.name));\n    const playerFn = roleNode && isIdent(roleNode)\n        ? { eval: (ctx) => resolveRole(roleNode.name\x2C ctx) }\n        : { eval: (ctx) => ctx.mover };\n    const fromNode = named.get("from");\n    const fromFn = fromNode ? compileInt(fromNode\x2C env) : undefined;\n    if (kind === "Move") {\n        const stepsNode = named.get("steps");\n        const stepsFn = stepsNode ? compileInt(stepsNode\x2C env) : undefined;\n        return {\n            eval: (ctx) => {\n                const track = trackForPlayer(ctx\x2C playerFn.eval(ctx)\x2C trackName);\n                if (!track)\n                    return OFF;\n                const ring = track.sites;\n                const from = fromFn ? fromFn.eval(ctx) : ctx.frame.from ?? OFF;\n                const idx = ring.indexOf(from);\n                if (idx < 0)\n                    return OFF;\n                const steps = stepsFn ? stepsFn.eval(ctx) : 0;\n                let i = idx + (steps > 0 ? steps : 0);\n                if (i < ring.length)\n                    return ring[i];\n                if (!track.loop)\n                    return OFF;\n                return ring[i % ring.length];\n            }\x2C\n        };\n    }\n    if (kind === "EndSite" || kind === "End") {\n        return {\n            eval: (ctx) => {\n                const track = trackForPlayer(ctx\x2C playerFn.eval(ctx)\x2C trackName);\n                if (!track || track.sites.length === 0)\n                    return OFF;\n                return track.sites[track.sites.length - 1];\n            }\x2C\n        };\n    }\n    // FirstSite (default): the first track site (from `from` onward\x2C cyclically)\n    // that satisfies `if:`. With no condition\x2C the track start (or `from`).\n    const ifNode = named.get("if");\n    const cond = ifNode ? compileBool(ifNode\x2C env) : undefined;\n    return {\n        eval: (ctx) => {\n            const track = trackForPlayer(ctx\x2C playerFn.eval(ctx)\x2C trackName);\n            if (!track || track.sites.length === 0)\n                return OFF;\n            const ring = track.sites;\n            const from = fromFn ? fromFn.eval(ctx) : OFF;\n            let start = 0;\n            if (from !== OFF) {\n                const fi = ring.indexOf(from);\n                if (fi < 0)\n                    return OFF;\n                start = fi;\n            }\n            if (!cond)\n                return ring[start];\n            for (let j = 0; j < ring.length; j += 1) {\n                const site = ring[(start + j) % ring.length];\n                if (cond.eval(ctx.withFrame({ to: site })))\n                    return site;\n            }\n            return OFF;\n        }\x2C\n    };\n}\n/**\n * `(sow [from:<site>] if:<bool> apply:<effect> [backtracking:True])`. Pick up\n * every seed at the selected hole (`(from)`)\x2C then drop one per following hole\n * along the mover's track. After the last seed lands\x2C evaluate `if:` with\n * `(to)` bound to the landing hole; if it ho