code-creation,Script,9,88750,0x2325599ee998,103, file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/random-ai.js:1:1,0x3d74e7e51d80,~
script-source,212,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/random-ai.js,/**\n * Java parity: AI/src/utils/RandomAI.java \u2014\n * pick a legal move uniformly at random.\n */\nimport { SeededRng } from "../rng.js";\nimport { AI } from "./ai.js";\nexport class RandomAI extends AI {\n    /** Seedable RNG so playouts/tests are reproducible. */\n    rng;\n    constructor(seed = 0xc0ffee) {\n        super();\n        this.friendlyName = "Random";\n        this.rng = new SeededRng(seed);\n    }\n    withSeed(seed) {\n        this.rng = new SeededRng(seed);\n        return this;\n    }\n    selectAction(context\x2C _options) {\n        const moves = context.game.moves(context);\n        if (moves.length === 0)\n            return undefined;\n        const idx = this.rng.nextInt(moves.length);\n        return moves[idx];\n    }\n}\n//# sourceMappingURL=random-ai.js.map
