script-source,229,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/named-tilings.js,/**\n * Named Archimedean (semi-regular) tiling generators \u2014 Java parity with\n * Core/src/game/functions/graph/generators/basis/tiling/**.\n *\n * Each tiling lays a fixed set of polygon-corner offsets (`ref`) around every\n * cell of an integer (row\x2C col) lattice mapped to the plane by `xy`\x2C dedups\n * coincident corners\x2C then joins every pair of vertices exactly one unit apart\n * (Java: `BaseGraphFunction.createGraphFromVertexList`\x2C unit = 1). The bounded\n * faces are the play cells.\n *\n * `(tiling T3464 n)` / `(tiling T33434 n)` etc. The dimension `dimA` (and\n * optional `dimB`) controls board extent and\x2C for the hex-shaped tilings\x2C the\n * hexagonal clip.\n */\nimport { Graph } from "./graph.js";\nconst SQRT3 = Math.sqrt(3);\n/** Vertex coincidence tolerance used while collecting tiling corners (Java: 0.1). */\nconst DEDUP = 0.1;\n/** Edge length: corners exactly this far apart are joined (Java: unit = 1). */\nconst UNIT = 1;\n/** Collect offset corners over the lattice\x2C then join unit-apart pairs. */\nfunction buildTiling(spec) {\n    const g = new Graph();\n    for (let row = 0; row < spec.rows; row += 1) {\n        for (let col = 0; col < spec.cols; col += 1) {\n            if (spec.keep && !spec.keep(row\x2C col\x2C spec.rows\x2C spec.cols))\n                continue;\n            const [px\x2C py] = spec.xy(row\x2C col);\n            for (const [dx\x2C dy] of spec.ref)\n                g.addVertex(px + dx\x2C py + dy\x2C DEDUP);\n        }\n    }\n    const vs = g.vertices;\n    for (let a = 0; a < vs.length; a += 1) {\n        const va = vs[a];\n        for (let b = a + 1; b < vs.length; b += 1) {\n            const vb = vs[b];\n            const d = Math.hypot(va.x - vb.x\x2C va.y - vb.y);\n            if (Math.abs(d - UNIT) < 0.01)\n                g.addEdge(a\x2C b);\n        }\n    }\n    g.makeFaces();\n    return g;\n}\n/** Hexagon clip used by 3464 / 3636: keep a rhombus-cornered hexagon. */\nconst hexClipDiff = (row\x2C col\x2C _rows\x2C cols) => !(col > Math.floor(cols / 2) + row || row - col > Math.floor(cols / 2));\n/** Hexagon clip used by 31212 / 33336 / 4612 / 333333_33434. */\nconst hexClipAbs = (row\x2C col\x2C rows) => Math.abs(row - col) <= Math.floor(rows / 2);\n/** Twelve evenly-spaced unit-circle corners (dodecagon)\x2C used by 4612 / 31212. */\nfunction dodecagon() {\n    const r = 1 / Math.sqrt(2 - SQRT3);\n    const off = Math.PI / 12;\n    const out = [];\n    for (let s = 0; s < 12; s += 1) {\n        const theta = off + (s / 12) * 2 * Math.PI;\n        out.push([r * Math.cos(theta)\x2C r * Math.sin(theta)]);\n    }\n    return out;\n}\n/** Six hexagon corners + twelve outer-square corners (3464 / 333333_33434). */\nfunction hexPlusSquares(ux\x2C uy) {\n    const out = [\n        [-0.5 * ux\x2C 1.0 * uy]\x2C\n        [0.5 * ux\x2C 1.0 * uy]\x2C\n        [1.0 * ux\x2C 0.0 * uy]\x2C\n        [0.5 * ux\x2C -1.0 * uy]\x2C\n        [-0.5 * ux\x2C -1.0 * uy]\x2C\n        [-1.0 * ux\x2C 0.0 * uy]\x2C\n    ];\n    const a = 1 + SQRT3 / 2;\n    const h = a / Math.cos((15 * Math.PI) / 180);\n    for (let n = 0; n < 12; n += 1) {\n        const theta = ((15 + n * 30) * Math.PI) / 180;\n        out.push([h * Math.cos(theta)\x2C h * Math.sin(theta)]);\n    }\n    return out;\n}\nconst dim = (n\x2C dflt = 3) => (Number.isFinite(n) ? n : dflt);\n/** Triangle clip used by tri/hex Triangle shapes: lower-left triangle. */\nconst triClip = (row\x2C col) => row <= col;\n/**\n * `(hex [shape] dimA [dimB])` \u2014 board on a regular hexagonal tiling (cells are\n * hexagons). Java: hex/Hex.java + shape variants.\n */\nexport function genHex(shape\x2C dimA\x2C dimB) {\n    const a = dim(dimA);\n    const b = dimB !== undefined && Number.isFinite(dimB) ? dimB : undefined;\n    const ux = SQRT3 / 2;\n    const ref = [\n        [0.0 * ux\x2C 1.0]\x2C\n        [1.0 * ux\x2C 0.5]\x2C\n        [1.0 * ux\x2C -0.5]\x2C\n        [0.0 * ux\x2C -1.0]\x2C\n        [-1.0 * ux\x2C -0.5]\x2C\n        [-1.0 * ux\x2C 0.5]\x2C\n    ];\n    const hx = SQRT3;\n    const hy = 3 / 2;\n    const xy = (r\x2C c) => [hx * (c - 0.5 * r)\x2C hy * r];\n    const st = (shape ?? "Hexagon").toLowerCase();\n    switch (st) {\n        case "rectangle":\n        case "square":\n            return buildTiling({ ref\x2C rows: a\x2C cols: b ?? a\x2C xy });\n        case "diamond":\n        case "prism":\n        case "rhombus":\n            return buildTiling({ ref\x2C rows: a\x2C cols: b ?? a\x2C xy });\n        case "triangle":\n            return buildTiling({ ref\x2C rows: a\x2C cols: a\x2C xy\x2C keep: triClip });\n        default: {\n            const rows = 2 * a - 1;\n            return buildTiling({ ref\x2C rows\x2C cols: rows\x2C xy\x2C keep: hexClipDiff });\n        }\n    }\n}\n/**\n * `(tri [shape] dimA [dimB])` \u2014 board on a triangular tiling (cells are\n * triangles; each lattice point is a vertex). Java: tri/Tri.java + variants.\n */\nexport function genTri(shape\x2C dimA\x2C dimB) {\n    const a = dim(dimA);\n    const b = dimB !== undefined && Number.isFinite(dimB) ? dimB : undefined;\n    const ref = [[0\x2C 0]];\n    const xy = (r\x2C c) => [c - 0.5 * r\x2C (SQRT3 / 2) * r];\n    const st = (shape ?? "Triangle").toLowerCase();\n    switch (st) {\n        case "hexagon": {\n            const rows = 2 * (a + 1) - 1;\n            return buildTiling({ ref\x2C rows\x2C cols: rows\x2C xy\x2C keep: hexClipDiff });\n        }\n        case "rectangle":\n        case "square":\n        case "diamond":\n        case "prism":\n        case "rhombus":\n            return buildTiling({ ref\x2C rows: a + 1\x2C cols: (b ?? a) + 1\x2C xy });\n        default:\n            return buildTiling({ ref\x2C rows: a + 1\x2C cols: a + 1\x2C xy\x2C keep: triClip });\n    }\n}\n/** Add a polygon's perimeter (vertices + closing edges) to a graph. */\nfunction addPoly(g\x2C pts) {\n    const ids = pts.map(([x\x2C y]) => g.addVertex(x\x2C y));\n    for (let i = 0; i < ids.length; i += 1)\n        g.addEdge(ids[i]\x2C ids[(i + 1) % ids.length]);\n}\n/**\n * `(brick [shape] dimA [dimB] [trim:bool])` \u2014 a running-bond brick wall: each\n * brick is a 2\xd71 hexagonal cell (mid-edge vertices included)\x2C rows offset by\n * half a brick. Java: brick/Brick.java + SquareOrRectangleOnBrick.\n */\nexport function genBrick(shape\x2C dimA\x2C dimB\x2C trim = false) {\n    const a = dim(dimA);\n    let b = dimB !== undefined && Number.isFinite(dimB) ? dimB : a;\n    if ((shape ?? "").toLowerCase() === "limping")\n        b = a + 1;\n    const rows = a;\n    const cols = b * 2 + 1;\n    const g = new Graph();\n    const brick = (r\x2C c) => addPoly(g\x2C [\n        [c\x2C r]\x2C\n        [c\x2C r + 1]\x2C\n        [c + 1\x2C r + 1]\x2C\n        [c + 2\x2C r + 1]\x2C\n        [c + 2\x2C r]\x2C\n        [c + 1\x2C r]\x2C\n    ]);\n    const half = (r\x2C c) => addPoly(g\x2C [\n        [c\x2C r]\x2C\n        [c\x2C r + 1]\x2C\n        [c + 1\x2C r + 1]\x2C\n        [c + 1\x2C r]\x2C\n    ]);\n    for (let r = 0; r < rows; r += 1)\n        for (let c = r % 2; c < cols; c += 2) {\n            if (trim && c === 0)\n                half(r\x2C c + 1);\n            else if (trim && c >= cols - 1)\n                half(r\x2C c);\n            else\n                brick(r\x2C c);\n        }\n    g.makeFaces();\n    return g;\n}\nconst lerp = (t\x2C p\x2C q) => [\n    p[0] + (q[0] - p[0]) * t\x2C\n    p[1] + (q[1] - p[1]) * t\x2C\n];\nconst rot = (theta\x2C p) => {\n    const c = Math.cos(theta);\n    const s = Math.sin(theta);\n    return [p[0] * c - p[1] * s\x2C p[0] * s + p[1] * c];\n};\n/**\n * `(quadhex layers)` \u2014 a hexagon tessellated by quadrilaterals (Three-Player\n * Chess board). Java: quadhex/Quadhex.sixUniformSections \u2014 six rotations of a\n * layers\xd7layers quad-meshed triangle.\n */\nexport function genQuadhex(layers) {\n    const L = Math.max(1\x2C Math.floor(dim(layers)));\n    const g = new Graph();\n    const A = [0\x2C 0];\n    const B = [0\x2C (L * SQRT3) / 2];\n    const C = [L / 2\x2C (L * SQRT3) / 2];\n    const E = [L\x2C 0];\n    const D = [(C[0] + E[0]) / 2\x2C (C[1] + E[1]) / 2];\n    for (let rotn = 0; rotn < 6; rotn += 1) {\n        const theta = (rotn * Math.PI) / 3;\n        for (let row = 0; row < L; row += 1) {\n            const r0 = row / L;\n            const r1 = (row + 1) / L;\n            const ptAD0 = rot(theta\x2C lerp(r0\x2C A\x2C D));\n            const ptAD1 = rot(theta\x2C lerp(r1\x2C A\x2C D));\n            const ptBC0 = rot(theta\x2C lerp(r0\x2C B\x2C C));\n            const ptBC1 = rot(theta\x2C lerp(r1\x2C B\x2C C));\n            for (let col = 0; col < L; col += 1) {\n                const c0 = col / L;\n                const c1 = (col + 1) / L;\n                const ptAB0 = lerp(c0\x2C ptAD0\x2C ptBC0);\n                const ptAB1 = lerp(c1\x2C ptAD0\x2C ptBC0);\n                const ptDC1 = lerp(c1\x2C ptAD1\x2C ptBC1);\n                const va = g.addVertex(ptAB0[0]\x2C ptAB0[1]);\n                const vb = g.addVertex(ptAB1[0]\x2C ptAB1[1]);\n                const vc = g.addVertex(ptDC1[0]\x2C ptDC1[1]);\n                g.addEdge(va\x2C vb);\n                g.addEdge(vb\x2C vc);\n                if (row === L - 1) {\n                    const ptDC0 = lerp(c0\x2C ptAD1\x2C ptBC1);\n                    const vd = g.addVertex(ptDC0[0]\x2C ptDC0[1]);\n                    g.addEdge(vc\x2C vd);\n                }\n            }\n        }\n    }\n    g.makeFaces();\n    return g;\n}\n/** Inner-ring step count for a spiral (doubles each of the first layers). */\nfunction spiralBaseNumber(numTurns\x2C numSites) {\n    for (let base = 1; base < numSites; base += 1) {\n        let steps = base;\n        let total = 1;\n        for (let ring = 1; ring < numTurns; ring += 1) {\n            total += steps;\n            if (total > numSites) {\n                if (ring <= numTurns)\n                    return base - 1;\n                break;\n            }\n            if (ring <= 2)\n                steps *= 2;\n        }\n    }\n    return 0;\n}\n/**\n * `(spiral turns:t sites:n [clockwise:bool])` \u2014 an Archimedean spiral path of\n * `n` vertices (e.g. the ancient Egyptian Mehen board). A line graph: vertices\n * joined consecutively\x2C no faces. Java: shape/Spiral.java.\n */\nexport function genSpiral(turns\x2C sites\x2C clockwise = true) {\n    const numTurns = Math.max(1\x2C Math.floor(dim(turns)));\n    const numSites = Math.max(1\x2C Math.floor(dim(sites)));\n    const g = new Graph();\n    // Spiral vertices must not be deduplicated \u2014 keep the exact site count.\n    const add = (x\x2C y) => g.addVertex(x\x2C y\x2C -1);\n    add(0\x2C 0); // central pivot\n    const base = spiralBaseNumber(numTurns\x2C numSites);\n    const thetas = new Array(4 * numSites).fill(0);\n    let index = 1;\n    let steps = base;\n    for (let ring = 1; ring <= numTurns + 1; ring += 1) {\n        const dTheta = (Math.PI * 2) / steps;\n        let theta = Math.PI * 2 * ring;\n        if (ring <= 2 || ring % 2 === 1)\n            theta -= dTheta / 2;\n        for (let step = 0; step < steps; step += 1) {\n            thetas[index] = theta;\n            index += 1;\n            theta += dTheta;\n        }\n        if (ring <= 2)\n            steps *= 2;\n    }\n    for (let vid = 2; vid < numSites; vid += 1)\n        thetas[vid] = ((thetas[vid - 1] ?? 0) + (thetas[vid + 1] ?? 0)) / 2;\n    for (let vid = 2; vid < numSites; vid += 1)\n        thetas[vid] = ((thetas[vid - 1] ?? 0) + (thetas[vid + 1] ?? 0)) / 2;\n    thetas[1] = (thetas[1] ?? 0) - 0.5 * ((thetas[2] ?? 0) - (thetas[1] ?? 0));\n    for (let vid = 1; vid < numSites; vid += 1) {\n        const theta = thetas[vid] ?? 0;\n        const r = theta; // a = 0\x2C b = 1\n        const x = clockwise ? -r * Math.cos(theta) : r * Math.cos(theta);\n        const y = r