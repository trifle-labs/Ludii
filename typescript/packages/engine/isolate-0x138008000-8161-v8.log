script-source,143,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-add-count.js,// @java (none) \u2014 TS-only\x2C mancala seed-count semantics\n/**\n * Adjusts the seed count at a site by a (possibly negative) delta\x2C keeping the\n * cell's occupancy in sync so `(is Empty)` / `(is Occupied)` stay correct.\n *\n * Mancala games track seeds as a per-site count rather than a stack of owned\n * pieces\x2C so `(sow)` and `(fromTo \u2026 count:)` move seeds by incrementing and\n * decrementing these counts. Reuses the `SetCount` action type.\n */\nimport { BaseAction } from "./action.js";\nexport class ActionAddCount extends BaseAction {\n    static TYPE = "SetCount";\n    toIndex;\n    delta;\n    seedOwner;\n    constructor(toIndex\x2C delta\x2C seedOwner) {\n        super();\n        this.toIndex = toIndex;\n        this.delta = delta;\n        this.seedOwner = seedOwner;\n    }\n    apply(state) {\n        if (this.toIndex < 0 || this.toIndex >= state.cells.length)\n            return state;\n        const next = Math.max(0\x2C state.countAtSite(this.toIndex) + this.delta);\n        let s = state.withCountAt(this.toIndex\x2C next);\n        const owner = next > 0 ? this.seedOwner : 0;\n        if ((s.cells[this.toIndex] ?? 0) !== owner) {\n            s = s.withCell(this.toIndex\x2C owner);\n        }\n        return s;\n    }\n    actionType() {\n        return ActionAddCount.TYPE;\n    }\n    to() {\n        return this.toIndex;\n    }\n    count() {\n        return this.delta;\n    }\n}\n//# sourceMappingURL=action-add-count.js.map
