script-source,140,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/tri-game.js,// @java Core/src/game/Game.java Game (TS template subset)\n/**\n * Concrete `Game` for Y-style connection games played on a triangular\n * board of hexagonal cells \u2014 Y by Schensted & Titus (1953)\x2C and its\n * variants (Master Y\x2C Y (Hex)\x2C \u2026).\n *\n * Topology: an N-row triangle with row r containing r+1 cells (r in\n * [0\x2C N)). Total cells = N(N+1)/2. Adjacency follows the standard\n * hex-axial neighbour pattern intersected with the triangular mask.\n *\n * Winning condition: one player connects all THREE sides of the\n * triangle through a single chain of their own pieces. The three\n * sides are:\n *   - Top: the single cell at row 0.\n *   - Left: column 0 of every row.\n *   - Right: the diagonal cell (r\x2C r) of every row.\n *\n * For .lud parity the corners belong to BOTH adjacent sides; first\n * player to touch all three regions wins. Draws are impossible on a\n * filled Y board (a classic Y theorem).\n *\n * `(tri Hexagon N)` (used by "Y (Hex)") is a hexagonal-outline triangle\n * tiling. The simplified topology here collapses both `(tri N)` and\n * `(tri Hexagon N)` to the same N-row triangular model; the Hexagon\n * variant's outer hexagonal symmetry isn't honoured exactly\x2C but the\n * connection game still plays correctly with three sides.\n */\nimport { ConceptSet } from "./concept.js";\nimport { Context } from "./context.js";\nimport { Move } from "./move.js";\nimport { State } from "./state.js";\nimport { Trial } from "./trial.js";\nconst TRI_LABELS = ["\u25cf"\x2C "\u25cb"];\n/** Six hex-axial neighbours; identical to HexGame's offsets. */\nconst TRI_NEIGHBOURS = [\n    [1\x2C 0]\x2C\n    [-1\x2C 0]\x2C\n    [0\x2C 1]\x2C\n    [0\x2C -1]\x2C\n    [1\x2C -1]\x2C\n    [-1\x2C 1]\x2C\n];\nfunction triCellCount(size) {\n    return (size * (size + 1)) / 2;\n}\n/**\n * Map (row\x2C col) for a row-major lower-triangular layout to a flat\n * index. row in [0\x2C size); col in [0\x2C row+1).\n */\nfunction triIndex(row\x2C col) {\n    return (row * (row + 1)) / 2 + col;\n}\nfunction triCoords(idx) {\n    // Inverse of triIndex: solve idx = r(r+1)/2 + c for the largest r\n    // with r(r+1)/2 <= idx. Use the closed-form quadratic root and\n    // adjust for floating-point slack at the boundary.\n    let r = Math.floor((-1 + Math.sqrt(1 + 8 * idx)) / 2);\n    while ((r + 1) * (r + 2) <= 2 * idx)\n        r += 1;\n    while (r > 0 && r * (r + 1) > 2 * idx)\n        r -= 1;\n    const c = idx - (r * (r + 1)) / 2;\n    return [r\x2C c];\n}\nfunction inTri(size\x2C row\x2C col) {\n    return row >= 0 && row < size && col >= 0 && col <= row;\n}\n/**\n * Y connection check: a player wins when their stones form a single\n * connected region (using hex adjacency) that touches all three sides.\n * We BFS from any of the player's stones that touches a side\x2C then\n * verify that the reached set touches all three sides.\n */\nfunction connectsAllSides(cells\x2C size\x2C player) {\n    if (size < 1)\n        return false;\n    const visited = new Uint8Array(cells.length);\n    for (let start = 0; start < cells.length; start += 1) {\n        if (cells[start] !== player || visited[start] !== 0)\n            continue;\n        let touchTop = false;\n        let touchLeft = false;\n        let touchRight = false;\n        const stack = [start];\n        visited[start] = 1;\n        while (stack.length > 0) {\n            const cur = stack.pop() ?? 0;\n            const [r\x2C c] = triCoords(cur);\n            if (r === 0)\n                touchTop = true;\n            if (c === 0)\n                touchLeft = true;\n            if (c === r)\n                touchRight = true;\n            for (const [dr\x2C dc] of TRI_NEIGHBOURS) {\n                const nr = r + dr;\n                const nc = c + dc;\n                if (!inTri(size\x2C nr\x2C nc))\n                    continue;\n                const ni = triIndex(nr\x2C nc);\n                if (visited[ni] !== 0)\n                    continue;\n                if (cells[ni] !== player)\n                    continue;\n                visited[ni] = 1;\n                stack.push(ni);\n            }\n        }\n        if (touchTop && touchLeft && touchRight)\n            return true;\n    }\n    return false;\n}\nexport class TriGame {\n    id;\n    name;\n    numPlayers = 2;\n    size;\n    componentLabels;\n    constructor(options = {}) {\n        const size = options.size ?? 7;\n        if (!Number.isInteger(size) || size < 2) {\n            throw new Error(`size must be an integer >= 2; got ${size}.`);\n        }\n        this.size = size;\n        this.id = options.id ?? `tri-${size}`;\n        this.name = options.name ?? `Y (tri ${size})`;\n        this.componentLabels = Object.freeze([\n            ...(options.componentLabels ?? TRI_LABELS)\x2C\n        ]);\n    }\n    get width() {\n        return this.size;\n    }\n    get height() {\n        return this.size;\n    }\n    get siteCount() {\n        return triCellCount(this.size);\n    }\n    get numSites() {\n        return triCellCount(this.size);\n    }\n    start() {\n        const cells = new Array(this.siteCount).fill(0);\n        const state = new State(1\x2C cells\x2C this.componentLabels);\n        const trial = new Trial([]\x2C false\x2C -1).saveState(state);\n        return new Context(this\x2C state\x2C trial);\n    }\n    moves(context) {\n        if (context.over)\n            return [];\n        const out = [];\n        const mover = context.state.mover;\n        const label = this.componentLabels[mover - 1] ?? `P${mover}`;\n        for (let i = 0; i < this.siteCount; i += 1) {\n            if (context.state.cells[i] === 0) {\n                const [r\x2C c] = triCoords(i);\n                out.push(new Move({\n                    id: `m${context.trial.numMoves}:${i}:${mover}`\x2C\n                    label: `Place ${label} at (${r + 1}\x2C ${c + 1})`\x2C\n                    siteIndices: [i]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                }));\n            }\n        }\n        return out;\n    }\n    apply(context\x2C move) {\n        if (context.over) {\n            throw new Error("Cannot apply a move to a terminal trial.");\n        }\n        if (move.mover !== context.state.mover) {\n            throw new Error(`Move mover (${move.mover}) does not match state mover (${context.state.mover}).`);\n        }\n        const site = move.siteIndices[0];\n        if (site === undefined)\n            throw new Error("Move missing target site.");\n        if (context.state.cells[site] !== 0) {\n            throw new Error(`Site ${site} is already occupied.`);\n        }\n        const placed = move.applyTo(context.state);\n        const win = connectsAllSides(placed.cells\x2C this.size\x2C move.placedOwner);\n        const over = win;\n        const winner = win ? move.placedOwner : -1;\n        const advanced = over ? placed : placed.withMover(move.mover === 1 ? 2 : 1);\n        const trial = context.trial\n            .withMove(move\x2C over\x2C winner)\n            .saveState(advanced);\n        return new Context(this\x2C advanced\x2C trial);\n    }\n    over(context) {\n        return context.over;\n    }\n    concepts(context) {\n        let set = ConceptSet.of("Add"\x2C "AlternatingTurns"\x2C "ConnectionWin"\x2C "PieceOwnership"\x2C "DeterministicPlayout");\n        if (context) {\n            for (const move of this.moves(context)) {\n                set = set.union(move.concepts());\n            }\n        }\n        return set;\n    }\n}\nexport function triGame(size = 7) {\n    return new TriGame({ size });\n}\n//# sourceMappingURL=tri-game.js.map
