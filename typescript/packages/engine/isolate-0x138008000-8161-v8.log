script-source,207,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/move-stats.js,/**\n * Java parity:\n * - AI/src/search/mcts/playout/MAST.java\n * - AI/src/search/mcts/playout/NST.java\n *\n * Move-Average Sampling Technique (MAST) keeps a running mean of the\n * playout reward observed every time a given move was played\x2C indexed by\n * Move.hash(). N-gram Sampling Technique (NST) does the same for n-grams\n * of consecutive moves (n=2 here \u2014 bigrams keyed by previous-move hash).\n */\nexport class MoveStats {\n    table = new Map();\n    update(move\x2C reward) {\n        const key = move.hash();\n        const cur = this.table.get(key);\n        if (cur === undefined) {\n            this.table.set(key\x2C { visits: 1\x2C totalReward: reward });\n        }\n        else {\n            cur.visits += 1;\n            cur.totalReward += reward;\n        }\n    }\n    mean(move) {\n        const cur = this.table.get(move.hash());\n        if (!cur || cur.visits === 0)\n            return 0;\n        return cur.totalReward / cur.visits;\n    }\n    visits(move) {\n        return this.table.get(move.hash())?.visits ?? 0;\n    }\n    size() {\n        return this.table.size;\n    }\n    clear() {\n        this.table.clear();\n    }\n}\n/**\n * Bigram stats keyed by (prev-move-hash\x2C current-move-hash). For the\n * first ply of a playout the prev key is 0.\n */\nexport class BigramStats {\n    table = new Map();\n    static key(prev\x2C current) {\n        return `${prev}:${current}`;\n    }\n    update(prevHash\x2C move\x2C reward) {\n        const key = BigramStats.key(prevHash\x2C move.hash());\n        const cur = this.table.get(key);\n        if (cur === undefined) {\n            this.table.set(key\x2C { visits: 1\x2C totalReward: reward });\n        }\n        else {\n            cur.visits += 1;\n            cur.totalReward += reward;\n        }\n    }\n    mean(prevHash\x2C move) {\n        const cur = this.table.get(BigramStats.key(prevHash\x2C move.hash()));\n        if (!cur || cur.visits === 0)\n            return 0;\n        return cur.totalReward / cur.visits;\n    }\n    visits(prevHash\x2C move) {\n        return this.table.get(BigramStats.key(prevHash\x2C move.hash()))?.visits ?? 0;\n    }\n    size() {\n        return this.table.size;\n    }\n    clear() {\n        this.table.clear();\n    }\n}\n//# sourceMappingURL=move-stats.js.map
