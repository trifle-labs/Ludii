script-source,210,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/pns-ai.js,/**\n * Java parity: AI/src/search/pns/ProofNumberSearch.java + PNSNode.java \u2014\n * a best-first AND/OR search that assigns proof and disproof numbers to\n * leaf states and expands the "most-proving" node at every iteration.\n *\n * Proves (or disproves) that a position is a win/loss for a designated\n * proof player. Suited to two-player deterministic games with perfect\n * information. For positions PNS can't fully resolve within the budget\x2C\n * `selectAction` falls back to picking a move that minimises the proof\n * number (i.e. closest to proven) at the root.\n *\n * Differences from Java:\n *   - Iteration / time budgets are first-class (Java's `selectAction`\n *     ignores `maxSeconds` / `maxIterations`).\n *   - "Infinity" uses `Number.POSITIVE_INFINITY`. Integer overflow is\n *     not a concern in JS so we don't cap.\n *   - `deleteSubtree` is implemented by dropping the children array\n *     (frees the reference; GC handles the rest).\n */\nimport { AI } from "./ai.js";\nconst INF = Number.POSITIVE_INFINITY;\nconst DEFAULT_ITERS = 100_000;\nexport class PNSAI extends AI {\n    proofGoal;\n    defaultIterations;\n    /** Status after the most recent search. */\n    lastStatus = "unresolved";\n    lastIterations = 0;\n    constructor(options = {}) {\n        super();\n        this.friendlyName = "Proof-Number Search";\n        this.proofGoal = options.proofGoal ?? "prove-win";\n        this.defaultIterations = options.defaultIterations ?? DEFAULT_ITERS;\n    }\n    selectAction(context\x2C options = {}) {\n        const proofPlayer = context.mover;\n        const rootMoves = context.game.moves(context);\n        if (rootMoves.length === 0)\n            return undefined;\n        if (rootMoves.length === 1) {\n            this.lastStatus = "unresolved";\n            this.lastIterations = 0;\n            return rootMoves[0];\n        }\n        const maxIters = options.maxIterations && options.maxIterations > 0\n            ? options.maxIterations\n            : this.defaultIterations;\n        const deadlineMs = options.maxSeconds && options.maxSeconds > 0\n            ? Date.now() + options.maxSeconds * 1000\n            : Number.POSITIVE_INFINITY;\n        const root = this.makeNode(undefined\x2C context\x2C proofPlayer);\n        this.evaluate(root\x2C proofPlayer);\n        setProofAndDisproofNumbers(root);\n        let iters = 0;\n        let current = root;\n        while (root.proofNumber !== 0 &&\n            root.disproofNumber !== 0 &&\n            iters < maxIters &&\n            Date.now() < deadlineMs) {\n            const mostProving = selectMostProvingNode(current);\n            this.expandNode(mostProving\x2C proofPlayer);\n            current = updateAncestors(mostProving);\n            iters += 1;\n        }\n        this.lastIterations = iters;\n        if (root.proofNumber === 0)\n            this.lastStatus = "proven";\n        else if (root.disproofNumber === 0)\n            this.lastStatus = "disproven";\n        else\n            this.lastStatus = "unresolved";\n        return this.pickRootMove(root\x2C rootMoves);\n    }\n    pickRootMove(root\x2C fallback) {\n        // Root is an OR-node when we're trying to PROVE the goal (we're\n        // choosing among siblings; one proven branch suffices). For an\n        // AND-node we still report some move \u2014 picking the most-proving\n        // child still tends to be the right defensive choice.\n        if (!root.children)\n            return fallback[0];\n        let bestIdx = 0;\n        let bestScore = INF;\n        for (let i = 0; i < root.children.length; i += 1) {\n            const child = root.children[i];\n            if (!child)\n                continue;\n            const score = root.type === "or" ? child.proofNumber : child.disproofNumber;\n            if (score < bestScore) {\n                bestScore = score;\n                bestIdx = i;\n            }\n        }\n        return root.legalMoves[bestIdx] ?? fallback[0];\n    }\n    makeNode(parent\x2C context\x2C proofPlayer) {\n        const moves = context.game.moves(context);\n        const isProofPlayerToMove = context.mover === proofPlayer;\n        // Proof goal + side-to-move determines AND/OR. PROVE_WIN: my move \u2192\n        // OR (any winning child suffices); opponent's move \u2192 AND. PROVE_LOSS\n        // flips both.\n        let type;\n        if (isProofPlayerToMove) {\n            type = this.proofGoal === "prove-win" ? "or" : "and";\n        }\n        else {\n            type = this.proofGoal === "prove-win" ? "and" : "or";\n        }\n        return {\n            parent\x2C\n            type\x2C\n            context\x2C\n            legalMoves: moves\x2C\n            children: moves.length > 0 ? new Array(moves.length).fill(undefined) : []\x2C\n            expanded: false\x2C\n            proofNumber: -1\x2C\n            disproofNumber: -1\x2C\n            value: "unknown"\x2C\n        };\n    }\n    evaluate(node\x2C proofPlayer) {\n        const ctx = node.context;\n        if (!ctx.over) {\n            node.value = "unknown";\n            return;\n        }\n        const winner = ctx.winner;\n        if (winner === proofPlayer) {\n            node.value = this.proofGoal === "prove-win" ? "true" : "false";\n        }\n        else if (winner === 0) {\n            // Draw \u2014 neither proves nor disproves.\n            node.value = "false";\n        }\n        else {\n            node.value = this.proofGoal === "prove-win" ? "false" : "true";\n        }\n    }\n    expandNode(node\x2C proofPlayer) {\n        if (!node.children) {\n            node.expanded = true;\n            return;\n        }\n        for (let i = 0; i < node.children.length; i += 1) {\n            const move = node.legalMoves[i];\n            if (!move)\n                continue;\n            const childCtx = node.context.game.apply(node.context\x2C move);\n            const child = this.makeNode(node\x2C childCtx\x2C proofPlayer);\n            node.children[i] = child;\n            this.evaluate(child\x2C proofPlayer);\n            setProofAndDisproofNumbers(child);\n            // Short-circuit: if this child already proves/disproves our node\x2C\n            // stop expanding siblings (matches Java).\n            if (node.type === "or" && child.proofNumber === 0)\n                break;\n            if (node.type === "and" && child.disproofNumber === 0)\n                break;\n        }\n        node.expanded = true;\n    }\n}\nfunction setProofAndDisproofNumbers(node) {\n    if (node.expanded && node.children) {\n        if (node.type === "and") {\n            let pn = 0;\n            let dn = INF;\n            for (const child of node.children) {\n                if (!child)\n                    continue;\n                pn = pn + child.proofNumber;\n                if (child.disproofNumber < dn)\n                    dn = child.disproofNumber;\n            }\n            node.proofNumber = pn;\n            node.disproofNumber = dn;\n        }\n        else {\n            let pn = INF;\n            let dn = 0;\n            for (const child of node.children) {\n                if (!child)\n                    continue;\n                dn = dn + child.disproofNumber;\n                if (child.proofNumber < pn)\n                    pn = child.proofNumber;\n            }\n            node.proofNumber = pn;\n            node.disproofNumber = dn;\n        }\n        return;\n    }\n    // Leaf.\n    switch (node.value) {\n        case "false":\n            node.proofNumber = INF;\n            node.disproofNumber = 0;\n            break;\n        case "true":\n            node.proofNumber = 0;\n            node.disproofNumber = INF;\n            break;\n        default: {\n            const fanout = Math.max(1\x2C node.legalMoves.length);\n            if (node.type === "and") {\n                node.proofNumber = fanout;\n                node.disproofNumber = 1;\n            }\n            else {\n                node.proofNumber = 1;\n                node.disproofNumber = fanout;\n            }\n            break;\n        }\n    }\n}\nfunction selectMostProvingNode(start) {\n    let current = start;\n    while (current.expanded && current.children) {\n        let next;\n        if (current.type === "or") {\n            for (const child of current.children) {\n                if (child && child.proofNumber === current.proofNumber) {\n                    next = child;\n                    break;\n                }\n            }\n        }\n        else {\n            for (const child of current.children) {\n                if (child && child.disproofNumber === current.disproofNumber) {\n                    next = child;\n                    break;\n                }\n            }\n        }\n        if (!next)\n            return current;\n        current = next;\n    }\n    return current;\n}\nfunction updateAncestors(start) {\n    let node = start;\n    while (node) {\n        const oldProof = node.proofNumber;\n        const oldDisproof = node.disproofNumber;\n        setProofAndDisproofNumbers(node);\n        if (node.proofNumber === oldProof && node.disproofNumber === oldDisproof) {\n            return node;\n        }\n        if (node.proofNumber === 0 || node.disproofNumber === 0) {\n            // Subtree (dis)proven \u2014 drop children to free memory.\n            node.children = undefined;\n        }\n        if (!node.parent)\n            return node;\n        node = node.parent;\n    }\n    return start;\n}\n//# sourceMappingURL=pns-ai.js.map
