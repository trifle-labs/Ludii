script-source,126,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/flat-board-game.js,// @java Core/src/game/Game.java Game (TS template subset)\n/**\n * Java parity:\n * - Conceptually a hand-rolled subset of `Core/src/game/Game.java`\n *   instantiated for the "place on empty until N-in-a-row" rule shape.\n *\n * Designed for the MVE: any rectangular grid\x2C any number of players\x2C\n * any in-a-row length K. Players take alternating turns. The game ends\n * either with the active mover winning (their move completed a line) or\n * with a draw when every cell is filled.\n */\nimport { ConceptSet } from "./concept.js";\nimport { Context } from "./context.js";\nimport { Move } from "./move.js";\nimport { State } from "./state.js";\nimport { Trial } from "./trial.js";\nconst DEFAULT_COMPONENT_LABELS = ["X"\x2C "O"\x2C "\u25b3"\x2C "\u25a1"\x2C "\u25c7"\x2C "\u2605"\x2C "\u25cf"\x2C "\u25a0"];\nfunction siteIndex(width\x2C x\x2C y) {\n    return y * width + x;\n}\nfunction nextMover(mover\x2C numPlayers) {\n    return (mover % numPlayers) + 1;\n}\nfunction hasLine(cells\x2C width\x2C height\x2C lineLength\x2C owner\x2C lastSite) {\n    if (owner === 0) {\n        return false;\n    }\n    const lx = lastSite % width;\n    const ly = Math.floor(lastSite / width);\n    const directions = [\n        [1\x2C 0]\x2C\n        [0\x2C 1]\x2C\n        [1\x2C 1]\x2C\n        [1\x2C -1]\x2C\n    ];\n    for (const [dx\x2C dy] of directions) {\n        let count = 1;\n        for (let s = 1; s < lineLength; s += 1) {\n            const x = lx + dx * s;\n            const y = ly + dy * s;\n            if (x < 0 || x >= width || y < 0 || y >= height) {\n                break;\n            }\n            if (cells[siteIndex(width\x2C x\x2C y)] !== owner) {\n                break;\n            }\n            count += 1;\n        }\n        for (let s = 1; s < lineLength; s += 1) {\n            const x = lx - dx * s;\n            const y = ly - dy * s;\n            if (x < 0 || x >= width || y < 0 || y >= height) {\n                break;\n            }\n            if (cells[siteIndex(width\x2C x\x2C y)] !== owner) {\n                break;\n            }\n            count += 1;\n        }\n        if (count >= lineLength) {\n            return true;\n        }\n    }\n    return false;\n}\nexport class FlatBoardGame {\n    id;\n    name;\n    numPlayers;\n    width;\n    height;\n    lineLength;\n    componentLabels;\n    initialPlacement;\n    initialMover;\n    get numSites() {\n        return this.width * this.height;\n    }\n    constructor(options) {\n        if (!Number.isInteger(options.width) || options.width <= 0) {\n            throw new Error(`width must be a positive integer; got ${options.width}.`);\n        }\n        if (!Number.isInteger(options.height) || options.height <= 0) {\n            throw new Error(`height must be a positive integer; got ${options.height}.`);\n        }\n        if (!Number.isInteger(options.numPlayers) || options.numPlayers < 0) {\n            throw new Error(`numPlayers must be a non-negative integer; got ${options.numPlayers}.`);\n        }\n        if (!Number.isInteger(options.lineLength) || options.lineLength < 2) {\n            throw new Error(`lineLength must be an integer >= 2; got ${options.lineLength}.`);\n        }\n        this.id = options.id;\n        this.name = options.name;\n        this.width = options.width;\n        this.height = options.height;\n        this.numPlayers = options.numPlayers;\n        this.lineLength = options.lineLength;\n        const labels = options.componentLabels ??\n            DEFAULT_COMPONENT_LABELS.slice(0\x2C options.numPlayers);\n        if (labels.length < options.numPlayers) {\n            throw new Error(`componentLabels must include one label per player (need ${options.numPlayers}\x2C got ${labels.length}).`);\n        }\n        this.componentLabels = Object.freeze([...labels]);\n        const siteCount = this.width * this.height;\n        if (options.initialPlacement !== undefined) {\n            if (options.initialPlacement.length !== siteCount) {\n                throw new Error(`initialPlacement must have ${siteCount} entries; got ${options.initialPlacement.length}.`);\n            }\n            this.initialPlacement = Object.freeze([...options.initialPlacement]);\n        }\n        else {\n            this.initialPlacement = Object.freeze(new Array(siteCount).fill(0));\n        }\n        // 0-player simulations have no mover; default to 0 in that case.\n        const moverDefault = this.numPlayers === 0 ? 0 : 1;\n        const mover = options.initialMover ?? moverDefault;\n        const moverMin = this.numPlayers === 0 ? 0 : 1;\n        if (!Number.isInteger(mover) ||\n            mover < moverMin ||\n            mover > this.numPlayers) {\n            throw new Error(`initialMover must be ${moverMin}..${this.numPlayers}; got ${mover}.`);\n        }\n        this.initialMover = mover;\n    }\n    get siteCount() {\n        return this.width * this.height;\n    }\n    start() {\n        const cells = [...this.initialPlacement];\n        const state = new State(this.initialMover\x2C cells\x2C this.componentLabels);\n        // 0-player simulations are immediately terminal from the engine's\n        // POV \u2014 no mover\x2C no legal moves. The trial state holds the initial\n        // configuration so callers can still inspect it.\n        const initiallyOver = this.numPlayers === 0;\n        const trial = new Trial([]\x2C initiallyOver\x2C initiallyOver ? 0 : -1).saveState(state);\n        return new Context(this\x2C state\x2C trial);\n    }\n    moves(context) {\n        if (context.over) {\n            return [];\n        }\n        const out = [];\n        const mover = context.state.mover;\n        const label = this.componentLabels[mover - 1] ?? `P${mover}`;\n        for (let i = 0; i < this.siteCount; i += 1) {\n            if (context.state.cells[i] === 0) {\n                const x = i % this.width;\n                const y = Math.floor(i / this.width);\n                out.push(new Move({\n                    id: `m${context.trial.numMoves}:${i}:${mover}`\x2C\n                    label: `Play ${label} at (${x + 1}\x2C ${y + 1})`\x2C\n                    siteIndices: [i]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                }));\n            }\n        }\n        return out;\n    }\n    apply(context\x2C move) {\n        if (context.over) {\n            throw new Error("Cannot apply a move to a terminal trial.");\n        }\n        if (move.mover !== context.state.mover) {\n            throw new Error(`Move mover (${move.mover}) does not match state mover (${context.state.mover}).`);\n        }\n        const site = move.siteIndices[0];\n        if (site === undefined) {\n            throw new Error("Move missing target site.");\n        }\n        if (context.state.cells[site] !== 0) {\n            throw new Error(`Site ${site} is already occupied.`);\n        }\n        const placed = move.applyTo(context.state);\n        const winner = hasLine(placed.cells\x2C this.width\x2C this.height\x2C this.lineLength\x2C move.placedOwner\x2C site)\n            ? move.placedOwner\n            : -1;\n        const filled = placed.cells.every((c) => c !== 0);\n        const over = winner !== -1 || filled;\n        const finalWinner = winner === -1 && over ? 0 : winner;\n        const advanced = over\n            ? placed\n            : placed.withMover(nextMover(placed.mover\x2C this.numPlayers));\n        const trial = context.trial\n            .withMove(move\x2C over\x2C finalWinner)\n            .saveState(advanced);\n        return new Context(this\x2C advanced\x2C trial);\n    }\n    over(context) {\n        return context.over;\n    }\n    /**\n     * Java parity: `Game.concepts()`. Structural concepts for the\n     * "place to make a line" family are constant; plus the concepts\n     * implied by every legal move.\n     */\n    concepts(context) {\n        let set = ConceptSet.of("Add"\x2C "AlternatingTurns"\x2C "LineWin"\x2C "DrawByFill"\x2C "PieceOwnership"\x2C "DeterministicPlayout");\n        if (context) {\n            for (const move of this.moves(context)) {\n                set = set.union(move.concepts());\n            }\n        }\n        return set;\n    }\n}\nexport function ticTacToeGame() {\n    return new FlatBoardGame({\n        id: "tic-tac-toe"\x2C\n        name: "Tic-Tac-Toe"\x2C\n        width: 3\x2C\n        height: 3\x2C\n        numPlayers: 2\x2C\n        lineLength: 3\x2C\n        componentLabels: ["X"\x2C "O"]\x2C\n    });\n}\n//# sourceMappingURL=flat-board-game.js.map
