code-creation,Script,9,90000,0x2325599ef1d0,378, file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/tilings.js:1:1,0x3d74e7e58e78,~
script-source,216,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/tilings.js,/**\n * Board tilings for the ludeme interpreter.\n *\n * Java parity:\n * - Core/src/game/types/board/TilingMethod and the `(hex \u2026)` / `(tri \u2026)` /\n *   `(square \u2026)` board builders in game.functions.graph.generators.basis.*\n *\n * The interpreter steps the board as a 2-D integer lattice: every neighbour\n * is reached by adding a `(dx\x2C dy)` offset to a site's `(x\x2C y)` coordinate\n * and mapping back through `InterpBoard.siteAt`. That model is coordinate-\n * agnostic\x2C so a hex board is just a different *direction set* over the same\n * lattice using axial coordinates \u2014 `q` along x\x2C `r` along y. A `Tiling`\n * therefore only has to supply the compass/relative/grouped offset tables;\n * non-rectangular shapes (the Hexagon outline) are handled by an on-board\n * mask computed at board-construction time\x2C leaving the stepping code below\n * unchanged.\n */\n// ---- square -----------------------------------------------------------------\nconst SQUARE_ABSOLUTE = {\n    N: { dx: 0\x2C dy: 1 }\x2C\n    S: { dx: 0\x2C dy: -1 }\x2C\n    E: { dx: 1\x2C dy: 0 }\x2C\n    W: { dx: -1\x2C dy: 0 }\x2C\n    NE: { dx: 1\x2C dy: 1 }\x2C\n    NW: { dx: -1\x2C dy: 1 }\x2C\n    SE: { dx: 1\x2C dy: -1 }\x2C\n    SW: { dx: -1\x2C dy: -1 }\x2C\n};\nconst SQUARE_RELATIVE = {\n    Forward: { dx: 0\x2C dy: 1 }\x2C\n    Forwards: { dx: 0\x2C dy: 1 }\x2C\n    Backward: { dx: 0\x2C dy: -1 }\x2C\n    Backwards: { dx: 0\x2C dy: -1 }\x2C\n    Rightward: { dx: 1\x2C dy: 0 }\x2C\n    Rightwards: { dx: 1\x2C dy: 0 }\x2C\n    Leftward: { dx: -1\x2C dy: 0 }\x2C\n    Leftwards: { dx: -1\x2C dy: 0 }\x2C\n    FR: { dx: 1\x2C dy: 1 }\x2C\n    FL: { dx: -1\x2C dy: 1 }\x2C\n    BR: { dx: 1\x2C dy: -1 }\x2C\n    BL: { dx: -1\x2C dy: -1 }\x2C\n};\nfunction pick(table\x2C names) {\n    const out = [];\n    for (const n of names) {\n        const d = table[n];\n        if (d)\n            out.push(d);\n    }\n    return out;\n}\nconst SQUARE_ORTHOGONAL = pick(SQUARE_ABSOLUTE\x2C ["N"\x2C "E"\x2C "S"\x2C "W"]);\nconst SQUARE_DIAGONAL = pick(SQUARE_ABSOLUTE\x2C ["NE"\x2C "SE"\x2C "SW"\x2C "NW"]);\nconst SQUARE_ALL = [...SQUARE_ORTHOGONAL\x2C ...SQUARE_DIAGONAL];\nexport const SQUARE_TILING = {\n    kind: "square"\x2C\n    absolute: SQUARE_ABSOLUTE\x2C\n    relative: SQUARE_RELATIVE\x2C\n    groups: {\n        Orthogonal: SQUARE_ORTHOGONAL\x2C\n        Diagonal: SQUARE_DIAGONAL\x2C\n        // Java (Face.stepsTo): on a square board `Adjacent` tags both edge- and\n        // vertex-sharing neighbours\x2C i.e. all 8 directions.\n        Adjacent: SQUARE_ALL\x2C\n        All: SQUARE_ALL\x2C\n    }\x2C\n};\n// ---- hex (axial\x2C pointy-topped) --------------------------------------------\n/**\n * Pointy-topped hexes in axial coordinates: `q` increases east\x2C `r`\n * increases north. The six edge-neighbours are the canonical axial unit\n * vectors. A pointy-top hex has no due-N/S neighbour\x2C so the compass set is\n * E/W plus the four corner diagonals.\n */\nconst HEX_ABSOLUTE = {\n    E: { dx: 1\x2C dy: 0 }\x2C\n    W: { dx: -1\x2C dy: 0 }\x2C\n    NE: { dx: 0\x2C dy: 1 }\x2C\n    NW: { dx: -1\x2C dy: 1 }\x2C\n    SE: { dx: 1\x2C dy: -1 }\x2C\n    SW: { dx: 0\x2C dy: -1 }\x2C\n};\nconst HEX_RELATIVE = {\n    Forward: { dx: 0\x2C dy: 1 }\x2C\n    Forwards: { dx: 0\x2C dy: 1 }\x2C\n    Backward: { dx: 0\x2C dy: -1 }\x2C\n    Backwards: { dx: 0\x2C dy: -1 }\x2C\n    Rightward: { dx: 1\x2C dy: 0 }\x2C\n    Rightwards: { dx: 1\x2C dy: 0 }\x2C\n    Leftward: { dx: -1\x2C dy: 0 }\x2C\n    Leftwards: { dx: -1\x2C dy: 0 }\x2C\n};\nconst HEX_ALL = pick(HEX_ABSOLUTE\x2C ["E"\x2C "NE"\x2C "NW"\x2C "W"\x2C "SW"\x2C "SE"]);\nexport const HEX_TILING = {\n    kind: "hex"\x2C\n    absolute: HEX_ABSOLUTE\x2C\n    relative: HEX_RELATIVE\x2C\n    groups: {\n        // A hex grid has no orthogonal/diagonal split: every group keyword maps\n        // to the six edge-adjacent neighbours.\n        Orthogonal: HEX_ALL\x2C\n        Diagonal: HEX_ALL\x2C\n        Adjacent: HEX_ALL\x2C\n        All: HEX_ALL\x2C\n    }\x2C\n};\n// ---- tri (triangular vertex lattice) ---------------------------------------\n/**\n * Triangular tiling\x2C vertex mode \u2014 which is what essentially every corpus\n * `(tri \u2026)` game uses. A triangular lattice is a square lattice with one\n * diagonal added\x2C so it embeds in the integer grid with a uniform six-\n * neighbour set: the four orthogonals plus the NE/SW diagonal. (The NW/SE\n * diagonal is the longer \u221a3 chord and is *not* an edge.)\n */\nconst TRI_ABSOLUTE = {\n    N: { dx: 0\x2C dy: 1 }\x2C\n    S: { dx: 0\x2C dy: -1 }\x2C\n    E: { dx: 1\x2C dy: 0 }\x2C\n    W: { dx: -1\x2C dy: 0 }\x2C\n    NE: { dx: 1\x2C dy: 1 }\x2C\n    SW: { dx: -1\x2C dy: -1 }\x2C\n};\nconst TRI_RELATIVE = {\n    Forward: { dx: 0\x2C dy: 1 }\x2C\n    Forwards: { dx: 0\x2C dy: 1 }\x2C\n    Backward: { dx: 0\x2C dy: -1 }\x2C\n    Backwards: { dx: 0\x2C dy: -1 }\x2C\n    Rightward: { dx: 1\x2C dy: 0 }\x2C\n    Rightwards: { dx: 1\x2C dy: 0 }\x2C\n    Leftward: { dx: -1\x2C dy: 0 }\x2C\n    Leftwards: { dx: -1\x2C dy: 0 }\x2C\n};\nconst TRI_ALL = pick(TRI_ABSOLUTE\x2C ["N"\x2C "S"\x2C "E"\x2C "W"\x2C "NE"\x2C "SW"]);\nexport const TRI_TILING = {\n    kind: "tri"\x2C\n    absolute: TRI_ABSOLUTE\x2C\n    relative: TRI_RELATIVE\x2C\n    groups: {\n        Orthogonal: TRI_ALL\x2C\n        Diagonal: TRI_ALL\x2C\n        Adjacent: TRI_ALL\x2C\n        All: TRI_ALL\x2C\n    }\x2C\n};\n/**\n * Coerce a board dimension to a positive integer. Non-finite inputs (a NaN\n * left by an unresolved option or an unsupported size expression) fall back\n * to `fallback` so the mask allocation never throws "Invalid array length".\n */\nfunction safeDim(value\x2C fallback = 3) {\n    if (!Number.isFinite(value))\n        return fallback;\n    return Math.max(1\x2C Math.floor(value));\n}\n/**\n * A regular hexagonal outline of side `side` laid on an axial bounding box.\n * Cell count is `3\xb7side\xb2 \u2212 3\xb7side + 1` (Java's Hexagon shape). The box is\n * `(2\xb7side \u2212 1)\xb2`; cells outside the hex radius are masked off.\n */\nexport function hexagonMask(side) {\n    const n = safeDim(side);\n    const radius = n - 1;\n    const span = 2 * n - 1;\n    const onBoard = new Array(span * span);\n    for (let r = 0; r < span; r += 1) {\n        for (let q = 0; q < span; q += 1) {\n            const qa = q - radius;\n            const ra = r - radius;\n            // axial hex distance from centre \u2264 radius\n            const inside = Math.abs(qa) <= radius &&\n                Math.abs(ra) <= radius &&\n                Math.abs(qa + ra) <= radius;\n            onBoard[r * span + q] = inside;\n        }\n    }\n    return { width: span\x2C height: span\x2C onBoard };\n}\n/** A rhombus / parallelogram of hexes: `cols \xd7 rows`\x2C fully filled. */\nexport function rhombusMask(cols\x2C rows) {\n    return {\n        width: safeDim(cols)\x2C\n        height: safeDim(rows)\x2C\n    };\n}\n/**\n * Triangle outline of side `n` on the triangular lattice. Bounding box n\xd7n\x2C\n * lower-triangular (a cell is on-board where `x \u2265 y`). Cell count n(n+1)/2.\n */\nexport function triangleMask(n) {\n    const N = safeDim(n);\n    const onBoard = new Array(N * N);\n    for (let y = 0; y < N; y += 1) {\n        for (let x = 0; x < N; x += 1) {\n            onBoard[y * N + x] = x >= y;\n        }\n    }\n    return { width: N\x2C height: N\x2C onBoard };\n}\n/**\n * Hexagonal outline of side `n` on the triangular lattice. Bounding box\n * `(2n\u22121)\xb2`; cell count `3n\xb2\u22123n+1`.\n */\nexport function triHexagonMask(n) {\n    const N = safeDim(n);\n    const span = 2 * N - 1;\n    const half = N - 1;\n    const onBoard = new Array(span * span);\n    for (let y = 0; y < span; y += 1) {\n        for (let x = 0; x < span; x += 1) {\n            onBoard[y * span + x] = x <= half + y && y - x <= half;\n        }\n    }\n    return { width: span\x2C height: span\x2C onBoard };\n}\n/**\n * Rectangular strip of `rows \xd7 cols` on the triangular lattice. The rows\n * shear by half a cell each step\x2C so the bounding box is `rows + cols` wide\n * with a staircase mask.\n */\nexport function triRectangleMask(rows\x2C cols) {\n    const r = safeDim(rows);\n    const c = safeDim(cols);\n    const w = r + c;\n    const onBoard = new Array(r * w);\n    for (let y = 0; y < r; y += 1) {\n        for (let x = 0; x < w; x += 1) {\n            onBoard[y * w + x] = x >= Math.ceil(y / 2) && x < c + Math.floor(y / 2);\n        }\n    }\n    return { width: w\x2C height: r\x2C onBoard };\n}\n//# sourceMappingURL=tilings.js.map
