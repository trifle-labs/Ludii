script-source,196,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/ai.js,/**\n * Java parity: Core/src/other/AI.java \u2014 base type for AI players.\n *\n * The Java AI surface is large (initAI\x2C selectAction\x2C generateAnalysisReport\x2C\n * features\x2C \u2026). The TS engine only needs `selectAction(context\x2C options)` \u2014\n * the rest is left as no-op hooks subclasses can override.\n */\nexport class AI {\n    /** Java parity: `AI.friendlyName`. */\n    friendlyName = "AI";\n    /** Index of the player this AI plays for; -1 = unassigned. */\n    player = -1;\n    /** Java parity: `AI.initAI(game\x2C playerID)`. */\n    initAI(playerID) {\n        this.player = playerID;\n    }\n    /** Java parity: `AI.closeAI()` \u2014 release resources. */\n    closeAI() {\n        // default: nothing to release\n    }\n}\n//# sourceMappingURL=ai.js.map
