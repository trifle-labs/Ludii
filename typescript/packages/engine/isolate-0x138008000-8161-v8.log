 items[0];\n        if (only && isList(only) && only.delimiter === "curly") {\n            return only.items;\n        }\n    }\n    return items;\n}\n/**\n * Compile a moves-list body (`(or \u2026)`\x2C a bare `{ \u2026 }` block\x2C `(priority \u2026)`).\n * A trailing `(then <effect>)` sibling is not a generator \u2014 it decorates the\n * moves produced by the other alternatives\x2C so it is split out\x2C compiled via\n * `compileThen`\x2C and folded into every generated move. `combine` defines how\n * the surviving generators are joined (concat for `or`\x2C first-non-empty for\n * `priority`).\n */\nfunction compileMovesList(children\x2C env\x2C combine) {\n    const gens = [];\n    const thens = [];\n    for (const child of flattenMoveList(children)) {\n        if (isString(child))\n            continue; // skip define-name leftovers\n        if (isList(child) && listHead(child) === "then") {\n            thens.push(compileThen(child\x2C env));\n            continue;\n        }\n        gens.push(compileMoves(child\x2C env));\n    }\n    const base = combine(gens);\n    if (thens.length === 0)\n        return base;\n    const moveAgain = thens.some((t) => t.moveAgain);\n    const effects = thens\n        .map((t) => t.effect)\n        .filter((e) => e !== undefined);\n    return {\n        generate: (ctx) => base.generate(ctx).map((m) => {\n            // Record the move as the last move so `(last To)` / `(last From)` in a\n            // `(then \u2026)` resolve to it\x2C and bind its from/to into the frame.\n            const ectx = ctx\n                .withContext(ctx.context.withTrial(ctx.context.trial.withMove(m\x2C false\x2C -1)))\n                .withFrame({ from: m.from()\x2C to: m.to() });\n            const extra = effects.flatMap((e) => e(ectx));\n            return extra.length > 0 || moveAgain\n                ? m.withConsequence(extra\x2C moveAgain)\n                : m;\n        })\x2C\n    };\n}\nconst concatMoves = (parts) => ({\n    generate: (ctx) => parts.flatMap((p) => p.generate(ctx))\x2C\n});\nconst firstNonEmptyMoves = (parts) => ({\n    generate: (ctx) => {\n        for (const p of parts) {\n            const moves = p.generate(ctx);\n            if (moves.length > 0)\n                return moves;\n        }\n        return [];\n    }\x2C\n});\n/**\n * `(forEach Piece)` \u2014 iterate the mover's pieces\x2C binding `from` to each\n * occupied site and dispatching that piece's compiled move generator.\n */\nfunction compileForEach(node\x2C env) {\n    const kindNode = node.items[1];\n    const kind = kindNode && isIdent(kindNode) ? kindNode.name : "";\n    if (kind === "Player") {\n        // `(forEach Player <moves>)` \u2014 bind frame.player to each player index\n        // 1..numPlayers and run the inner move generator (So Long Sucker uses this\n        // to set the next active player). Java: ForEachPlayer.\n        const movesNode = node.items[2];\n        if (!movesNode)\n            return EMPTY_MOVES;\n        let inner;\n        try {\n            inner = compileMoves(movesNode\x2C env);\n        }\n        catch {\n            return EMPTY_MOVES;\n        }\n        const gen = inner;\n        return {\n            generate: (ctx) => {\n                const out = [];\n                const n = ctx.context.game.numPlayers;\n                for (let p = 1; p <= n; p += 1) {\n                    out.push(...gen.generate(ctx.withFrame({ player: p })));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Piece" || kind === "piece") {\n        // `(forEach Piece ["Name"] [<moves>] [(then \u2026)])`. An optional piece-type\n        // name and/or an explicit <moves> clause may follow `Piece`. The lowercase\n        // `(forEach piece)` is an accepted alias (Wumpus World).\n        //\n        // With an explicit <moves> clause (e.g. checkers' `(forEach Piece "Counter"\n        // ("StepToEmpty" \u2026) (then \u2026))`)\x2C run that clause from each of the mover's\n        // piece sites with `from` bound\x2C folding any sibling (then \u2026) into every\n        // generated move. The piece-type name is accepted but not filtered on: this\n        // engine tracks owner\x2C not per-site component identity\x2C so all the mover's\n        // pieces are iterated. Without a clause\x2C dispatch to each piece's\n        // equipment-defined move generator.\n        const after = node.items.slice(2);\n        const movesNode = after.find((n) => isList(n) && listHead(n) !== "then");\n        if (movesNode) {\n            const inner = compileMoves(movesNode\x2C env);\n            const thens = after\n                .filter((n) => isList(n) && listHead(n) === "then")\n                .map((n) => compileThen(n\x2C env));\n            const moveAgain = thens.some((t) => t.moveAgain);\n            const effects = thens\n                .map((t) => t.effect)\n                .filter((e) => e !== undefined);\n            return {\n                generate: (ctx) => {\n                    const out = [];\n                    const mover = ctx.mover;\n                    const cells = ctx.state.cells;\n                    for (let s = 0; s < cells.length; s += 1) {\n                        if (cells[s] !== mover)\n                            continue;\n                        const sub = ctx.withFrame({ from: s\x2C piece: mover });\n                        for (const m of inner.generate(sub)) {\n                            if (effects.length === 0 && !moveAgain) {\n                                out.push(m);\n                                continue;\n                            }\n                            const ectx = sub\n                                .withContext(sub.context.withTrial(sub.context.trial.withMove(m\x2C false\x2C -1)))\n                                .withFrame({ from: m.from()\x2C to: m.to() });\n                            const extra = effects.flatMap((e) => e(ectx));\n                            out.push(extra.length > 0 || moveAgain\n                                ? m.withConsequence(extra\x2C moveAgain)\n                                : m);\n                        }\n                    }\n                    return out;\n                }\x2C\n            };\n        }\n        return {\n            generate: (ctx) => {\n                const byOwner = env.pieceMovesByOwner;\n                const byWhat = env.pieceMovesByWhat;\n                if (!byOwner)\n                    return [];\n                const mover = ctx.mover;\n                const ownerGen = byOwner.get(mover);\n                const out = [];\n                const cells = ctx.state.cells;\n                const state = ctx.state;\n                for (let s = 0; s < cells.length; s += 1) {\n                    if (cells[s] !== mover)\n                        continue;\n                    // Dispatch the generator for the *component* on this site (Java:\n                    // each Component has its own move rule). Heterogeneous-piece games\n                    // (chess) hit the per-`what` map; single-piece games fall back to the\n                    // per-owner generator\x2C which is identical to the old behaviour.\n                    const what = state.whatAtSite(s);\n                    const gen = byWhat?.get(what) ?? ownerGen;\n                    if (!gen)\n                        continue;\n                    const sub = ctx.withFrame({ from: s\x2C piece: what });\n                    out.push(...gen.generate(sub));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Site") {\n        // (forEach Site <region> <moves>) \u2014 bind frame.site (and to) to each\n        // member of the region\x2C then run the inner move generator there.\n        const regionNode = node.items[2];\n        const movesNode = node.items[3];\n        if (!regionNode || !movesNode)\n            throw new LudemeCompileError("(forEach Site \u2026) needs a region and a moves clause.");\n        const region = compileRegion(regionNode\x2C env);\n        const inner = compileMoves(movesNode\x2C env);\n        return {\n            generate: (ctx) => {\n                const out = [];\n                for (const s of region.eval(ctx)) {\n                    if (s < 0)\n                        continue;\n                    out.push(...inner.generate(ctx.withFrame({ site: s\x2C to: s })));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Value") {\n        // (forEach Value min:<a> max:<b> <moves>) \u2014 bind frame.value to each\n        // integer in [min\x2C max] and run the inner move generator.\n        const { positional\x2C named } = parseArgs(node.items.slice(2));\n        const minNode = named.get("min");\n        const maxNode = named.get("max");\n        // (forEach Value <intArray> <moves>) \u2014 iterate over an explicit list of\n        // values (e.g. (values Remembered "Throws") or (array \u2026)) instead of a\n        // numeric range\x2C binding frame.value to each element.\n        if (!minNode && !maxNode) {\n            const listNode = positional[0];\n            const movesNode = positional[1];\n            if (!listNode || !movesNode)\n                throw new LudemeCompileError("(forEach Value <list> <moves>) needs a list and a moves clause.");\n            const listFn = compileRegion(listNode\x2C env);\n            const inner = compileMoves(movesNode\x2C env);\n            return {\n                generate: (ctx) => {\n                    const out = [];\n                    for (const v of listFn.eval(ctx)) {\n                        out.push(...inner.generate(ctx.withFrame({ value: v })));\n                    }\n                    return out;\n                }\x2C\n            };\n        }\n        const movesNode = positional[0];\n        if (!minNode || !maxNode || !movesNode)\n            throw new LudemeCompileError("(forEach Value \u2026) needs min:\x2C max: and a moves clause.");\n        const minFn = compileInt(minNode\x2C env);\n        const maxFn = compileInt(maxNode\x2C env);\n        const inner = compileMoves(movesNode\x2C env);\n        return {\n            generate: (ctx) => {\n                const lo = minFn.eval(ctx);\n                const hi = maxFn.eval(ctx);\n                const out = [];\n                for (let v = lo; v <= hi; v += 1) {\n                    out.push(...inner.generate(ctx.withFrame({ value: v })));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Die") {\n        // (forEach Die [if:<bool>] <moves>) \u2014 for each die with a non-zero face\x2C\n        // bind frame.value to its pips\x2C generate the inner moves\x2C and tag each\n        // with ActionUseDie so the die is spent when the move is applied.\n        const { positional\x2C named } = parseArgs(node.items.slice(2));\n        const ifNode = named.get("if");\n        const cond = ifNode\n            ? compileBool(ifNode\x2C env)\n            : { eval: () => true };\n        const movesNode = positional[0];\n        if (!movesNode)\n            throw new LudemeCompileError("(forEach Die \u2026) needs a moves clause.");\n        const inner = compileMoves(movesNode\x2C env);\n        return {\n            generate: (ctx) => {\n                const dice = ctx.state.diceValues;\n                const out = [];\n                for (let i = 0; i < dice.length; i += 1) {\n                    const pips = dice[i] ?? 0;\n                    if (pips === 0)\n                        continue;\n                    const sub = ctx.withFrame({ value: pips });\n                    if (!cond.eval(sub))\n                        continue;\n                    for (const m of inner.generate(sub)) {\n                        out.push(m.withConsequence([new ActionUseDie(i\x2C 0)]\x2C false));\n                    }\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Direction") {\n        // (forEach Direction [(from <site>)] <dirs> <body>) \u2014 step one cell from\n        // the source along each resolved direction\x2C bind frame.to to the\n        // neighbour\x2C and run the inner move generator there. The source defaults\n        // to the current to/from site (last move's destination). Direction rays\n        // beyond one step are handled by the body recursing (e.g. knight walks).\n        const rest = node.items.slice(2);\n        const fromNode = rest.find((n) => isList(n) && listHead(n) === "from");\n        const fromInner = fromNode?.items[1];\n        const fromFn = fromInner ? compileInt(fromInner\x2C env) : undefined;\n        const dirNode = rest.find((n) => (isList(n) && listHead(n) === "directions") ||\n            (isIdent(n) && !isPlaceholderIdent(n.name)) ||\n            (isList(n) && n.delimiter === "curly"));\n        const tokens = collectDirectionTokens(dirNode);\n        const BODY_HEADS = new Set([\n            "move"\x2C\n            "if"\x2C\n            "forEach"\x2C\n            "and"\x2C\n            "or"\x2C\n            "add"\x2C\n            "set"\x2C\n            "do"\x2C\n            "priority"\x2C\n        ]);\n        const bodyNode = rest.find((n) => isList(n) && BODY_HEADS.has(listHead(n) ?? ""));\n        let inner;\n        if (bodyNode) {\n            try {\n                inner = compileMoves(bodyNode\x2C env);\n            }\n            catch {\n                inner = undefined;\n            }\n        }\n        if (!inner)\n            return EMPTY_MOVES;\n        const gen = inner;\n        return {\n            generate: (ctx) => {\n                const from = fromFn?.eval(ctx) ??\n                    ctx.frame.to ??\n                    ctx.frame.from ??\n                    lastToSite(ctx);\n                if (from === undefined || from < 0)\n                    return [];\n                const board = ctx.board;\n                const x = board.xOf(from);\n                const y = board.yOf(from);\n                const dirs = resolveDirectionTokens(tokens\x2C ctx);\n                const out = [];\n                const seen = new Set();\n                for (const d of dirs) {\n                    const nb = board.siteAt(x + d.dx\x2C y + d.dy);\n                    if (nb < 0 || seen.has(nb))\n                        continue;\n                    seen.add(nb);\n                    out.push(...gen.generate(ctx.withFrame({ from\x2C to: nb\x2C between: nb })));\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Group") {\n        // `(forEach Group [if:<cond>] <moves> [(then \u2026)])` \u2014 iterate every maximal\n        // connected same-owner group; bind frame.to/site to the group's max site\n        // (mirrors (max (array (sites))))\x2C then run the inner move generator.\n        // Java: Core/src/game/rules/play/moves/nonDecision/operators/foreach/group/ForEachGroup.java\n        const { positional: gPos\x2C named: gNamed } = parseArgs(node.items.slice(2));\n        const gIfNode = gNamed.get("if");\n        const gCond = gIfNode\n            ? compileBool(gIfNode\x2C env)\n            : { eval: () => true };\n        const gMovesNode = gPos[0];\n        if (!gMovesNode)\n            return EMPTY_MOVES;\n        const gInner = compileMoves(gMovesNode\x2C env);\n        const gThenNode = node.items.find((n) => isList(n) && listHead(n) === "then");\n        const gThen = gThenNode ? compileThen(gThenNode\x2C env) : undefined;\n        return {\n            generate: (ctx) => {\n                const mover = ctx.mover;\n                const groups = groupComponents(ctx\x2C (s) => (ctx.state.cells[s] ?? 0) === mover);\n                const out = [];\n                for (const group of groups) {\n                    const sites = [...group];\n                    if (sites.length === 0)\n                        continue;\n                    const rep = Math.max(...sites);\n                    const sub = ctx.withFrame({ to: rep\x2C from: rep\x2C site: rep });\n                    if (!gCond.eval(sub))\n                        continue;\n                    const innerMoves = gInner.generate(sub);\n                    if (gThen && innerMoves.length > 0) {\n                        const { moveAgain\x2C effect } = gThen;\n                        for (const m of innerMoves) {\n                            const ectx = sub\n                                .withContext(sub.context.withTrial(sub.context.trial.withMove(m\x2C false\x2C -1)))\n                                .withFrame({ from: m.from()\x2C to: m.to() });\n                            const extra = effect ? effect(ectx) : [];\n                            out.push(extra.length > 0 || moveAgain\n                                ? m.withConsequence(extra\x2C moveAgain)\n                                : m);\n                        }\n                    }\n                    else {\n                        out.push(...innerMoves);\n                    }\n                }\n                return out;\n            }\x2C\n        };\n    }\n    if (kind === "Level") {\n        // `(forEach Level <site> [FromBottom|FromTop] <moves> [(then \u2026)])` \u2014 iterate\n        // every stack level at the site from top (default) or bottom\x2C binding\n        // frame.level to each index\x2C generating the inner moves for each level.\n        // Java: Core/src/game/rules/play/moves/nonDecision/operators/foreach/level/ForEachLevel.java\n        const { positional: lvlPos } = parseArgs(node.items.slice(2));\n        const lvlSiteNode = lvlPos[0];\n        if (!lvlSiteNode)\n            return EMPTY_MOVES;\n        const lvlSiteFn = compileInt(lvlSiteNode\x2C env);\n        let lvlBodyIdx = 1;\n        let fromBottom = false;\n        const lvlDirNode = lvlPos[1];\n        if (lvlDirNode &&\n            isIdent(lvlDirNode) &&\n            (lvlDirNode.name === "FromBottom" || lvlDirNode.name === "FromTop")) {\n            fromBottom = lvlDirNode.name === "FromBottom";\n            lvlBodyIdx = 2;\n        }\n        const lvlMovesNode = lvlPos[lvlBodyIdx];\n        if (!lvlMovesNode)\n            return EMPTY_MOVES;\n        const lvlInner = compileMoves(lvlMovesNode\x2C env);\n        const lvlThenNode = node.items.find((n) => isList(n) && listHead(n) === "then");\n        const lvlThen = lvlThenNode ? compileThen(lvlThenNode\x2C env) : undefined;\n        return {\n            generate: (ctx) => {\n                const site = lvlSiteFn.eval(ctx);\n                if (site < 0)\n                    return [];\n                const stackSize = ctx.state.stackSize(site);\n                const levels = fromBottom\n                    ? Array.from({ length: stackSize }\x2C (_\x2C i) => i)\n                    : Array.from({ length: stackSize }\x2C (_\x2C i) => stackSize - 1 - i);\n                const out = [];\n                for (const level of levels) {\n                    const sub = ctx.withFrame({ level\x2C site\x2C to: site });\n                    const innerMoves = lvlInner.generate(sub);\n                    if (lvlThen && innerMoves.length > 0) {\n                        const { moveAgain\x2C effect } = lvlThen;\n                        for (const m of innerMoves) {\n                            const ectx = sub\n                                .withContext(sub.context.withTrial(sub.context.trial.withMove(m\x2C false\x2C -1)))\n                                .withFrame({ from: m.from()\x2C to: m.to() });\n                            const extra = effect ? effect(ectx) : [];\n                            out.push(extra.length > 0 || moveAgain\n                                ? m.withConsequence(extra\x2C moveAgain)\n                                : m);\n                        }\n                    }\n                    else {\n                        out.push(...innerMoves);\n                    }\n                }\n                return out;\n            }\x2C\n        };\n    }\n    throw new LudemeCompileError(`Unsupported (forEach ${kind} \u2026) in moves.`);\n}\n/**\n * Read the direction tokens a `(move Step \u2026)` declares. A step with no\n * explicit direction defaults to Ludii's "Adjacent"\x2C which on a square board\n * is all 8 neighbours (edge + vertex sharing).\n */\nfunction stepDirectionTokens(node) {\n    const tokens = rawDirectionTokens(node).filter((t) => !t.startsWith("#"));\n    return tokens.length > 0 ? tokens : ["Adjacent"];\n}\n/**\n * The one-cell neighbours of `from` along the given direction tokens. On a\n * rectangular lattice this is `siteAt(x\xb1dx\x2C y\xb1dy)`; on a graph board (built by\n * the graph algebra \u2014 concentric / merge / dual\x2C used by morris\x2C alquerque\x2C\n * mancala-graph and the like) the lattice has no meaning\x2C so steps follow the\n * board's adjacency relations instead. There\x2C the only genuine connections are\n * the graph edges\x2C so the catch-all groups (Adjacent/All) resolve to the\n * edge-connected neighbours rather than to geometrically-inferred diagonals.\n */\nfunction stepNeighbours(ctx\x2C from\x2C tokens) {\n    const board = ctx.board;\n    const traj = board.traj;\n    if (traj) {\n        const out = new Set();\n        for (const token of tokens) {\n            if (token === "Orthogonal" || token === "Adjacent" || token === "All") {\n                for (const n of traj.neighbours(from))\n                    out.add(n);\n            }\n            else if (token === "Diagonal") {\n                for (const n of traj.group(from\x2C "Diagonal"))\n                    out.add(n);\n            }\n            else {\n                const n = traj.step(from\x2C token);\n                if (n >= 0)\n                    out.add(n);\n            }\n        }\n        return [...out];\n    }\n    const x = board.xOf(from);\n    const y = board.yOf(from);\n    const out = [];\n    for (const d of resolveDirectionTokens(tokens\x2C ctx)) {\n        const to = board.siteAt(x + d.dx\x2C y + d.dy);\n        if (to !== OFF)\n            out.push(to);\n    }\n    return out;\n}\n/**\n * Compile an `(apply <effect>)` block to a function producing the extra\n * actions a move carries. Currently handles `(remove <site>)`.\n */\nfunction compileApply(node\x2C env) {\n    // Three Java Apply forms: (apply <effect>)\x2C (apply if:<cond> <effect>) and\n    // (apply if:<cond>) \u2014 the last is a bare guard whose move lives in the\n    // surrounding (then \u2026)\x2C so it contributes no actions here.\n    const { positional\x2C named } = parseArgs(node.items.slice(1));\n    const ifNode = named.get("if");\n    const cond = ifNode ? compileBool(ifNode\x2C env) : undefined;\n    const effectNode = positional.find((n) => isList(n));\n    if (!effectNode) {\n        if (cond)\n            return () => [];\n        throw new LudemeCompileError("(apply \u2026) needs an effect.");\n    }\n    const effect = compileEffect(effectNode\x2C env);\n    if (!cond)\n        return effect;\n    return (ctx) => (cond.eval(ctx) ? effect(ctx) : []);\n}\n/**\n * Compile an effect ludeme (the body of an `(apply \u2026)`) into a function\n * producing the actions it contributes. Control-flow forms compose\n * sub-effects: `(if <cond> <then> <else>?)` picks a branch and `(and \u2026)`\n * runs several; leaf effects (`remove`/`addScore`/`set \u2026`) delegate to\n * `compileEffectAction`.\n */\nfunction compileEffect(node\x2C env) {\n    const head = listHead(node);\n    // A curly `{ eff \u2026 }` block is an implicit sequence of sub-effects\x2C as is\n    // `(and { \u2026 })` where the `and` takes a single curly-list argument. Flatten\n    // either into a lenient sequence so one unsupported member doesn't fail the\n    // whole compile (mancala capture defines lean on this heavily).\n    if (node.delimiter === "curly") {\n        const parts = effectChildren(node.items).map((n) => compileEffectLenient(n\x2C env));\n        return (ctx) => parts.flatMap((p) => p(ctx));\n    }\n    if (head === "if") {\n        const { positional } = parseArgs(node.items.slice(1));\n        const [condNode\x2C thenNode\x2C elseNode] = positional;\n        if (!condNode || !thenNode) {\n            throw new LudemeCompileError("(if \u2026) effect needs a cond and a then.");\n        }\n        const cond = compileBool(condNode\x2C env);\n        const thenE = effectOf(thenNode\x2C env);\n        const elseE = elseNode ? effectOf(elseNode\x2C env) : undefined;\n        return (ctx) => (cond.eval(ctx) ? thenE(ctx) : elseE ? elseE(ctx) : []);\n    }\n    if (head === "and") {\n        const parts = effectChildren(node.items.slice(1)).map((n) => compileEffectLenient(n\x2C env));\n        return (ctx) => parts.flatMap((p) => p(ctx));\n    }\n    if (head === "forEach") {\n        return compileForEachEffect(node\x2C env);\n    }\n    if (head === "move") {\n        // `(move \u2026)` in effect position\x2C e.g. inside `(apply (if <cond> (move \u2026)))`.\n        // Java's Apply returns the moves generated by the nested move ludeme and\n        // applies them as consequence actions. Lenient: compile the inner move\n        // generator and\x2C at apply-time\x2C flatten its generated moves' actions into\n        // the effect action stream (covers capture-and-relocate defines like\n        // Tawula's CaptureEnemyPiece and Wellisch Chess's GrabToPiece).\n        // Java: Core/src/game/rules/play/moves/nonDecision/effect/Apply.java\n        try {\n            const innerMoves = compileMoveLudeme(node\x2C env);\n            return (ctx) => innerMoves.generate(ctx).flatMap((m) => [...m.actions]);\n        }\n        catch {\n            return () => [];\n        }\n    }\n    if (head === "do") {\n        // `(do <prior> next:<main>)` / `(do <prior> ifAfterwards:<cond>)` in effect\n        // position. Java: requirement/Do.java \u2014 applies prior actions as a preamble\n        // then runs the main move generator. Lenient: reuse compileDo (which handles\n        // both arms in moves position) and flatten the generated moves' actions.\n        try {\n            const inner = compileDo(node\x2C env);\n            return (ctx) => inner.generate(ctx).flatMap((m) => [...m.actions]);\n        }\n        catch {\n            return () => [];\n        }\n    }\n    const leaf = compileEffectAction(node\x2C env);\n    if (leaf)\n        return leaf;\n    throw new LudemeCompileError(`Unsupported effect: (${head} \u2026).`);\n}\n/**\n * Flatten an effect-argument list into its component effect lists\x2C expanding\n * any nested curly `{ \u2026 }` blocks (a `(and { \u2026 })` argument) into their items.\n */\nfunction effectChildren(items) {\n    const out = [];\n    for (const it of items) {\n        if (!isList(it))\n            continue;\n        if (it.delimiter === "curly")\n            out.push(...effectChildren(it.items));\n        else\n            out.push(it);\n    }\n    return out;\n}\n/** Compile one effect\x2C dropping it to a no-op if it uses unsupported forms. */\nfunction compileEffectLenient(node\x2C env) {\n    try {\n        return compileEffect(node\x2C env);\n    }\n    catch {\n        return () => [];\n    }\n}\n/** An effect node that may be a leaf or control-flow; empty if not a list. */\nfunction effectOf(node\x2C env) {\n    return isList(node) ? compileEffect(node\x2C env) : () => [];\n}\n/**\n * `(forEach \u2026)` as an effect. The only kind with a concrete state mapping is\n * `(forEach Site <region> <effect>)`: bind `frame.site`/`frame.to` to each\n * region member and run the sub-effect there\x2C flattening the actions. The\n * piece/level/value iterators carry no per-iteration site state in this model\x2C\n * so they degrade to a no-op rather than failing the whole compile (these show\n * up almost exclusively in dice-race games like Bargese/Pachisi).\n */\nfunction compileForEachEffect(node\x2C env) {\n    const kindNode = node.items[1];\n    const kind = kindNode && isIdent(kindNode) ? kindNode.name : "";\n    if (kind === "Site") {\n        const regionNode = node.items[2];\n        const effectNode = node.items[3];\n        if (!regionNode || !effectNode)\n            return () => [];\n        const region = compileRegion(regionNode\x2C env);\n        const eff = effectOf(effectNode\x2C env);\n        return (ctx) => {\n            const out = [];\n            for (const s of region.eval(ctx)) {\n                if (s < 0)\n                    continue;\n                out.push(...eff(ctx.withFrame({ site: s\x2C to: s })));\n            }\n            return out;\n        };\n    }\n    return () => [];\n}\n/**\n * `(move Step <dir> (to if:<bool> (apply <effect>)))`. From the current\n * piece site (`from`\x2C bound by `forEach Piece`)\x2C step one cell along each\n * resolved direction; emit a relocating `ActionMove` when the `to:` guard\n * holds. A relocating move overwrites its destination\x2C so a capture is the\n * same `ActionMove` \u2014 an `(apply (remove (to)))` that clears the very\n * destination is therefore subsumed and dropped.\n */\nfunction compileStep(node\x2C env\x2C startIndex = 2) {\n    const after = node.items.slice(startIndex);\n    const toNode = after.find((n) => isList(n) && listHead(n) === "to");\n    const dirNode = after.find((n) => n !== toNode);\n    const tokens = stepDirectionTokens(dirNode);\n    let cond = { eval: () => true };\n    let effect;\n    if (toNode) {\n        const { positional\x2C named } = parseArgs(toNode.items.slice(1));\n        const ifNode = named.get("if");\n        if (ifNode)\n            cond = compileBool(ifNode\x2C env);\n        const applyNode = positional.find((n) => isList(n) && listHead(n) === "apply");\n        if (applyNode)\n            effect = compileApply(applyNode\x2C env);\n    }\n    return {\n        generate: (ctx) => {\n            const from = ctx.frame.from;\n            if (from === undefined || from < 0)\n                return [];\n            const mover = ctx.mover;\n            const out = [];\n            // Java Step.alreadyCompute: a (from\x2Cto) pair is emitted once even when\n            // overlapping direction tokens reach the same neighbour.\n            const seen = new Set();\n            for (const to of stepNeighbours(ctx\x2C from\x2C tokens)) {\n                if (to === OFF || seen.has(to))\n                    continue;\n                seen.add(to);\n                const sub = ctx.withFrame({ from\x2C to });\n                if (!cond.eval(sub))\n                    continue;\n                const actions = [new ActionMove({ from\x2C to })];\n                if (effect) {\n                    for (const a of effect(sub)) {\n                        // A remove of the destination is already done by the relocation.\n                        if (a.actionType() === "Remove" && a.to() === to)\n                            continue;\n                        actions.push(a);\n                    }\n                }\n                out.push(new Move({\n                    id: `step:${from}:${to}:${mover}`\x2C\n                    label: `Step ${from}\u2192${to}`\x2C\n                    siteIndices: [to]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                    actions\x2C\n                }));\n            }\n            return out;\n        }\x2C\n    };\n}\n/** The four orthogonal starting headings a turtle walk is applied from. */\nconst ORTHO_HEADINGS = [\n    { dx: 0\x2C dy: 1 }\x2C // N\n    { dx: 1\x2C dy: 0 }\x2C // E\n    { dx: 0\x2C dy: -1 }\x2C // S\n    { dx: -1\x2C dy: 0 }\x2C // W\n];\n/**\n * Extract turtle walks from a `(move Leap \u2026)` walk argument. A walk is a\n * sequence of step tokens (`F` forward\x2C `R`/`L` rotate); the argument is\n * either a single walk `{F F R F}` or a list of walks `{{F F R F}{F F L F}}`.\n */\nfunction parseWalks(node) {\n    if (!node || !isList(node))\n        return [];\n    const nested = node.items.length > 0 && node.items.every((it) => isList(it));\n    if (nested) {\n        const walks = [];\n        for (const it of node.items) {\n            if (isList(it))\n                walks.push(walkSteps(it));\n        }\n        return walks;\n    }\n    return [walkSteps(node)];\n}\nfunction walkSteps(node) {\n    const out = [];\n    for (const it of node.items) {\n        if (isIdent(it))\n            out.push(it.name);\n    }\n    return out;\n}\n/**\n * Resolve turtle walks to the set of (dx\x2C dy) landing offsets. Each walk runs\n * from every orthogonal heading: `F` advances one cell along the heading\x2C\n * `R` rotates the heading 90\xb0 clockwise `(hx\x2Chy)\u2192(hy\x2C-hx)`\x2C `L` 90\xb0 counter-\n * clockwise `(hx\x2Chy)\u2192(-hy\x2Chx)`. Duplicate and zero offsets are dropped\x2C so\n * the canonical KnightWalk `{{F F R F}{F F L F}}` yields the 8 knight jumps.\n */\nfunction walkOffsets(walks) {\n    const seen = new Set();\n    const offsets = [];\n    for (const walk of walks) {\n        for (const start of ORTHO_HEADINGS) {\n            let hx = start.dx;\n            let hy = start.dy;\n            let x = 0;\n            let y = 0;\n            for (const step of walk) {\n                if (step === "F") {\n                    x += hx;\n                    y += hy;\n                }\n                else if (step === "R") {\n                    const nx = hy;\n                    const ny = -hx;\n                    hx = nx;\n                    hy = ny;\n                }\n                else if (step === "L") {\n                    const nx = -hy;\n                    const ny = hx;\n                    hx = nx;\n                    hy = ny;\n                }\n            }\n            if (x === 0 && y === 0)\n                continue;\n            const key = `${x}\x2C${y}`;\n            if (seen.has(key))\n                continue;\n            seen.add(key);\n            offsets.push({ dx: x\x2C dy: y });\n        }\n    }\n    return offsets;\n}\n/**\n * `(move Leap <walk> (to if:<land> (apply <effect>)?))`. From the piece's\n * `from` site\x2C jump to each walk-derived offset whose `to:` guard holds. Like\n * Step\x2C the relocation overwrites its destination\x2C so an `(apply (remove\n * (to)))` capturing the landing cell is subsumed and dropped.\n */\nfunction compileLeap(node\x2C env) {\n    const after = node.items.slice(2);\n    const toNode = after.find((n) => isList(n) && listHead(n) === "to");\n    const walkNode = after.find((n) => n !== toNode);\n    const offsets = walkOffsets(parseWalks(walkNode));\n    let cond = { eval: () => true };\n    let effect;\n    if (toNode) {\n        const { positional\x2C named } = parseArgs(toNode.items.slice(1));\n        const ifNode = named.get("if");\n        if (ifNode)\n            cond = compileBool(ifNode\x2C env);\n        const applyNode = positional.find((n) => isList(n) && listHead(n) === "apply");\n        if (applyNode)\n            effect = compileApply(applyNode\x2C env);\n    }\n    return {\n        generate: (ctx) => {\n            const from = ctx.frame.from;\n            if (from === undefined || from < 0)\n                return [];\n            const board = ctx.board;\n            const x = board.xOf(from);\n            const y = board.yOf(from);\n            const mover = ctx.mover;\n            const out = [];\n            for (const d of offsets) {\n                const to = board.siteAt(x + d.dx\x2C y + d.dy);\n                if (to === OFF)\n                    continue;\n                const sub = ctx.withFrame({ from\x2C to });\n                if (!cond.eval(sub))\n                    continue;\n                const actions = [new ActionMove({ from\x2C to })];\n                if (effect) {\n                    for (const a of effect(sub)) {\n                        if (a.actionType() === "Remove" && a.to() === to)\n                            continue;\n                        actions.push(a);\n                    }\n                }\n                out.push(new Move({\n                    id: `leap:${from}:${to}:${mover}`\x2C\n                    label: `Leap ${from}\u2192${to}`\x2C\n                    siteIndices: [to]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                    actions\x2C\n                }));\n            }\n            return out;\n        }\x2C\n    };\n}\n/**\n * Default `goRule` for a slide with no explicit `(between if:\u2026)` \u2014 Java:\n * `IsIn(Between\x2C SitesEmpty)`\x2C i.e. the slide passes through (and may stop on)\n * an empty cell only. Evaluated against `frame.between`\x2C which the slide loop\n * sets to the candidate cell.\n */\nconst SLIDE_DEFAULT_GO = {\n    eval: (ctx) => {\n        const s = ctx.frame.between ?? OFF;\n        return s >= 0 && s < ctx.state.cells.length && (ctx.state.cells[s] ?? 0) === 0;\n    }\x2C\n};\n/** Java Constants.UNDEFINED \u2014 a `min` of -1 makes `min <= toIdx` always hold. */\nconst SLIDE_MIN_UNDEFINED = -1;\n/** Java Constants.MAX_DISTANCE \u2014 the unbounded slide reach. */\nconst SLIDE_MAX_DISTANCE = 1000;\n/**\n * Extract the `(between \u2026)` distance bounds: `(exact N)` \u2192 min=max=N\x2C\n * `(range A B)` \u2192 min=A\x2Cmax=B. Returns IntFns (evaluated per context\x2C as Java\n * does) or the unbounded defaults when no range ludeme is present.\n */\nfunction slideRange(betweenNode\x2C env) {\n    const def = {\n        minFn: { eval: () => SLIDE_MIN_UNDEFINED }\x2C\n        maxFn: { eval: () => SLIDE_MAX_DISTANCE }\x2C\n    };\n    if (!betweenNode)\n        return def;\n    const { positional } = parseArgs(betweenNode.items.slice(1));\n    const rangeNode = positional.find((n) => isList(n) &&\n        (listHead(n) === "exact" ||\n            listHead(n) === "range" ||\n            listHead(n) === "min"));\n    if (!rangeNode)\n        return def;\n    const head = listHead(rangeNode);\n    if (head === "exact") {\n        const n = rangeNode.items[1];\n        if (!n)\n            return def;\n        const fn = compileInt(n\x2C env);\n        return { minFn: fn\x2C maxFn: fn };\n    }\n    if (head === "range") {\n        const a = rangeNode.items[1];\n        const b = rangeNode.items[2];\n        if (!a)\n            return def;\n        const minFn = compileInt(a\x2C env);\n        return { minFn\x2C maxFn: b ? compileInt(b\x2C env) : minFn };\n    }\n    // (min N) \u2014 lower bound only\x2C unbounded above.\n    const a = rangeNode.items[1];\n    return a\n        ? { minFn: compileInt(a\x2C env)\x2C maxFn: def.maxFn }\n        : def;\n}\n/**\n * Direction tokens for a `(move Slide \u2026)`. With none given the slide runs\n * in every compass direction \u2014 Ludii's square radials are 8-connected\x2C so a\n * bare `(move Slide)` is a chess-queen slide (the Amazons / rook / bishop\n * shape). Explicit `(directions \u2026)` or a bare group keyword override it.\n */\nfunction slideDirectionTokens(node) {\n    const tokens = rawDirectionTokens(node).filter((t) => !t.startsWith("#"));\n    return tokens.length > 0 ? tokens : ["All"];\n}\n/** A `(difference \u2026)` / `(union \u2026)` / `(intersection \u2026)` direction-set node. */\nfunction isDirSetCombinator(node) {\n    if (!isList(node))\n        return false;\n    const head = listHead(node);\n    return (head === "difference" || head === "union" || head === "intersection");\n}\n/** True for any node that supplies a direction set to a move ludeme: a bare\n * group keyword\x2C a `(directions {\u2026})` list\x2C or a set combinator. */\nfunction isDirectionArg(node) {\n    return isIdent(node) || (isList(node) && (listHead(node) === "directions" || isDirSetCombinator(node)));\n}\n/** Stable key for de-duping / set-arithmetic on direction offsets. */\nfunction dirKey(d) {\n    return `${d.dx}\x2C${d.dy}`;\n}\n/**\n * Compile a direction-set node into an eval-time resolver of concrete offsets.\n *\n * Handles the set-combinator ludemes (Java game.functions.directions):\n *   - `(difference A B\u2026)` \u2014 A with every direction in B\u2026 removed (Difference.java)\n *   - `(union A B\u2026)` \u2014 every direction in any operand (Union.java)\n *   - `(intersection A B\u2026)` \u2014 directions present in all operands (Intersection.java)\n * Operands recurse\x2C so combinators nest. Everything else falls through to the\n * token path (`slideDirectionTokens` + `resolveDirectionTokens`)\x2C which also\n * resolves the move-relative `SameDirection` / `OppositeDirection` tokens.\n * Set operations key directions by their (dx\x2Cdy) offset.\n */\nfunction compileDirsResolver(node) {\n    if (node && isDirSetCombinator(node)) {\n        const list = node;\n        const head = listHead(list);\n        const parts = list.items.slice(1).map((n) => compileDirsResolver(n));\n        if (head === "difference") {\n            const first = parts[0];\n            const rest = parts.slice(1);\n            if (!first)\n                return () => [];\n            return (ctx\x2C fromSite) => {\n                const removed = new Set();\n                for (const p of rest) {\n                    for (const d of p(ctx\x2C fromSite))\n                        removed.add(dirKey(d));\n                }\n                return first(ctx\x2C fromSite).filter((d) => !removed.has(dirKey(d)));\n            };\n        }\n        if (head === "intersection") {\n            const first = parts[0];\n            if (!first)\n                return () => [];\n            return (ctx\x2C fromSite) => {\n                const sets = parts.map((p) => new Set(p(ctx\x2C fromSite).map(dirKey)));\n                const out = [];\n                const seen = new Set();\n                for (const d of first(ctx\x2C fromSite)) {\n                    const k = dirKey(d);\n                    if (seen.has(k))\n                        continue;\n                    if (sets.every((s) => s.has(k))) {\n                        out.push(d);\n                        seen.add(k);\n                    }\n                }\n                return out;\n            };\n        }\n        // union\n        return (ctx\x2C fromSite) => {\n            const out = [];\n            const seen = new Set();\n            for (const p of parts) {\n                for (const d of p(ctx\x2C fromSite)) {\n                    const k = dirKey(d);\n                    if (!seen.has(k)) {\n                        seen.add(k);\n                        out.push(d);\n                    }\n                }\n            }\n            return out;\n        };\n    }\n    const tokens = slideDirectionTokens(node);\n    return (ctx\x2C fromSite) => resolveDirectionTokens(tokens\x2C ctx\x2C fromSite);\n}\n/**\n * `(move Slide <dir?> (between (range)? if:<go>)? (to if:<stop> (apply <eff>))?)`.\n *\n * Faithful port of Java `Slide.eval` (Slide.java). Per direction the radial is\n * walked cell-by-cell (`toIdx` = 1\x2C2\x2C\u2026):\n *\n *   - `stopRule` = the `to if:` condition. When it holds\x2C a move to this cell\n *     is emitted (only if `min <= toIdx`) and the ray then breaks \u2014 BUT the\n *     break itself is gated on `min <= toIdx`\x2C so a not-yet-reached minimum\n *     keeps the ray going (this is what makes `(between (exact 2))` skip the\n *     distance-1 cell yet still stop at distance 2).\n *   - `goRule` = the `between if:` condition (default: the cell is empty).\n *     When it fails the ray breaks; when it holds a move is emitted (if\n *     `min <= toIdx`) and the walk continues.\n *   - `min`/`max` come from the `(between (exact N))` / `(range A B)` ludeme\x2C\n *     defaulting to UNDEFINED (-1\x2C always passes) / MAX_DISTANCE.\n *\n * The `(apply \u2026)` side effect (typically `(remove (to))`) is chained onto every\n * emitted move; a relocation already overwrites its destination\x2C so