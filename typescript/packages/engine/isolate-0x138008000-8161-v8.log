script-source,153,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-move-top-piece.js,// @java Core/src/other/action/move/move/ActionMoveTopPiece.java ActionMoveTopPiece\n/**\n * Java parity: Core/src/other/action/move/move/ActionMoveTopPiece.java\n * \u2014 move only the piece on the top of a stack to another site.\n */\nimport { BaseAction } from "./action.js";\nexport class ActionMoveTopPiece extends BaseAction {\n    static TYPE = "Move";\n    fromIndex;\n    toIndex;\n    constructor(from\x2C to) {\n        super();\n        this.fromIndex = from;\n        this.toIndex = to;\n    }\n    apply(state) {\n        const stackSize = state.stackSize(this.fromIndex);\n        if (stackSize === 0) {\n            const owner = state.cells[this.fromIndex] ?? 0;\n            if (owner === 0)\n                return state;\n            return state.withCell(this.fromIndex\x2C 0).withCell(this.toIndex\x2C owner);\n        }\n        const top = state.stackAt(this.fromIndex\x2C stackSize - 1);\n        return state.withStackPop(this.fromIndex).withStackPush(this.toIndex\x2C top);\n    }\n    actionType() {\n        return ActionMoveTopPiece.TYPE;\n    }\n    from() {\n        return this.fromIndex;\n    }\n    to() {\n        return this.toIndex;\n    }\n    isStacking() {\n        return true;\n    }\n}\n//# sourceMappingURL=action-move-top-piece.js.map
