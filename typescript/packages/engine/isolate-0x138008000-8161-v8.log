script-source,145,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-bet.js,// @java Core/src/other/action/state/ActionBet.java ActionBet\n/** Java parity: Core/src/other/action/state/ActionBet.java. */\nimport { BaseAction } from "./action.js";\nexport class ActionBet extends BaseAction {\n    static TYPE = "Bet";\n    player;\n    amount;\n    constructor(player\x2C amount) {\n        super();\n        this.player = player;\n        this.amount = amount;\n    }\n    apply(state) {\n        // Bet moves chips from a player's amount into the pot.\n        const prevAmount = state.amount(this.player);\n        return state\n            .withAmount(this.player\x2C prevAmount - this.amount)\n            .withPot(state.pot + this.amount);\n    }\n    actionType() {\n        return ActionBet.TYPE;\n    }\n    who() {\n        return this.player;\n    }\n    value() {\n        return this.amount;\n    }\n}\n//# sourceMappingURL=action-bet.js.map
