code-creation,Script,9,77000,0x2325599e27e0,114, file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/topology.js:1:1,0x24a6cb093600,~
script-source,138,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/topology.js,// @java Core/src/other/topology/Topology.java Topology\n/**\n * Java parity:\n * - Core/src/game/util/graph/Topology.java \u2014 the graph layer that holds\n *   vertex / edge / cell collections and adjacency for a board.\n *\n * The TS port covers the flat rectangular case the engine actually\n * compiles to (FlatBoardGame). For Hex boards the existing HexGame\n * embeds its own adjacency; once those games converge on a shared\n * `Game` (task #85) we'll expand this module accordingly.\n */\n/**\n * Flat rectangular board topology.\n *\n * Convention follows Java's `Topology`: vertex (0\x2C0) is the bottom-left\n * corner. For a W\xd7H board\x2C vertex (x\x2Cy) has index `y * W + x`.\n *\n * Adjacency is 4-connected orthogonal by default; diagonal neighbours\n * are exposed via the explicit `diagonalNeighbours` accessor.\n */\nexport class FlatTopology {\n    width;\n    height;\n    vertices;\n    edges;\n    cells;\n    constructor(width\x2C height) {\n        if (!Number.isInteger(width) || width < 1) {\n            throw new Error(`width must be a positive integer; got ${width}.`);\n        }\n        if (!Number.isInteger(height) || height < 1) {\n            throw new Error(`height must be a positive integer; got ${height}.`);\n        }\n        this.width = width;\n        this.height = height;\n        const vertices = [];\n        for (let y = 0; y < height; y += 1) {\n            for (let x = 0; x < width; x += 1) {\n                vertices.push({ index: y * width + x\x2C x\x2C y });\n            }\n        }\n        this.vertices = Object.freeze(vertices);\n        const edges = [];\n        for (let y = 0; y < height; y += 1) {\n            for (let x = 0; x < width; x += 1) {\n                const here = y * width + x;\n                if (x + 1 < width) {\n                    edges.push({ index: edges.length\x2C a: here\x2C b: here + 1 });\n                }\n                if (y + 1 < height) {\n                    edges.push({ index: edges.length\x2C a: here\x2C b: here + width });\n                }\n            }\n        }\n        this.edges = Object.freeze(edges);\n        // For a flat board cells coincide with vertices (one piece per\n        // square). They are exposed separately to mirror the Java surface.\n        this.cells = Object.freeze(vertices.map((v) => ({ index: v.index\x2C x: v.x\x2C y: v.y })));\n    }\n    size(type) {\n        if (type === "Vertex")\n            return this.vertices.length;\n        if (type === "Edge")\n            return this.edges.length;\n        return this.cells.length;\n    }\n    sites(type) {\n        const n = this.size(type);\n        const out = new Array(n);\n        for (let i = 0; i < n; i += 1)\n            out[i] = i;\n        return out;\n    }\n    /** Orthogonal (4-connected) neighbours of a cell/vertex. */\n    orthogonalNeighbours(index) {\n        const v = this.vertices[index];\n        if (!v)\n            return [];\n        const { x\x2C y } = v;\n        const out = [];\n        if (x > 0)\n            out.push(index - 1);\n        if (x + 1 < this.width)\n            out.push(index + 1);\n        if (y > 0)\n            out.push(index - this.width);\n        if (y + 1 < this.height)\n            out.push(index + this.width);\n        return out;\n    }\n    /** Diagonal (4 additional) neighbours of a cell/vertex. */\n    diagonalNeighbours(index) {\n        const v = this.vertices[index];\n        if (!v)\n            return [];\n        const { x\x2C y } = v;\n        const out = [];\n        if (x > 0 && y > 0)\n            out.push(index - this.width - 1);\n        if (x + 1 < this.width && y > 0)\n            out.push(index - this.width + 1);\n        if (x > 0 && y + 1 < this.height)\n            out.push(index + this.width - 1);\n        if (x + 1 < this.width && y + 1 < this.height)\n            out.push(index + this.width + 1);\n        return out;\n    }\n    /** All 8-connected neighbours (orthogonal + diagonal). */\n    neighbours(index) {\n        return [\n            ...this.orthogonalNeighbours(index)\x2C\n            ...this.diagonalNeighbours(index)\x2C\n        ];\n    }\n}\n//# sourceMappingURL=topology.js.map
