script-source,218,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/ludeme-game.js,/**\n * LudemeGame \u2014 a `Game` that plays a `.lud` definition by *interpreting*\n * its ludeme tree\x2C rather than pattern-matching it onto a hand-rolled\n * template (FlatBoardGame etc.).\n *\n * Java parity:\n * - Core/src/game/Game.java \u2014 the real engine instantiates a tree of\n *   ludeme objects and calls `start`/`moves`/`apply`/`over`. This is the\n *   TS analogue: the `(play \u2026)` clause compiles to a move generator and\n *   the `(end \u2026)` clause to a set of ending rules\x2C both evaluated against\n *   the live state via `EvalContext`.\n *\n * The constructor takes a *define-expanded\x2C option-applied* `(game \u2026)`\n * AST node \u2014 i.e. the output of `parseLud \u2192 applyOptions \u2192 expandDefines`.\n */\nimport { isIdent\x2C isList\x2C isNumber\x2C isString\x2C listHead\x2C parseLud\x2C } from "@ludii/typescript-language";\nimport { getBuiltinDefines } from "../builtin-defines.js";\nimport { Context } from "../context.js";\nimport { expandDefines } from "../lud-defines.js";\nimport { applyOptions } from "../lud-options.js";\nimport { State } from "../state.js";\nimport { Trial } from "../trial.js";\nimport { compileBool\x2C compileEnd\x2C compileMoves\x2C compileRegion\x2C } from "./compile.js";\nimport { EvalContext\x2C InterpBoard\x2C } from "./eval-context.js";\nimport { buildBoardGraph } from "./graph/board-graph.js";\nimport { SQUARE_TILING\x2C HEX_TILING\x2C TRI_TILING\x2C hexagonMask\x2C rhombusMask\x2C triangleMask\x2C triHexagonMask\x2C triRectangleMask\x2C } from "./tilings.js";\nfunction child(node\x2C head) {\n    for (const item of node.items) {\n        if (isList(item) && listHead(item) === head)\n            return item;\n    }\n    return undefined;\n}\n/**\n * Locate the `(play \u2026)` clause for a game's rules. Most games carry it as a\n * direct child of `(rules \u2026)`; phase-structured games instead nest it inside\n * `phases:{ (phase "Name" (play \u2026) \u2026) \u2026 }`. We use the first phase's play \u2014\n * games always start in phase 0\x2C and per-phase switching (driven by\n * `(nextPhase \u2026)`) is a separate follow-on to the initial-move generation.\n */\nfunction findPlayClause(rules) {\n    const direct = child(rules\x2C "play");\n    if (direct)\n        return direct;\n    const phasesBlock = findPhasesBlock(rules);\n    if (!phasesBlock)\n        return undefined;\n    for (const item of phasesBlock.items) {\n        if (isList(item) && listHead(item) === "phase") {\n            const play = child(item\x2C "play");\n            if (play)\n                return play;\n        }\n    }\n    return undefined;\n}\n/**\n * Compile every `(phase \u2026)` in a phase-structured game into a runtime list\x2C\n * resolving each `(nextPhase \u2026 "Target")` to the destination phase's index.\n * A game with a direct `(play \u2026)` (no phases) yields a single nameless phase\n * with no transitions \u2014 the common\x2C switch-free fast path.\n */\nfunction parsePhases(rules\x2C env) {\n    const direct = child(rules\x2C "play");\n    if (direct?.items[1]) {\n        return [\n            {\n                name: ""\x2C\n                play: compileMoves(direct.items[1]\x2C env)\x2C\n                nextPhases: []\x2C\n                role: ""\x2C\n            }\x2C\n        ];\n    }\n    const phasesBlock = findPhasesBlock(rules);\n    if (!phasesBlock) {\n        throw new Error("LudemeGame: rules has no (play \u2026).");\n    }\n    const phaseNodes = phasesBlock.items.filter((n) => isList(n) && listHead(n) === "phase");\n    // Phase name \u2192 index\x2C so `(nextPhase \u2026 "Name")` can be resolved.\n    const indexByName = new Map();\n    phaseNodes.forEach((node\x2C i) => {\n        const nameNode = node.items[1];\n        if (nameNode && isString(nameNode))\n            indexByName.set(nameNode.value\x2C i);\n    });\n    const phases = [];\n    for (const node of phaseNodes) {\n        const nameNode = node.items[1];\n        const name = nameNode && isString(nameNode) ? nameNode.value : "";\n        // An optional role ident sits between the name and the `(play \u2026)` /\n        // `(nextPhase \u2026)` lists\x2C e.g. `(phase "Placement" P1 (play \u2026))`.\n        const roleNode = node.items[2];\n        const role = roleNode && isIdent(roleNode) ? roleNode.name : "";\n        const playNode = child(node\x2C "play");\n        if (!playNode?.items[1]) {\n            // A phase with no (play \u2026) generates nothing; keep it as a placeholder\n            // so indices line up\x2C but it will yield no moves.\n            phases.push({ name\x2C play: { generate: () => [] }\x2C nextPhases: []\x2C role });\n            continue;\n        }\n        const play = compileMoves(playNode.items[1]\x2C env);\n        const nextPhases = [];\n        for (const item of node.items) {\n            if (!isList(item) || listHead(item) !== "nextPhase")\n                continue;\n            const after = item.items.slice(1);\n            // The destination is the trailing string; an optional leading role ident\n            // (Mover/Next) and an optional boolean (a list) may precede it.\n            const targetNode = [...after].reverse().find((n) => isString(n));\n            const targetName = targetNode && isString(targetNode) ? targetNode.value : undefined;\n            const target = targetName !== undefined ? indexByName.get(targetName) : undefined;\n            if (target === undefined)\n                continue;\n            const roleNode = after.find((n) => isIdent(n));\n            const who = roleNode && isIdent(roleNode) && roleNode.name === "Next"\n                ? "Next"\n                : "Mover";\n            const condNode = after.find((n) => isList(n));\n            let cond;\n            if (condNode) {\n                try {\n                    cond = compileBool(condNode\x2C env);\n                }\n                catch {\n                    // An unsupported transition condition is treated as never-taken\x2C\n                    // so the game stays in its current phase rather than failing.\n                    continue;\n                }\n            }\n            nextPhases.push({ cond\x2C target\x2C who });\n        }\n        phases.push({ name\x2C play\x2C nextPhases\x2C role });\n    }\n    return phases.length > 0\n        ? phases\n        : [{ name: ""\x2C play: { generate: () => [] }\x2C nextPhases: []\x2C role: "" }];\n}\n/**\n * Each player's starting phase index. A player starts in the first phase whose\n * role includes them (Java: the engine assigns `Phase.owner`-matching phases).\n * A roleless phase (or `Each`/`All`/`Shared`/`Mover`) applies to everyone;\n * `P<k>` applies only to player k. Players with no matching phase default to 0.\n */\nfunction computeInitialPhases(phases\x2C numPlayers) {\n    const appliesToAll = (role) => role === "" ||\n        role === "All" ||\n        role === "Each" ||\n        role === "Shared" ||\n        role === "Mover" ||\n        role === "Next";\n    const out = new Array(numPlayers + 1).fill(0);\n    for (let p = 1; p <= numPlayers; p += 1) {\n        for (let i = 0; i < phases.length; i += 1) {\n            const role = phases[i].role;\n            const m = /^P(\\d+)$/.exec(role);\n            if (appliesToAll(role) || (m && Number(m[1]) === p)) {\n                out[p] = i;\n                break;\n            }\n        }\n    }\n    return out;\n}\n/** The curly block of phases\x2C from either `(phases {\u2026})` or `phases:{\u2026}`. */\nfunction findPhasesBlock(rules) {\n    const phasesChild = child(rules\x2C "phases");\n    if (phasesChild) {\n        const curly = phasesChild.items.find((n) => isList(n) && n.delimiter === "curly");\n        if (curly)\n            return curly;\n    }\n    for (let i = 0; i < rules.items.length - 1; i += 1) {\n        const cur = rules.items[i];\n        const nxt = rules.items[i + 1];\n        if (cur &&\n            isIdent(cur) &&\n            cur.name === "phases:" &&\n            nxt &&\n            isList(nxt) &&\n            nxt.delimiter === "curly") {\n            return nxt;\n        }\n    }\n    return undefined;\n}\n/** Find a child list by head\x2C descending through curly groups. */\nfunction childDeep(node\x2C head) {\n    for (const item of node.items) {\n        if (!isList(item))\n            continue;\n        if (listHead(item) === head)\n            return item;\n        // Recurse into curly groups (the normal equipment list) and into paren-shell\n        // nodes left behind when an option placeholder `(<Tag:arg>)` was the sole\n        // child of a parenthesised expression \u2014 those have no ident head.\n        if (item.delimiter === "curly" || !listHead(item)) {\n            const inner = childDeep(item\x2C head);\n            if (inner)\n                return inner;\n        }\n    }\n    return undefined;\n}\n/**\n * Scan the equipment for `(hand <role> [size:N])` declarations and lay each\n * player's hand out contiguously after the board sites. Java parity:\n * `Equipment.java` appends one container per hand; `(hand Each)` expands to\n * one hand per player. Defaults to one site per hand when no `size:` given.\n */\nfunction parseHands(equipment\x2C numPlayers\x2C boardNumSites) {\n    const handSizes = new Array(numPlayers + 1).fill(0);\n    const scan = (node) => {\n        for (const item of node.items) {\n            if (!isList(item))\n                continue;\n            if (listHead(item) === "hand") {\n                const roleNode = item.items[1];\n                // Optional `size:N` keyword (lexer emits `size:` as its own ident).\n                let size = 1;\n                for (let i = 2; i < item.items.length; i += 1) {\n                    const tok = item.items[i];\n                    if (tok && isIdent(tok) && tok.name === "size:") {\n                        const v = item.items[i + 1];\n                        if (v && isNumber(v))\n                            size = v.value;\n                    }\n                }\n                if (roleNode && isIdent(roleNode)) {\n                    const role = roleNode.name;\n                    if (role === "Each") {\n                        for (let p = 1; p <= numPlayers; p += 1)\n                            handSizes[p] = size;\n                    }\n                    else {\n                        const m = /^P(\\d+)$/.exec(role);\n                        if (m?.[1]) {\n                            const p = Number(m[1]);\n                            if (p >= 1 && p <= numPlayers)\n                                handSizes[p] = size;\n                        }\n                        // `Shared` and other roles are not modelled yet.\n                    }\n                }\n            }\n            else if (item.delimiter === "curly") {\n                scan(item);\n            }\n        }\n    };\n    scan(equipment);\n    const handStart = new Array(numPlayers + 1).fill(0);\n    let offset = boardNumSites;\n    for (let p = 1; p <= numPlayers; p += 1) {\n        handStart[p] = offset;\n        offset += handSizes[p] ?? 0;\n    }\n    return { handSizes\x2C handStart\x2C totalHandSites: offset - boardNumSites };\n}\n/** Guard board dimensions so an unresolved option (NaN) fails cleanly rather\n * than crashing `new Array(NaN)` deep in state allocation. */\nfunction assertDims(b) {\n    if (!Number.isInteger(b.width) || !Number.isInteger(b.height) ||\n        b.width <= 0 || b.height <= 0) {\n        throw new Error(`LudemeGame: invalid board dimensions ${b.width}\xd7${b.height}.`);\n    }\n    return b;\n}\n/**\n * `(square Diamond n)` \u2014 a square grid rotated 45\xb0. The diamond of side `n`\n * is the L1-ball of radius `n-1` on a `(2n-1)\xd7(2n-1)` lattice; on-board iff\n * `|x-c| + |y-c| <= n-1` with `c = n-1`. Cell count `2n\xb2-2n+1`.\n */\nfunction diamondMask(n) {\n    if (!Number.isInteger(n) || n <= 0) {\n        throw new Error(`LudemeGame: invalid (square Diamond ${n}).`);\n    }\n    const span = 2 * n - 1;\n    const c = n - 1;\n    const onBoard = new Array(span * span).fill(false);\n    for (let y = 0; y < span; y += 1) {\n        for (let x = 0; x < span; x += 1) {\n            onBoard[y * span + x] = Math.abs(x - c) + Math.abs(y - c) <= n - 1;\n        }\n    }\n    return { width: span\x2C height: span\x2C onBoard };\n}\nfunction parseBoard(equipment) {\n    // A mancala board is its own container ludeme \u2014 no `(board <shape>)` wrapper.\n    const mancala = childDeep(equipment\x2C "mancalaBoard");\n    if (mancala)\n        return parseMancalaBoard(mancala);\n    // `(surakartaBoard N \u2026)` \u2014 loop-capture board with no `(board \u2026)` wrapper.\n    // Model as an N\xd7N flat grid (the loop tracks are best-effort).\n    const surakarta = childDeep(equipment\x2C "surakartaBoard");\n    if (surakarta) {\n        const nNode = surakarta.items[1];\n        const n = nNode && isNumber(nNode) ? nNode.value : 6;\n        return assertDims({ width: n\x2C height: n\x2C tiling: SQUARE_TILING });\n    }\n    // `(boardless \u2026)` \u2014 tile-laying games (Trax\x2C Andantino\x2C \u2026) grow an unbounded\n    // grid; use a 9\xd79 placeholder so the rest of the pipeline compiles.\n    const boardless = childDeep(equipment\x2C "boardless");\n    if (boardless) {\n        return assertDims({ width: 9\x2C height: 9\x2C tiling: SQUARE_TILING });\n    }\n    const board = childDeep(equipment\x2C "board");\n    if (!board)\n        throw new Error("LudemeGame: equipment has no (board \u2026).");\n    const shape = board.items[1];\n    if (!shape || !isList(shape)) {\n        throw new Error("LudemeGame: unsupported board shape.");\n    }\n    const head = listHead(shape);\n    // Collect numeric args (a leading shape-name ident like `Diamond`/`Square`\n    // is skipped) and the optional shape name.\n    const first = shape.items[1];\n    const shapeName = first && isIdent(first) ? first.name.toLowerCase() : undefined;\n    // `collectDims` evaluates simple arithmetic (e.g. `(+ 12 0)`) and skips\n    // shape-name idents\x2C so option-substituted dim expressions resolve instead\n    // of being dropped (Shisen-Sho: `(rectangle (+ 12 0) (+ 14 0))`).\n    const nums = collectDims(shape);\n    const n1 = nums[0] ?? Number.NaN;\n    if (head === "square") {\n        if (shapeName === "diamond") {\n            const m = diamondMask(n1);\n            return {\n                width: m.width\x2C\n                height: m.height\x2C\n                tiling: SQUARE_TILING\x2C\n                onBoard: m.onBoard\x2C\n            };\n        }\n        // `Square`/`Limping`/unnamed \u2192 plain n\xd7n grid (Limping approximated).\n        return assertDims({ width: n1\x2C height: n1\x2C tiling: SQUARE_TILING });\n    }\n    if (head === "rectangle") {\n        // Java: (rectangle rows columns) \u2014 rows = height\x2C columns = width.\n        const n2 = nums[1] ?? n1;\n        return assertDims({ width: n2\x2C height: n1\x2C tiling: SQUARE_TILING });\n    }\n    if (head === "hex" || head === "hexagon") {\n        return parseHexBoard(shape);\n    }\n    if (head === "tri") {\n        return parseTriBoard(shape);\n    }\n    // Board-algebra shapes (merge / add / dual / concentric / circle / \u2026) build\n    // a planar graph; geometry + direction adjacency come from its Trajectories.\n    const g = buildBoardGraph(board);\n    if (g) {\n        return {\n            width: g.width\x2C\n            height: g.height\x2C\n            tiling: SQUARE_TILING\x2C\n            traj: g.traj\x2C\n            numSites: g.numSites\x2C\n            numFaces: g.numFaces\x2C\n        };\n    }\n    throw new Error(`LudemeGame: unsupported board tiling "${head}".`);\n}\n/** Orthogonal/diagonal step offsets for a track-string token. N = +y (up). */\nconst TRACK_DIRS = {\n    E: [1\x2C 0]\x2C\n    W: [-1\x2C 0]\x2C\n    N: [0\x2C 1]\x2C\n    S: [0\x2C -1]\x2C\n    NE: [1\x2C 1]\x2C\n    NW: [-1\x2C 1]\x2C\n    SE: [1\x2C -1]\x2C\n    SW: [-1\x2C -1]\x2C\n};\n/**\n * Walk a Ludii track string (e.g. `"5\x2CW\x2CN\x2CE"`) over the row-major C\xd7R grid\n * into an ordered list of site indices. The first token is the start site;\n * each later token is a bare direction (walk until off-grid)\x2C a direction\n * with a count (`N1` = exactly one step)\x2C or a numeric site to jump to.\n * Unknown tokens (compound hex directions like `ESE`) are skipped.\n */\nfunction parseTrackString(spec\x2C width\x2C height\x2C indexOffset = 0) {\n    const toIdx = (x\x2C y) => y * width + x;\n    const inB = (x\x2C y) => x >= 0 && x < width && y >= 0 && y < height;\n    const tokens = spec\n        .split("\x2C")\n        .map((t) => t.trim())\n        .filter((t) => t.length > 0);\n    const sites = [];\n    let cx = 0;\n    let cy = 0;\n    for (const tok of tokens) {\n        if (tok === "End")\n            break;\n        if (/^\\d+$/.test(tok)) {\n            // Track literals reference Java's cell indices\x2C where a leading store\n            // cell shifts the playing holes up by `indexOffset`. Translate back to\n            // this engine's 0-based playing-hole lattice.\n            const idx = Number(tok) - indexOffset;\n            cx = idx % width;\n            cy = Math.floor(idx / width);\n            sites.push(idx);\n            continue;\n        }\n        const m = /^([NSEW]+)(\\d*)$/.exec(tok);\n        const dir = m?.[1] ? TRACK_DIRS[m[1]] : undefined;\n        if (!dir)\n            continue;\n        const [dx\x2C dy] = dir;\n        if (m?.[2]) {\n            const n = Number(m[2]);\n            for (let k = 0; k < n; k += 1) {\n                cx += dx;\n                cy += dy;\n                if (!inB(cx\x2C cy))\n                    break;\n                sites.push(toIdx(cx\x2C cy));\n            }\n        }\n        else {\n            for (;;) {\n                const nx = cx + dx;\n                const ny = cy + dy;\n                if (!inB(nx\x2C ny))\n                    break;\n                cx = nx;\n                cy = ny;\n                sites.push(toIdx(cx\x2C cy));\n            }\n        }\n    }\n    return sites;\n}\n/**\n * `{0..3 7 11..9}` \u2014 a curly list of explicit track sites\x2C where `a..b`\n * lexes as a number `a` followed by an ident `.b`. Reconstruct ascending or\n * descending ranges\x2C otherwise take bare numbers verbatim.\n */\nfunction parseTrackSiteList(list\x2C indexOffset = 0) {\n    const sites = [];\n    const items = list.items;\n    for (let i = 0; i < items.length; i += 1) {\n        const it = items[i];\n        if (!it || !isNumber(it))\n            continue;\n        const start = it.value;\n        const next = items[i + 1];\n        if (next && isIdent(next) && /^\\.\\d+$/.test(next.name)) {\n            const end = Number(next.name.slice(1));\n            const step = end >= start ? 1 : -1;\n            for (let v = start; step > 0 ? v <= end : v >= end; v += step) {\n                sites.push(v - indexOffset);\n            }\n            i += 1;\n        }\n        else {\n            sites.push(start - indexOffset);\n        }\n    }\n    return sites;\n}\n/** Parse the `(track "Name" <spec> [loop:True] [Role])` declarations. */\nfunction parseTracks(shape\x2C width\x2C height\x2C indexOffset = 0) {\n    const tracks = [];\n    // Track declarations may be direct children of the mancalaBoard node or be\n    // grouped inside a curly-brace list `{ (track \u2026) (track \u2026) }` (e.g. Adi).\n    const candidates = [];\n    for (const item of shape.items) {\n        if (!isList(item))\n            continue;\n        if (listHead(item) === "track")\n            candidates.push(item);\n        else if (item.delimiter === "curly") {\n            for (const inner of item.items) {\n                if (isList(inner) && listHead(inner) === "track")\n                    candidates.push(inner);\n            }\n        }\n    }\n    for (const item of candidates) {\n        if (!isList(item))\n            continue;\n        const nameNode = item.items[1];\n        const name = nameNode && isString(nameNode) ? nameNode.value : "Track";\n        let sites = [];\n        let loop = false;\n        let owner = 0;\n        for (let i = 2; i < item.items.length; i += 1) {\n            const tok = item.items[i];\n            if (!tok)\n                continue;\n            if (isString(tok)) {\n                sites = parseTrackString(tok.value\x2C width\x2C height\x2C indexOffset);\n            }\n            else if (isList(tok) && tok.delimiter === "curly") {\n                sites = parseTrackSiteList(tok\x2C indexOffset);\n            }\n            else if (isIdent(tok)) {\n                if (tok.name === "loop:") {\n                    const v = item.items[i + 1];\n                    if (v && isIdent(v) && v.name === "True")\n                        loop = true;\n                    i += 1;\n                }\n                else {\n                    const pid = playerOfRole(tok.name);\n                    if (pid !== undefined)\n                        owner = pid;\n                }\n            }\n        }\n        tracks.push({ name\x2C sites\x2C loop\x2C owner });\n    }\n    return tracks;\n}\n/**\n * `(mancalaBoard <rows> <cols> [store:<Type>] (track \u2026)\u2026)` \u2014 a C\xd7R grid of\n * sowing holes with one or more declared tracks. `store:None` games capture\n * to `(hand \u2026)`; other store types are approximated as a plain grid (the\n * separate store containers are not modelled yet).\n */\nfunction parseMancalaBoard(shape) {\n    const nums = [];\n    for (let i = 1; i < shape.items.length; i += 1) {\n        const it = shape.items[i];\n        if (it && isNumber(it))\n            nums.push(it.value);\n    }\n    const rows = nums[0] ?? Number.NaN;\n    const cols = nums[1] ?? rows;\n    const board = assertDims({\n        width: cols\x2C\n        height: rows\x2C\n        tiling: SQUARE_TILING\x2C\n    });\n    // `store:None` has no store cells; every other store type (default Outer\x2C\n    // Inner\x2C Mixed) gives each of the two players one captured-seed store.\n    // In Java those games index a left store at cell 0\x2C shifting the playing\n    // holes up by one \u2014 track literals carry that offset\x2C so subtract it.\n    let storeNone = false;\n    for (let i = 1; i < shape.items.length; i += 1) {\n        const tok = shape.items[i];\n        if (tok && isIdent(tok) && tok.name === "store:") {\n            const v = shape.items[i + 1];\n            if (v && isIdent(v) && v.name === "None")\n                storeNone = true;\n        }\n    }\n    const indexOffset = storeNone ? 0 : 1;\n    const tracks = parseTracks(shape\x2C board.width\x2C board.height\x2C indexOffset);\n    return { ...board\x2C tracks\x2C numStores: storeNone ? 0 : 2 };\n}\n/**\n * Statically evaluate a board-dimension node to a number. Handles literals\x2C\n * simple integer arithmetic (`+ - * /`) over literals \u2014 which is what option\n * substitution leaves behind\x2C e.g. `(- 5 1)` \u2014 and curly lists of sizes\n * (irregular polygons)\x2C for which the largest member bounds the board. Any\n * unresolved or unsupported form yields NaN\x2C which downstream mask builders\n * clamp to a default rather than crash.\n */\nfunction staticEvalDim(node) {\n    if (!node)\n        return Number.NaN;\n    if (isNumber(node))\n        return node.value;\n    if (isList(node)) {\n        if (node.delimiter === "curly") {\n            let max = Number.NaN;\n            for (const item of node.items) {\n                const v = staticEvalDim(item);\n                if (Number.isFinite(v) && (!Number.isFinite(max) || v > max))\n                    max = v;\n            }\n            return max;\n        }\n        const head = listHead(node);\n        const args = node.items.slice(1).map(staticEvalDim);\n        if (args.some((a) => !Number.isFinite(a)))\n            return Number.NaN;\n        switch (head) {\n            case "+":\n                return args.reduce((a\x2C b) => a + b\x2C 0);\n            case "-":\n                return args.length === 1 ? -args[0] : args.reduce((a\x2C b) => a - b);\n            case "*":\n                return args.reduce((a\x2C b) => a * b\x2C 1);\n            case "/":\n                return args.reduce((a\x2C b) => a / b);\n            default:\n                return Number.NaN;\n        }\n    }\n    return Number.NaN;\n}\n/** Collect board-dimension numbers from a shape's args (skips idents). */\nfunction collectDims(shape) {\n    const dims = [];\n    for (let i = 1; i < shape.items.length; i += 1) {\n        const v = staticEvalDim(shape.items[i]);\n        if (Number.isFinite(v))\n            dims.push(v);\n    }\n    return dims;\n}\n/**\n * `(tri \u2026)` board shapes on the triangular vertex lattice. The default\n * outline for `(tri n)` is a triangle; named shapes give Hexagon / Rectangle\n * / Square outlines. All use TRI_TILING (uniform six-neighbour adjacency).\n */\nfunction parseTriBoard(shape) {\n    const first = shape.items[1];\n    const shapeName = first && isIdent(first) ? first.name.toLowerCase() : undefined;\n    const nums = collectDims(shape);\n    const n1 = nums[0] ?? Number.NaN;\n    const n2 = nums[1] ?? n1;\n    let mask;\n    if (shapeName === "hexagon") {\n        mask = triHexagonMask(n1);\n    }\n    else if (shapeName === "rectangle" || shapeName === "prism") {\n        mask = triRectangleMask(n1\x2C n2);\n    }\n    else if (shapeName === "square") {\n        mask = triRectangleMask(n1\x2C n1);\n    }\n    else if (shapeName === undefined || shapeName === "triangle") {\n        mask = triangleMask(n1);\n    }\n    else {\n        // Limping / Diamond / Star / custom polygon: approximate with a bounding\n        // hexagon so the game still compiles.\n        mask = triHexagonMask(n1);\n    }\n    return {\n        width: mask.width\x2C\n        height: mask.height\x2C\n        tiling: TRI_TILING\x2C\n        onBoard: mask.onBoard\x2C\n    };\n}\n/**\n * `(hex \u2026)` board shapes. Java's HexBoard takes an optional named shape\n * (Hexagon / Rhombus / Rectangle / \u2026) followed by its dimension(s). All map\n * onto an axial bounding box with HEX_TILING adjacency; non-rectangular\n * outlines (Hexagon) carry an on-board mask.\n */\nfunction parseHexBoard(shape) {\n    const first = shape.items[1];\n    const shapeName = first && isIdent(first) ? first.name.toLowerCase() : undefined;\n    const nums = collectDims(shape);\n    const n1 = nums[0] ?? Number.NaN;\n    const n2 = nums[1] ?? n1;\n    if (shapeName === "rhombus" || shapeName === "rhombi") {\n        const m = rhombusMask(n1\x2C n2);\n        return { width: m.width\x2C height: m.height\x2C tiling: HEX_TILING };\n    }\n    if (shapeName === "rectangle") {\n        // (hex Rectangle rows columns) \u2014 fully-filled box of hexes.\n        const m = rhombusMask(n2\x2C n1);\n        return { width: m.width\x2C height: m.height\x2C tiling: HEX_TILING };\n    }\n    if (shapeName === "hexagon" || shapeName === undefined) {\n        // (hex n) / (hex Hexagon n) \u2192 regular hexagon of side n.\n        // (hex w h) with no name \u2192 parallelogram.\n        if (shapeName === undefined && nums.length >= 2) {\n            const m = rhombusMask(n1\x2C n2);\n            return { width: m.width\x2C height: m.height\x2C tiling: HEX_TILING };\n        }\n        const m = hexagonMask(n1);\n        return {\n            width: m.width\x2C\n            height: m.height\x2C\n            tiling: HEX_TILING\x2C\n            onBoard: m.onBoard\x2C\n        };\n    }\n    // Other named outlines (Triangle / Diamond / Star / Limping): approximate\n    // with a bounding hexagon so the game still compiles and plays.\n    const m = hexagonMask(n1);\n    return {\n        width: m.width\x2C\n        height: m.height\x2C\n        tiling: HEX_TILING\x2C\n        onBoard: m.onBoard\x2C\n    };\n}\nfunction parsePieces(equipment\x2C numPlayers) {\n    const table = {\n        labels: []\x2C\n        owner: new Map()\x2C\n        idByLabel: new Map()\x2C\n        ownerById: []\x2C\n    };\n    const byPlayer = new Map();\n    // Players who already received their primary (id == owner) component.\n    const primaryAssigned = new Set();\n    const nextId = { value: numPlayers + 1 };\n    for (const item of equipment.items) {\n        let pieceNode;\n        if (isList(item) && listHead(item) === "piece")\n            pieceNode = item;\n        else if (isList(item) && item.delimiter === "curly") {\n            // equipment wrapped in a curly list of entries\n            for (const inner of item.items) {\n                if (isList(inner) && listHead(inner) === "piece") {\n                    collectPiece(inner\x2C table\x2C byPlayer\x2C numPlayers\x2C primaryAssigned\x2C nextId);\n                }\n            }\n            continue;\n        }\n        if (pieceNode)\n            collectPiece(pieceNode\x2C table\x2C byPlayer\x2C numPlayers\x2C primaryAssigned\x2C nextId);\n    }\n    for (let p = 1; p <= numPlayers; p += 1) {\n        table.labels.push(byPlayer.get(p) ?? `P${p}`);\n    }\n    return table;\n}\n/** Register one (label\x2C owner) pair: owner map + a fresh-or-primary `what` id. */\nfunction assignComponent(label\x2C owner\x2C table\x2C byPlayer\x2C primaryAssigned\x2C nextId) {\n    table.owner.set(label\x2C owner);\n    if (!byPlayer.has(owner))\n        byPlayer.set(owner\x2C label);\n    let id;\n    if (!primaryAssigned.has(owner)) {\n        id = owner;\n        primaryAssigned.add(owner);\n    }\n    else {\n        id = nextId.value;\n        nextId.value += 1;\n    }\n    table.idByLabel.set(label\x2C id);\n    table.ownerById[id] = owner;\n}\nfunction collectPiece(pieceNode\x2C table\x2C byPlayer\x2C numPlayers\x2C primaryAssigned\x2C nextId) {\n    const labelNode = pieceNode.items[1];\n    if (!labelNode || !isString(labelNode))\n        return;\n    const label = labelNode.value;\n    // The slot after the name is an optional RoleType keyword; anything else\n    // (the move-rules list\x2C or nothing) means no role was given. Java's Piece\n    // constructor treats a missing role as `RoleType.Each`\x2C so a bare\n    // `(piece "Pawn" <rules>)` is one component per player \u2014 register it that\n    // way rather than dropping it.\n    const roleNode = pieceNode.items[2];\n    const role = roleNode && isIdent(roleNode) ? roleNode.name : "Each";\n    if (role === "Each") {\n        for (let p = 1; p <= numPlayers; p += 1) {\n            assignComponent(`${label}${p}`\x2C p\x2C table\x2C byPlayer\x2C primaryAssigned\x2C nextId);\n        }\n        return;\n    }\n    const m = /^P(\\d+)$/.exec(role);\n    if (m?.[1]) {\n        const p = Number(m[1]);\n        assignComponent(label\x2C p\x2C table\x2C byPlayer\x2C primaryAssigned\x2C nextId);\n    }\n}\n/** Players can be a count `(players 2)` or a list `(players {(player N)\u2026})`. */\nfunction parseNumPlayers(gameNode) {\n    const playersNode = child(gameNode\x2C "players");\n    if (!playersNode)\n        return 2;\n    const arg = playersNode.items[1];\n    if (arg && isNumber(arg))\n        return arg.value;\n    // `(players { (player N) (player S) })` \u2014 count the (player \u2026) entries.\n    let count = 0;\n    const scan = (node) => {\n        for (const item of node.items) {\n            if (!isList(item))\n                continue;\n            if (listHead(item) === "player")\n                count += 1;\n            else if (item.delimiter === "curly")\n                scan(item);\n        }\n    };\n    scan(playersNode);\n    return count > 0 ? count : 2;\n}\n/**\n * Per-player facing directions from `(players {(player N) (player S) \u2026})`.\n * Returns a 1-based array (`[0]` unused); an entry is the facing token (N/S/\n * E/W/\u2026) the player declared\x2C or `undefined` for the count form `(players N)`\n * and any player without an explicit `(player <Dir>)`. Java parity:\n * `Game.create` copies each `Player.direction()` onto that player's components\x2C\n * and an undeclared facing defaults to `CompassDirection.N`.\n */\nfunction parsePlayerFacings(gameNode\x2C numPlayers) {\n    const facings = new Array(numPlayers + 1).fill(undefined);\n    const playersNode = child(gameNode\x2C "players");\n    if (!playersNode)\n        return facings;\n    let idx = 0;\n    const scan = (node) => {\n        for (const item of node.items) {\n            if (!isList(item))\n                continue;\n            if (listHead(item) === "player") {\n                idx += 1;\n                const arg = item.items[1];\n                if (idx <= numPlayers && arg && isIdent(arg))\n                    facings[idx] = arg.name;\n            }\n            else if (item.delimiter === "curly")\n                scan(item);\n        }\n    };\n    scan(playersNode);\n    return facings;\n}\n/** Collect the direct numeric children of a list\x2C e.g. `{2 3 4 5}` \u2192 [2\x2C3\x2C4\x2C5]. */\nfunction numbersIn(list) {\n    const out = [];\n    for (const it of list.items) {\n        if (it && isNumber(it))\n            out.push(it.value);\n    }\n    return out;\n}\n/** Faces of a plain die: `from\x2C from+1\x2C \u2026\x2C from+d-1` (Java Dice default). */\nfunction rangeFaces(from\x2C d) {\n    const out = [];\n    for (let i = 0; i < d; i += 1)\n        out.push(from + i);\n    return out;\n}\n/**\n * Parse one `(dice d:N from:K num:M faces:{\u2026} facesByDie:{\u2026})` declaration\x2C\n * appending one face-set per physical die to `out`. Java parity: the Dice\n * equipment ludeme \u2014 `d` sides (default 6)\x2C `from` start value (default 1)\x2C\n * `num` dice\x2C `faces` overriding the range for every die\x2C `facesByDie`\n * giving each die its own face set.\n */\nfunction parseOneDice(dice\x2C out) {\n    let d = 6;\n    let from = 1;\n    let num = 1;\n    let hasNum = false;\n    let faces;\n    let facesByDie;\n    for (let i = 1; i < dice.items.length; i += 1) {\n        const tok = dice.items[i];\n        if (tok && isNumber(tok) && !hasNum) {\n            // Bare positional count\x2C e.g. `(dice 2)` after define expansion.\n            num = tok.value;\n            hasNum = true;\n            continue;\n        }\n        if (!tok || !isIdent(tok))\n            continue;\n        const val = dice.items[i + 1];\n        switch (tok.name) {\n            case "d:":\n                if (val && isNumber(val))\n                    d = val.value;\n                break;\n            case "from:":\n                if (val && isNumber(val))\n                    from = val.value;\n                break;\n            case "num:":\n                if (val && isNumber(val)) {\n                    num = val.value;\n                    hasNum = true;\n                }\n                break;\n            case "faces:":\n                if (val && isList(val))\n                    faces = numbersIn(val);\n                break;\n            case "facesByDie:":\n                if (val && isList(val)) {\n                    facesByDie = [];\n                    for (const sub of val.items) {\n                        if (isList(sub))\n                            facesByDie.push(numbersIn(sub));\n                    }\n                }\n                break;\n            default:\n                break;\n        }\n    }\n    if (facesByDie && facesByDie.length > 0) {\n        for (const f of facesByDie)\n            out.push(f);\n        return;\n    }\n    const dieFaces = faces ?? rangeFaces(from\x2C d);\n    for (let k = 0; k < num; k += 1)\n        out.push([...dieFaces]);\n}\n/** Scan equipment for every `(dice \u2026)` container; undefined if none. */\nfunction parseDice(equipment) {\n    const perDieFaces = [];\n    const scan = (node) => {\n        for (const item of node.items) {\n            if (!isList(item))\n                continue;\n            if (listHead(item) === "dice")\n                parseOneDice(item\x2C perDieFaces);\n            else if (item.delimiter === "curly")\n                scan(item);\n        }\n    };\n    scan(equipment);\n    if (perDieFaces.length === 0)\n        return undefined;\n    return { numDice: perDieFaces.length\x2C faces: perDieFaces };\n}\nfunction parseGame(gameNode) {\n    if (listHead(gameNode) !== "game") {\n        throw new Error("LudemeGame: root node must be (game \u2026).");\n    }\n    const numPlayers = parseNumPlayers(gameNode);\n    const equipment = child(gameNode\x2C "equipment");\n    if (!equipment)\n        throw new Error("LudemeGame: game has no (equipment \u2026).");\n    const parsed = parseBoard(equipment);\n    const boardNumSites = parsed.numSites ?? parsed.width * parsed.height;\n    // Java seeds non-board containers after `maxSiteMainBoard = max(numFaces\x2C\n    // numPlaySites)`. On a Vertex-play graph board faces outnumber the play\n    // sites\x2C so a hand's index lives in Cell space past the board faces.\n    const numBoardFaces = parsed.numFaces ?? boardNumSites;\n    const cellBase = Math.max(numBoardFaces\x2C boardNumSites);\n    const hands = parseHands(equipment\x2C numPlayers\x2C cellBase);\n    // Store cells (mancala) follow the board + hands in the cell array.\n    const numStores = parsed.numStores ?? 0;\n    const storeBase = cellBase + hands.totalHandSites;\n    const stores = [];\n    for (let i = 0; i < numStores; i += 1)\n        stores.push(storeBase + i);\n    const board = new InterpBoard(parsed.width\x2C parsed.height\x2C hands.handStart\x2C hands.handSizes\x2C parsed.tiling\x2C parsed.onBoard\x2C parsed.tracks ?? []\x2C stores\x2C parsed.traj);\n    board.playerFacing = parsePlayerFacings(gameNode\x2C numPlayers);\n    const components = parsePieces(equipment\x2C numPlayers);\n    const diceDef = parseDice(equipment);\n    const nameNode = gameNode.items[1];\n    const name = nameNode && isString(nameNode) ? nameNode.value : "Game";\n    return {\n        name\x2C\n        numPlayers\x2C\n        board\x2C\n        componentLabels: components.labels\x2C\n        pieceOwner: components.owner\x2C\n        componentIdByLabel: components.idByLabel\x2C\n        componentOwnerById: components.ownerById\x2C\n        totalHandSites: hands.totalHandSites\x2C\n        totalStoreSites: numStores\x2C\n        cellBase\x2C\n        diceDef\x2C\n    };\n}\n/** Visit every `(piece \u2026)` entry\x2C descending the equipment curly group. */\nfunction forEachPiece(equipment\x2C cb) {\n    const scan = (node) => {\n        for (const item of node.items) {\n            if (!isList(item))\n                continue;\n            if (listHead(item) === "piece")\n                cb(item);\n            else if (item.delimiter === "curly")\n                scan(item);\n        }\n    };\n    scan(equipment);\n}\n/** Player id from a role token (P1\x2C P2\x2C \u2026); undefined if not a P-role. */\nfunction playerOfRole(name) {\n    const m = /^P(\\d+)$/.exec(name);\n    return m?.[1] ? Number(m[1]) : undefined;\n}\n/**\n * Compile each `(piece <label> <role> <moves>)` definition into a move\n * generator and register it for the owning player(s) in the env.\n */\nfunction compilePieceMoves(equipment\x2C env) {\n    const byOwner = env.pieceMovesByOwner;\n    if (!byOwner)\n        return;\n    const byWhat = env.pieceMovesByWhat;\n    const idByLabel = env.componentIdByLabel;\n    forEachPiece(equipment\x2C (piece) => {\n        const labelNode = piece.items[1];\n        const label = labelNode && isString(labelNode) ? labelNode.value : undefined;\n        // The slot after the name is an optional RoleType keyword. Anything that\n        // is not an ident (a moves list\x2C or absent) means no role was declared \u2014\n        // Java's Piece constructor treats that as