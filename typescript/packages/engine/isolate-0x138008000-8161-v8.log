script-source,236,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/radial.js,// @java Core/src/game/util/graph/Radial.java Radial\n// @java Core/src/game/util/graph/Radials.java Radials\n//\n// A Radial is a ray: a sequence of graph elements starting at an origin and\n// stepping in one direction (e.g. a rook's file). Radials is the per-element\n// collection\x2C indexed by direction\x2C with the "distinct" sublists Java uses to\n// deduplicate a radial against its opposite.\nimport { AbsoluteDirection as ABS\x2C NUM_DIRECTIONS\x2C specific\x2C } from "./absolute-direction.js";\nimport { absTanAngleDifference3D\x2C angle2D } from "./math.js";\nimport { matchesElement } from "./step.js";\n/** @java Core/src/game/util/graph/Radial.java Radial */\nexport class Radial {\n    steps;\n    direction;\n    opps = null;\n    constructor(steps\x2C direction) {\n        this.steps = steps;\n        this.direction = direction;\n    }\n    from() {\n        return this.steps[0];\n    }\n    lastStep() {\n        return this.steps[this.steps.length - 1];\n    }\n    opposites() {\n        return this.opps;\n    }\n    /** @java Radial.matches: same direction and identical step path. */\n    matches(other) {\n        if (this.direction !== other.direction)\n            return false;\n        return this.stepsMatch(other);\n    }\n    /** @java Radial.stepsMatch: same length\x2C element-for-element match. */\n    stepsMatch(other) {\n        if (this.steps.length !== other.steps.length)\n            return false;\n        for (let n = 0; n < this.steps.length; n += 1) {\n            if (!matchesElement(this.steps[n]\x2C other.steps[n])) {\n                return false;\n            }\n        }\n        return true;\n    }\n    /** @java Radial.isOppositeAngleTo: first hops point ~180\xb0 apart (~9\xb0 slack). */\n    isOppositeAngleTo(other) {\n        const tanThreshold = Math.tan(0.1);\n        const geA = this.steps[1];\n        const geB = this.steps[0];\n        const geC = other.steps[1];\n        return absTanAngleDifference3D(geA.pt\x2C geB.pt\x2C geC.pt) < tanThreshold;\n    }\n    /** @java Radial.addOpposite */\n    addOpposite(opp) {\n        if (this.opps === null) {\n            this.opps = [opp];\n            return;\n        }\n        for (const existing of this.opps) {\n            if (this.direction === opp.direction ||\n                specific(this.direction) ||\n                opp.stepsMatch(existing)) {\n                return;\n            }\n        }\n        this.opps.push(opp);\n    }\n    /** @java Radial.removeOppositeSubsets */\n    removeOppositeSubsets() {\n        if (this.opps === null)\n            return;\n        for (let o = this.opps.length - 1; o >= 0; o -= 1) {\n            const oppositeO = this.opps[o];\n            for (let n = 0; n < this.opps.length; n += 1) {\n                if (n === o)\n                    continue;\n                if (oppositeO.isSubsetOf(this.opps[n])) {\n                    this.opps.splice(o\x2C 1);\n                    break;\n                }\n            }\n        }\n    }\n    /** @java Radial.isSubsetOf: this path is a prefix of other's. */\n    isSubsetOf(other) {\n        if (this.steps.length > other.steps.length)\n            return false;\n        for (let n = 0; n < this.steps.length; n += 1) {\n            if (!matchesElement(this.steps[n]\x2C other.steps[n])) {\n                return false;\n            }\n        }\n        return true;\n    }\n}\n/** Stable CW-from-N sort \u2014 @java Radials.sort / Steps.sort via ItemScore. */\nfunction sortByFirstHop(list) {\n    const ranked = list.map((radial\x2C n) => {\n        const p0 = radial.steps[0];\n        const p1 = radial.steps[1];\n        const theta = angle2D(p0.pt.x\x2C p0.pt.y\x2C p1.pt.x\x2C p1.pt.y);\n        let score = Math.PI / 2 - theta + 0.0001;\n        while (score < 0)\n            score += 2 * Math.PI;\n        return { radial\x2C score\x2C n };\n    });\n    ranked.sort((a\x2C b) => (a.score === b.score ? a.n - b.n : a.score - b.score));\n    for (let i = 0; i < ranked.length; i += 1) {\n        list[i] = ranked[i].radial;\n    }\n}\n/** @java Core/src/game/util/graph/Radials.java Radials */\nexport class Radials {\n    siteType;\n    siteId;\n    radials = [];\n    inDirectionLists;\n    distinctInDirectionLists;\n    totalDirections = new Set();\n    constructor(siteType\x2C siteId) {\n        this.siteType = siteType;\n        this.siteId = siteId;\n        this.inDirectionLists = Array.from({ length: NUM_DIRECTIONS }\x2C () => []);\n        this.distinctInDirectionLists = Array.from({ length: NUM_DIRECTIONS }\x2C () => []);\n    }\n    inDirection(dirn) {\n        return this.inDirectionLists[dirn];\n    }\n    distinctInDirection(dirn) {\n        return this.distinctInDirectionLists[dirn];\n    }\n    addInDirection(dirn\x2C radial) {\n        this.inDirectionLists[dirn].push(radial);\n    }\n    /** @java Radials.addSafe: dedup\x2C register opposites\x2C track distinctness. */\n    addSafe(radial) {\n        // Skip exact duplicates.\n        for (const existing of this.radials)\n            if (existing.matches(radial))\n                return;\n        // Register opposite relationships (rotational pairs or opposite-angle rays).\n        for (const existing of this.radials) {\n            if ((radial.direction === ABS.CW && existing.direction === ABS.CCW) ||\n                (radial.direction === ABS.CCW && existing.direction === ABS.CW) ||\n                (radial.direction === ABS.In && existing.direction === ABS.Out) ||\n                (radial.direction === ABS.Out && existing.direction === ABS.In) ||\n                (radial.isOppositeAngleTo(existing) &&\n                    ((specific(radial.direction) && specific(existing.direction)) ||\n                        radial.direction === existing.direction))) {\n                radial.addOpposite(existing);\n                existing.addOpposite(radial);\n            }\n        }\n        // Distinctness within this direction.\n        let isDistinct = true;\n        for (const existing of this.inDirection(radial.direction)) {\n            if (radial.stepsMatch(existing) || radial.isOppositeAngleTo(existing)) {\n                isDistinct = false;\n                break;\n            }\n            const opps = radial.opposites();\n            if (opps !== null) {\n                for (const existingOpposite of opps) {\n                    if (radial.stepsMatch(existingOpposite)) {\n                        isDistinct = false;\n                        break;\n                    }\n                }\n            }\n        }\n        this.radials.push(radial);\n        this.inDirectionLists[radial.direction].push(radial);\n        this.totalDirections.add(radial.direction);\n        if (isDistinct) {\n            this.distinctInDirectionLists[radial.direction].push(radial);\n        }\n    }\n    /** @java Radials.removeSubsetsInDirection */\n    removeSubsetsInDirection(dirn) {\n        const list = this.inDirectionLists[dirn];\n        for (let n = list.length - 1; n >= 0; n -= 1) {\n            const radial = list[n];\n            for (let nn = 0; nn < list.length; nn += 1) {\n                if (n === nn)\n                    continue;\n                if (radial.isSubsetOf(list[nn])) {\n                    list.splice(n\x2C 1);\n                    break;\n                }\n            }\n        }\n    }\n    /** @java Radials.setDistinct: recompute distinct sublists per direction. */\n    setDistinct() {\n        for (let dirn = 0; dirn < NUM_DIRECTIONS; dirn += 1) {\n            this.distinctInDirectionLists[dirn].length = 0;\n        }\n        for (let dirn = 0; dirn < NUM_DIRECTIONS; dirn += 1) {\n            const list = this.inDirectionLists[dirn];\n            const distinct = this.distinctInDirectionLists[dirn];\n            for (const radial of list) {\n                let isDistinct = true;\n                for (const existing of distinct) {\n                    if (radial === existing)\n                        continue;\n                    const opps = existing.opposites();\n                    if (opps === null)\n                        continue;\n                    for (const opp of opps) {\n                        if (radial.stepsMatch(opp)) {\n                            isDistinct = false;\n                            break;\n                        }\n                    }\n                    if (!isDistinct)\n                        break;\n                }\n                if (isDistinct)\n                    distinct.push(radial);\n            }\n        }\n    }\n    /** @java Radials.sort: CW from N across every list. */\n    sort() {\n        sortByFirstHop(this.radials);\n        for (let dirn = 0; dirn < NUM_DIRECTIONS; dirn += 1) {\n            sortByFirstHop(this.inDirectionLists[dirn]);\n            sortByFirstHop(this.distinctInDirectionLists[dirn]);\n        }\n    }\n}\n//# sourceMappingURL=radial.js.map
