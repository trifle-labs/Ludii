script-source,232,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectory/absolute-direction.js,// @java Core/src/game/util/directions/AbsoluteDirection.java AbsoluteDirection\n//\n// Faithful port of Java's AbsoluteDirection enum. ORDINALS MUST MATCH the Java\n// declaration order exactly: they index into Steps/Radials per-direction arrays\n// and are stored as bits in a Step's `directions` BitSet\x2C so any reordering\n// silently corrupts trajectory parity. See PARITY.md (roadmap item 2).\n//\n// 51 values total: 13 meta (All..Support)\x2C 16 compass (N..NNE)\x2C 4 rotational\n// (CW/CCW/In/Out)\x2C 9 upward (U..UNW)\x2C 9 downward (D..DNW).\n/** Absolute movement/connectivity directions\x2C ordinal-faithful to Java. */\nexport var AbsoluteDirection;\n(function (AbsoluteDirection) {\n    AbsoluteDirection[AbsoluteDirection["All"] = 0] = "All";\n    AbsoluteDirection[AbsoluteDirection["Angled"] = 1] = "Angled";\n    AbsoluteDirection[AbsoluteDirection["Adjacent"] = 2] = "Adjacent";\n    AbsoluteDirection[AbsoluteDirection["Axial"] = 3] = "Axial";\n    AbsoluteDirection[AbsoluteDirection["Orthogonal"] = 4] = "Orthogonal";\n    AbsoluteDirection[AbsoluteDirection["Diagonal"] = 5] = "Diagonal";\n    AbsoluteDirection[AbsoluteDirection["OffDiagonal"] = 6] = "OffDiagonal";\n    AbsoluteDirection[AbsoluteDirection["SameLayer"] = 7] = "SameLayer";\n    AbsoluteDirection[AbsoluteDirection["Upward"] = 8] = "Upward";\n    AbsoluteDirection[AbsoluteDirection["Downward"] = 9] = "Downward";\n    AbsoluteDirection[AbsoluteDirection["Rotational"] = 10] = "Rotational";\n    AbsoluteDirection[AbsoluteDirection["Base"] = 11] = "Base";\n    AbsoluteDirection[AbsoluteDirection["Support"] = 12] = "Support";\n    // Intercardinal (16-compass)\n    AbsoluteDirection[AbsoluteDirection["N"] = 13] = "N";\n    AbsoluteDirection[AbsoluteDirection["E"] = 14] = "E";\n    AbsoluteDirection[AbsoluteDirection["S"] = 15] = "S";\n    AbsoluteDirection[AbsoluteDirection["W"] = 16] = "W";\n    AbsoluteDirection[AbsoluteDirection["NE"] = 17] = "NE";\n    AbsoluteDirection[AbsoluteDirection["SE"] = 18] = "SE";\n    AbsoluteDirection[AbsoluteDirection["NW"] = 19] = "NW";\n    AbsoluteDirection[AbsoluteDirection["SW"] = 20] = "SW";\n    AbsoluteDirection[AbsoluteDirection["NNW"] = 21] = "NNW";\n    AbsoluteDirection[AbsoluteDirection["WNW"] = 22] = "WNW";\n    AbsoluteDirection[AbsoluteDirection["WSW"] = 23] = "WSW";\n    AbsoluteDirection[AbsoluteDirection["SSW"] = 24] = "SSW";\n    AbsoluteDirection[AbsoluteDirection["SSE"] = 25] = "SSE";\n    AbsoluteDirection[AbsoluteDirection["ESE"] = 26] = "ESE";\n    AbsoluteDirection[AbsoluteDirection["ENE"] = 27] = "ENE";\n    AbsoluteDirection[AbsoluteDirection["NNE"] = 28] = "NNE";\n    // Rotational\n    AbsoluteDirection[AbsoluteDirection["CW"] = 29] = "CW";\n    AbsoluteDirection[AbsoluteDirection["CCW"] = 30] = "CCW";\n    AbsoluteDirection[AbsoluteDirection["In"] = 31] = "In";\n    AbsoluteDirection[AbsoluteDirection["Out"] = 32] = "Out";\n    // Spatial \u2014 upward\n    AbsoluteDirection[AbsoluteDirection["U"] = 33] = "U";\n    AbsoluteDirection[AbsoluteDirection["UN"] = 34] = "UN";\n    AbsoluteDirection[AbsoluteDirection["UNE"] = 35] = "UNE";\n    AbsoluteDirection[AbsoluteDirection["UE"] = 36] = "UE";\n    AbsoluteDirection[AbsoluteDirection["USE"] = 37] = "USE";\n    AbsoluteDirection[AbsoluteDirection["US"] = 38] = "US";\n    AbsoluteDirection[AbsoluteDirection["USW"] = 39] = "USW";\n    AbsoluteDirection[AbsoluteDirection["UW"] = 40] = "UW";\n    AbsoluteDirection[AbsoluteDirection["UNW"] = 41] = "UNW";\n    // Spatial \u2014 downward\n    AbsoluteDirection[AbsoluteDirection["D"] = 42] = "D";\n    AbsoluteDirection[AbsoluteDirection["DN"] = 43] = "DN";\n    AbsoluteDirection[AbsoluteDirection["DNE"] = 44] = "DNE";\n    AbsoluteDirection[AbsoluteDirection["DE"] = 45] = "DE";\n    AbsoluteDirection[AbsoluteDirection["DSE"] = 46] = "DSE";\n    AbsoluteDirection[AbsoluteDirection["DS"] = 47] = "DS";\n    AbsoluteDirection[AbsoluteDirection["DSW"] = 48] = "DSW";\n    AbsoluteDirection[AbsoluteDirection["DW"] = 49] = "DW";\n    AbsoluteDirection[AbsoluteDirection["DNW"] = 50] = "DNW";\n})(AbsoluteDirection || (AbsoluteDirection = {}));\n/** Number of distinct AbsoluteDirection values (= Java AbsoluteDirection.values().length). */\nexport const NUM_DIRECTIONS = 51;\n/** All directions in ordinal order \u2014 the analogue of `AbsoluteDirection.values()`. */\nexport const ALL_DIRECTIONS = Array.from({ length: NUM_DIRECTIONS }\x2C (_\x2C i) => i);\nconst NAMES = [\n    "All"\x2C "Angled"\x2C "Adjacent"\x2C "Axial"\x2C "Orthogonal"\x2C "Diagonal"\x2C "OffDiagonal"\x2C\n    "SameLayer"\x2C "Upward"\x2C "Downward"\x2C "Rotational"\x2C "Base"\x2C "Support"\x2C\n    "N"\x2C "E"\x2C "S"\x2C "W"\x2C "NE"\x2C "SE"\x2C "NW"\x2C "SW"\x2C\n    "NNW"\x2C "WNW"\x2C "WSW"\x2C "SSW"\x2C "SSE"\x2C "ESE"\x2C "ENE"\x2C "NNE"\x2C\n    "CW"\x2C "CCW"\x2C "In"\x2C "Out"\x2C\n    "U"\x2C "UN"\x2C "UNE"\x2C "UE"\x2C "USE"\x2C "US"\x2C "USW"\x2C "UW"\x2C "UNW"\x2C\n    "D"\x2C "DN"\x2C "DNE"\x2C "DE"\x2C "DSE"\x2C "DS"\x2C "DSW"\x2C "DW"\x2C "DNW"\x2C\n];\nconst BY_NAME = new Map(NAMES.map((n\x2C i) => [n\x2C i]));\n/** Direction name (e.g. "NE")\x2C matching Java's enum `name()`. */\nexport function directionName(dir) {\n    return NAMES[dir] ?? `?${dir}`;\n}\n/** Look up a direction by its Java name\x2C or undefined if unknown. */\nexport function directionByName(name) {\n    return BY_NAME.get(name);\n}\n// @java Core/src/game/util/directions/AbsoluteDirection.java specific\n/**\n * Whether the direction is a specific direction (e.g. N) as opposed to a class\n * of directions (e.g. Adjacent). Java derives this from `convert(dir) != null`;\n * convert returns a DirectionFacing for every compass/rotational/spatial value\n * (ordinal >= 13) and null for the meta values (All..Support\x2C ordinal < 13).\n */\nexport function specific(dir) {\n    return dir 