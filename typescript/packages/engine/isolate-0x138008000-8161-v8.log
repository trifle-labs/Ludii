script-source,227,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/generators.js,/**\n * Board-shape generators \u2014 Java parity with\n * Core/src/game/functions/graph/generators/**. Each returns a planar\n * {@link Graph}; faces are computed by the caller (or here when the shape's\n * cells are needed). Coordinates are laid out so the angle-binned direction\n * model in trajectories.ts yields the expected compass neighbours.\n */\nimport { Graph } from "./graph.js";\n/**\n * `(square n)` \u2014 an n\xd7n grid. Java `RectangleOnSquare` sizes the vertex grid as\n * `dim + (Cell ? 1 : 0)`: in Cell play this is an n\xd7n grid of unit-square cells\n * ((n+1)\xb2 vertices); in Vertex play (alquerque / Go / morris / hunt) the n\n * counts vertices directly\x2C giving exactly n\xb2 intersections.\n */\nexport function genSquare(n\x2C vertexMode = false\x2C diagonals) {\n    return genRectangle(n\x2C n\x2C vertexMode\x2C diagonals);\n}\n/**\n * `(rectangle rows cols)` \u2014 rows\xd7cols grid (see {@link genSquare} on vertexMode).\n * `diagonals` adds the optional diagonal edges (`Alternating` / `Solid` /\n * `SolidNoSplit` / `Concentric`)\x2C matching Java `Square.handleDiagonals`.\n */\nexport function genRectangle(rows\x2C cols\x2C vertexMode = false\x2C diagonals) {\n    // In Cell play the dim counts cells\x2C so the vertex grid is (dim+1) per side;\n    // in Vertex play the dim already counts vertices (one fewer cell per side).\n    const r = Math.max(1\x2C Math.floor(rows)) - (vertexMode ? 1 : 0);\n    const c = Math.max(1\x2C Math.floor(cols)) - (vertexMode ? 1 : 0);\n    const g = new Graph();\n    const W = c + 1;\n    const id = (x\x2C y) => y * W + x;\n    for (let y = 0; y <= r; y += 1)\n        for (let x = 0; x <= c; x += 1)\n            g.addVertex(x\x2C y);\n    for (let y = 0; y <= r; y += 1)\n        for (let x = 0; x <= c; x += 1) {\n            if (x < c)\n                g.addEdge(id(x\x2C y)\x2C id(x + 1\x2C y));\n            if (y < r)\n                g.addEdge(id(x\x2C y)\x2C id(x\x2C y + 1));\n        }\n    addDiagonals(g\x2C r\x2C c\x2C id\x2C diagonals);\n    g.makeFaces();\n    return g;\n}\n/**\n * Add diagonal edges across grid cells\x2C matching Java\n * `Square.handleDiagonals`. Each cell has corners A=(c\x2Cr)\x2C B=(c\x2Cr+1)\x2C\n * C=(c+1\x2Cr+1)\x2C D=(c+1\x2Cr); the chosen diagonal depends on the type.\n */\nfunction addDiagonals(g\x2C r\x2C c\x2C id\x2C diagonals) {\n    if (!diagonals)\n        return;\n    const type = diagonals.toLowerCase();\n    const midRow = r / 2;\n    const midCol = c / 2;\n    for (let row = 0; row < r; row += 1)\n        for (let col = 0; col < c; col += 1) {\n            const a = id(col\x2C row);\n            const b = id(col\x2C row + 1);\n            const cc = id(col + 1\x2C row + 1);\n            const d = id(col + 1\x2C row);\n            switch (type) {\n                case "alternating":\n                    if ((row + col) % 2 === 0)\n                        g.addEdge(a\x2C cc);\n                    else\n                        g.addEdge(b\x2C d);\n                    break;\n                case "solidnosplit":\n                    g.addEdge(a\x2C cc);\n                    g.addEdge(b\x2C d);\n                    break;\n                case "solid": {\n                    // A central vertex split joins all four corners.\n                    const x = g.addVertex(col + 0.5\x2C row + 0.5);\n                    g.addEdge(a\x2C x);\n                    g.addEdge(b\x2C x);\n                    g.addEdge(cc\x2C x);\n                    g.addEdge(d\x2C x);\n                    break;\n                }\n                case "concentric":\n                    if ((row < midRow && col < midCol) || (row >= midRow && col >= midCol))\n                        g.addEdge(b\x2C d);\n                    else\n                        g.addEdge(a\x2C cc);\n                    break;\n                default:\n                    break;\n            }\n        }\n}\n/**\n * `(circle {c0 c1 \u2026} [stagger:bool])` \u2014 concentric circular rings; ring r holds\n * `counts[r]` vertices evenly spaced on a circle of radius r. A count of 1 is a\n * single centre vertex; 0 leaves that ring empty. Each ring is joined into a\n * cycle and consecutive rings are spoked at their nearest vertices.\n */\nexport function genCircle(counts\x2C stagger = false) {\n    const g = new Graph();\n    const ringVerts = [];\n    for (let r = 0; r < counts.length; r += 1) {\n        const k = Math.max(0\x2C Math.floor(counts[r] ?? 0));\n        const verts = [];\n        if (k === 1) {\n            verts.push(g.addVertex(0\x2C 0));\n        }\n        else if (k > 1) {\n            const radius = r === 0 ? 1 : r;\n            const offset = stagger && r % 2 === 1 ? Math.PI / k : 0;\n            for (let i = 0; i < k; i += 1) {\n                const a = offset + (2 * Math.PI * i) / k;\n                verts.push(g.addVertex(radius * Math.cos(a)\x2C radius * Math.sin(a)));\n            }\n        }\n        ringVerts.push(verts);\n        // Ring cycle.\n        if (verts.length > 2)\n            for (let i = 0; i < verts.length; i += 1)\n                g.addEdge(verts[i]\x2C verts[(i + 1) % verts.length]);\n    }\n    // Radial spokes: connect each vertex of an outer ring to the nearest vertex\n    // of the previous non-empty ring.\n    for (let r = 1; r < ringVerts.length; r += 1) {\n        const inner = lastNonEmpty(ringVerts\x2C r);\n        const outer = ringVerts[r] ?? [];\n        if (!inner || inner.length === 0)\n            continue;\n        for (const ov of outer)\n            g.addEdge(ov\x2C nearest(g\x2C ov\x2C inner));\n    }\n    g.makeFaces();\n    return g;\n}\n/**\n * `(concentric {c0 c1 \u2026})` \u2014 like {@link genCircle} but the rings are filled\n * (a centre point is common). Shares the circular layout.\n */\nexport function genConcentricCounts(counts) {\n    return genCircle(counts\x2C false);\n}\nconst POLY_SIDES = {\n    triangle: 3\x2C\n    square: 4\x2C\n    pentagon: 5\x2C\n    hexagon: 6\x2C\n    target: 0\x2C // handled as circular single-cell rings\n};\n/**\n * `(concentric <Polygon> rings:N [joinCorners] [joinMidpoints] [steps:k])` \u2014\n * N nested regular polygons (Morris-family boards). Each ring carries the\n * polygon's corners plus one midpoint per side (8 points for a square). Rings\n * are joined around their perimeter; spokes connect midpoints (default) and/or\n * corners (joinCorners) of consecutive rings.\n */\nexport function genConcentricPolygon(shape\x2C rings\x2C joinCorners\x2C joinMidpoints\x2C steps) {\n    const name = shape.toLowerCase();\n    const sides = POLY_SIDES[name] ?? 4;\n    const N = Math.max(1\x2C Math.floor(rings));\n    if (sides === 0) {\n        // Target: N rings each a single circle of `steps` cells (default 8).\n        const k = Math.max(1\x2C Math.floor(steps ?? 8));\n        return genCircle(Array.from({ length: N + 1 }\x2C (_\x2C r) => (r === 0 ? 1 : k)));\n    }\n    const g = new Graph();\n    // Corner angles of the polygon; midpoints sit halfway between corners.\n    const cornerAngle = (i) => Math.PI / 2 + (2 * Math.PI * i) / sides; // first corner pointing up\n    const ringCorners = [];\n    const ringMids = [];\n    for (let r = 1; r <= N; r += 1) {\n        const corners = [];\n        const mids = [];\n        for (let i = 0; i < sides; i += 1) {\n            const a = cornerAngle(i);\n            corners.push(g.addVertex(r * Math.cos(a)\x2C r * Math.sin(a)));\n            const a2 = cornerAngle(i + 1);\n            const mx = (Math.cos(a) + Math.cos(a2)) / 2;\n            const my = (Math.sin(a) + Math.sin(a2)) / 2;\n            mids.push(g.addVertex(r * mx\x2C r * my));\n        }\n        ringCorners.push(corners);\n        ringMids.push(mids);\n        // Perimeter: corner_i \u2014 mid_i \u2014 corner_{i+1} \u2014 \u2026\n        for (let i = 0; i < sides; i += 1) {\n            g.addEdge(corners[i]\x2C mids[i]);\n            g.addEdge(mids[i]\x2C corners[(i + 1) % sides]);\n        }\n    }\n    // Spokes between consecutive rings.\n    for (let r = 1; r < N; r += 1) {\n        if (joinMidpoints || (!joinCorners && !joinMidpoints)) {\n            const a = ringMids[r - 1];\n            const b = ringMids[r];\n            for (let i = 0; i < sides; i += 1)\n                g.addEdge(a[i]\x2C b[i]);\n        }\n        if (joinCorners) {\n            const a = ringCorners[r - 1];\n            const b = ringCorners[r];\n            for (let i = 0; i < sides; i += 1)\n                g.addEdge(a[i]\x2C b[i]);\n        }\n    }\n    g.makeFaces();\n    return g;\n}\nfunction lastNonEmpty(rings\x2C before) {\n    for (let i = before - 1; i >= 0; i -= 1) {\n        const r = rings[i];\n        if (r && r.length > 0)\n            return r;\n    }\n    return undefined;\n}\nfunction nearest(g\x2C from\x2C candidates) {\n    const fv = g.vertices[from];\n    let best = candidates[0];\n    let bestD = Number.POSITIVE_INFINITY;\n    for (const c of candidates) {\n        const cv = g.vertices[c];\n        if (!fv || !cv)\n            continue;\n        const d = (fv.x - cv.x) ** 2 + (fv.y - cv.y) ** 2;\n        if (d < bestD) {\n            bestD = d;\n            best = c;\n        }\n    }\n    return best;\n}\n//# sourceMappingURL=generators.js.map
