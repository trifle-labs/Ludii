script-source,226,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-roll-dice.js,// @java Core/src/other/action/die/ActionUpdateDice.java ActionUpdateDice\n/**\n * Re-roll every die\x2C writing fresh face values into the state. The roll is\n * deferred to apply-time so move *generation* stays pure (enumerating moves\n * never consumes the RNG); the actual draw happens once\x2C when the chosen\n * move is applied. Java parity: Core/src/other/action/die/ActionUpdateDice\n * + the (roll) effect.\n */\nimport { BaseAction } from "./action.js";\nexport class ActionRollDice extends BaseAction {\n    static TYPE = "RollDice";\n    /** Per-die face sets: `faces[i]` are the values printable on die `i`. */\n    faces;\n    constructor(faces) {\n        super();\n        this.faces = faces;\n    }\n    apply(state\x2C rng) {\n        const rolled = this.faces.map((f) => {\n            if (f.length === 0)\n                return 0;\n            const idx = rng ? rng.nextInt(f.length) : 0;\n            return f[idx] ?? 0;\n        });\n        return state.withDiceValues(rolled);\n    }\n    actionType() {\n        return ActionRollDice.TYPE;\n    }\n}\n//# sourceMappingURL=action-roll-dice.js.map
