script-source,200,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/ai/feature.js,/**\n * Java parity:\n * - AI/src/features/Feature.java\n * - AI/src/features/feature_sets/BaseFeatureSet.java\n *\n * A `Feature` maps a (Context\x2C candidate Move) pair to a real-valued\n * activation. The Java side ships a sprawling feature library\n * (geometric\x2C pattern\x2C spatial) generated by feature discovery; this TS\n * port keeps the abstraction and provides a small starter set of\n * geometric features so downstream code (e.g. a softmax policy or\n * decision tree) has something concrete to compose.\n */\n/** Sum the named subset of features for a (context\x2C move). */\nexport class FeatureSet {\n    features;\n    constructor(features) {\n        this.features = features;\n    }\n    /** Linear combination of activations \xd7 weights. */\n    dot(context\x2C move\x2C weights) {\n        let total = 0;\n        for (let i = 0; i < this.features.length; i += 1) {\n            const w = weights[i] ?? 0;\n            if (w === 0)\n                continue;\n            const f = this.features[i];\n            if (!f)\n                continue;\n            total += w * f.activation(context\x2C move);\n        }\n        return total;\n    }\n    /** Vector of activations\x2C one per feature. */\n    extract(context\x2C move) {\n        const out = new Array(this.features.length);\n        for (let i = 0; i < this.features.length; i += 1) {\n            const f = this.features[i];\n            out[i] = f ? f.activation(context\x2C move) : 0;\n        }\n        return out;\n    }\n}\n// ---- Built-in geometric features ------------------------------------------\n/** 1 if the move targets a corner of an N\xd7N flat board\x2C else 0. */\nexport class CornerFeature {\n    name = "is-corner";\n    activation(context\x2C move) {\n        const site = move.siteIndices[0];\n        if (site === undefined)\n            return 0;\n        const game = context.game;\n        const w = game.width ?? 0;\n        const h = game.height ?? 0;\n        if (w <= 0 || h <= 0)\n            return 0;\n        const x = site % w;\n        const y = Math.floor(site / w);\n        if ((x === 0 || x === w - 1) && (y === 0 || y === h - 1))\n            return 1;\n        return 0;\n    }\n}\n/** 1 if the move targets the geometric centre of the board (odd-sized)\x2C else 0. */\nexport class CentreFeature {\n    name = "is-centre";\n    activation(context\x2C move) {\n        const site = move.siteIndices[0];\n        if (site === undefined)\n            return 0;\n        const game = context.game;\n        const w = game.width ?? 0;\n        const h = game.height ?? 0;\n        if (w <= 0 || h <= 0)\n            return 0;\n        if (w % 2 === 0 || h % 2 === 0)\n            return 0;\n        const cx = Math.floor(w / 2);\n        const cy = Math.floor(h / 2);\n        return site === cy * w + cx ? 1 : 0;\n    }\n}\n/** Activation = number of friendly orthogonal neighbours of the target site. */\nexport class FriendlyNeighbourCountFeature {\n    name = "friendly-neighbours";\n    activation(context\x2C move) {\n        const site = move.siteIndices[0];\n        if (site === undefined)\n            return 0;\n        const game = context.game;\n        const w = game.width ?? 0;\n        const h = game.height ?? 0;\n        if (w <= 0 || h <= 0)\n            return 0;\n        const x = site % w;\n        const y = Math.floor(site / w);\n        const mover = move.mover;\n        let count = 0;\n        const offsets = [\n            [1\x2C 0]\x2C\n            [-1\x2C 0]\x2C\n            [0\x2C 1]\x2C\n            [0\x2C -1]\x2C\n        ];\n        for (const [dx\x2C dy] of offsets) {\n            const nx = x + dx;\n            const ny = y + dy;\n            if (nx < 0 || nx >= w || ny < 0 || ny >= h)\n                continue;\n            const cell = context.state.cellAt(ny * w + nx);\n            if (cell.owner === mover)\n                count += 1;\n        }\n        return count;\n    }\n}\n/** A small starter feature set useful for square-board games. */\nexport function defaultGeometricFeatures() {\n    return new FeatureSet([\n        new CornerFeature()\x2C\n        new CentreFeature()\x2C\n        new FriendlyNeighbourCountFeature()\x2C\n    ]);\n}\n//# sourceMappingURL=feature.js.map
