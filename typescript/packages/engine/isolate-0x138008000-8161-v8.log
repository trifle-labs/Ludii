         componentLabels: [labels[0] ?? "P1"\x2C labels[1] ?? "P2"]\x2C\n            id: name.toLowerCase().replace(/\\s+/g\x2C "-")\x2C\n            name\x2C\n        });\n    }\n    const playClause = findChildList(rulesForm\x2C "play");\n    const playMode = playClause\n        ? (detectPlayModeIn(playClause) ?? { kind: "add" })\n        : { kind: "add" };\n    const siteCount = equipment.board.width * equipment.board.height;\n    const startForm = findChildList(game\x2C "start") ?? findChildList(rulesForm\x2C "start");\n    const startSpec = startForm\n        ? compileStartClause(startForm\x2C equipment\x2C numPlayers\x2C siteCount)\n        : undefined;\n    if (playMode.kind === "stack") {\n        if (win.kind !== "line") {\n            throw new LudCompileError("(move (stack \u2026)) requires an (is Line K) win rule"\x2C rulesForm.range.from());\n        }\n        return new StackGame({\n            id: name.toLowerCase().replace(/\\s+/g\x2C "-")\x2C\n            name\x2C\n            width: equipment.board.width\x2C\n            height: equipment.board.height\x2C\n            numPlayers\x2C\n            componentLabels: labels\x2C\n            winMode: "line"\x2C\n            lineLength: win.lineLength\x2C\n            initialMover: startSpec?.mover\x2C\n        });\n    }\n    if (playMode.kind === "step" ||\n        playMode.kind === "slide" ||\n        playMode.kind === "hop") {\n        if (!startSpec || startSpec.placement.every((c) => c === 0)) {\n            // No on-board seed \u2014 likely a hand-placement game whose Step/Hop\n            // verb only fires after a hand drop (e.g. Moxie). Fall through to\n            // a placement-style flat board so the game still compiles.\n            const lineLength = win.kind === "line" ? win.lineLength : defaultLineLength;\n            return new FlatBoardGame({\n                id: name.toLowerCase().replace(/\\s+/g\x2C "-")\x2C\n                name\x2C\n                width: equipment.board.width\x2C\