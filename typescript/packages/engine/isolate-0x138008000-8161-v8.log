st out = [];\n            const emit = (to\x2C sub) => {\n                const actions = [new ActionMove({ from\x2C to })];\n                if (effect) {\n                    for (const a of effect(sub)) {\n                        if (a.actionType() === "Remove" && a.to() === to)\n                            continue;\n                        actions.push(a);\n                    }\n                }\n                out.push(new Move({\n                    id: `slide:${from}:${to}:${mover}`\x2C\n                    label: `Slide ${from}\u2192${to}`\x2C\n                    siteIndices: [to]\x2C\n                    mover\x2C\n                    placedOwner: mover\x2C\n                    actions\x2C\n                }));\n            };\n            for (const d of dirs) {\n                for (let toIdx = 1; toIdx <= max; toIdx += 1) {\n                    const to = board.siteAt(x0 + d.dx * toIdx\x2C y0 + d.dy * toIdx);\n                    if (to === OFF)\n                        break;\n                    const sub = ctx.withFrame({ from\x2C to\x2C between: to });\n                    // stopRule fires: emit (if reached min) and break \u2014 but the break is\n                    // gated on min\x2C so a not-yet-reached minimum continues the ray.\n                    if (stopRule && stopRule.eval(sub)) {\n                        if (min <= toIdx) {\n                            emit(to\x2C sub);\n                            break;\n                        }\n                    }\n                    // goRule: can we pass through / land on this cell?\n                    if (!goRule.eval(sub))\n                        break;\n                    if (min <= toIdx)\n                        emit(to\x2C sub);\n                }\n            }\n            return out;\n        }\x2C\n    };\n}\n/**\n * `(move Shoot (piece "Dot") <dirs?>)` \u2014 the Amazons arrow. After an amazon\n * relocates (keeping the turn via `(then (moveAgain))`)\x2C it shoots a marker\n *