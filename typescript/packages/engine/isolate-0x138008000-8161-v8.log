script-source,115,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/test/parity/trial-format.mjs,/**\n * trial-format.mjs\n *\n * Parser: Ludii Java trial file text \u2192 structured object.\n *\n * Trial file format:\n *   game=../Common/res/lud/.../.../GameName.lud\n *   START GAME OPTIONS\n *   [option lines...]\n *   END GAME OPTIONS\n *   RNG internal state=b0\x2Cb1\x2C...\n *   Move=[Move:mover=N\x2Cfrom=F\x2Cto=T\x2Cactions=[ActionType:key=val\x2C...]\x2C...]\n *   ...\n *   LEGAL MOVES LIST SIZE = N  (interleaved\x2C ignored)\n *   numInitialPlacementMoves=N\n *   winner=N\n *   endtype=Xyz\n *   rankings=0.0\x2C2.0\x2C1.0\n *   SANDBOX=false\n *   LUDII_VERSION=...\n */\n\n/**\n * Parse one action descriptor string like:\n *   "Add:type=Cell\x2Cto=127\x2Cwhat=1\x2Cdecision=true"\n *   "Move:typeFrom=Cell\x2Cfrom=5\x2Cto=10"\n *   "Pass:decision=true"\n *   "Remove:type=Cell\x2Cto=42"\n *\n * Returns { actionType: string\x2C fields: Map<string\x2C string> }\n */\nfunction parseAction(str) {\n  const colonIdx = str.indexOf(':');\n  if (colonIdx === -1) {\n    return { actionType: str.trim()\x2C fields: new Map() };\n  }\n  const actionType = str.slice(0\x2C colonIdx).trim();\n  const rest = str.slice(colonIdx + 1);\n  const fields = new Map();\n\n  // Split on commas that are NOT inside brackets.\n  // e.g. "type=Cell\x2Cto=127\x2Cwhat=1\x2Cdecision=true"\n  // We need a simple split since values are scalars (no nested commas).\n  for (const part of rest.split('\x2C')) {\n    const eqIdx = part.indexOf('=');\n    if (eqIdx === -1) continue;\n    const key = part.slice(0\x2C eqIdx).trim();\n    const val = part.slice(eqIdx + 1).trim();\n    fields.set(key\x2C val);\n  }\n\n  return { actionType\x2C fields };\n}\n\n/**\n * Parse the bracketed actions list from a Move line.\n *\n * Input example (already with outer brackets stripped):\n *   "Add:type=Cell\x2Cto=127\x2Cwhat=1\x2Cdecision=true"\n *   "Move:typeFrom=Cell\x2Cfrom=5\x2Cto=10]\x2C[Remove:type=Cell\x2Cto=5"\n *\n * The strategy: split on "]\x2C[" which separates action descriptors.\n * Each descriptor is "ActionType:key=val\x2Ckey=val\x2C..."\n */\nfunction parseActions(bracketContent) {\n  // bracketContent is everything between the outermost [ and ]\n  // Actions are separated by "]\x2C[" \u2014 split on that.\n  const parts = bracketContent.split(']\x2C[');\n  return parts.map(p => parseAction(p.trim()));\n}\n\n/**\n * Parse one Move line like:\n *   Move=[Move:mover=1\x2Cfrom=127\x2Cto=127\x2Cactions=[Add:type=Cell\x2Cto=127\x2Cwhat=1\x2Cdecision=true]]\n *\n * Returns { mover\x2C from\x2C to\x2C actions }\n */\nexport function parseMoveString(line) {\n  // Strip "Move=[Move:" prefix and trailing "]"\n  // Format: Move=[Move:mover=N\x2Cfrom=F\x2Cto=T\x2Cactions=[...]]\n  const prefixRe = /^Move=\\[Move:(.+)\\]$/;\n  const m = prefixRe.exec(line.trim());\n  if (!m) {\n    // Fallback: handle edge cases\n    throw new Error(`Cannot parse move line: ${line.slice(0\x2C 100)}`);\n  }\n\n  const inner = m[1]; // "mover=1\x2Cfrom=127\x2Cto=127\x2Cactions=[...]"\n\n  // Find the actions=[...] portion \u2014 it contains nested brackets\n  const actionsIdx = inner.indexOf('\x2Cactions=[');\n  let outerFields;\n  let actionsContent = '';\n\n  if (actionsIdx !== -1) {\n    outerFields = inner.slice(0\x2C actionsIdx);\n    // Extract content between the outermost [ ] of actions\n    const actStart = actionsIdx + '\x2Cactions=['.length;\n    // The actions list ends at the last ] in inner (which is also the last ]\n    // before the closing ] of the whole Move)\n    actionsContent = inner.slice(actStart\x2C inner.length); // may have trailing ]\n    // strip trailing ] \u2014 the regex already ate the outer ] of Move=[...]\n    // but the actions=[...] still has its own closing ]\n    if (actionsContent.endsWith(']')) {\n      actionsContent = actionsContent.slice(0\x2C -1);\n    }\n  } else {\n    outerFields = inner;\n  }\n\n  // Parse outer fields: mover=N\x2Cfrom=F\x2Cto=T (comma-separated simple k=v)\n  let mover = -1;\n  let from = -1;\n  let to = -1;\n\n  for (const part of outerFields.split('\x2C')) {\n    const eqIdx = part.indexOf('=');\n    if (eqIdx === -1) continue;\n    const key = part.slice(0\x2C eqIdx).trim();\n    const val = parseInt(part.slice(eqIdx + 1).trim()\x2C 10);\n    if (key === 'mover') mover = isNaN(val) ? -1 : val;\n    else if (key === 'from') from = isNaN(val) ? -1 : val;\n    else if (key === 'to') to = isNaN(val) ? -1 : val;\n  }\n\n  const actions = actionsContent ? parseActions(actionsContent) : [];\n\n  return { mover\x2C from\x2C to\x2C actions };\n}\n\n/**\n * Parse a complete trial file text.\n *\n * @param {string} text - full contents of a .txt trial file\n * @param {string} trialFilePath - path to the trial file (for relative resolution)\n * @returns {{ gamePath\x2C rngState\x2C options\x2C moves\x2C numInitialPlacementMoves\x2C winner\x2C rankings\x2C endtype }}\n */\nexport function parseTrial(text\x2C trialFilePath) {\n  const lines = text.split('\\n');\n  let i = 0;\n\n  // Line 1: game=...\n  const gameLineRe = /^game=(.+)$/;\n  const gameLine = lines[i]?.trim() ?? '';\n  const gameMatch = gameLineRe.exec(gameLine);\n  if (!gameMatch) {\n    throw new Error(`Expected game= line\x2C got: ${gameLine.slice(0\x2C 80)}`);\n  }\n  const gameRelPath = gameMatch[1].trim();\n  i++;\n\n  // Resolve the path relative to the Player/ directory.\n  // The trial file is at: <PlayerDir>/res/random_trials/.../<name>.txt\n  // The game path is like: ../Common/res/lud/.../<game>.lud\n  // So Player/../Common/res/lud/... = Ludii root / Common/res/lud/...\n  // We'll store the relative path as-is and let the runner resolve it.\n  const gamePath = gameRelPath;\n\n  // Skip "START GAME OPTIONS" / options / "END GAME OPTIONS"\n  const options = [];\n  while (i < lines.length && !lines[i]?.trim().startsWith('START GAME OPTIONS')) i++;\n  if (lines[i]?.trim() === 'START GAME OPTIONS') {\n    i++;\n    while (i < lines.length && lines[i]?.trim() !== 'END GAME OPTIONS') {\n      const optLine = lines[i]?.trim();\n      if (optLine) options.push(optLine);\n      i++;\n    }\n    if (lines[i]?.trim() === 'END GAME OPTIONS') i++;\n  }\n\n  // RNG internal state (optional)\n  let rngState = null;\n  if (lines[i]?.trim().startsWith('RNG internal state=')) {\n    const rngLine = lines[i].trim();\n    rngState = rngLine.slice('RNG internal state='.length).split('\x2C').map(Number);\n    i++;\n  }\n\n  // Parse moves + interleaved metadata\n  const moves = [];\n  let numInitialPlacementMoves = 0;\n  let winner = -1;\n  let rankings = [];\n  let endtype = '';\n\n  while (i < lines.length) {\n    const line = lines[i]?.trim() ?? '';\n    i++;\n\n    if (!line) continue;\n\n    if (line.startsWith('Move=[')) {\n      try {\n        moves.push(parseMoveString(line));\n      } catch (e) {\n        // Skip unparseable move lines\n      }\n    } else if (line.startsWith('numInitialPlacementMoves=')) {\n      numInitialPlacementMoves = parseInt(line.slice('numInitialPlacementMoves='.length)\x2C 10);\n    } else if (line.startsWith('winner=')) {\n      winner = parseInt(line.slice('winner='.length)\x2C 10);\n    } else if (line.startsWith('rankings=')) {\n      const rankStr = line.slice('rankings='.length).trim();\n      rankings = rankStr.split('\x2C').map(Number);\n    } else if (line.startsWith('endtype=')) {\n      endtype = line.slice('endtype='.length).trim();\n    }\n    // LEGAL MOVES LIST SIZE\x2C SANDBOX\x2C LUDII_VERSION are ignored\n  }\n\n  return {\n    gamePath\x2C\n    trialFilePath\x2C\n    rngState\x2C\n    options\x2C\n    moves\x2C\n    numInitialPlacementMoves\x2C\n    winner\x2C\n    rankings\x2C\n    endtype\x2C\n  };\n}\n
