script-source,186,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-stack-move.js,// @java Core/src/other/action/move/ActionSubStackMove.java ActionSubStackMove\n/**\n * Java parity:\n * - Core/src/other/action/move/ActionSubStackMove.java\n *\n * Move a contiguous sub-stack of pieces (from level `levelFrom` up) to\n * the destination\x2C preserving order. With the TS stack model this is\n * `count` pops + `count` pushes.\n */\nimport { BaseAction } from "./action.js";\nexport class ActionSubStackMove extends BaseAction {\n    static TYPE = "StackMove";\n    fromIndex;\n    toIndex;\n    fromLevel;\n    constructor(from\x2C fromLevel\x2C to) {\n        super();\n        this.fromIndex = from;\n        this.toIndex = to;\n        this.fromLevel = fromLevel;\n        this.levelFromValue = fromLevel;\n    }\n    apply(state) {\n        const fromSize = state.stackSize(this.fromIndex);\n        if (fromSize === 0) {\n            const single = state.cells[this.fromIndex] ?? 0;\n            if (single === 0)\n                return state;\n            return state\n                .withCell(this.fromIndex\x2C 0)\n                .withStackPush(this.toIndex\x2C single);\n        }\n        const sliceCount = Math.max(0\x2C fromSize - this.fromLevel);\n        if (sliceCount === 0)\n            return state;\n        const pieces = [];\n        let next = state;\n        for (let i = 0; i < sliceCount; i++) {\n            pieces.push(next.stackAt(this.fromIndex\x2C next.stackSize(this.fromIndex) - 1));\n            next = next.withStackPop(this.fromIndex);\n        }\n        // pieces collected top-down; restore original order on destination.\n        for (let i = pieces.length - 1; i >= 0; i--) {\n            next = next.withStackPush(this.toIndex\x2C pieces[i] ?? 0);\n        }\n        return next;\n    }\n    actionType() {\n        return ActionSubStackMove.TYPE;\n    }\n    from() {\n        return this.fromIndex;\n    }\n    to() {\n        return this.toIndex;\n    }\n    levelFrom() {\n        return this.fromLevel;\n    }\n    isStacking() {\n        return true;\n    }\n}\n//# sourceMappingURL=action-stack-move.js.map
