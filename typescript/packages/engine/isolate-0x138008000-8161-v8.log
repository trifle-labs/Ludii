script-source,222,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/language/dist/src/lud-parser.js,/**\n * Minimal recursive-descent parser for the `.lud` S-expression grammar.\n *\n * Targets the subset used by tic-tac-toe-shaped game definitions in\n * `Common/res/lud/test/Tic-Tac-Toe Renamed.lud`. Anything outside the\n * supported syntax raises a `LudParseError` with the offending token.\n */\nimport { lexLud } from "./lud-lexer.js";\nimport { TokenRange } from "./token-range.js";\nexport class LudParseError extends Error {\n    offset;\n    constructor(message\x2C offset) {\n        super(`${message} (at offset ${offset})`);\n        this.name = "LudParseError";\n        this.offset = offset;\n    }\n}\nclass Cursor {\n    tokens;\n    index = 0;\n    constructor(tokens) {\n        this.tokens = tokens;\n    }\n    peek() {\n        return this.tokens[this.index];\n    }\n    next() {\n        const tok = this.tokens[this.index];\n        if (!tok) {\n            throw new LudParseError("Unexpected end of input"\x2C this.endOffset());\n        }\n        this.index += 1;\n        return tok;\n    }\n    hasMore() {\n        return this.index < this.tokens.length;\n    }\n    endOffset() {\n        const last = this.tokens[this.tokens.length - 1];\n        return last ? last.range.to() : 0;\n    }\n}\nfunction parseNode(cursor) {\n    const tok = cursor.next();\n    switch (tok.kind) {\n        case "lparen":\n        case "lcurly":\n            return parseListBody(cursor\x2C tok);\n        case "rparen":\n        case "rcurly":\n            throw new LudParseError(`Unexpected "${tok.lexeme}"`\x2C tok.range.from());\n        case "string":\n            return {\n                kind: "string"\x2C\n                value: tok.text\x2C\n                range: tok.range\x2C\n            };\n        case "number": {\n            const value = Number(tok.text);\n            if (!Number.isFinite(value)) {\n                throw new LudParseError(`Invalid numeric literal "${tok.text}"`\x2C tok.range.from());\n            }\n            return {\n                kind: "number"\x2C\n                value\x2C\n                range: tok.range\x2C\n            };\n        }\n        case "ident":\n            return {\n                kind: "ident"\x2C\n                name: tok.text\x2C\n                range: tok.range\x2C\n            };\n    }\n}\nfunction parseListBody(cursor\x2C opener) {\n    const closer = opener.kind === "lparen" ? "rparen" : "rcurly";\n    const delimiter = opener.kind === "lparen" ? "round" : "curly";\n    const items = [];\n    while (true) {\n        const next = cursor.peek();\n        if (!next) {\n            throw new LudParseError(`Unterminated ${delimiter}-bracket list`\x2C opener.range.from());\n        }\n        if (next.kind === closer) {\n            cursor.next();\n            return {\n                kind: "list"\x2C\n                delimiter\x2C\n                items\x2C\n                range: new TokenRange(opener.range.from()\x2C next.range.to())\x2C\n            };\n        }\n        items.push(parseNode(cursor));\n    }\n}\n/** Parse a single `.lud` source string into a top-level node. */\nexport function parseLud(source) {\n    const tokens = lexLud(source);\n    const cursor = new Cursor(tokens);\n    if (!cursor.hasMore()) {\n        throw new LudParseError("Empty source"\x2C 0);\n    }\n    const node = parseNode(cursor);\n    // Some `.lud` files have a trailing `(metadata ...)` form. Allow\n    // multiple top-level forms by collecting them into a synthetic list.\n    if (!cursor.hasMore()) {\n        return node;\n    }\n    const extras = [node];\n    while (cursor.hasMore()) {\n        extras.push(parseNode(cursor));\n    }\n    return {\n        kind: "list"\x2C\n        delimiter: "round"\x2C\n        items: extras\x2C\n        range: new TokenRange(node.range.from()\x2C extras[extras.length - 1]?.range.to() ?? node.range.to())\x2C\n    };\n}\n//# sourceMappingURL=lud-parser.js.map
