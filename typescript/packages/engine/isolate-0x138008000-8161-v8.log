script-source,151,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/action/action-move-n.js,// @java Core/src/other/action/move/ActionMoveN.java ActionMoveN\n/**\n * Java parity: Core/src/other/action/move/ActionMoveN.java \u2014 move N\n * pieces from a stack/site to another.\n */\nimport { ACTION_OFF\x2C BaseAction } from "./action.js";\nexport class ActionMoveN extends BaseAction {\n    static TYPE = "MoveN";\n    fromIndex;\n    toIndex;\n    countValue;\n    constructor(options) {\n        super();\n        if (!Number.isInteger(options.count) || options.count < 1) {\n            throw new RangeError("ActionMoveN.count must be a positive integer.");\n        }\n        this.fromIndex = options.from;\n        this.toIndex = options.to;\n        this.countValue = options.count;\n    }\n    apply(state) {\n        // For non-stacking games we ignore count (single-piece moves); for\n        // stacking games we pop `count` pieces from `from` and push them to\n        // `to`. Java semantics: pop from top\x2C push in popped order so the\n        // bottom of the moved pile ends up on top of the destination.\n        let next = state;\n        const popped = [];\n        for (let i = 0; i < this.countValue; i += 1) {\n            const top = next.stackAt(this.fromIndex\x2C next.stackSize(this.fromIndex) - 1);\n            if (top === 0)\n                break;\n            popped.push(top);\n            next = next.withStackPop(this.fromIndex);\n        }\n        for (const owner of popped) {\n            next = next.withStackPush(this.toIndex\x2C owner);\n        }\n        return next;\n    }\n    actionType() {\n        return ActionMoveN.TYPE;\n    }\n    from() {\n        return this.fromIndex;\n    }\n    to() {\n        return this.toIndex;\n    }\n    count() {\n        return this.countValue;\n    }\n    value() {\n        return ACTION_OFF;\n    }\n}\n//# sourceMappingURL=action-move-n.js.map
