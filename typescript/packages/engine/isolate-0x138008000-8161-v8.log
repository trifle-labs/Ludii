script-source,136,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/state.js,// @java Core/src/other/state/State.java State\n// @java Core/src/other/state/container/ContainerState.java ContainerState\n/**\n * Java parity:\n * - Core/src/other/state/State.java \u2014 the conceptual ancestor.\n * - Core/src/other/state/container/ContainerState.java \u2014 the per-piece\n *   slice. In the TS port the Board container's data lives directly in\n *   `cells`; the conceptual ContainerState surface is exposed via the\n *   `containerState()` view object below.\n *\n * Mover indices are 1-based to match Java. `owner === 0` means empty.\n * Score / value / count arrays are indexed by 0-based player slot\x2C with\n * index 0 corresponding to the shared/neutral slot Java uses.\n */\nexport class State {\n    mover;\n    cells;\n    /**\n     * Per-site component index (Java: ContainerState.what(site))\x2C parallel to\n     * `cells` which stores the owner (who). 0 = no specific component recorded;\n     * `whatAtSite`/`containerState().what` then fall back to the owner so\n     * single-component-per-player games are unchanged. Heterogeneous-piece games\n     * (chess family\x2C shogi\x2C \u2026) populate this so a pawn keeps a different `what`\n     * from a rook even when both belong to the same player.\n     */\n    whats;\n    componentLabels;\n    scores;\n    valuesPlayer;\n    hiddenForPlayer;\n    stacks;\n    stateAt;\n    valueAt;\n    rotationAt;\n    countAt;\n    phases;\n    temps;\n    amounts;\n    counter;\n    pot;\n    pending;\n    vars;\n    remembered;\n    trumpSuit;\n    next;\n    diceAllEqual;\n    diceValues;\n    stalemated;\n    constructor(mover\x2C cells\x2C componentLabels\x2C options = {}) {\n        // mover == 0 is reserved for 0-player simulation games (no side to move).\n        if (!Number.isInteger(mover) || mover < 0) {\n            throw new Error(`mover must be a non-negative integer (0 = no mover); got ${mover}.`);\n        }\n        const numPlayers = options.numPlayers ?? componentLabels.length;\n        if (!Number.isInteger(numPlayers) || numPlayers < 0) {\n            throw new Error(`numPlayers must be a non-negative integer; got ${numPlayers}.`);\n        }\n        const n = cells.length;\n        this.mover = mover;\n        this.cells = Object.freeze([...cells]);\n        this.whats = Object.freeze(fillSlot(options.whats\x2C n\x2C 0));\n        this.componentLabels = Object.freeze([...componentLabels]);\n        this.scores = Object.freeze(fillSlot(options.scores\x2C numPlayers + 1\x2C 0));\n        this.valuesPlayer = Object.freeze(fillSlot(options.valuesPlayer\x2C numPlayers + 1\x2C 0));\n        this.hiddenForPlayer = Object.freeze(fillHidden(options.hiddenForPlayer\x2C numPlayers + 1\x2C n));\n        this.stacks = Object.freeze(fillStacks(options.stacks\x2C this.cells));\n        this.stateAt = Object.freeze(fillSlot(options.stateAt\x2C n\x2C 0));\n        this.valueAt = Object.freeze(fillSlot(options.valueAt\x2C n\x2C 0));\n        this.rotationAt = Object.freeze(fillSlot(options.rotationAt\x2C n\x2C 0));\n        this.countAt = Object.freeze(options.countAt\n            ? fillSlot(options.countAt\x2C n\x2C 0)\n            : this.cells.map((c) => (c === 0 ? 0 : 1)));\n        this.phases = Object.freeze(fillSlot(options.phases\x2C numPlayers + 1\x2C 0));\n        this.temps = Object.freeze(fillSlot(options.temps\x2C numPlayers + 1\x2C 0));\n        this.amounts = Object.freeze(fillSlot(options.amounts\x2C numPlayers + 1\x2C 0));\n        this.counter = options.counter ?? 0;\n        this.pot = options.pot ?? 0;\n        this.pending = options.pending\n            ? Object.freeze(new Set(options.pending))\n            : Object.freeze(new Set());\n        this.vars = options.vars\n            ? Object.freeze(new Map(options.vars))\n            : Object.freeze(new Map());\n        this.remembered = options.remembered\n            ? Object.freeze(new Map(Array.from(options.remembered\x2C ([k\x2C v]) => [\n                k\x2C\n                Object.freeze([...v])\x2C\n            ])))\n            : Object.freeze(new Map());\n        this.trumpSuit = options.trumpSuit ?? 0;\n        this.next = options.next ?? 0;\n        this.diceAllEqual = options.diceAllEqual ?? false;\n        this.diceValues = Object.freeze([...(options.diceValues ?? [])]);\n        this.stalemated = Object.freeze(fillBoolSlot(options.stalemated\x2C numPlayers + 1));\n    }\n    /** Java parity: `State.isHidden(pid\x2C siteIndex)`. */\n    isHidden(pid\x2C siteIndex) {\n        const row = this.hiddenForPlayer[pid];\n        if (!row)\n            return false;\n        return row[siteIndex] ?? false;\n    }\n    /** Java parity: `State.setHidden(pid\x2C siteIndex\x2C hidden)`. */\n    withHidden(pid\x2C siteIndex\x2C hidden) {\n        if (!Number.isInteger(pid) ||\n            pid < 0 ||\n            pid >= this.hiddenForPlayer.length) {\n            throw new RangeError(`pid ${pid} out of range [0\x2C ${this.hiddenForPlayer.length}).`);\n        }\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n        const grid = this.hiddenForPlayer.map((row) => [...row]);\n        const target = grid[pid];\n        if (!target) {\n            throw new RangeError(`pid ${pid} row missing.`);\n        }\n        target[siteIndex] = hidden;\n        return this.with({ hiddenForPlayer: grid });\n    }\n    withCell(siteIndex\x2C owner) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n        const next = [...this.cells];\n        next[siteIndex] = owner;\n        return this.with({ cells: next });\n    }\n    /**\n     * Component index recorded at a site (Java: ContainerState.what(site)).\n     * Falls back to the owner when no specific component was recorded\x2C and is 0\n     * for an empty site regardless of any stale value left in `whats`.\n     */\n    whatAtSite(siteIndex) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length)\n            return 0;\n        if ((this.cells[siteIndex] ?? 0) === 0)\n            return 0;\n        const w = this.whats[siteIndex] ?? 0;\n        return w !== 0 ? w : (this.cells[siteIndex] ?? 0);\n    }\n    /** Set the component index at a site (Java: ContainerState.setWhat). */\n    withWhatAt(siteIndex\x2C what) {\n        this.requireSite(siteIndex);\n        const next = [...this.whats];\n        next[siteIndex] = what;\n        return this.with({ whats: next });\n    }\n    withMover(mover) {\n        return this.with({ mover });\n    }\n    /**\n     * Java parity: `State.setStalemated(player\x2C value)`. Returns a copy with the\n     * given player's stalemated flag updated. Read by `(no Moves <player>)`.\n     */\n    withStalemated(player\x2C value) {\n        if (!Number.isInteger(player) || player < 0 || player >= this.stalemated.length) {\n            return this;\n        }\n        const next = [...this.stalemated];\n        next[player] = value;\n        return this.with({ stalemated: next });\n    }\n    /** Java parity: `State.setScore(pid\x2C value)` (1-based pid). */\n    withScore(pid\x2C value) {\n        if (!Number.isInteger(pid) || pid < 0 || pid >= this.scores.length) {\n            throw new RangeError(`pid ${pid} out of range [0\x2C ${this.scores.length}).`);\n        }\n        const next = [...this.scores];\n        next[pid] = value;\n        return this.with({ scores: next });\n    }\n    /** Java parity: `State.setValuePlayer(pid\x2C value)` (1-based pid). */\n    withValuePlayer(pid\x2C value) {\n        if (!Number.isInteger(pid) || pid < 0 || pid >= this.valuesPlayer.length) {\n            throw new RangeError(`pid ${pid} out of range [0\x2C ${this.valuesPlayer.length}).`);\n        }\n        const next = [...this.valuesPlayer];\n        next[pid] = value;\n        return this.with({ valuesPlayer: next });\n    }\n    score(pid) {\n        return this.scores[pid] ?? 0;\n    }\n    valuePlayer(pid) {\n        return this.valuesPlayer[pid] ?? 0;\n    }\n    cellAt(siteIndex) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n        const owner = this.cells[siteIndex] ?? 0;\n        if (owner === 0) {\n            return { owner: 0 };\n        }\n        const label = this.componentLabels[owner - 1];\n        return label === undefined ? { owner } : { owner\x2C componentLabel: label };\n    }\n    get siteCount() {\n        return this.cells.length;\n    }\n    /**\n     * Java parity: `State.fullHash()` \u2014 a deterministic 32-bit fingerprint\n     * of the visible state used as the keys in `Trial.previousStates`.\n     * The TS port uses FNV-1a over the public data members so two states\n     * with identical observable shape collide.\n     */\n    hash() {\n        let h = 0x811c9dc5;\n        const mix = (n) => {\n            h ^= n & 0xff;\n            h = Math.imul(h\x2C 0x01000193);\n            h ^= (n >>> 8) & 0xff;\n            h = Math.imul(h\x2C 0x01000193);\n            h ^= (n >>> 16) & 0xff;\n            h = Math.imul(h\x2C 0x01000193);\n            h ^= (n >>> 24) & 0xff;\n            h = Math.imul(h\x2C 0x01000193);\n        };\n        mix(this.mover);\n        for (const c of this.cells)\n            mix(c);\n        for (const s of this.scores)\n            mix(s);\n        for (const v of this.valuesPlayer)\n            mix(v);\n        return h >>> 0;\n    }\n    /** Returns the conceptual ContainerState slice for the board. */\n    containerState() {\n        const cells = this.cells;\n        const stacks = this.stacks;\n        return Object.freeze({\n            size: cells.length\x2C\n            who: (i) => cells[i] ?? 0\x2C\n            what: (i) => this.whatAtSite(i)\x2C\n            count: (i) => stacks[i]?.length ?? 0\x2C\n            isEmpty: (i) => (stacks[i]?.length ?? 0) === 0\x2C\n        });\n    }\n    /** Java parity: `ContainerState.sizeStack(siteIndex)`. */\n    stackSize(siteIndex) {\n        return this.stacks[siteIndex]?.length ?? 0;\n    }\n    /**\n     * Java parity: `ContainerState.who(siteIndex\x2C level)`. Returns the\n     * owner at the given stack level\x2C or 0 if empty.\n     */\n    stackAt(siteIndex\x2C level) {\n        const stack = this.stacks[siteIndex];\n        if (!stack)\n            return 0;\n        return stack[level] ?? 0;\n    }\n    /** Java parity: `ContainerState.push(siteIndex\x2C what)`. */\n    withStackPush(siteIndex\x2C owner) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n        if (!Number.isInteger(owner) || owner < 1) {\n            throw new Error(`owner must be a 1-based integer; got ${owner}.`);\n        }\n        const nextStacks = this.stacks.map((s) => [...s]);\n        const target = nextStacks[siteIndex] ?? [];\n        target.push(owner);\n        nextStacks[siteIndex] = target;\n        const nextCells = [...this.cells];\n        nextCells[siteIndex] = owner;\n        return this.with({ cells: nextCells\x2C stacks: nextStacks });\n    }\n    /** Java parity: `ContainerState.pop(siteIndex)`. */\n    withStackPop(siteIndex) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n        const nextStacks = this.stacks.map((s) => [...s]);\n        const target = nextStacks[siteIndex] ?? [];\n        target.pop();\n        nextStacks[siteIndex] = target;\n        const nextCells = [...this.cells];\n        nextCells[siteIndex] = target[target.length - 1] ?? 0;\n        return this.with({ cells: nextCells\x2C stacks: nextStacks });\n    }\n    // ---- Per-site value / state / rotation / count -----------------------\n    stateAtSite(siteIndex) {\n        return this.stateAt[siteIndex] ?? 0;\n    }\n    valueAtSite(siteIndex) {\n        return this.valueAt[siteIndex] ?? 0;\n    }\n    rotationAtSite(siteIndex) {\n        return this.rotationAt[siteIndex] ?? 0;\n    }\n    countAtSite(siteIndex) {\n        return this.countAt[siteIndex] ?? 0;\n    }\n    withStateAt(siteIndex\x2C value) {\n        this.requireSite(siteIndex);\n        const next = [...this.stateAt];\n        next[siteIndex] = value;\n        return this.with({ stateAt: next });\n    }\n    withValueAt(siteIndex\x2C value) {\n        this.requireSite(siteIndex);\n        const next = [...this.valueAt];\n        next[siteIndex] = value;\n        return this.with({ valueAt: next });\n    }\n    withRotationAt(siteIndex\x2C value) {\n        this.requireSite(siteIndex);\n        const next = [...this.rotationAt];\n        next[siteIndex] = value;\n        return this.with({ rotationAt: next });\n    }\n    withCountAt(siteIndex\x2C value) {\n        this.requireSite(siteIndex);\n        const next = [...this.countAt];\n        next[siteIndex] = value;\n        return this.with({ countAt: next });\n    }\n    // ---- Per-player phase / temp / amount --------------------------------\n    phase(pid) {\n        return this.phases[pid] ?? 0;\n    }\n    temp(pid) {\n        return this.temps[pid] ?? 0;\n    }\n    amount(pid) {\n        return this.amounts[pid] ?? 0;\n    }\n    withPhase(pid\x2C value) {\n        this.requirePid(pid);\n        const next = [...this.phases];\n        next[pid] = value;\n        return this.with({ phases: next });\n    }\n    withTemp(pid\x2C value) {\n        this.requirePid(pid);\n        const next = [...this.temps];\n        next[pid] = value;\n        return this.with({ temps: next });\n    }\n    withAmount(pid\x2C value) {\n        this.requirePid(pid);\n        const next = [...this.amounts];\n        next[pid] = value;\n        return this.with({ amounts: next });\n    }\n    // ---- Game-level scalars ----------------------------------------------\n    withCounter(value) {\n        return this.with({ counter: value });\n    }\n    withPot(value) {\n        return this.with({ pot: value });\n    }\n    withTrumpSuit(value) {\n        return this.with({ trumpSuit: value });\n    }\n    withNext(value) {\n        return this.with({ next: value });\n    }\n    withDiceAllEqual(value) {\n        return this.with({ diceAllEqual: value });\n    }\n    /** Java parity: replace per-die face values from a fresh roll. */\n    withDiceValues(values) {\n        const allEqual = values.length >= 2 && values.every((v) => v === values[0]);\n        return this.with({\n            diceValues: [...values]\x2C\n            diceAllEqual: values.length >= 2 ? allEqual : this.diceAllEqual\x2C\n        });\n    }\n    // ---- Pending sites ---------------------------------------------------\n    isPending(siteIndex) {\n        return this.pending.has(siteIndex);\n    }\n    withPendingAdd(siteIndex) {\n        const next = new Set(this.pending);\n        next.add(siteIndex);\n        return this.with({ pending: next });\n    }\n    withPendingClear() {\n        return this.with({ pending: new Set() });\n    }\n    // ---- Named variables -------------------------------------------------\n    getVar(name) {\n        return this.vars.get(name) ?? 0;\n    }\n    withVar(name\x2C value) {\n        const next = new Map(this.vars);\n        next.set(name\x2C value);\n        return this.with({ vars: next });\n    }\n    // ---- Remembered values -----------------------------------------------\n    rememberedFor(name) {\n        return this.remembered.get(name) ?? [];\n    }\n    withRemember(name\x2C value) {\n        const next = new Map(this.remembered);\n        const cur = next.get(name) ?? [];\n        next.set(name\x2C Object.freeze([...cur\x2C value]));\n        return this.with({ remembered: next });\n    }\n    withForget(name\x2C value) {\n        const next = new Map(this.remembered);\n        const cur = next.get(name);\n        if (cur) {\n            const filtered = cur.filter((v) => v !== value);\n            if (filtered.length === 0)\n                next.delete(name);\n            else\n                next.set(name\x2C Object.freeze(filtered));\n        }\n        return this.with({ remembered: next });\n    }\n    requireSite(siteIndex) {\n        if (siteIndex < 0 || siteIndex >= this.cells.length) {\n            throw new RangeError(`siteIndex ${siteIndex} out of range [0\x2C ${this.cells.length}).`);\n        }\n    }\n    requirePid(pid) {\n        if (!Number.isInteger(pid) || pid < 0 || pid >= this.scores.length) {\n            throw new RangeError(`pid ${pid} out of range [0\x2C ${this.scores.length}).`);\n        }\n    }\n    with(patch) {\n        const nextCells = patch.cells ?? this.cells;\n        const nextStacks = patch.stacks ??\n            (patch.cells ? syncStacks(this.stacks\x2C nextCells) : this.stacks);\n        return new State(patch.mover ?? this.mover\x2C nextCells\x2C this.componentLabels\x2C {\n            whats: patch.whats ?? this.whats\x2C\n            scores: patch.scores ?? this.scores\x2C\n            valuesPlayer: patch.valuesPlayer ?? this.valuesPlayer\x2C\n            hiddenForPlayer: patch.hiddenForPlayer ?? this.hiddenForPlayer\x2C\n            stacks: nextStacks\x2C\n            stateAt: patch.stateAt ?? this.stateAt\x2C\n            valueAt: patch.valueAt ?? this.valueAt\x2C\n            rotationAt: patch.rotationAt ?? this.rotationAt\x2C\n            countAt: patch.countAt ?? this.countAt\x2C\n            phases: patch.phases ?? this.phases\x2C\n            temps: patch.temps ?? this.temps\x2C\n            amounts: patch.amounts ?? this.amounts\x2C\n            counter: patch.counter ?? this.counter\x2C\n            pot: patch.pot ?? this.pot\x2C\n            pending: patch.pending ?? this.pending\x2C\n            vars: patch.vars ?? this.vars\x2C\n            remembered: patch.remembered ?? this.remembered\x2C\n            trumpSuit: patch.trumpSuit ?? this.trumpSuit\x2C\n            next: patch.next ?? this.next\x2C\n            diceAllEqual: patch.diceAllEqual ?? this.diceAllEqual\x2C\n            diceValues: patch.diceValues ?? this.diceValues\x2C\n            stalemated: patch.stalemated ?? this.stalemated\x2C\n            numPlayers: this.scores.length - 1\x2C\n        });\n    }\n}\nfunction syncStacks(previous\x2C cells) {\n    const out = [];\n    for (let i = 0; i < cells.length; i += 1) {\n        const top = cells[i] ?? 0;\n        const prev = previous[i];\n        if (top === 0) {\n            out.push([]);\n        }\n        else if (!prev || prev.length === 0) {\n            out.push([top]);\n        }\n        else {\n            // Replace the visible top while keeping any buried pieces.\n            const copy = [...prev];\n            copy[copy.length - 1] = top;\n            out.push(copy);\n        }\n    }\n    return out;\n}\nfunction fillStacks(source\x2C cells) {\n    if (source !== undefined) {\n        return source.map((s) => Object.freeze([...s]));\n    }\n    return cells.map((c) => Object.freeze(c === 0 ? [] : [c]));\n}\nfunction fillHidden(source\x2C rows\x2C cols) {\n    const out = [];\n    for (let r = 0; r < rows; r += 1) {\n        const src = source?.[r];\n        const row = new Array(cols).fill(false);\n        if (src) {\n            for (let c = 0; c < Math.min(cols\x2C src.length); c += 1) {\n                row[c] = src[c] ?? false;\n            }\n        }\n        out.push(row);\n    }\n    return out;\n}\nfunction fillSlot(source\x2C length\x2C fill) {\n    if (source === undefined)\n        return new Array(length).fill(fill);\n    if (source.length === length)\n        return [...source];\n    const out = new Array(length).fill(fill);\n    for (let i = 0; i < Math.min(length\x2C source.length); i += 1) {\n        out[i] = source[i] ?? fill;\n    }\n    return out;\n}\nfunction fillBoolSlot(source\x2C length) {\n    if (source === undefined)\n        return new Array(length).fill(false);\n    if (source.length === length)\n        return [...source];\n    const out = new Array(length).fill(false);\n    for (let i = 0; i < Math.min(length\x2C source.length); i += 1) {\n        out[i] = source[i] ?? false;\n    }\n    return out;\n}\n//# sourceMappingURL=state.js.map
