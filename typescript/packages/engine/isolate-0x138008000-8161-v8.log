script-source,221,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/language/dist/src/lud-lexer.js,/**\n * Minimal `.lud` lexer. Produces a token stream suitable for an\n * S-expression-style parser.\n *\n * Java reference:\n * - The full Java tokenizer lives across the `Language/` module. This\n *   TS lexer targets the subset of `.lud` syntax needed by the\n *   browser-player MVE (game definitions like tic-tac-toe).\n *\n * Supported tokens:\n * - `(` / `)` \u2014 round-paren grouping\n * - `{` / `}` \u2014 curly-brace grouping (Ludii uses `{}` for ordered lists\n *   of equipment / metadata entries)\n * - strings \u2014 double-quoted\x2C no escape sequences in the MVE subset\n * - numbers \u2014 integer or decimal\x2C optional leading `-`\n * - identifiers \u2014 anything else not whitespace / paren / quote\n * - comments \u2014 `//` to end of line; ignored\n */\nimport { TokenRange } from "./token-range.js";\nexport class LudLexError extends Error {\n    offset;\n    constructor(message\x2C offset) {\n        super(`${message} (at offset ${offset})`);\n        this.name = "LudLexError";\n        this.offset = offset;\n    }\n}\nfunction isDigit(ch) {\n    return ch >= "0" && ch <= "9";\n}\nfunction isIdentChar(ch) {\n    if (ch === "" || ch === "(" || ch === ")" || ch === "{" || ch === "}") {\n        return false;\n    }\n    if (ch === '"') {\n        return false;\n    }\n    // Treat any non-whitespace character as identifier content.\n    return !/\\s/.test(ch);\n}\nexport function lexLud(source) {\n    const tokens = [];\n    let i = 0;\n    const length = source.length;\n    while (i < length) {\n        const ch = source[i] ?? "";\n        if (/\\s/.test(ch)) {\n            i += 1;\n            continue;\n        }\n        // Line comment: `//` ... newline\n        if (ch === "/" && source[i + 1] === "/") {\n            while (i < length && source[i] !== "\\n") {\n                i += 1;\n            }\n            continue;\n        }\n        if (ch === "(") {\n            tokens.push({\n                kind: "lparen"\x2C\n                text: "("\x2C\n                lexeme: "("\x2C\n                range: new TokenRange(i\x2C i + 1)\x2C\n            });\n            i += 1;\n            continue;\n        }\n        if (ch === ")") {\n            tokens.push({\n                kind: "rparen"\x2C\n                text: ")"\x2C\n                lexeme: ")"\x2C\n                range: new TokenRange(i\x2C i + 1)\x2C\n            });\n            i += 1;\n            continue;\n        }\n        if (ch === "{") {\n            tokens.push({\n                kind: "lcurly"\x2C\n                text: "{"\x2C\n                lexeme: "{"\x2C\n                range: new TokenRange(i\x2C i + 1)\x2C\n            });\n            i += 1;\n            continue;\n        }\n        if (ch === "}") {\n            tokens.push({\n                kind: "rcurly"\x2C\n                text: "}"\x2C\n                lexeme: "}"\x2C\n                range: new TokenRange(i\x2C i + 1)\x2C\n            });\n            i += 1;\n            continue;\n        }\n        if (ch === '"') {\n            const start = i;\n            i += 1;\n            let body = "";\n            // A quote ends the string only when it is *not* preceded by a\n            // backslash. This matches Ludii\x2C where HTML metadata escapes quotes as\n            // `\\"` (and sometimes `\\\\"`); collapsing the backslashes would let the\n            // following quote terminate the string early. Backslashes are kept\n            // literally in the body \u2014 the MVE never inspects escaped metadata text.\n            while (i < length) {\n                const c = source[i];\n                if (c === '"' && source[i - 1] !== "\\\\") {\n                    break;\n                }\n                body += c;\n                i += 1;\n            }\n            if (i >= length) {\n                throw new LudLexError("Unterminated string literal"\x2C start);\n            }\n            i += 1; // consume closing quote\n            tokens.push({\n                kind: "string"\x2C\n                text: body\x2C\n                lexeme: source.slice(start\x2C i)\x2C\n                range: new TokenRange(start\x2C i)\x2C\n            });\n            continue;\n        }\n        if (isDigit(ch) || (ch === "-" && isDigit(source[i + 1] ?? ""))) {\n            const start = i;\n            if (ch === "-") {\n                i += 1;\n            }\n            while (i < length && isDigit(source[i] ?? "")) {\n                i += 1;\n            }\n            if (source[i] === ".") {\n                i += 1;\n                while (i < length && isDigit(source[i] ?? "")) {\n                    i += 1;\n                }\n            }\n            const lexeme = source.slice(start\x2C i);\n            tokens.push({\n                kind: "number"\x2C\n                text: lexeme\x2C\n                lexeme\x2C\n                range: new TokenRange(start\x2C i)\x2C\n            });\n            continue;\n        }\n        if (isIdentChar(ch)) {\n            const start = i;\n            // Option references like `<Tag:argName>` carry an internal `:` that is\n            // not a named-argument key\x2C so keep angle-bracketed tokens whole.\n            const isOptionRef = ch === "<";\n            while (i < length && isIdentChar(source[i] ?? "")) {\n                // A `:` ends a named-argument key (e.g. `at:`\x2C `if:`). Stop right\n                // after it so `at:#1` lexes as `at:` + `#1`\x2C matching how `at:(to)`\n                // already splits when a paren follows. Without this\x2C `key:value`\n                // glued tokens hide the `#n` placeholder from define expansion.\n                if (!isOptionRef && source[i] === ":") {\n                    i += 1;\n                    break;\n                }\n                i += 1;\n            }\n            const lexeme = source.slice(start\x2C i);\n            tokens.push({\n                kind: "ident"\x2C\n                text: lexeme\x2C\n                lexeme\x2C\n                range: new TokenRange(start\x2C i)\x2C\n            });\n            continue;\n        }\n        throw new LudLexError(`Unexpected character "${ch}"`\x2C i);\n    }\n    return tokens;\n}\n//# sourceMappingURL=lud-lexer.js.map
