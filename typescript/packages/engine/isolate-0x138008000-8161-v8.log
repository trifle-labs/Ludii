script-source,231,file:///Users/billy/GitHub/trifle-labs/Ludii/typescript/packages/engine/dist/src/eval/graph/trajectories.js,/**\n * Play-site adjacency facade over the faithful {@link TrajectoriesCore} engine\n * (src/eval/graph/trajectory/)\x2C which is the direct port of Java\n * Core/src/game/util/graph/Trajectories.java.\n *\n * A Ludii board plays either on faces (`use:Cell`\x2C the default) or on vertices\n * (`use:Vertex` / `use:Edge`). This class projects the core's full\n * SiteType\xd7direction Steps/Radials onto a single play SiteType and exposes the\n * compact `step / ray / group / neighbours` interface the evaluator consumes.\n * Site ids are element ids of the play type\x2C i.e. identical to the Graph's\n * `faces[i]` / `vertices[i]` ordering \u2014 so numbering is unchanged from the\n * previous lattice-derived facade.\n *\n * All adjacency and direction decisions now come from the core (one mechanism\x2C\n * matching Java on every tiling)\x2C replacing the old 8-compass `Math.round`\n * shortcut. See PARITY.md (roadmap item 1).\n */\nimport { AbsoluteDirection\x2C directionByName\x2C } from "./trajectory/absolute-direction.js";\nimport { SiteType } from "./trajectory/graph-element.js";\nimport { TrajectoriesCore } from "./trajectory/trajectories.js";\n/**\n * Adjacency + direction view of a graph as a set of play-sites. `numSites` is\n * the count of faces (Cell) or vertices (Vertex); methods take a site index in\n * `[0\x2C numSites)`.\n */\nexport class Trajectories {\n    kind;\n    numSites;\n    core;\n    playType;\n    els;\n    constructor(graph\x2C kind) {\n        this.kind = kind;\n        this.core = new TrajectoriesCore(graph);\n        this.playType = kind === "Vertex" ? SiteType.Vertex : SiteType.Cell;\n        this.els = this.core.topo.elements(this.playType);\n        this.numSites = this.els.length;\n    }\n    xOf(site) {\n        return this.els[site]?.pt.x ?? Number.NaN;\n    }\n    yOf(site) {\n        return this.els[site]?.pt.y ?? Number.NaN;\n    }\n    /** Nearest play-site neighbour in a compass/structural direction\x2C or -1. */\n    step(site\x2C dir) {\n        const d = directionByName(dir);\n        if (d === undefined)\n            return -1;\n        const steps = this.core.stepsToTypeInDirection(this.playType\x2C site\x2C this.playType\x2C d);\n        if (steps.length === 0)\n            return -1;\n        // On a collision keep the nearest\x2C matching the legacy facade.\n        const from = this.els[site];\n        if (!from)\n            return steps[0].to.id;\n        let best = steps[0].to;\n        let bestD = sqDist(from\x2C best);\n        for (let i = 1; i < steps.length; i += 1) {\n            const to = steps[i].to;\n            const dd = sqDist(from\x2C to);\n            if (dd < bestD) {\n                bestD = dd;\n                best = to;\n            }\n        }\n        return best.id;\n    }\n    /** The ray of play-sites reached by repeatedly stepping `dir` from `site`. */\n    ray(site\x2C dir) {\n        const d = directionByName(dir);\n        if (d === undefined)\n            return [];\n        const radials = this.core.radialsInDirection(this.playType\x2C site\x2C d);\n        if (radials.length === 0)\n            return [];\n        // The longest radial is the full line; its tail (beyond the origin) is the ray.\n        let longest = radials[0];\n        for (const r of radials) {\n            if (r.steps.length > longest.steps.length)\n                longest = r;\n        }\n        return longest.steps.slice(1).map((e) => e.id);\n    }\n    /** Neighbour play-sites in a named direction group (Orthogonal/Diagonal/Adjacent/All). */\n    group(site\x2C name) {\n        // Unknown names behave like the legacy "all neighbours" fallback.\n        const d = directionByName(name) ?? AbsoluteDirection.Adjacent;\n        return this.core\n            .stepsToTypeInDirection(this.playType\x2C site\x2C this.playType\x2C d)\n            .map((s) => s.to.id);\n    }\n    /** All orthogonal neighbours (edge-sharing). */\n    neighbours(site) {\n        return this.core\n            .stepsToTypeInDirection(this.playType\x2C site\x2C this.playType\x2C AbsoluteDirection.Orthogonal)\n            .map((s) => s.to.id);\n    }\n}\n/** Squared planar distance between two graph elements. */\nfunction sqDist(a\x2C b) {\n    const dx = b.pt.x - a.pt.x;\n    const dy = b.pt.y - a.pt.y;\n    return dx * dx + dy * dy;\n}\n//# sourceMappingURL=trajectories.js.map
